@{
    ViewData["Title"] = "Gestión de Solicitudes Remotas.";

    string rutaApi = ViewBag.RutaApi ?? string.Empty;
}

<div class="dashboard">
    <!-- Panel Izquierdo: Lista de Solicitudes -->
    <div class="requests-panel card-golden">
        <div class="panel-header card-header-golden" style="flex-direction: column; align-items: stretch; padding: 0;">
            <div style="display: flex; justify-content: space-between; padding: 15px 20px;">
                <h2 id="panel-title" style="margin: 0; font-size: 1.25rem;">
                    Bandeja de Entrada
                    <span class="badge" id="pending-count">0</span>
                </h2>
            </div>
            <div class="tabs-container">
                <button class="tab-btn active" id="tab-pendientes" onclick="switchTab('pendientes')">Pendientes</button>
                <button class="tab-btn" id="tab-historico" onclick="switchTab('historico')">Histórico</button>
            </div>
            <div id="historico-filters" style="display: none; padding: 10px 20px; background: rgba(0,0,0,0.2); flex-direction: column; gap: 0.5rem;">
                <div style="display: flex; gap: 0.5rem;">
                    <div style="flex: 1;"><label style="font-size: 0.7rem; color: #ddd; display: block;">Desde</label><input type="date" id="historico-desde" class="form-control" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" /></div>
                    <div style="flex: 1;"><label style="font-size: 0.7rem; color: #ddd; display: block;">Hasta</label><input type="date" id="historico-hasta" class="form-control" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" /></div>
                </div>
                <button class="btn btn-golden" onclick="cargarHistorico()" style="padding: 0.25rem; font-size: 0.8rem;">Buscar</button>
            </div>
        </div>
        <div class="requests-list" id="requests-container">
            <div class="empty-state">
                <p>Cargando solicitudes...</p>
            </div>
        </div>
    </div>

    <!-- Panel Derecho: Detalle y Resolución -->
    <div class="detail-panel card-golden" id="detail-panel" style="display: none;">
        <div class="detail-header card-header-golden" style="border-radius: 0;">
            <div style="display: flex; justify-content: space-between;">
                <h2 style="color: white; margin: 0;">Resolver Autorización</h2>
                <span class="module-badge" id="detail-module" style="color: white;"></span>
            </div>
            <p class="request-meta" style="color: rgba(255,255,255,0.8);">ID: <span id="detail-id"></span></p>
        </div>

        <div class="request-details" id="request-details" style="margin-top: 1.5rem;">
            <div class="basic-info-grid">
                <div class="info-item">
                    <span class="info-label">Tipo</span>
                    <span class="info-value" id="lbl-tipo"></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Solicitante</span>
                    <span class="info-value" id="lbl-solicitante"></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Fecha</span>
                    <span class="info-value" id="lbl-fecha"></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Estado</span>
                    <span class="info-value" id="lbl-estado"></span>
                </div>
            </div>

            <h3 class="context-title">Detalles de la Operación</h3>
            <div class="context-grid" id="detail-context-grid">
                <!-- Generado dinámicamente -->
            </div>

            <h3 class="context-title" id="title-resolucion" style="display: none; margin-top: 1.5rem;">Resolución Aplicada</h3>
            <div class="basic-info-grid" id="resolucion-info-grid" style="display: none; margin-bottom: 0.5rem;">
                <div class="info-item">
                    <span class="info-label">Decisión</span>
                    <span class="info-value" id="lbl-res-decision"></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Usuario</span>
                    <span class="info-value" id="lbl-res-usuario"></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Fecha Resol.</span>
                    <span class="info-value" id="lbl-res-fecha"></span>
                </div>
            </div>
            <div class="context-grid" id="detail-resolucion-grid" style="display: none;">
                <!-- Generado dinámicamente -->
            </div>
        </div>

        <div class="resolution-form" id="resolution-form">
            <div class="form-group">
                <label for="resolution-comment">Observación para el cajero (Opcional)</label>
                <textarea id="resolution-comment" class="form-control" rows="3" placeholder="Ej: Faltan firmas en el remito..."></textarea>
            </div>

            <div class="action-buttons">
                <button class="btn btn-golden" onclick="resolverSolicitud('Aprobado')">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Aprobar
                </button>
                <button class="btn btn-reject" onclick="resolverSolicitud('Rechazado')">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Rechazar
                </button>
            </div>
        </div>
    </div>

    <div class="detail-panel card-golden" id="empty-detail-panel">
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem; opacity: 0.5; color: var(--bs-golden-primary);"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            <p>Selecciona una solicitud de la bandeja para ver los detalles y resolverla.</p>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const AUTH_SOL_RUTA_API = "@rutaApi";
    </script>
}