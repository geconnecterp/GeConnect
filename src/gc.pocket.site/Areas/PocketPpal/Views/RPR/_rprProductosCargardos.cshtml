@model GridCoreSmart<ProductoGenDto>

@{
    var dataMod = new ProductoGenDto();
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
    int cont = 0;
}

<div class="grid-golden h-100">
    <div class="grid-golden-body p-1">
        <div class="table-responsive table-wrapper table-wrapper-500">
            <table class="table table-sm table-hover mb-0 table-golden rpr-product-grid" id="tbProdRPR">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-sm-center th-compact" scope="col" style="width:5%">IT</th>
                        <th class="text-sm-center th-compact" scope="col" style="width:10%">ID</th>
                        <th class="text-left th-compact" scope="col" style="width:25%">Descripción</th>
                        <th class="text-sm-center th-compact" scope="col" style="width:10%">Un.B.</th>
                        <th class="text-sm-center th-compact" scope="col" style="width:10%">Bto</th>
                        <th class="text-sm-center th-compact" scope="col" style="width:10%">Un</th>
                        <th class="text-sm-center th-compact" scope="col" style="width:20%">Cantidad</th>
                        <th class="text-sm-center th-compact" scope="col" style="width:10%">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos != null && Model.ListaDatos.Any())
                    {
                        @foreach (var item in Model.ListaDatos)
                        {
                            cont++;
                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                            var id = $"btnDel{item.p_id}";
                            var unidadesPresentacion = item.unidad_pres.ToString("0");
                            var bultos = item.bulto.ToString("0");
                            var unidadesSueltas = CantidadProductoFormatter.Formatear(item.us, item.up_id);
                            var cantidad = CantidadProductoFormatter.Formatear(item.cantidad, item.up_id);
                            
                            <tr class="@clase cursor-pointer" data-prod-id="@item.p_id">
                                <td class="text-sm-center td-compact">
                                    <span class="badge bg-secondary">@item.item</span>
                                </td>
                                <td class="text-sm-center td-compact">
                                    <strong class="text-golden">@item.p_id</strong>
                                </td>
                                <td class="td-compact rpr-description" title="@item.p_desc">
                                    <div class="d-flex flex-column">
                                        <span class="corta-linea">@item.p_desc</span>
                                    </div>
                                </td>
                                <td class="text-sm-end td-compact rpr-number">
                                   @unidadesPresentacion
                                </td>
                                <td class="text-sm-end td-compact rpr-number">
                                    <strong>@bultos</strong>
                                </td>
                                <td class="text-sm-end td-compact rpr-number">
                                    <strong>@unidadesSueltas</strong>
                                </td>
                                <td class="text-sm-end td-compact rpr-number">
                                    <span class="badge bg-success rpr-quantity-badge">@cantidad</span>
                                </td>
                                <td class="text-sm-center td-compact">
                                    <button type="button" 
                                            id="@id" 
                                            class="btnDelete btn btn-sm btn-danger" 
                                            onclick="EliminarProducto('@item.p_id','@item.item')" 
                                            value="@item.p_id"
                                            title="Eliminar producto">
                                        <i class="bx bx-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bx bx-info-circle bx-md"></i>
                                <p class="mb-0">No hay productos cargados</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @* Footer con información adicional *@
    @if (Model.ListaDatos != null && Model.ListaDatos.Any())
    {
        <div class="grid-golden-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                <i class="bx bx-package"></i> Total productos: <strong>@Model.ListaDatos.Count()</strong>
            </small>
            <small class="text-muted">
                <i class="bx bx-calculator"></i> Total unidades: <strong>@CantidadProductoFormatter.FormatearTotalMixto(Model.ListaDatos.Sum(x => x.cantidad))</strong>
            </small>
        </div>
    }
</div>
