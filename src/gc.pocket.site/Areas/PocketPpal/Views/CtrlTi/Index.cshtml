
@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
}

<div class="container-fluid py-3">
    <div class="row mb-3 text-center">
        <div class="col-12">
            <h3 class="text-golden-dark">
                <i class="bx bx-check-shield"></i> Control de Salida de Transferencias
            </h3>
            <p class="text-muted mb-0">Seleccione el tipo de transferencia a controlar</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <a asp-action="CtrlTI_AU" asp-controller="ctrlti" asp-area="pocketppal" asp-route-titId="S"
               class="card-golden text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0"><i class="bx bx-building me-2"></i>Entre Sucursales</h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Control de mercadería transferida entre sucursales</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a asp-action="CtrlTI_AU" asp-controller="ctrlti" asp-area="pocketppal" asp-route-titId="D"
               class="card-golden text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0"><i class="bx bx-package me-2"></i>Entre Depósitos</h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Control de mercadería transferida entre depósitos</p>
                </div>
            </a>
        </div>
    </div>
</div>
