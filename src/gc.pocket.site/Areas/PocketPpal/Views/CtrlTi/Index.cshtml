
@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
}

<section class="pocket-modern pocket-hub pocket-transfer-hub">
    <div class="pocket-modern__intro">
        <div class="col-12">
            <span class="pocket-modern__eyebrow"><i class="bx bx-check-shield"></i> Control operativo</span>
            <h1 class="pocket-modern__title">Control de salida de transferencias</h1>
            <p class="pocket-modern__subtitle">Seleccione el circuito de origen para controlar la mercadería transferida.</p>
        </div>
    </div>

    <div class="pocket-hub__grid">
        <div class="col-12 col-md-6">
            <a asp-action="CtrlTI_AU" asp-controller="ctrlti" asp-area="pocketppal" asp-route-titId="S"
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0"><i class="bx bx-building me-2"></i>Entre Sucursales</h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Control de mercadería transferida entre sucursales</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a asp-action="CtrlTI_AU" asp-controller="ctrlti" asp-area="pocketppal" asp-route-titId="D"
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0"><i class="bx bx-package me-2"></i>Entre Depósitos</h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Control de mercadería transferida entre depósitos</p>
                </div>
            </a>
        </div>
    </div>
</section>

@section styles {
    <link rel="stylesheet" href="~/css/pocket-modern.css" asp-append-version="true" />
}
