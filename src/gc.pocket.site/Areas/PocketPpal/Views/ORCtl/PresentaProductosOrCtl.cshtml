@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";

    string orCompte = ViewBag.Compte ?? "N/A";
    (string, string) mensaje = (string.Empty, orCompte);

    var callback = Url.Action("PresentaProductosOrCtl", "orctl", new { area = "pocketppal", or_compte=orCompte });
}



<div class="d-flex justify-content-between align-items-center gap-4 my-3">
    <partial name="_NroComprobante" model="mensaje" />

    <a asp-action="ORValidaProducto" asp-controller="orctl" asp-area="pocketppal" 
     asp-route-or_compte ="@orCompte" asp-route-p_id="" asp-route-nuevo="true" class="btn btn-sm btn-success">
        <i class="bx bx-cart"></i> Cargar
    </a>
</div>


<partial name="_listacontrol" />

<div class="row mb-3">
    <div class="pocket-action-dock">
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm m-3 pocket-action-dock__button" aria-label="Consultar información de producto" title="Información de producto"><i class="bx bx-ms bx-info-circle"></i></a>
        <button type="button" id="btnConfirmar" class="btn btn-sm btn-success m-3 pocket-action-dock__button" style="display:none;" aria-label="Continuar" title="Continuar"><i class="bx bx-sm bx-right-arrow-alt"></i></button>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        const orCompte = '@orCompte';
        var homeModUrl = "@Url.Action("index", "orctl", new { area = "pocketppal" })";
        var CargaProductosOrCtlUrl = "@Url.Action("CargaProductosOrCtl", "orctl", new { area = "pocketppal" })"
        var ReguardaProductosEnServerOrCtlUrl = "@Url.Action("ReguardaProductosEnServerOrCtl", "orctl", new { area = "pocketppal" })"
        var EliminarProductoOrCtlUrl = "@Url.Action("EliminarProductoOrCtl", "orctl", new { area = "pocketppal" })";
    </script>
    <script src="~/js/app/or/orCtlLista.js" asp-append-version="true"></script>
}
