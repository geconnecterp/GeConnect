        var ObtenerOrdenesRepartoUrl = "@Url.Action("ObtenerOrdenesReparto", "or", new { area = "pocketppal" })"; //reutilizo fx de OR
        var homeModUrl = "@Url.Action("index", "orctl", new { area = "pocketppal" })";
        var ValidarUsuarioUrl = "@Url.Action("ValidarUsuario", "or", new { area = "pocketppal" })"; //reutilizo fx de OR
        var AbrirOrListaUrl  = "@Url.Action("PresentaProductosOrCtl", "orctl", new { area = "pocketppal" })";
