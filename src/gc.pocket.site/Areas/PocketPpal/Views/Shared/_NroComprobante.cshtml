@model (string,string)

@{
    bool band = !string.IsNullOrWhiteSpace(Model.Item1);
    string clase = band ? "justify-content-around" : "justify-content-center";
}

<div class="row mb-2">
    <div class="d-flex @clase">
        <span class="text-info" id="spanNroAuto">N° OR: <strong>@Model.Item2</strong> </span>
        @if (band)
        {
            <span class="text-info" id="spanText"><strong>@Model.Item1</strong></span>
        }
    </div>
</div>