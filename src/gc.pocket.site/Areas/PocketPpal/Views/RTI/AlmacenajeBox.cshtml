@section scripts {
    <script type="text/javascript">
        var almacenajeBoxUrl = "@Url.Action("ConfirmaBoxUl", "rti", new { area = "pocketppal" })";
        var validaBoxUrl = "@Url.Action("validarbox", "rti", new { area = "pocketppal" })";
        var validaUlUrl = "@Url.Action("validarul", "rti", new { area = "pocketppal" })";
        var homeRPRUrl = "@Url.Action("rpr", "almacen", new { area = "gestion" })";
        var homeInicio = "@Url.Action("index", "home", new { area = "" })";
    </script>

    <script src="~/js/app/rpr/rprab.js"></script>
