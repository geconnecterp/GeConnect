@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";

    var callback = Url.Action("almacenajeBox", "rti", new { area = "pocketppal" });
}

<div class="container-fluid py-3">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card-golden">
                <div class="card-golden-header">
                    <i class="bx bx-box me-2"></i>
                    <h6 class="mb-0">Almacenamiento de UL de transferencia</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-golden-label">
                                    <i class="bx bx-barcode me-1"></i>UL
                                </span>
                                <input type="text" maxlength="18" id="txtUl"
                                       class="form-control input-busqueda-golden inputEditable"
                                       placeholder="Ingresar UL..." autofocus />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-golden-label">
                                    <i class="bx bx-package me-1"></i>BOX
                                </span>
                                <input type="text" maxlength="11" id="txtBox" disabled
                                       class="form-control input-busqueda-golden inputEditable"
                                       placeholder="Agregar BOX" />
                            </div>
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="bx bx-info-circle"></i>
                        Escanee la UL y luego el BOX de destino
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 pocket-action-dock">
            <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal"
               asp-route-callback="@callback" class="btn btn-info btn-sm pocket-action-dock__button" title="Información de producto" aria-label="Consultar información de producto">
                <i class="bx bx-info-circle"></i>
            </a>
            <button type="button" disabled id="btnConfirmar" class="btn btn-success btn-sm pocket-action-dock__button" title="Confirmar" aria-label="Confirmar almacenaje">
                <i class="bx bx-check"></i>
            </button>
        </div>
    </div>
</div>
