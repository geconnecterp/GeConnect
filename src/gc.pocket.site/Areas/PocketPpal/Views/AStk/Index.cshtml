@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
}

<div class="container-fluid px-3 py-3">
    <!-- ✅ CARD GOLDEN PARA BÚSQUEDA DE BOX Y TIPO DE AJUSTE -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card-golden">
                <div class="card-golden-header">
                    <i class="bx bx-package me-2"></i>
                    <h6 class="mb-0">Ajuste de Stock - Selección de BOX y Tipo</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-golden-label" style="min-width:80px;">
                                    <i class="bx bx-barcode me-1"></i>BOX
                                </span>
                                <input type="text" 
                                       id="boxId" 
                                       maxlength="11" 
                                       class="form-control input-busqueda-golden" 
                                       placeholder="Ingrese código de BOX..." 
                                       autofocus />
                                <button id="btnVerifica" 
                                        type="button" 
                                        class="btn btn-sm btn-success">
                                    <i class="bx bx-check-circle me-1"></i>Verificar
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6 col-12">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-golden-label" style="min-width:80px;">
                                    <i class="bx bx-cog me-1"></i>Ajuste
                                </span>
                                @Html.DropDownList("ddlTipoAjuste",null,"Seleccione tipo...",new{ @class="form-control"})
                            </div>
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="bx bx-info-circle"></i> 
                        Seleccione el BOX y el tipo de ajuste de stock a realizar
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ BOTONES DE ACCIÓN -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-center gap-2">
                <button type="button" 
                        id="btnCancelar" 
                        class="btn btn-secondary btn-sm">
                    <i class="bx bx-x me-1"></i>Cancelar
                </button>
                <button type="button" 
                        id="btnContinua01" 
                        disabled 
                        class="btn btn-success btn-sm">
                    <i class="bx bx-right-arrow-alt me-1"></i>Continuar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        var validaBoxUrl = "@Url.Action("ValidarBox", "infoprod", new { area = "pocketppal" })";
        var cargaProducto = "@Url.Action("CargarProductos", "astk", new { area = "pocketppal" })";
    </script>
    <script src="~/js/app/cprevias/astk.js"></script>
}