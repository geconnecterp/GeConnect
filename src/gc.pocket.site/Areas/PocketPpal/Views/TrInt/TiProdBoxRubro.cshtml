@model AutorizacionTIDto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
    var callback = Url.Action("tiprodboxrubro", "trint", new { area = "pocketppal" });

}
<div class="pocket-ti-itinerary">
    <div class="pocket-ti-itinerary__heading text-info">
        <span>Nro Auto. TI <strong class="text-nowrap">@Model.Ti</strong></span>
        <span id="titVista">ITINERARIO X BOX</span>
    </div>
    <div class="pocket-ti-itinerary__options">
        <div class="form-check">
            <input name="rbVista" class="form-check-input" type="radio" value="B" id="rbBox" checked>
            <label class="form-check-label" for="rbBox">BOX</label>
        </div>
        <div class="form-check">
            <input name="rbVista" class="form-check-input" type="radio" value="B" id="rbRubro">
            <label class="form-check-label" for="rbRubro">Rubro</label>
        </div>
    </div>
    <div class="input-group input-group-sm text-info">
        <input id="txtData01" class="form-control" readonly aria-label="TI seleccionada" />
        <input id="txtData02" class="form-control" readonly aria-label="BOX o rubro seleccionado" />
    </div>
    <div id="divGrids"></div>
</div>
<div class="row mb-3">
    <div class="pocket-action-dock">
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm m-2 pocket-action-dock__button" aria-label="Consultar información de producto" title="Información de producto"><i class="bx bx-ms bx-info-circle"></i></a>
        <form asp-action="TICargaCarrito" asp-controller="trint" asp-area="pocketppal" method="get">
        <button type="submit" id="btnContinua02" disabled class="btn btn-success btn-sm m-2 pocket-action-dock__button" aria-label="Continuar" title="Continuar"><i class="bx bx-ms bx-right-arrow-alt"></i></button>
            @Html.Hidden("esrubro")
            @Html.Hidden("esbox")
            @Html.Hidden("boxid")
            @Html.Hidden("rubroid")
            @Html.Hidden("rubrogid")

        </form>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        var presentarBoxDeProductosUrl = "@Url.Action("PresentarBoxDeProductos", "trint", new { area = "pocketppal" })";
        var presentarRubroDeProductosUrl = "@Url.Action("PresentarRubroDeProductos", "trint", new { area = "pocketppal" })";
        
    </script>

    <script src="~/js/app/ti/ti02.js" asp-append-version="true"></script>
}

