@model GridCoreSmart<TiListaProductoDto>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
    int cont = 0;
    bool esSucursal = ViewBag.EsSucursal == true;
    string usuarioActual = ViewBag.UsuarioActual as string ?? string.Empty;
}

<div class="table-responsive table-wrapper pocket-record-list">
    <table class="table table-sm mb-0 table-hover table-wrapper-fixed-head" id="tbListaProd">
        <thead>
            <tr class="header table-dark">
                <th style="display:none;"></th>
                <th scope="col">Productos a colectar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaDatos!)
            {
                cont++;
                if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                var pedido = item.Pedido.ToString(item.up_id == "07" ? "N0" : "N3");
                var colectado = item.Colectado.ToString(item.up_id == "07" ? "N0" : "N3");
                var formatoCantidad = item.up_id == "07" ? "N0" : "N3";
                var esReemplazo = "S".Equals(item.Remplazo, StringComparison.OrdinalIgnoreCase);
                var resultado = (item.Resultado ?? "PE").Trim().ToUpperInvariant();
                var esPropio = !(esReemplazo || item.Resultado == "40") ||
                    string.Equals(item.Remplazo_usu_id?.Trim(), usuarioActual.Trim(), StringComparison.OrdinalIgnoreCase);
                var estadoBloqueaCarga = resultado == "E1" || resultado == "21";
                var totalColectadoVisible = item.Colectado + item.Colectado_remplazo + item.Colectado_otros;
                var diferenciaColectado = item.Pedido - totalColectadoVisible;
                // La leyenda resume las cantidades visibles; la habilitación conserva su regla vigente.
                var pedidoCumplido = item.Colectado_x_p >= item.Pedido;
                var tieneColeccionPropia = item.Colectado > 0;
                var permiteCarga = !esSucursal || (esReemplazo
                    ? esPropio && !estadoBloqueaCarga
                    : !pedidoCumplido || tieneColeccionPropia);
                var permiteColeccion = permiteCarga && (!esSucursal || item.Pedido > 0 || item.Colectado > 0);
                var permiteReemplazo = ViewBag.PermiteReemplazo == true && permiteCarga && !esReemplazo && item.Pedido > 0;
                var estadoColeccionTexto = diferenciaColectado == 0
                    ? string.Empty
                    : diferenciaColectado > 0
                        ? $"Falta colectar: {diferenciaColectado.ToString(formatoCantidad)}"
                        : $"Sobra: {Math.Abs(diferenciaColectado).ToString(formatoCantidad)}";
                var estadoColeccionClase = diferenciaColectado == 0
                    ? "bg-success"
                    : diferenciaColectado > 0
                        ? "bg-warning text-dark"
                        : "bg-danger";
                var estadoTextoRespaldo = resultado switch
                {
                    "PE" => "Pendiente sin colección",
                    "E0" => "Colección compartida en este BOX",
                    "E1" => "Colección realizada por otros usuarios",
                    "00" => "Pedido completado por usted",
                    "01" => "Pedido completado por otros usuarios",
                    "02" => "Producto completado en la transferencia",
                    "03" => "Producto completado en la transferencia",
                    "04" => "Producto completado con reemplazo",
                    "40" => "Producto cargado como reemplazo",
                    "10" => "Colección propia incompleta",
                    "11" => "Colección de otros usuarios incompleta",
                    "20" => "Cantidad propia mayor al pedido",
                    "21" => "Cantidad de otros usuarios mayor al pedido",
                    _ => "Estado informado por el servidor"
                };
                // El SP define el mensaje; los textos locales se conservan solo como respaldo.
                var estadoTexto = string.IsNullOrWhiteSpace(item.Resultado_msj)
                    ? estadoTextoRespaldo
                    : item.Resultado_msj.Trim();
                var estadoClase = resultado switch
                {
                    "00" or "01" or "02" or "03" or "04" => "bg-success",
                    "10" or "11" or "E0" or "40" => "bg-warning text-dark",
                    "20" or "21" or "E1" => "bg-danger",
                    _ => "bg-secondary"
                };

                <tr class="@clase" tiprod="@item.P_id">
                    <td style="display:none;">@cont</td>
                    <td>
                        <div class="pocket-record @(esSucursal ? "pocket-record--collection" : "")">
                            <div class="pocket-record__body">
                                <div class="pocket-record__title">
                                    <span class="pocket-record__code">@item.P_id</span>
                                    <strong title="@item.P_desc">@item.P_desc</strong>
                                    @if (esReemplazo)
                                    {
                                        <span class="badge bg-warning text-dark ms-1" title="Producto cargado como reemplazo">
                                            <i class="bx bx-transfer-alt"></i> REEMPLAZO
                                        </span>
                                    }
                                </div>
                                <div class="pocket-record__context"><span class="pocket-record__box">BOX <strong>@item.Box_id</strong></span><span class="pocket-record__rubro" title="Rubro @item.Rub_id">Rubro <strong>@item.Rub_id</strong></span></div>
                                <div class="pocket-record__quantities">
                                    <div><span>Pedido</span><strong>@pedido</strong></div>
                                    <div><span>Colectado</span><strong>@colectado</strong></div>
                                    @if (!esReemplazo)
                                    {
                                        <div><span>Reemplazo</span><strong>@item.Colectado_remplazo.ToString(formatoCantidad)</strong></div>
                                    }
                                    @if (esSucursal)
                                    {
                                        <div><span>Colectado Otros</span><strong>@item.Colectado_otros.ToString(formatoCantidad)</strong></div>
                                    }
                                </div>
                                @if (esSucursal)
                                {
                                    @if (!esReemplazo && diferenciaColectado != 0)
                                    {
                                        <div class="pocket-record__totals">
                                            <span class="badge @estadoColeccionClase" title="@estadoColeccionTexto">@estadoColeccionTexto</span>
                                        </div>
                                    }
                                    <div class="pocket-record__status">
                                        <span class="badge @estadoClase" title="@resultado · @estadoTexto">@resultado · @estadoTexto</span>
                                    </div>
                                    @if (esReemplazo && !string.IsNullOrWhiteSpace(item.Remplazo_p_id))
                                    {
                                        <small class="text-muted pocket-record__reference">
                                            <span class="pocket-record__reference-text" title="Reemplaza al producto @item.Remplazo_p_id">Rem. @item.Remplazo_p_id</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Remplazo_box))
                                            {
                                                <span class="pocket-record__box" title="BOX original"><strong>@item.Remplazo_box</strong></span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Remplazo_usu_id))
                                            {
                                                <span class="pocket-record__reference-text" title="Operador @item.Remplazo_usu_id">- (@item.Remplazo_usu_id)</span>
                                            }
                                        </small>
                                    }
                                    @if (!permiteCarga)
                                    {
                                        <small class="text-danger fw-semibold pocket-record__restriction">@(esPropio ? "Este estado no permite realizar una nueva carga." : "El reemplazo pertenece a otro operador y no puede modificarse.")</small>
                                    }
                                }
                            </div>
                            <div class="pocket-record__actions">
                                @if (permiteColeccion)
                                {
                                    <a asp-action="TIValidaProducto" asp-controller="trint" asp-area="pocketppal" asp-route-pId="@item.P_id" asp-route-boxId="@item.Box_id" asp-route-item="@item.Item" class="btn btn-sm btn-success btnBarcode" title="Colectar producto"><i class="bx bx-barcode"></i></a>
                                }
                                @if (permiteReemplazo)
                                {
                                    <a asp-action="TIValidaProducto" asp-controller="trint" asp-area="pocketppal"
                                       asp-route-pId="@item.P_id" asp-route-boxId="@item.Box_id" asp-route-item="@item.Item" asp-route-reemplazar="true"
                                       class="btn btn-sm btn-warning btnReemplazarProducto"
                                       title="Reemplazar producto"
                                       aria-label="Reemplazar @item.P_id @item.P_desc"
                                       data-producto-id="@item.P_id"
                                       data-producto-desc="@item.P_desc"
                                       data-box-id="@item.Box_id"
                                       data-pedido="@pedido"
                                       data-colectado="@colectado">
                                        <i class="bx bx-transfer-alt"></i>
                                    </a>
                                }
                                @if (!esSucursal && !string.IsNullOrEmpty(item.Nota) && !string.IsNullOrWhiteSpace(item.Nota))
                                {
                                    <button type="button" class="btn btn-sm btn-warning btnNota" onclick="mostrarMensaje('@item.Nota')"><i class="bx bx-note"></i></button>
                                }
                                @if (item.Colectado > 0 && (!esSucursal || esPropio))
                                {
                                    <button type="button" class="btn btn-sm btn-danger" title="Eliminar colección propia" onclick="limpiarProductoCarrito('@item.P_id','@item.Box_id',@item.Item)"><i class="bx bx-eraser"></i></button>
                                }

                            </div>
                        </div>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
