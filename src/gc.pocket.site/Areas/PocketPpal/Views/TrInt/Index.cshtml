@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
}

<section class="pocket-modern pocket-hub pocket-transfer-hub">
    <!-- ✅ TÍTULO Y DESCRIPCIÓN -->
    <div class="pocket-modern__intro">
        <div class="col-12">
            <span class="pocket-modern__eyebrow"><i class="bx bx-transfer-alt"></i> Operaciones de depósito</span>
            <h1 class="pocket-modern__title">
                <i class="bx bx-transfer-alt"></i> Transferencias Internas
            </h1>
            <p class="pocket-modern__subtitle">Seleccione el tipo de transferencia a realizar y si requiere autorización previa.</p>
        </div>
    </div>

    <!-- ✅ OPCIONES DE TRANSFERENCIA CON CARDS GOLDEN -->
    <div class="pocket-hub__grid">
        <!-- Entre Sucursales -->
        <div class="col-md-12 col-sm-12 pocket-hub__feature">
            <a asp-action="TI_AU" 
               asp-controller="trint" 
               asp-area="pocketppal" 
               asp-route-tiId="S" 
               asp-route-cs="false" 
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0 text-white">
                        <i class="bx bx-building me-2"></i>Entre Sucursales
                    </h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Transferencia con autorización entre sucursales</p>
                </div>
            </a>
        </div>

        <!-- Entre Depósitos -->
        <div class="col-md-6 col-sm-12">
            <a asp-action="TI_AU" 
               asp-controller="trint" 
               asp-area="pocketppal" 
               asp-route-tiId="D" 
               asp-route-cs="true" 
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0 text-white">
                        <i class="bx bx-package me-2"></i>Entre Depósitos
                    </h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Con autorización</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-sm-12">
            <a asp-action="TICargaCarrito" 
               asp-controller="trint" 
               asp-area="pocketppal" 
               asp-route-tiId="E" 
               asp-route-cs="false" 
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0 text-white">
                        <i class="bx bx-package me-2"></i>Entre Depósitos (SIN AUTORIZACIÓN)
                    </h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Sin necesidad de autorización previa</p>
                </div>
            </a>
        </div>

        <!-- Entre Box -->
        <div class="col-md-6 col-sm-12">
            <a asp-action="TI_AU" 
               asp-controller="trint" 
               asp-area="pocketppal" 
               asp-route-tiId="B" 
               asp-route-cs="true" 
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0 text-white">
                        <i class="bx bx-box me-2"></i>Entre Box
                    </h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Con autorización</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-sm-12">
            <a asp-action="TICargaCarrito" 
               asp-controller="trint" 
               asp-area="pocketppal" 
               asp-route-tiId="O" 
               asp-route-cs="false" 
               class="card-golden pocket-action-card pocket-transfer-card text-decoration-none h-100 d-block">
                <div class="card-golden-header">
                    <h5 class="mb-0 text-white">
                        <i class="bx bx-box me-2"></i>Entre Box (SIN AUTORIZACIÓN)
                    </h5>
                </div>
                <div class="card-body text-center">
                    <p class="mb-0 text-muted">Sin necesidad de autorización previa</p>
                </div>
            </a>
        </div>
    </div>
</section>

@section styles {
    <link rel="stylesheet" href="~/css/pocket-modern.css" asp-append-version="true" />
}
