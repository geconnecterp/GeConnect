@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
    var callback = Url.Action("index", "or", new { area = "pocketppal" });

}

<section class="pocket-modern pocket-workspace">
    <div class="pocket-workspace__header">
        <h1 class="pocket-workspace__heading"><i class="bx bx-list-check"></i> Órdenes disponibles</h1>
        <p class="pocket-workspace__hint">Seleccione una orden para consultar su detalle y continuar.</p>
    </div>

    <partial name="_gridOrdenReparto" />

    <div class="pocket-workspace__actions pocket-action-dock">
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm pocket-action-dock__button" aria-label="Consultar información de producto" title="Información de producto"><i class="bx bx-ms bx-info-circle"></i></a>
        <button type="button" id="btnContinuar" class="btn btn-sm btn-success pocket-action-dock__button" style="display:none;" aria-label="Continuar con la orden seleccionada" title="Continuar"><i class="bx bx-sm bx-right-arrow-alt"></i></button>
    </div>
</section>

@section styles {
    <link rel="stylesheet" href="~/css/pocket-modern.css" asp-append-version="true" />
}

@section scripts {
    <script type="text/javascript">

        var ObtenerOrdenesRepartoUrl = "@Url.Action("ObtenerOrdenesReparto", "or", new { area = "pocketppal" })";
        var homeModUrl = "@Url.Action("index", "or", new { area = "pocketppal" })";
        var ValidarUsuarioUrl = "@Url.Action("ValidarUsuario", "or", new { area = "pocketppal" })"; 
        var AbrirOrListaUrl =  "@Url.Action("CargaORLista", "or", new { area = "pocketppal" })";
        var PresentarListaORbyBoxUrl = "@Url.Action("PresentarListaORbyBox", "or", new { area = "pocketppal" })";
        var PresentarListaORbyRubroUrl = "@Url.Action("PresentarListaORbyRubro", "or", new { area = "pocketppal" })";
         var ORCargaCarritoUrl = "@Url.Action("ORCargaCarrito", "or", new { area = "pocketppal" })";

    </script>
    <script src="~/js/app/or/orCoreCommon.js"></script>

    <script src="~/js/app/or/orCore.js"></script>
}
