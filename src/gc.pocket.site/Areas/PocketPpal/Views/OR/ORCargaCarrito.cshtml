@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
    var callback = Url.Action("orcargacarrito", "or", new { area = "pocketppal" });

    string orCompte = ViewBag.Compte ?? "N/A";
    (string, string) mensaje = (string.Empty, orCompte);
    string orden = ViewBag.OrdenProductos as string ?? "B";
}
@model GridCoreSmart<ORProductoDto>
@section styles {
    <link rel="stylesheet" href="~/css/pocket-records.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pocket-or.css" asp-append-version="true" />
}
<partial name="_NroComprobante" model="mensaje" />
<div class="pocket-or-options">
    <div class="form-check">
        <input class="form-check-input" type="radio" name="tipoOR" id="radioBox" value="BOX" checked="@(orden == "B")">
        <label class="form-check-label" for="radioBox">
            BOX
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="tipoOR" id="radioRub" value="RUB" checked="@(orden == "R")">
        <label class="form-check-label" for="radioRub">
            RUBRO
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="tipoOR" id="radioProd" value="PROD" checked="@(orden == "P")">
        <label class="form-check-label" for="radioProd">
            PRODUCTO
        </label>
    </div>
</div>
<div id="contenedorCarritoOR"><partial name="_gridORListaProducto" model="Model" /></div>
<div class="row mb-3">
    <div class="pocket-action-dock">
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm m-3 pocket-action-dock__button" aria-label="Consultar información de producto" title="Información de producto"><i class="bx bx-ms bx-info-circle"></i></a>
        <button type="button" id="btnContinuar" class="btn btn-sm btn-success m-3 pocket-action-dock__button" style="display:none;" aria-label="Continuar" title="Continuar"><i class="bx bx-sm bx-right-arrow-alt"></i></button>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        var ObtenerOrdenesRepartoUrl = "@Url.Action("ObtenerOrdenesReparto", "or", new { area = "pocketppal" })";
        var homeModUrl = "@Url.Action("index", "or", new { area = "pocketppal" })";
        var ValidarUsuarioUrl = "@Url.Action("ValidarUsuario", "or", new { area = "pocketppal" })";
        var AbrirOrListaUrl =  "@Url.Action("CargaORLista", "or", new { area = "pocketppal" })";
        var PresentarListaORbyBoxUrl = "@Url.Action("PresentarListaORbyBox", "or", new { area = "pocketppal" })";
        var PresentarListaORbyRubroUrl = "@Url.Action("PresentarListaORbyRubro", "or", new { area = "pocketppal" })";

         // ✅ NUEVO: URL para buscar productos con ordenamiento
            var BuscarListaProductosORUrl = "@Url.Action("BuscaORListaProductos", "or", new { area = "pocketppal" })";

            // ✅ NUEVO: URL para limpiar producto del carrito 
            var LimpiaProductoCarritoORUrl = "@Url.Action("LimpiaProductoCarritoOR", "or", new { area = "pocketppal" })";

        var proximoProductoUrl = "@Url.Action("ORCargaCarrito", "or", new { area = "pocketppal" })";


          // Variables globales desde PocketControllerBase
        administracion = '@(User.Claims.First(c => c.Type.Contains("AdmId")).Value ?? "")';
        var admAuth = administracion.split('#')[0];
        var usuAuth = '@(User.Claims.First(c => c.Type.Contains("name"))?.Value ?? "")';
        var orCompteActual = '@orCompte';
    </script>
    <script src="~/js/app/or/orCoreCommon.js" asp-append-version="true"></script>
    <script src="~/js/app/or/orCoreCarrito.js" asp-append-version="true"></script>
    <script src="~/js/app/reemplazoProducto.js" asp-append-version="true"></script>
}
