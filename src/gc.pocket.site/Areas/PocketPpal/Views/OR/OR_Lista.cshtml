@{
    Layout = "~/areas/gestion/views/shared/_LayoutGestion.cshtml";
    var callback = Url.Action("CargaORLista", "or", new { area = "pocketppal", or_compte = ViewBag.Compte ??""});
}

<div class="d-flex justify-content-center align-items-center gap-4 my-3">
    <div class="form-check">
        <input class="form-check-input" type="radio" name="tipoOR" id="radioBox" value="BOX" checked>
        <label class="form-check-label" for="radioBox">
            BOX
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="tipoOR" id="radioRub" value="RUB">
        <label class="form-check-label" for="radioRub">
            RUB
        </label>
    </div>
</div>

<!-- ✅ Contenedor donde se inyectarán las vistas parciales -->
<div id="contenedorListaOR"></div>

<div class="row mb-3">
    <div class="d-flex justify-content-center">
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm m-3"><i class="bx bx-ms bx-info-circle"></i></a>
        <button type="button" id="btnContinuar" class="btn btn-sm btn-success m-3" style="display:none;"><i class="bx bx-sm bx-right-arrow-alt"></i></button>
    </div>
</div>

@section scripts {
    <script type="text/javascript">

        var ObtenerOrdenesRepartoUrl = "@Url.Action("ObtenerOrdenesReparto", "or", new { area = "pocketppal" })";
        var homeModUrl = "@Url.Action("index", "or", new { area = "pocketppal" })";
        var ValidarUsuarioUrl = "@Url.Action("ValidarUsuario", "or", new { area = "pocketppal" })";
        var AbrirOrListaUrl =  "@Url.Action("CargaORLista", "or", new { area = "pocketppal" })";
        var PresentarListaORbyBoxUrl = "@Url.Action("PresentarListaORbyBox", "or", new { area = "pocketppal" })";
        var PresentarListaORbyRubroUrl = "@Url.Action("PresentarListaORbyRubro", "or", new { area = "pocketppal" })";
        var ORCargaCarritoUrl = "@Url.Action("ORCargaCarrito", "or", new { area = "pocketppal" })";

          // Variables globales desde PocketControllerBase
        administracion = '@(User.Claims.First(c => c.Type.Contains("AdmId")).Value ?? "")';
        var admAuth = administracion.split('#')[0];
        var usuAuth = '@(User.Claims.First(c => c.Type.Contains("name"))?.Value ?? "")';
        var orCompteActual = '@(ViewContext.HttpContext.Session.GetString("ORComprobanteActual") ?? "")';
    </script>
    <script src="~/js/app/or/orCoreCommon.js"></script>
    <script src="~/js/app/or/orCoreLista.js"></script>
}