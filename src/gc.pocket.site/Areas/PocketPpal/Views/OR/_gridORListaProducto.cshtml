@model GridCoreSmart<ORProductoDto>
@*
    Vista parcial para mostrar lista de productos de OR
    Ordenable por BOX, RUBRO o PRODUCTO
    Versión mejorada con estilos Golden
*@
@{
    var alt = true;
    string clase = string.Empty;
    int cont = 0;
}

<div class="grid-golden h-100">
    <div class="grid-golden-body p-1">
        <div class="table-responsive table-wrapper table-wrapper-500">
            <table class="table table-sm table-hover mb-0 table-golden" id="tbORListaProd">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th style="display:none;"></th>
                        <th scope="col" class="text-left th-compact">Producto</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos != null && Model.ListaDatos.Any())
                    {
                        @foreach (var item in Model.ListaDatos)
                        {
                            cont++;
                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

                            <tr class="@clase cursor-pointer" 
                                data-prod-id="@item.p_id"
                                data-box-id="@item.box_id"
                                data-rub-id="@item.rub_id">
                                <td style="display:none;">@cont</td>
                                <td class="td-compact">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <!-- ✅ Información del producto -->
                                        <div class="d-flex flex-column flex-grow-1">
                                            <div class="p-0">
                                                <strong class="text-golden">@item.p_id</strong> 
                                                <span>@item.p_desc</span>
                                            </div>
                                            <div class="p-0">
                                                <small class="text-muted">
                                                    <i class="bx bx-package"></i> Box: <strong>@item.box_id</strong> | 
                                                    <i class="bx bx-category"></i> Rub: <strong>@item.rub_id</strong>
                                                </small>
                                            </div>
                                            <div class="p-0">
                                                <span class="badge bg-info">
                                                    Cantidad: @item.pedido
                                                </span>
                                                @if (item.colectado > 0)
                                                {
                                                    <span class="badge bg-success">
                                                        Colectado: @item.colectado
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- ✅ Botones de acción -->
                                        <div class="d-flex align-items-center gap-1">
                                            <a asp-action="ORValidaProducto" 
                                               asp-controller="or" 
                                               asp-area="pocketppal" 
                                               asp-route-pId="@item.p_id" 
                                               class="btn btn-sm btn-success">
                                                <i class="bx bx-barcode"></i>
                                            </a>
                                            
                                            @if (!string.IsNullOrEmpty(item.nota) && !string.IsNullOrWhiteSpace(item.nota))
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-warning btnNota" 
                                                        onclick="mostrarMensaje('@item.nota)')">
                                                    <i class="bx bx-note"></i>
                                                </button>
                                            }
                                            
                                            @if (item.colectado > 0)
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-danger" 
                                                        onclick="limpiarProductoCarrito('@item.p_id','@item.box_id')">
                                                    <i class="bx bx-eraser"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                <i class="bx bx-info-circle bx-md"></i>
                                <p class="mb-0">No hay productos disponibles</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @* Footer con información adicional *@
    @if (Model.ListaDatos != null && Model.ListaDatos.Any())
    {
        <div class="grid-golden-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                <i class="bx bx-package"></i> Total productos: <strong>@Model.ListaDatos.Count()</strong>
            </small>
            <small class="text-muted">
                <i class="bx bx-check-circle"></i> Colectados: <strong>@Model.ListaDatos.Count(x => x.colectado > 0)</strong>
            </small>
        </div>
    }
</div>