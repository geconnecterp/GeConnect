@model AppItem
@{
    Layout = "_LayoutGestion";
    var callback = Url.Action("index", "Inventario", new { area = "Gestion", titId = "Inventarios" });
}

<section class="pocket-modern pocket-workspace">
    <div class="pocket-workspace__header">
        <div>
            <span class="pocket-modern__eyebrow"><i class="bx bx-package"></i> Conteo de existencias</span>
            <h1 class="pocket-workspace__heading">Inventarios autorizados</h1>
        </div>
        <p class="pocket-workspace__hint">Seleccione un inventario para consultar sus boxes o planillas.</p>
    </div>

    <div class="container px-0">
        @{
            await Html.RenderPartialAsync("~/views/shared/_menuprint.cshtml", Model);
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div id="invAuto" aria-live="polite"></div>
        </div>
        <div class="col-lg-6">
            <div id="invDetalle" aria-live="polite">
                <div class="pocket-workspace__placeholder">
                    <div>
                        <i class="bx bx-pointer"></i>
                        <strong>Seleccione un inventario</strong>
                        <div class="small mt-1">Aquí se mostrarán los boxes o planillas disponibles.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pocket-workspace__actions pocket-action-dock">
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm m-2 pocket-action-dock__button">
            <i class="bx bx-ms bx-info-circle"></i>
            <span class="visually-hidden">Información de producto</span>
        </a>
        <button type="button" id="btnContinua01" disabled class="btn btn-success btn-sm m-2 pocket-action-dock__button">
            <i class="bx bx-ms bx-right-arrow-alt"></i>
            <span class="visually-hidden">Continuar</span>
        </button>
    </div>
</section>

@section styles {
    <link rel="stylesheet" href="~/css/pocket-modern.css" asp-append-version="true" />
}

@section scripts {
    <script type="text/javascript">
        // ✅ Inicialización de URLs (existente)
        var inv_lista = '@Url.Action("ObtenerInventarioLista", "Inventario", new { area = "Gestion" })';
        var inv_box = '@Url.Action("ObtenerInventarioBox", "Inventario", new { area = "Gestion" })';
        var inv_planilla = '@Url.Action("ObtenerInventarioPlanilla", "Inventario", new { area = "Gestion" })';
        var inv_valida_conteo = '@Url.Action("ValidarConteo", "Inventario", new { area = "Gestion" })';
        var inv_conteo = '@Url.Action("CargaConteo", "Inventario", new { area = "Gestion" })';
        var inv_obtener_conteo = '@Url.Action("ObtenerConteo", "Inventario", new { area = "Gestion" })';
        var inv_confirmar = '@Url.Action("ConfirmarConteo", "Inventario", new { area = "Gestion" })';
        
        // ✅ Valores por defecto
        estado.esBox = false;
        estado.invId = '';
        estado.boxId = '';
        estado.inv_nro = '';
        estado.invt_id = '';
        estado.tipo = '';
        estado.tipo_id = '';
        
        console.log('Estado inicializado en Index.cshtml:', estado);
    </script>
    <script src="~/js/app/gestion/inv.js"></script>
}
