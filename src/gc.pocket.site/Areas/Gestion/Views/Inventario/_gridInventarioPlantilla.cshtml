@model GridCoreSmart<InventarioPlanillaDto>

@{
    var alt = true;
    string clase = string.Empty;
    var fechaHoy = DateTime.Today;
}

<div class="card card-golden">
    <div class="card card-golden-header">
        <h5><i class="bx bx-package"></i> Planillas</h5>
    </div>
    <div class="card-body p-2">
        <div class="mb-3">
            <label class="form-label fw-bold">Opciones de Planilla</label>
            <div class="d-flex gap-3">
                <div class="form-check">
                    <input class="form-check-input" 
                           type="radio" 
                           name="opcionPlanilla" 
                           id="rbNuevaPlanilla" 
                           value="nueva" 
                           checked>
                    <label class="form-check-label" for="rbNuevaPlanilla">
                        <i class="bx bx-plus-circle text-success me-1"></i>
                        Nueva Planilla
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" 
                           type="radio" 
                           name="opcionPlanilla" 
                           id="rbModificarPlanilla" 
                           value="modificar">
                    <label class="form-check-label" for="rbModificarPlanilla">
                        <i class="bx bx-edit text-primary me-1"></i>
                        Modificar Planilla
                    </label>
                </div>
            </div>
        </div>
        
        <div class="table-responsive text-nowrap table-wrapper-500">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridInventarioPlanilla">
                <thead class="table-golden-header">
                    <tr class="header">
                        <th class="text-center" scope="col" style="width: 60px;">Seleccionar</th>
                        <th class="text-center" scope="col">Planilla Conteo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos?.Any() == true)
                    {
                       
                        @foreach (var item in Model.ListaDatos)
                        {
                            alt = !alt;
                            clase = alt ? string.Empty : "table-row-alt";

                            <tr class="@clase" data-inv-nro="@item.inv_nro" data-carga-nro="@item.carga_nro">
                                <td class="text-center">
                                    <input class="form-check-input" 
                                           type="radio" 
                                           name="planillaSeleccionada" 
                                           id="rbPlanilla_@item.carga_nro" 
                                           value="@item.carga_nro"  >
                                </td>
                                <td class="@Model.ObtenerClase(item.carga_nro)" title="@item.inv_descripcion">
                                    @Model.FormatearDato(item.carga_des, FormatDato.Ninguno)
                                </td>
                            </tr>
                          
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                <i class="bx bx-info-circle me-2"></i>
                                No hay planillas disponibles
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ListaDatos?.Any() == true)
        {
            <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                <div class="text-muted small d-flex align-items-center">
                    <i class="bx bx-package me-1"></i>
                    Total: @Model.CantidadReg planillas
                </div>
                <div class="text-muted small">
                    @Model.DatoAux01
                </div>
            </div>
        }
    </div>
</div>