@model AppItem
@{
    Layout = "_LayoutGestion";
    var callback = Url.Action("index", "Inventario", new { area = "Gestion", titId = "Inventarios" });

    string invNro = ViewBag.InvNro;
    string tipo = ViewBag.Tipo;
    string tipoId = ViewBag.TipoId;
    var regs = ViewBag.RegistrosConteo as List<InventarioConteoDto>;
    List<InventarioConteoDto> conteo = regs?.Count>0?regs: [];
    var buscar = new BusquedaProducto();
}

<div class="container">
    @{
        await Html.RenderPartialAsync("~/views/shared/_menuprint.cshtml", Model);
    }
</div>
<div class="card card-golden">
    <div class="card-golden-header py-1 d-flex align-items-center">
        <h5><i class="bx bx-package"></i> N° IN: <span class="fw-bold">@invNro</span></h5>
        <div class="flex-grow-1 text-center">
            @if (tipo.Equals("B"))
            {
                <h5>
                    Box: <span class="fw-bold">@tipoId</span>
                </h5>
            }
            else
            {
                <h5>
                    Planilla Conte N°: <span class="fw-bold">@tipoId</span>
                </h5>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row mb-1">
            <div class="col-md-7 col-sm-6">
                <partial name="~/areas/gestion/views/producto/_ctrbuscarproducto.cshtml" model="@buscar" />
                @Html.Hidden("estadoFuncion", false)
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-2 col-sm-3">
                <div class="input-group  input-group-sm">
                    <span class="input-group-text" style="width:50px">Id:</span>
                    <input type="text" class="form-control inputEditable" nae="pId" id="pId" readonly />
                </div>
            </div>
            <div class="col-md-2 col-sm-2">
                <div class="input-group  input-group-sm">
                    <span class="input-group-text" style="width:50px">Bto:</span>
                    <input type="text" class="form-control inputEditable" name="btos" id="btos" readonly />
                </div>
            </div>
            <div class="col-md-2 col-sm-2">
                <div class="input-group  input-group-sm">
                    <span class="input-group-text" style="width:50px">Un:</span>
                    <input type="text" class="form-control inputEditable" name="uns" id="uns" readonly />
                </div>
            </div>
            <div class="col-md-1 col-sm-2">
                <button type="button" id="btnCargaConteo"
                        class="btn btn-success btn-sm btn-block" disabled
                        title="Cargar producto">
                    <i class="bx bx-box"></i>
                </button>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <span id="nnProducto" class="badge-golden-producto"></span>
            </div>
        </div>
        <partial name="_gridInvProductos" model="conteo" />
    </div>
</div>
<div class="row mb-3">
    <div class="pocket-action-dock">
        @* <button type="button" disabled id="btnVerCtrl" class="btn btn-danger btn-sm m-2" title="Observar Detalle de CONTROL"><i class="bx bx-sm bx-list-ol"></i></button> *@
        <a asp-action="producto" asp-controller="infoprod" asp-area="pocketppal" asp-route-callback="@callback" class="btn btn-info btn-sm m-2 pocket-action-dock__button" aria-label="Consultar información de producto" title="Información de producto"><i class="bx bx-ms bx-info-circle"></i></a>
        <button type="button" id="btnConfirmarConteo" disabled class="btn btn-success btn-sm m-2 pocket-action-dock__button" aria-label="Continuar con la confirmación del conteo" title="Continuar"><i class="bx bx-ms bx-right-arrow-alt"></i></button>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        // ✅ CRÍTICO: Pasar los parámetros del servidor al objeto estado de JavaScript
        estado.inv_nro = '@invNro';
        estado.tipo = '@tipo';
        estado.tipo_id = '@tipoId';
        estado.esBox = '@tipo' === 'B';
        estado.invt_id = '@tipo';
        if(estado.tipo === "B")        
        {
            estado.boxId = '@tipo';
        }
        
        let ocultarTrash = false;
        let productoBase = null; //se hidrata en busquedas.
        let funcionBusquedaAvanzada = false;
        let busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "gestion" })";
        let validarEstado = true;
    </script>

    <script src="~/js/app/busquedas.js" type="text/javascript"></script>
    <script src="~/js/app/gestion/inv-conteo.js" asp-append-version="true"></script>
}
