@{
    ViewData["Title"] = "Inicio";
}
@if (User.Identity?.IsAuthenticated == true)
{
    var nombre = User.Claims.First(c => c.Type.Contains("nya")).Value;
    var administracionClaim = User.Claims.First(c => c.Type.Contains("AdmId")).Value;
    var administracionPartes = administracionClaim.Split("#");
    var sucursal = administracionPartes.Length > 1 ? administracionPartes[1] : administracionClaim;
    var primerNombre = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nombre;
    var saludo = DateTime.Now.Hour switch
    {
        < 12 => "Buenos días",
        < 20 => "Buenas tardes",
        _ => "Buenas noches"
    };

    <section class="home-dashboard" aria-labelledby="homeWelcomeTitle">
        <div class="home-welcome">
            <div class="home-welcome-rings" aria-hidden="true"></div>
            <div class="home-welcome-copy">
                <span class="home-welcome-eyebrow">CENTRO DE OPERACIONES</span>
                <h1 id="homeWelcomeTitle">@saludo, @primerNombre</h1>
                <p>Elegí una operación para comenzar a trabajar desde GECO Pocket.</p>

                <div class="home-welcome-meta">
                    <span>
                        <i class="bx bx-building" aria-hidden="true"></i>
                        Sucursal @sucursal
                    </span>
                    <span>
                        <i class="bx bx-shield-quarter" aria-hidden="true"></i>
                        Sesión activa
                    </span>
                </div>
            </div>

            <div class="home-welcome-brand" aria-hidden="true">
                <img src="~/img/gc.png" alt="" />
                <span>POCKET</span>
            </div>
        </div>

        <div class="home-operations">
            <header class="home-section-header">
                <div>
                    <span class="home-section-eyebrow">ACCESOS RÁPIDOS</span>
                    <h2>Operaciones disponibles</h2>
                    <p>Seleccione el módulo con el que desea trabajar.</p>
                </div>
                <span class="home-touch-hint">
                    <i class="bx bx-touch" aria-hidden="true"></i>
                    Toque una opción
                </span>
            </header>

            @await Component.InvokeAsync("MenuPpal")
        </div>
    </section>
}
