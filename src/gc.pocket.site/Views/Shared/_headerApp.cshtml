<!--(Nombre modulo,(NN,url))-->
@model (string,(string,(string,bool)))
@{
    string a = User.Claims.First(c => c.Type.Contains("AdmId")).Value;
    var adm = a.Split("#");
}

<!-- Header Golden Minimalista -->
<div class="card-golden pocket-header mb-3">
    <!-- Barra Superior -->
    <div class="card-golden-header pocket-header-main d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3">
        <a asp-action="index" asp-controller="home" asp-area="" 
           class="btn btn-link text-white text-decoration-none p-0 fw-bold pocket-header-brand">
            <i class="bx bx-home-alt me-1"></i>GECOPocket
        </a>
        
        <span class="badge bg-golden-light text-golden-dark px-3 py-2 pocket-header-branch">
            <i class="bx bx-building me-1"></i>Sucursal @adm[1]
        </span>

        <span class="text-white fw-semibold text-truncate pocket-header-user" title="@Model.Item2.Item1">
            <i class="bx bx-user me-1"></i>@Model.Item2.Item1
        </span>
    </div>
    
    <!-- Barra Inferior -->
    <div class="d-flex justify-content-between align-items-center gap-2 bg-golden-light py-2 px-3 pocket-header-module">
        <h6 class="text-golden-dark mb-0 fw-bold text-truncate pocket-module-title" title="@Model.Item1.ToUpper()">
            <i class="bx bx-folder-open me-1"></i>@Model.Item1.ToUpper()
        </h6>

        @if (!string.IsNullOrEmpty(Model.Item2.Item2.Item1) && !Model.Item2.Item2.Item1.Equals("#"))
        {
            if (!Model.Item2.Item2.Item2)
            {
                <a href="@Model.Item2.Item2.Item1" class="btn btn-danger btn-sm">
                    <i class="bx bx-left-arrow-alt me-1"></i>Volver
                </a>
            }
            else
            {
                <button type="button" id="btnVolverGen" class="btn btn-danger btn-sm">
                    <i class="bx bx-left-arrow-alt me-1"></i>Volver
                </button>
            }
        }
    </div>
</div>


