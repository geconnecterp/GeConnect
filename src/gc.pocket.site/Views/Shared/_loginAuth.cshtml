@{
    var usuario = User.Claims.First(c => c.Type.Contains("name")).Value;
    var nombre = User.Claims.First(c => c.Type.Contains("nya")).Value;
    var administracionClaim = User.Claims.First(c => c.Type.Contains("AdmId")).Value;
    var administracionPartes = administracionClaim.Split("#");
    var sucursal = administracionPartes.Length > 1 ? administracionPartes[1] : administracionClaim;
    var palabrasNombre = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var iniciales = string.Concat(palabrasNombre.Take(2).Select(palabra => char.ToUpperInvariant(palabra[0])));
}

<div class="dropdown pocket-user-menu">
    <button type="button"
            class="pocket-user-trigger dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Abrir menú de usuario de @nombre">
        <span class="pocket-user-avatar" aria-hidden="true">@iniciales</span>
        <span class="pocket-user-summary">
            <strong>@nombre</strong>
            <small>@usuario</small>
        </span>
        <i class="bx bx-chevron-down" aria-hidden="true"></i>
    </button>

    <ul class="dropdown-menu dropdown-menu-end pocket-user-dropdown">
        <li class="pocket-user-dropdown-header">
            <span class="pocket-user-avatar" aria-hidden="true">@iniciales</span>
            <span>
                <strong>@nombre</strong>
                <small>Sucursal @sucursal</small>
            </span>
        </li>
        <li><hr class="dropdown-divider" /></li>
        <li>
            <a class="dropdown-item" asp-action="Privacy" asp-controller="Home" asp-area="">
                <i class="bx bx-file me-2" aria-hidden="true"></i>
                Normativas
            </a>
        </li>
        <li>
            <a class="dropdown-item pocket-user-logout" asp-action="Logout" asp-controller="Token" asp-area="Seguridad">
                <i class="bx bx-log-out-circle me-2" aria-hidden="true"></i>
                Cerrar sesión
            </a>
        </li>
    </ul>
</div>
