@model MenuSettings

@if (Model.Aplicaciones.Count > 0)
{
    <nav class="home-module-grid" aria-label="Módulos disponibles">
        @foreach (var item in Model.Aplicaciones.OrderBy(aplicacion => aplicacion.Orden))
        {
            var siglaNormalizada = item.Sigla.Trim().ToUpperInvariant();
            var icono = "bx-grid-alt";

            if (siglaNormalizada.Contains("CTL"))
            {
                icono = "bx-check-shield";
            }
            else if (siglaNormalizada.Contains("RPR"))
            {
                icono = "bx-package";
            }
            else if (siglaNormalizada.Contains("RTI") || siglaNormalizada == "TI")
            {
                icono = "bx-transfer-alt";
            }
            else if (siglaNormalizada.Contains("OR"))
            {
                icono = "bx-trip";
            }
            else if (siglaNormalizada.Contains("INFO"))
            {
                icono = "bx-search-alt";
            }
            else if (siglaNormalizada.Contains("INV"))
            {
                icono = "bx-clipboard";
            }
            else if (siglaNormalizada.Contains("CPREV"))
            {
                icono = "bx-list-check";
            }

            <a asp-action="@item.Action"
               asp-controller="@item.Controller"
               asp-area="@item.Area"
               class="home-module-card"
               style="--module-color: @item.Color"
               title="@item.Nombre"
               aria-label="@item.Sigla: @item.Nombre">
                <span class="home-module-icon" aria-hidden="true">
                    <i class="bx @icono"></i>
                </span>
                <span class="home-module-content">
                    <strong>@item.Sigla</strong>
                    <span>@item.Nombre</span>
                </span>
                <i class="bx bx-right-arrow-alt home-module-arrow" aria-hidden="true"></i>
            </a>
        }
    </nav>
}
else
{
    <div class="home-empty-state" role="status">
        <i class="bx bx-info-circle" aria-hidden="true"></i>
        <strong>No hay operaciones disponibles</strong>
        <span>Consulte con el administrador si considera que debería tener accesos habilitados.</span>
    </div>
}
