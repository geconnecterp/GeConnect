@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var sucursal = string.Empty;

    if (autenticado)
    {
        var administracionClaim = User.Claims.First(c => c.Type.Contains("AdmId")).Value;
        var administracionPartes = administracionClaim.Split("#");
        sucursal = administracionPartes.Length > 1 ? administracionPartes[1] : administracionClaim;
    }
}

<header class="pocket-app-header">
    <nav class="pocket-app-navbar container-xxl" aria-label="Navegación principal">
        <a asp-action="Index"
           asp-controller="Home"
           asp-area=""
           class="pocket-app-brand"
           aria-label="Ir al inicio de GECONet Pocket">
            <img src="~/img/gc.png" alt="" />
            <span>
                <strong>GECONet</strong>
                <small>POCKET</small>
            </span>
        </a>

        <div class="pocket-app-nav-actions">
            @if (autenticado)
            {
                <span class="pocket-app-branch" title="Sucursal @sucursal">
                    <i class="bx bx-building" aria-hidden="true"></i>
                    <span>Sucursal @sucursal</span>
                </span>
                <partial name="_loginAuth" />
            }
            else
            {
                <partial name="_loginBlank" />
            }
        </div>
    </nav>
</header>
