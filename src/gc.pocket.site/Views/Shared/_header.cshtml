@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var sucursal = gc.pocket.site.Models.Cuenta.OperadorCuenta.Desde(User).Sucursal;
}

<header class="pocket-app-header">
    <nav class="pocket-app-navbar container-xxl" aria-label="Navegación principal">
        <a asp-action="Index"
           asp-controller="Home"
           asp-area=""
           class="pocket-app-brand"
           aria-label="Ir al inicio de GECONet Pocket">
            <img src="~/img/gc.png" alt="" />
            <span>
                <strong>GECONet</strong>
                <small>POCKET</small>
            </span>
        </a>

        @if (autenticado)
        {
            <div class="pocket-app-branch" title="Sucursal @sucursal" aria-label="Sucursal activa">
                <span class="pocket-branch-label">Sucursal</span>
                <strong class="pocket-branch-name">@sucursal</strong>
            </div>
        }

        <div class="pocket-app-nav-actions">
            @if (autenticado)
            {
                <partial name="_loginAuth" />
            }
            else
            {
                <partial name="_loginBlank" />
            }
        </div>
    </nav>
</header>
