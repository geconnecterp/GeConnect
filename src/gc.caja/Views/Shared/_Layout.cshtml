<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Sistema de Caja GECO</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Boxicons -->
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/lobibox/css/lobibox.min.css" />
    <!-- ✅ CORREGIDO: Rutas locales con ~ -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/golden-overlay.css" rel="stylesheet" asp-append-version="true">

    <style>
        /* Estilos adicionales propios de la vista (para la grilla de menú) */
        body {
            background-color: #f4f6f9;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            padding: 10px;
        }

        .menu-btn {
            height: 120px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            text-align: center;
            transition: all 0.3s ease;
        }

            .menu-btn i {
                font-size: 2.5rem;
                margin-bottom: 10px;
            }

            .menu-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        /* Simular loading de background overlay */
        #loaderOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.9);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
    </style>
    @await RenderSectionAsync("styles", required: false)
    <link rel="stylesheet" href="~/lib/virtual-keyboard/css/virtual-keyboard.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - gc.caja - Sistema de Caja GECO
        </div>
    </footer>

    <partial name="_espera" />
    <partial name="_mensaje" />

    <!-- ✅ Scripts en orden correcto -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- ✅ AGREGADO: jQuery UI para autocomplete -->
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="~/lib/lobibox/js/lobibox.min.js"></script>
    <script src="~/lib/popper.js/umd/popper.min.js"></script>
    <script src="~/js/app/siteGen.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/virtual-keyboard/js/virtual-keyboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script type="text/javascript">
        // Variables de TempData
        var MensajeErrorTempData = '@TempData["error"]';
        var MensajeInfoTempData = '@TempData["info"]';
        var MensajeWarnTempData = '@TempData["warn"]';
        var MensajeSuccessTempData = '@TempData["succ"]';

        var home = "@Url.Action("index", "home", new { area = "" })";
        var login = "@Url.Action("Login", "Token", new { area = "seguridad" })";
        var logout = "@Url.Action("logout", "Token", new { area = "seguridad" })";
    </script>
</body>
</html>
