<!-- Modal: Confirmación de Cambio de Punto de Venta -->
<div class="modal modal-golden fade" 
     id="modalCambiaPV" 
     data-bs-backdrop="static" 
     data-bs-keyboard="false" 
     tabindex="-1" 
     aria-labelledby="modalCambiaPVTitle" 
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            
            <!-- Header con gradiente golden-warning -->
            <div class="modal-header bg-gradient-warning-golden text-dark border-0">
                <h5 class="modal-title fw-bold d-flex align-items-center" id="modalCambiaPVTitle">
                    <i class='bx bx-error bx-spin me-2 text-warning' style='font-size: 1.5rem;'></i>
                    <span>⚠️ Cambio de Punto de Venta Requerido</span>
                </h5>
            </div>  

            <!-- Body simplificado -->
            <div class="modal-body p-4 bg-light">
                
              @*   <!-- Mensaje de advertencia principal -->
                <div class="alert alert-warning border-warning shadow-sm mb-3" role="alert">
                    <div class="d-flex align-items-start">
                        <i class='bx bx-info-circle fs-3 me-3 text-warning flex-shrink-0'></i>
                        <div>
                            <h6 class="alert-heading fw-bold mb-2">Atención Requerida</h6>
                            <p class="mb-0" id="mensajeCambioPV">
                                El sistema detectó que debe cambiar de punto de venta para continuar operando.
                            </p>
                        </div>
                    </div>
                </div> *@

                <!-- Información del cambio (sin input, solo informativo) -->
                <div class="card border-0 bg-white shadow-sm">
                    <div class="card-body p-3">
                        @* <div class="d-flex align-items-center text-muted mb-2">
                            <i class='bx bx-store fs-5 me-2 text-primary'></i>
                            <div>
                                <small class="d-block fw-semibold text-dark">Punto de Venta Destino</small>
                                <small class="text-muted" id="lblNuevoPV">Se aplicará automáticamente</small>
                            </div>
                        </div>
                        <hr class="my-2"> *@
                        <div class="d-flex align-items-center text-muted">
                            <i class='bx bx-user fs-5 me-2 text-success'></i>
                            <div>
                                <small class="d-block fw-semibold text-dark">Usuario</small>
                                <small class="text-muted" id="lblUsuarioPV">---</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nota informativa adicional -->
                <div class="mt-3 p-3 bg-info-subtle border-start border-4 border-info rounded">
                    <small class="d-flex align-items-start">
                        <i class='bx bx-bulb fs-5 me-2 text-info flex-shrink-0'></i>
                        <span class="text-muted">
                            Al confirmar, el sistema realizará el cambio automáticamente y 
                            continuará con el proceso de apertura de caja.
                        </span>
                    </small>
                </div>

            </div>

            <!-- Footer con botones destacados -->
            <div class="modal-footer border-0 bg-white p-3 d-flex justify-content-between">
                <button 
                    type="button" 
                    class="btn btn-outline-danger btn-lg shadow-sm d-flex align-items-center" 
                    id="btnCancelaCambiaPV">
                    <i class='bx bx-x-circle me-2'></i>
                    Cancelar y Salir
                </button>
                <button 
                    type="button" 
                    class="btn btn-success btn-lg shadow d-flex align-items-center" 
                    id="btnConfirmaCambioPV">
                    <i class='bx bx-check-circle me-2'></i>
                    Confirmar Cambio
                </button>
            </div>

        </div>
    </div>
</div>