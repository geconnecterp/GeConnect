<!-- Modal Menú Principal Caja -->
<div class="modal modal-golden fade" id="modalMenuCaja" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalMenuTitle" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <!-- Header con gradiente dorado -->
            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title fw-bold" id="modalMenuTitle">
                    <i class='bx bx-store-alt text-white'></i>
                    Menú Principal - Caja
                    <span id="lblPV" class="badge bg-light text-dark ms-2 shadow-sm"></span>
                </h5>
                <button type="button" class="btn btn-sm btn-danger d-flex align-items-center shadow" id="btnCerrarMenu">
                    <i class='bx bx-x fs-5'></i> Salir
                </button>
            </div>

            <!-- Body con grid mejorado -->
            <div class="modal-body p-4 bg-light">
                <div class="menu-grid-enhanced">

                    <!-- FILA 1: Operaciones de Facturación -->
                    <div class="menu-row">
                        <button class="btn menu-btn-enhanced btn-success" data-action="facturacion">
                            <i class='bx bx-receipt'></i>
                            <span>FACTURACIÓN</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-primary" data-action="cobranza-diferida">
                            <i class='bx bx-dollar-circle'></i>
                            <span>COBRANZA DIFERIDA</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-danger" data-action="cobranzacc">
                            <i class='bx bx-dollar-circle'></i>
                            <span>COBRANZA CTA CTE</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-orange" data-action="devolucion-nc">
                            <i class='bx bx-undo'></i>
                            <span>DEVOLUCIÓN NC</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-pink" data-action="debito-credito">
                            <i class='bx bx-transfer'></i>
                            <span>N DÉBITO y CRÉDITO</span>
                        </button>
                       
                    </div>

                    <!-- FILA 2: Distribución y Operaciones -->
                    <div class="menu-row">
                        <button class="btn menu-btn-enhanced btn-dark-red" data-action="anula-cobranza">
                            <i class='bx bx-x-circle'></i>
                            <span>ANULA COBRANZA</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-success" data-action="dist-facturacion">
                            <i class='bx bx-spreadsheet'></i>
                            <span>DIST. FACTURACIÓN</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-danger" data-action="dist-cobranza">
                            <i class='bx bx-list-check'></i>
                            <span>DIST. COBRANZA</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-dark-red" data-action="cambio-valores">
                            <i class='bx bx-refresh'></i>
                            <span>CAMBIO VALORES</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-warning text-dark" data-action="rendiciones">
                            <i class='bx bx-file-blank'></i>
                            <span>RENDICIONES</span>
                        </button>

                       
                    </div>

                    <!-- FILA 3: Administración y Configuración -->
                    <div class="menu-row">
                        <button class="btn menu-btn-enhanced btn-secondary" data-action="cierre">
                            <i class='bx bx-lock'></i>
                            <span>CIERRE</span>
                        </button>
                       
                        <button class="btn menu-btn-enhanced btn-purple" data-action="reportes-z">
                            <i class='bx bx-bar-chart-alt-2'></i>
                            <span>REPORTES Z</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-dark-orange" data-action="cambio-pass">
                            <i class='bx bx-key'></i>
                            <span>CAMBIO PASS</span>
                        </button>

                        <button class="btn menu-btn-enhanced btn-primary" data-action="administrador">
                            <i class='bx bx-shield'></i>
                            <span>ADMINISTRADOR</span>
                        </button>

                        @* <!-- ✅ NUEVO: Botón que abre el modal del teclado demo -->
                        <button class="btn menu-btn-enhanced btn-dark-orange" data-action="demo-teclado">
                            <i class='bx bx-keyboard'></i>
                            <span>DEMO TECLADO</span>
                        </button> *@
                        <!-- Espacios vacíos para mantener alineación -->
                        <div class="menu-btn-placeholder"></div>
                        <div class="menu-btn-placeholder"></div>
                    </div>

                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer d-flex justify-content-between align-items-center bg-white border-top">
                <!-- Izquierda: Cajero y Estado -->
                <div class="text-start">
                    <small class="text-muted d-block">
                        <i class='bx bx-user'></i> Cajero:
                        <strong id="lblCajero" class="text-dark">---</strong>
                    </small>
                    <small class="text-muted d-block">
                        <i class='bx bx-pulse'></i> Estado:
                        <span class="badge bg-success">ONLINE</span>
                    </small>
                </div>

                <!-- Centro: Información de Caja -->
                <div class="text-center">
                    <small class="text-muted d-block">
                        PV: <strong id="lblPuntoVenta" class="text-dark">---</strong> |
                        Proceso: <strong id="lblNroProceso" class="text-dark">---</strong> |
                        Cierre: <strong id="lblNroCierre" class="text-dark">---</strong>
                    </small>
                </div>

                <!-- Derecha: Fecha y Hora -->
                <div class="text-end">
                    <small class="text-muted">
                        <i class='bx bx-time-five'></i>
                        <span id="lblFechaHora" class="fw-bold text-dark">---</span>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
