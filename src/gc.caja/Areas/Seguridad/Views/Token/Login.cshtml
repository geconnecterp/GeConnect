@using gc.infraestructura.EntidadesComunes.Options
@{
    var cajaConfig = ViewBag.CajaConfig as CajaSettings;
    var caja = cajaConfig?.CajaId ?? "N/A";
}

<!DOCTYPE html>
<html lang="es"
      class="light-style layout-wide customizer-hide"
      dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>Autenticación - GECONet</title>
    <meta name="description" content="Sistema de autenticación GECONet" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-default.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/extra.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/golden-overlay.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="~/lib/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/lib/lobibox/css/lobibox.min.css" />

    <!-- Page Authentication CSS -->
    <link rel="stylesheet" href="~/css/pages/page-auth.css" asp-append-version="true" />

    <!-- Helpers -->
    <script src="~/js/helpers.js" asp-append-version="true"></script>
    <script src="~/js/config.js"></script>
    <link rel="stylesheet" href="~/lib/virtual-keyboard/css/virtual-keyboard.css" asp-append-version="true" />

</head>

<body>
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-content">
            <div class="spinner-golden"></div>
            <h4 class="mt-3 text-golden">Procesando...</h4>
            <p class="text-muted">Por favor, espere un momento</p>
        </div>
    </div>

    <!-- Content -->
    <div class="container-xxl">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner-horizontal">
                <!-- ✅ NUEVO ORDEN: Layout Horizontal Invertido -->
                <div class="login-horizontal-container">
                    
                    <!-- ✅ COLUMNA IZQUIERDA: Formulario de Login (ARRIBA) -->
                    <div class="login-form-column">
                        <div class="card card-golden-login">
                            <div class="card-body">
                                <!-- Logo y Marca -->
                                <div class="app-brand-golden">
                                    <div class="app-brand-logo">
                                        <i class='bx bxs-shield-alt-2'></i>
                                    </div>
                                    <span class="app-brand-text">GECONet</span>
                                </div>

                                <!-- Título de Bienvenida -->
                                <h4 class="welcome-title text-center">¡Bienvenido al Sistema de CAJA! 👋</h4>
                                <p class="welcome-subtitle text-center">Por favor, ingrese sus credenciales para continuar</p>

                                <!-- Mensajes de Error/Info -->
                                <div id="messageContainer"></div>

                                <!-- Formulario de Login -->
                                <form id="formAuthentication" asp-area="seguridad" asp-action="login" asp-controller="token" method="post">
                                    @Html.AntiForgeryToken()

                                    <!-- Usuario -->
                                    <div class="mb-3">
                                        <label for="UserName" class="form-label-golden">
                                            <i class='bx bx-user'></i>
                                            Usuario
                                        </label>
                                        <input type="text"
                                               class="form-control form-control-golden jsteclado"
                                               id="UserName"
                                               name="UserName"
                                               placeholder="Ingrese su usuario"
                                               required
                                               autofocus
                                               autocomplete="username"
                                               style="text-transform: none !important;" />
                                    </div>

                                    <!-- Contraseña -->
                                    <div class="mb-3">
                                        <label class="form-label-golden" for="Password">
                                            <i class='bx bx-lock-alt'></i>
                                            Contraseña
                                        </label>
                                        <div class="input-group input-group-merge input-group-golden">
                                            <input type="password"
                                                   id="Password"
                                                   class="form-control form-control-golden jsteclado"
                                                   name="Password"
                                                   placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                                   required
                                                   autocomplete="current-password"
                                                   aria-describedby="togglePassword"
                                                   style="text-transform: none !important;" />
                                            <span class="input-group-text cursor-pointer" id="togglePassword">
                                                <i class="bx bx-hide" id="toggleIcon"></i>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Botón de Ingreso -->
                                    <div class="mb-3">
                                        <button class="btn btn-login-golden d-grid w-100" type="submit" id="btnLogin">
                                            <i class='bx bx-log-in-circle me-2'></i>
                                            Ingresar
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ COLUMNA DERECHA: Información de Caja (ABAJO) -->
                    <div class="login-info-column">
                        <div class="caja-info-display">
                            <div class="caja-info-header">
                                <i class='bx bx-store-alt'></i>
                                <span>Estación de Cobranza</span>
                            </div>
                            <div class="caja-info-body">
                                <div class="caja-info-item">
                                    <div class="caja-info-label">
                                        <i class='bx bx-hash'></i>
                                        <span>Caja ID</span>
                                    </div>
                                    <div class="caja-info-value">
                                        @(cajaConfig?.CajaId ?? "No configurada")
                                    </div>
                                </div>
                                <div class="caja-info-item">
                                    <div class="caja-info-label">
                                        <i class='bx bx-network-chart'></i>
                                        <span>Dirección IP</span>
                                    </div>
                                    <div class="caja-info-value">
                                        @(cajaConfig?.IP ?? "0.0.0.0")
                                    </div>
                                </div>
                                @if (cajaConfig != null)
                                {
                                    <div class="caja-info-item">
                                        <div class="caja-info-label">
                                            <i class='bx bx-receipt'></i>
                                            <span>Facturación</span>
                                        </div>
                                        <div class="caja-info-value">
                                            <span class="badge badge-facturacion-@(cajaConfig.Facturacion.ToString().ToLower())">
                                                @(cajaConfig.Facturacion == TipoFact.FE ? "Factura Electrónica" : "Controlador Fiscal")
                                            </span>
                                        </div>
                                    </div>
                                    @if (cajaConfig.Facturacion == TipoFact.CF && cajaConfig.TipoCnnCF != TipoCnnCF.NONE)
                                    {
                                        <div class="caja-info-item">
                                            <div class="caja-info-label">
                                                <i class='bx bx-link-alt'></i>
                                                <span>Conexión CF</span>
                                            </div>
                                            <div class="caja-info-value">
                                                <span class="badge badge-conexion-@(cajaConfig.TipoCnnCF.ToString().ToLower())">
                                                    @(cajaConfig.TipoCnnCF == TipoCnnCF.IP ? "Red (IP)" : "Puerto USB")
                                                </span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Fecha Actual -->
                        <div class="fecha-display">
                            <i class='bx bx-calendar'></i>
                            <strong>Fecha:</strong> @Model.FechaNN
                        </div>
                    </div>

                </div>
                <!-- /Login Horizontal Container -->
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/popper.js/umd/popper.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/lib/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/lib/lobibox/js/lobibox.min.js"></script>
    <script src="~/lib/lobibox/js/messageboxes.min.js"></script>
    <script src="~/lib/lobibox/js/notifications.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/virtual-keyboard/js/virtual-keyboard.js" asp-append-version="true"></script>

    <script type="text/javascript">
        // Variables de TempData
        var MensajeErrorTempData = '@TempData["error"]';
        var MensajeInfoTempData = '@TempData["info"]';
        var MensajeWarnTempData = '@TempData["warn"]';
        var MensajeSuccessTempData = '@TempData["succ"]';
    </script>
    <script src="~/js/app/seguridad/login.js"></script>
</body>
</html>
