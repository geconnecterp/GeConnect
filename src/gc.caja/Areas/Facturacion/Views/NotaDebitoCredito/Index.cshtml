@{
    ViewData["Title"] = "Nota de Debito, Credito y Factura de Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var modulo = "NotaDebitoCredito";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="card card-golden shadow-sm">
                <div class="card-header bg-gradient-golden">
                    <h4 class="mb-0 text-white">
                        <i class="bx bx-transfer me-1"></i>
                        Nota de Debito, Credito y Factura de Servicio
                    </h4>
                </div>

                <div class="card-body">
                    <div class="alert alert-success border-golden ncdev-alert-golden mb-4"
                         role="alert">
                        <i class="bx bx-check-circle me-1"></i>
                        <strong>Caja validada correctamente.</strong>
                        Identifique una cuenta habilitada para iniciar la operacion.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3 text-golden-dark">
                                Informacion de Caja
                            </h5>

                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="bx bx-user me-1"></i>
                                    Usuario:
                                    <strong>@ViewBag.Usuario</strong>
                                </li>
                                <li class="mb-2">
                                    <i class="bx bx-store me-1"></i>
                                    Caja:
                                    <strong>@ViewBag.CajaNombre</strong>
                                </li>
                                <li>
                                    <i class="bx bx-time me-1"></i>
                                    Fecha:
                                    <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
                                </li>
                            </ul>
                        </div>

                        <div class="col-md-6 mt-4 mt-md-0">
                            <div class="border border-golden rounded bg-golden-light p-3 h-100">
                                <h5 class="mb-3 text-golden-dark">
                                    <i class="bx bx-info-circle me-1"></i>
                                    Primer paso
                                </h5>

                                <p class="text-muted mb-0">
                                    El sistema buscara clientes y proveedores habilitados.
                                    La cuenta seleccionada definira que comprobantes se
                                    podran emitir en los pasos siguientes.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div id="ndcfsResumenCuenta"
                         class="alert alert-info border-golden ncdev-alert-golden d-none mt-4 mb-0"
                         role="alert">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var identificarClienteModalViewData = new ViewDataDictionary(ViewData);
    identificarClienteModalViewData["Modulo"] = modulo;
}
@await Html.PartialAsync("~/Areas/Facturacion/Views/Shared/_IdentificarClienteModal.cshtml", null, identificarClienteModalViewData)
@await Html.PartialAsync("~/Areas/Facturacion/Views/NotaDebitoCredito/_OperacionConceptos.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/NotaDebitoCredito/_Calculo.cshtml")

@section Scripts {
    <script>
        var BuscarClienteUrl =
            '@Url.Action("BuscarCliente", "Cliente", new { area = "Facturacion" })';

        var TraerGrillaClientesUrl =
            '@Url.Action("TraerGrillaClientes", "Cliente", new { area = "Facturacion" })';

        var LimpiarSesionClientesUrl =
            '@Url.Action("LimpiarSesionClientes", "Cliente", new { area = "Facturacion" })';

        var ndcfsRegistrarCuentaUrl =
            '@Url.Action("RegistrarCuentaSeleccionada", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsCancelarOperacionUrl =
            '@Url.Action("CancelarOperacion", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsObtenerIvaAlicuotasUrl =
            '@Url.Action("ObtenerIvaAlicuotas", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsObtenerTiposComprobanteUrl =
            '@Url.Action("ObtenerTiposComprobante", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsCalcularConceptosUrl =
            '@Url.Action("CalcularConceptos", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsConfirmarOperacionUrl =
            '@Url.Action("ConfirmarOperacion", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsModuloIndexUrl =
            '@Url.Action("Index", "NotaDebitoCredito", new { area = "Facturacion" })';

        var ndcfsMenuCajaUrl =
            '@Url.Action("Index", "Home", new { area = "" })';
    </script>

    <script src="~/js/app/reportes.js"
            asp-append-version="true">
    </script>
    <script src="~/js/app/ndNcFs.js"
            asp-append-version="true">
    </script>
}

