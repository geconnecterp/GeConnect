<div class="modal fade modal-golden"
     id="modalNdcfsCalculo"
     tabindex="-1"
     aria-labelledby="modalNdcfsCalculoLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header bg-gradient-golden text-white">
                <div>
                    <h5 class="modal-title mb-0" id="modalNdcfsCalculoLabel">
                        <i class="bx bx-calculator"></i>
                        Nota de Debito - Nota de Credito - Factura de Servicio
                    </h5>
                    <small>Calculo de la operacion</small>
                </div>
            </div>

            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="txtNdcfsNombreCalculo" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">ID</label>
                        <input type="text" class="form-control" id="txtNdcfsIdCalculo" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Domicilio</label>
                        <input type="text" class="form-control" id="txtNdcfsDomicilioCalculo" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tipo/Nro</label>
                        <input type="text" class="form-control" id="txtNdcfsTipoNumeroCalculo" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Emite</label>
                        <input type="text" class="form-control fw-bold text-golden-dark" id="txtNdcfsEmiteCalculo" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Condicion AFIP</label>
                        <input type="text" class="form-control" id="txtNdcfsAfipCalculo" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control" id="txtNdcfsEmailCalculo" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Movil</label>
                        <input type="text" class="form-control" id="txtNdcfsMovilCalculo" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cuenta</label>
                        <input type="text" class="form-control" id="txtNdcfsOrigenCalculo" readonly />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="card card-golden shadow-sm h-100">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="bx bx-list-ul"></i>
                                    Detalle de Conceptos
                                </h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive table-calc-conceptos">
                                    <table class="table table-golden table-hover mb-0" id="tbNdcfsSubtotales">
                                        <thead class="table-golden-header">
                                            <tr>
                                                <th class="text-start">Concepto</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyNdcfsSubtotales">
                                            <tr>
                                                <td colspan="2" class="text-center text-muted py-4">
                                                    <i class="bx bx-loader-alt bx-spin"></i>
                                                    Calculando...
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="table-golden-footer fw-bold">
                                            <tr class="total-row-golden">
                                                <td class="fs-4">TOTAL</td>
                                                <td class="text-end text-success fs-4" id="tdNdcfsTotalCalculo">$ 0.00</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card card-golden shadow-sm h-100">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="bx bx-info-circle"></i>
                                    Operacion
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="ndcfs-operacion-resumen">
                                    <div class="ndcfs-operacion-item">
                                        <span class="ndcfs-operacion-label">Tipo</span>
                                        <span class="ndcfs-operacion-value fw-bold" id="lblNdcfsOperacionCalculo">-</span>
                                    </div>

                                    <div class="ndcfs-operacion-item">
                                        <span class="ndcfs-operacion-label">Cuenta</span>
                                        <span class="ndcfs-operacion-value" id="lblNdcfsCuentaCalculo">-</span>
                                    </div>

                                    <div class="ndcfs-operacion-item">
                                        <span class="ndcfs-operacion-label">Comprobante ori.</span>
                                        <span class="ndcfs-operacion-value" id="lblNdcfsOrigenComprobanteCalculo">-</span>
                                    </div>

                                    <div class="ndcfs-operacion-item">
                                        <span class="ndcfs-operacion-label">Conceptos</span>
                                        <span class="ndcfs-operacion-value" id="lblNdcfsCantidadConceptosCalculo">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <button type="button" class="btn btn-secondary btn-lg" id="btnNdcfsVolverCalculo">
                        <i class="bx bx-arrow-back"></i>
                        VOLVER
                    </button>
                    <button type="button" class="btn btn-success btn-lg px-5" id="btnNdcfsFinalizar">
                        <i class="bx bx-check-circle"></i>
                        FINALIZAR
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
