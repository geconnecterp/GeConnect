@*
    ════════════════════════════════════════════════════════════
    MODAL: PRE-FACTURAS
    ════════════════════════════════════════════════════════════
    Permite seleccionar pre-facturas pendientes para cargar
    VERSIÓN: v3.2 - CORREGIDO: Conflicto checkbox + Columna Acción eliminada
*@

<!-- Modal Pre-Facturas -->
<div class="modal fade modal-golden"
     id="modalPreFacturas"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1"
     aria-labelledby="modalPreFacturasTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- HEADER -->
            <!-- ════════════════════════════════════════════════════════ -->
            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title fw-bold text-white" id="modalPreFacturasTitle">
                    <i class='bx bx-file-blank'></i> Prefacturas
                    <span id="spanContadorSeleccion" class="badge bg-white text-golden ms-2" style="display: none;">
                        0 seleccionadas
                    </span>
                </h5>
            </div>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- BODY -->
            <!-- ════════════════════════════════════════════════════ -->
            <div class="modal-body p-4 bg-light">

                <!-- Filtro: Solo Pendientes -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="form-check form-check-lg">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="chkSoloPendientes"
                                   checked>
                            <label class="form-check-label fw-bold" for="chkSoloPendientes">
                                <i class='bx bx-time-five'></i> Solo Pendientes
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Pre-Facturas -->
                <div class="card card-golden">
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 550px; overflow-y: auto;">
                            <table class="table table-golden table-hover table-sm mb-0" id="tbPreFacturas">
                                <!-- ✅ ACTUALIZADO v3.2: Eliminada columna "Acción" -->
                                <thead class="table-golden-header sticky-top">
                                    <tr>
                                        <th class="text-center" style="width: 12%;">Código PF</th>
                                        <th style="width: 30%;">Cliente</th>
                                        <th class="text-center" style="width: 18%;">Documento</th>
                                        <th class="text-center" style="width: 18%;">Fecha</th>
                                        <th style="width: 17%;">Sector</th>
                                        <th class="text-center" style="width: 5%;" title="Columna de selección">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="chkSeleccionarTodos"
                                                   title="Seleccionar todas las pre-facturas">
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyPreFacturas">
                                    <!-- Mensaje inicial -->
                                    <tr id="rowSinPreFacturas">
                                        <td colspan="6" class="text-center text-muted py-5">
                                            <i class='bx bx-file-blank bx-lg text-golden'></i>
                                            <p class="mb-0 mt-2">
                                                <strong>No hay pre-facturas disponibles</strong><br>
                                                <small>Cambie el filtro o verifique que existan pre-facturas pendientes</small>
                                            </p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ════════════════════════════════════════════════════ -->
            <!-- FOOTER -->
            <!-- ════════════════════════════════════════════════════ -->
            <div class="modal-footer bg-white">
                <button type="button"
                        class="btn btn-danger btn-lg px-5"
                        id="btnCancelarPreFactura">
                    <i class='bx bx-x-circle'></i> CANCELAR
                </button>
                <button type="button"
                        class="btn btn-success btn-lg px-5"
                        id="btnSeguirPreFactura"
                        disabled>
                    <i class='bx bx-check-circle'></i> SELECCIONAR
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!-- ESTILOS ADICIONALES - ACTUALIZADO v3.2 -->
<!-- ════════════════════════════════════════════════════════ -->
<style>
    /* Fila seleccionada */
    #tbPreFacturas tbody tr.selected-prefactura {
        background-color: #d4e6f1;
        border-left: 4px solid #3498db;
    }

    /* Hover en filas */
    #tbPreFacturas tbody tr:not(#rowSinPreFacturas):hover {
        background-color: #faf5e6;
        cursor: pointer;
    }

    /* ✅ NUEVO v3.2: Celda de checkbox sin hover de puntero */
    #tbPreFacturas tbody tr td.td-checkbox {
        cursor: default; /* ← No mostrar pointer sobre la celda del checkbox */
    }

    /* Checkbox en la tabla */
    #tbPreFacturas .form-check-input {
        width: 1.2rem;
        height: 1.2rem;
        cursor: pointer; /* ← Pointer solo sobre el checkbox */
    }

    /* ✅ NUEVO v3.2: Aumentar área clickeable del checkbox */
    #tbPreFacturas tbody tr td.td-checkbox {
        padding: 0.75rem; /* ← Más espacio para hacer click */
    }
</style>