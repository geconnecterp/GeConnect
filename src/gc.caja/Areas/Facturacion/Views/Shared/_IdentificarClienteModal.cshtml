@{
    // Determina el módulo actual, con "Facturacion" como valor por defecto.
    var modulo = ViewData["Modulo"] as string ?? "Facturacion";
}
<!-- Modal Identificar Cliente - Facturación -->
<div class="modal modal-golden fade" id="modalIdentificarCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalIdentificarClienteTitle" aria-hidden="true" data-modulo="@modulo">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <!-- Header con gradiente dorado -->
            <div class="modal-header bg-gradient-blue">
                <h5 class="modal-title fw-bold" id="modalIdentificarClienteTitle">
                    <i class='bx bx-user-circle text-white'></i>
                    @{
                        var titulo = modulo == "CobranzaDiferida"
                        ? "COBRANZA DIFERIDA - Identificar Cliente"
                        : "FACTURACIÓN - Identificar Cliente";
                    }
                    @titulo
                </h5>
            </div>

            <!-- Body -->
            <div class="modal-body p-4 bg-light">
                <!-- Sección de búsqueda CUIT/DNI -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-golden text-white fw-bold">
                                <i class='bx bx-search-alt'></i> CUIT/DNI/ID
                            </span>
                            <input type="text"
                                   class="form-control form-control-lg fw-bold jsteclado"
                                   id="txtBuscarCliente"
                                   placeholder="Ingrese CUIT, DNI o ID del cliente..."
                                   maxlength="20"
                                   autocomplete="off">
                            <button class="btn btn-golden btn-lg" type="button" id="btnBuscarCliente">
                                <i class='bx bx-search'></i> Buscar
                            </button>
                        </div>

                        <!-- ══════════════════════════════════════════════════════ -->
                        <!-- ✅ NUEVO: Checkbox de Auto-Confirmación                -->
                        <!-- ══════════════════════════════════════════════════════ -->
                        <div id="seccionAutoConfirmar" class="d-flex align-items-start gap-2 mt-2 @(modulo == "CobranzaDiferida" ? "d-none" : "")">
                            <!-- Checkbox a la izquierda -->
                            <div class="form-check mt-1">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="chkAutoConfirmar"
                                       checked
                                       style="cursor: pointer;">
                                <label class="form-check-label"
                                       for="chkAutoConfirmar"
                                       style="cursor: pointer;">
                                    <i class='bx bx-zap text-success'></i>
                                    <strong>Confirmar automáticamente</strong>
                                </label>
                            </div>

                            <!-- Texto explicativo a la derecha -->
                            <small class="text-muted d-block">
                                <i class='bx bx-info-circle'></i>
                                Presione <kbd>Enter</kbd> o <strong>Buscar</strong> para identificar al cliente.
                                <br>
                                <!-- 🔄 CAMBIO: Texto y color actualizados para mayor claridad -->
                                <span id="textoDesactivarEdicion" class="text-danger-emphasis @(modulo == "CobranzaDiferida" ? "d-none" : "")">
                                    <i class='bx bx-edit'></i>
                                    <strong>Desactive</strong> para editar datos (sólo Consumidores Finales).
                                </span>
                            </small>
                        </div>
                        <!-- ══════════════════════════════════════════════════════ -->
                    </div>
                </div>

                <!-- Separador con botones de acción rápida -->
                <div id="seccionAccionRapida" class="row mb-4 @(modulo == "CobranzaDiferida" ? "d-none" : "")">
                    <div class="col-md-6">
                        <button class="btn btn-warning w-100 py-3 fw-bold" id="btnListaPrecios" type="button" disabled>
                            <i class='bx bx-list-ul bx-lg'></i><br>
                            Lista Precios
                        </button>
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-warning w-100 py-3 fw-bold" id="btnNuevoCliente" type="button">
                            <i class='bx bx-user-plus bx-lg'></i><br>
                            Nuevo CF
                        </button>
                    </div>
                </div>

                <!-- Card con datos del cliente -->
                <div class="card card-golden" id="cardDatosCliente">
                    <div class="card-header">
                        <i class='bx bx-data'></i> Datos del Cliente
                    </div>
                    <div class="card-body bg-gradient-golden p-0">
                        <!-- Fila 1: Nombre, ID, Domicilio -->
                        <div class="row g-2 mb-2">
                            <div class="col-md-5">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-user'></i> Cliente
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm fw-bold bg-white"
                                           id="txtNombre"
                                           readonly>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-id-card'></i> ID
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm text-center fw-bold bg-white"
                                           id="txtClienteId"
                                           readonly>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-map'></i> Domicilio
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm bg-white"
                                           id="txtDomicilio"
                                           readonly>
                                </div>
                            </div>
                        </div>

                        <!-- Fila 2: Condición AFIP, Tipo/N°, Emite -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-receipt'></i> AFIP
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm bg-white"
                                           id="txtCondicionAfip"
                                           readonly>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-file'></i> CUIT
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm bg-white"
                                           id="txtTipoNumero"
                                           readonly>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-file'></i> Emite
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm bg-white"
                                           id="txtEmite"
                                           readonly>
                                </div>
                            </div>

                            <!-- Fila 3: Email, Móvil, BOTÓN EDITAR -->
                            <div class="col-md-3">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-envelope'></i> Email
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm bg-white"
                                           id="txtEmail"
                                           readonly>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">
                                        <i class='bx bx-phone'></i> Móvil
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm bg-white"
                                           id="txtMovil"
                                           readonly>
                                </div>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="button"
                                        class="btn btn-warning btn-sm w-100 shadow"
                                        id="btnEditarCliente"
                                        style="display: none;"
                                        title="Editar datos del Consumidor Final">
                                    <i class='bx bx-edit'></i> EDITAR DATOS
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mensaje cuando no hay cliente seleccionado -->
                <div class="alert alert-info text-center mb-0" id="alertSinCliente" role="alert">
                    <i class='bx bx-info-circle bx-lg'></i>
                    <p class="mb-0 mt-2">
                        <strong>No hay cliente seleccionado</strong><br>
                        <small>Ingrese CUIT, DNI o ID para buscar un cliente</small>
                    </p>
                </div>
            </div>

            <!-- Footer con botones de acción -->
            <div class="modal-footer d-flex justify-content-between bg-white border-top">
                <div>
                    <button type="button"
                            class="btn btn-outline-secondary btn-lg shadow-sm"
                            id="btnSalirFacturacion"
                            title="Salir al menú principal de caja">
                        <i class='bx bx-log-out-circle'></i> SALIR AL MENÚ
                    </button>
                </div>

                <div class="d-flex gap-3">
                    <button type="button"
                            class="btn btn-danger btn-lg shadow"
                            id="btnCancelarCliente"
                            title="Limpiar y reiniciar búsqueda">
                        <i class='bx bx-x-circle'></i> CANCELAR
                    </button>
                    <button type="button"
                            class="btn btn-success btn-lg shadow"
                            id="btnSeguirCliente"
                            disabled
                            title="Confirmar cliente y continuar">
                        <i class='bx bx-check-circle'></i> SEGUIR
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>