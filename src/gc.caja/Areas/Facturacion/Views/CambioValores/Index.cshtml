@{
    ViewData["Title"] = "Cambios e Ingresos de Valores";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var modulo = ViewBag.Modulo as string ?? "CambioValores";
}

<div id="mensajeInicial" class="container-fluid mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-info alert-dismissible fade show shadow" role="alert">
                <h4 class="alert-heading"><i class="bx bx-info-circle"></i> Informacion</h4>
                <p class="mb-0"><strong>@ViewBag.ModuloDesc</strong><br />Seleccione un cliente registrado para cargar cheques, transferencias u otros valores habilitados.</p>
            </div>
        </div>
    </div>
</div>

@{
    var identificarClienteModalViewData = new ViewDataDictionary(ViewData);
    identificarClienteModalViewData["Modulo"] = modulo;
}
@await Html.PartialAsync("~/Areas/Facturacion/Views/Shared/_IdentificarClienteModal.cshtml", null, identificarClienteModalViewData)

<div class="modal fade modal-golden" id="modalCambioValores" tabindex="-1" aria-labelledby="modalCambioValoresLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header bg-gradient-golden text-white">
                <div>
                    <h5 class="modal-title mb-0 fw-bold" id="modalCambioValoresLabel"><i class="bx bx-transfer-alt"></i> Cambios e Ingresos de Valores</h5>
                    <small class="fw-bold">Carga de valores recibidos de cliente registrado</small>
                </div>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="card card-golden shadow-sm mb-3">
                    <div class="card-header fw-bold"><i class="bx bx-user"></i> Datos del Cliente</div>
                    <div class="card-body bg-gradient-golden p-3">
                        <div class="row g-2 mb-2">
                            <div class="col-md-5"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">Nombre</span><input type="text" class="form-control form-control-sm fw-bold bg-white" id="txtNombreCambioValores" readonly></div></div>
                            <div class="col-md-2"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">ID</span><input type="text" class="form-control form-control-sm text-center fw-bold bg-white" id="txtClienteIdCambioValores" readonly></div></div>
                            <div class="col-md-5"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">Domicilio</span><input type="text" class="form-control form-control-sm bg-white" id="txtDomicilioCambioValores" readonly></div></div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-3"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">AFIP</span><input type="text" class="form-control form-control-sm bg-white" id="txtCondicionAfipCambioValores" readonly></div></div>
                            <div class="col-md-3"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">Tipo/Nro</span><input type="text" class="form-control form-control-sm bg-white" id="txtTipoNumeroCambioValores" readonly></div></div>
                            <div class="col-md-3"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">Email</span><input type="text" class="form-control form-control-sm bg-white" id="txtEmailCambioValores" readonly></div></div>
                            <div class="col-md-3"><div class="input-group input-group-sm"><span class="input-group-text bg-white bg-opacity-25 text-white fw-semibold border-0">Movil</span><input type="text" class="form-control form-control-sm bg-white" id="txtMovilCambioValores" readonly></div></div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-lg-3">
                        <div class="card card-golden shadow-sm h-100">
                            <div class="card-header fw-bold"><i class="bx bx-cog"></i> Operacion</div>
                            <div class="card-body">
                                <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="chkIngresoValor"><label class="form-check-label fw-bold" for="chkIngresoValor">Ingreso de Valor</label></div>
                                <div class="alert alert-warning small mb-0" id="lblTipoOperacionCambioValores">Cambio de Valor: se entregara efectivo en pesos contra el valor recibido.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div class="card card-golden shadow-sm h-100">
                            <div class="card-header fw-bold"><i class="bx bx-plus-circle"></i> Carga de valor</div>
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3"><label class="form-label small fw-bold">Medio</label><select class="form-select" id="cmbMedioCambioValores"></select></div>
                                    <div class="col-md-3"><label class="form-label small fw-bold">Instrumento</label><select class="form-select" id="cmbInstrumentoCambioValores"></select></div>
                                    <div class="col-md-2 d-none" id="grpDato1CambioValores"><label class="form-label small fw-bold" id="lblDato1CambioValores">Dato 1</label><input type="text" class="form-control jsteclado" id="txtDato1CambioValores" autocomplete="off"></div>
                                    <div class="col-md-2 d-none" id="grpDato2CambioValores"><label class="form-label small fw-bold" id="lblDato2CambioValores">Dato 2</label><input type="text" class="form-control jsteclado" id="txtDato2CambioValores" autocomplete="off"></div>
                                    <div class="col-md-2 d-none" id="grpDato3CambioValores"><label class="form-label small fw-bold" id="lblDato3CambioValores">Dato 3</label><input type="text" class="form-control jsteclado" id="txtDato3CambioValores" autocomplete="off"></div>
                                    <div class="col-md-2" id="grpFechaCambioValores"><label class="form-label small fw-bold">Fecha Valor</label><input type="date" class="form-control" id="txtFechaValorCambioValores"></div>
                                    <div class="col-md-2"><label class="form-label small fw-bold">Importe</label><input type="text" class="form-control text-end fw-bold input-decimal" id="txtImporteCambioValores" autocomplete="off"></div>
                                    <div class="col-md-1 d-grid"><button type="button" class="btn btn-golden" id="btnAgregarValorCambioValores" title="Agregar valor"><i class="bx bx-plus-circle"></i></button></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-golden shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="fw-bold"><i class="bx bx-list-ul"></i> Valores cargados</div>
                        <span class="badge bg-success" id="lblCambioValoresCount">0</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 46vh; overflow-y: auto;">
                            <table class="table table-golden table-hover mb-0" id="tbCambioValores">
                                <thead class="table-golden-header">
                                    <tr>
                                        <th style="width: 130px;">Medio</th>
                                        <th style="width: 170px;">Instrumento</th>
                                        <th>Detalle</th>
                                        <th class="text-center" style="width: 130px;">Fecha Valor</th>
                                        <th class="text-end" style="width: 170px;">Importe</th>
                                        <th class="text-center" style="width: 90px;">Accion</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyCambioValores">
                                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="bx bx-info-circle"></i> Sin valores cargados.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-golden-light border-top border-golden">
                        <div class="d-flex justify-content-end align-items-center gap-3">
                            <span class="fw-bold text-golden-dark fs-4">TOTAL:</span>
                            <span class="form-control form-control-lg text-end fw-bold text-success" id="lblTotalCambioValores" style="max-width: 320px;">$ 0.00</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <button type="button" class="btn btn-danger btn-lg" id="btnCancelarCambioValores"><i class="bx bx-x-circle"></i> CANCELAR</button>
                    <button type="button" class="btn btn-success btn-lg px-5" id="btnFinalizarCambioValores" disabled><i class="bx bx-check-circle"></i> FINALIZAR</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var clienteCompleto = null;
        let clienteActualFactura = null;
        const coTipo = 'CV';

        const MenuCajaUrl = '@Url.Action("Index", "Home", new { area = "" })';
        const BuscarClienteUrl = '@Url.Action("BuscarCliente", "Cliente", new { Area = "Facturacion", app = "CV" })';
        const TraerGrillaClientesUrl = '@Url.Action("TraerGrillaClientes", "Cliente", new { Area = "Facturacion" })';
        const LimpiarSesionClientesUrl = '@Url.Action("LimpiarSesionClientes", "Cliente", new { Area = "Facturacion" })';
        const ObtenerClienteActualUrl = '@Url.Action("ObtenerClienteActual", "Cliente", new { Area = "Facturacion" })';

        const verificarExistenciaCuentaCorrienteUrl = '@Url.Action("ValidarClienteRegistrado", "CambioValores", new { Area = "Facturacion" })';
        const cambioValoresMediosPagoUrl = '@Url.Action("ObtenerMediosPago", "CambioValores", new { Area = "Facturacion" })';
        const cambioValoresInstrumentosUrl = '@Url.Action("ObtenerInstrumentos", "CambioValores", new { Area = "Facturacion" })';
        const cambioValoresPrepararConfirmacionUrl = '@Url.Action("PrepararConfirmacion", "CambioValores", new { Area = "Facturacion" })';
        const cambioValoresMenuUrl = '@Url.Action("Index", "Home", new { area = "" })';
    </script>

    <script src="~/js/app/fact.js" asp-append-version="true"></script>
    <script src="~/js/app/cambioValores.js" asp-append-version="true"></script>
}
