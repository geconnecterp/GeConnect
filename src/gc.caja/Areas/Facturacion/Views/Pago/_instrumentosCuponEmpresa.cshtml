                         data-cupon-desc="ORDEN COMPRA CHICONI"
                         data-cupon-importe="0.00"
                         style="cursor: pointer; transition: all 0.2s ease;">
                        <div class="flex-grow-1">
                            <i class="bx bx-purchase-tag me-2 text-info"></i>
