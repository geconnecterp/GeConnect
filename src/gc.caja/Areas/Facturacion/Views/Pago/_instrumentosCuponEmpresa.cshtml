                         data-cupon-id="MUTUAL_UPCN" 
                         data-cupon-desc="MUTUAL UP.C.N"
                         data-cupon-importe="0.00"
                         style="cursor: pointer; transition: all 0.2s ease;">
                        <div class="flex-grow-1">
                            <i class="bx bx-buildings me-2 text-info"></i>
                            <span>MUTUAL UP.C.N</span>
                        </div>
                        <div style="width: 150px; text-align: right;">
                            <span class="fw-bold text-info">0.00</span>
                        </div>
                    </div>

                    <!-- ORDEN COMPRA CHICONI -->
