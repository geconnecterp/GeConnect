    @* ✅ NUEVO v21.3: EVENTOS DE NAVEGACIÓN CON TECLADO *@
    @* ═══════════════════════════════════════════════════════════════ *@

    <script>
        $(function () {
            console.log('🔧 Vinculando eventos de navegación - Modal Cupones/Empresa');

            // ❶ Evento: Click en ítem de empresa/mutual (selección + confirmación automática)
            $(document).on('click', '.instrumento-cupon-item', function () {
                console.log('🖱️ Click en empresa/mutual - Seleccionando y confirmando...');

                const $item = $(this);

                // Limpiar selecciones previas
                $('.instrumento-cupon-item').removeClass('selected');

                // Seleccionar ítem actual
                $item.addClass('selected');

                // Habilitar botón confirmar
                $('#btnConfirmarCuponEmpresa').prop('disabled', false);

                // Obtener datos de la empresa/mutual
                const cuponId = $item.data('cupon-id');
                const cuponDesc = $item.data('cupon-desc');
                const cuponImporte = $item.data('cupon-importe');

                console.log(`   ✅ Empresa/Mutual seleccionada: ${cuponDesc} (${cuponId})`);
                console.log(`   💰 Importe disponible: $ ${cuponImporte}`);

                // ✅ Confirmar automáticamente después de delay
                setTimeout(() => {
                    console.log('   ⏩ Confirmando selección automáticamente...');
                    $('#btnConfirmarCuponEmpresa').trigger('click');
                }, 200); // ← 200ms para feedback visual
            });

            // ❷ Evento: Hover en ítem (mejora visual)
            $(document).on('mouseenter', '.instrumento-cupon-item', function () {
                $(this).css({
                    'background-color': '#f8f9fa',
                    'transform': 'translateX(5px)',
                    'transition': 'all 0.2s ease'
                });
            });

            $(document).on('mouseleave', '.instrumento-cupon-item', function () {
                if (!$(this).hasClass('selected')) {
                    $(this).css({
                        'background-color': '',
                        'transform': 'translateX(0)'
                    });
                }
            });

            console.log('✅ Eventos de click y hover vinculados (12 empresas/mutuales)');

                 // ✅ Actualizar panel informativo al seleccionar empresa
            $(document).on('click keydown', function (e) {
                if (!$('#modalInstrumentosCuponEmpresa').hasClass('show')) return;

                // Solo procesar si es click en item o navegación con teclado
                if (e.type === 'click' && !$(e.target).closest('.instrumento-cupon-item').length) return;
                if (e.type === 'keydown' && e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;

                setTimeout(() => {
                    const $selected = $('.instrumento-cupon-item.selected');

                    if ($selected.length > 0) {
                        // Mostrar panel
                        $('#panelInfoEmpresa').removeClass('d-none');

                        // Actualizar nombre de empresa
                        const nombreEmpresa = $selected.data('cupon-desc');
                        $('#nombreEmpresaInfo').text(nombreEmpresa);

                        // Actualizar posición
                        const $items = $('.instrumento-cupon-item:visible');
                        const posicion = $items.index($selected) + 1;
                        $('#posicionActualCupon').text(posicion);
                        $('#totalCupones').text($items.length);
                    }
                }, 50);
            });

            // Ocultar panel al cerrar modal
            $('#modalInstrumentosCuponEmpresa').on('hidden.bs.modal', function () {
                $('#panelInfoEmpresa').addClass('d-none');
            });
        });
    </script>


