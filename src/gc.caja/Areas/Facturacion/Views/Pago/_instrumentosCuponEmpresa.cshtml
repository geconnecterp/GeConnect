                    <!-- VALE COMPRA TERAPIA POLIVALENTE -->
                    <div class="list-group-item list-group-item-action instrumento-cupon-item d-flex align-items-center" 
                         data-cupon-id="VALE_TERAPIA" 
                         data-cupon-desc="VALE COMPRA TERAPIA POLIVALENTE"
