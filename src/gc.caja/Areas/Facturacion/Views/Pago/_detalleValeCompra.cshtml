@*
    ═══════════════════════════════════════════════════════════════
    Modal de Detalle - Vale de Compra
    ═══════════════════════════════════════════════════════════════

    DESCRIPCIÓN:
    Modal simple para ingresar el monto del vale de compra seleccionado.

    CAMPOS:
    - Monto: valor del vale

    FLUJO:
    1. Se selecciona el vale desde modal de Instrumentos
    2. Se carga saldo disponible del vale
    3. Se ingresa el monto a aplicar (validado contra saldo del vale)

    VALIDACIONES:
    - Monto > 0
    - Monto <= Saldo Disponible del Vale
    - Monto <= Saldo a Cancelar de la Factura

    MAPEO BD:
    - rb_importe = Monto

    EVENTOS:
    - Manejados en pagoFactura.js
*@

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: DETALLE VALE DE COMPRA -->
<!-- ═══════════════════════════════════════════════════════════════ -->

<div class="modal fade" 
     id="modalDetalleValeCompra" 
     tabindex="-1" 
     role="dialog" 
     aria-labelledby="modalDetalleValeCompraLabel" 
     aria-hidden="true" 
     data-bs-backdrop="static" 
     data-bs-keyboard="false">

    <div class="modal-dialog modal-dialog-centered modal-dialog-elevated" role="document" style="max-width: 500px;">
        <div class="modal-content modal-golden">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- HEADER -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title" id="modalDetalleValeCompraLabel">
                    <i class="bx bx-gift me-2"></i>
                    Detalle - Vale de Compra
                </h5>
                <button type="button" 
                        class="btn-close" 
                        data-bs-dismiss="modal" 
                        aria-label="Cerrar"></button>
            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- BODY -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-body">

                <form id="formDetalleValeCompra">

                    <!-- Información del Vale Seleccionado -->
                    <div class="alert alert-info d-flex align-items-center mb-3">
                        <i class="bx bx-info-circle me-2"></i>
                        <div>
                            <strong>Vales de Compra CA</strong> 
                            <span class="mx-2">|</span>
                            <span id="lblValeCompraSeleccionado">-</span>
                        </div>
                    </div>

                    <!-- Información de Saldo Disponible -->
                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">
                                    <i class="bx bx-wallet me-1"></i>
                                    Saldo disponible:
                                </span>
                                <span id="lblSaldoValeCompra" class="fs-5 fw-bold text-success">$ 0,00</span>
                            </div>
                            
                            <!-- ✅ NUEVO v19.2: Alert de Fallback -->
                            <div id="alertFallbackVale" class="alert alert-info mt-2 mb-0 py-2" style="display: none;">
                                <small>
                                    <i class="bx bx-info-circle"></i>
                                    <strong>Usando saldo de factura:</strong> 
                                    El vale no tiene saldo registrado. Se utilizará el saldo de la factura como límite.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Campo Oculto: ID Vale -->
                    <input type="hidden" id="hdnIdValeCompra" name="idVale">
                    
                    <!-- Campo Oculto: Saldo Disponible (para validación) -->
                    <input type="hidden" id="hdnSaldoValeCompra" name="saldoDisponible" value="0">

                    <!-- Campo: Monto -->
                    <div class="mb-3">
                        <label for="txtMontoValeCompra" class="form-label fw-bold">
                            Monto a Aplicar <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-golden text-white">
                                <i class="bx bx-dollar"></i>
                            </span>
                            <input type="text"
                                   class="form-control form-control-lg text-end"
                                   id="txtMontoValeCompra"
                                   name="monto"
                                   placeholder="$ 0,00"
                                   required
                                   autocomplete="off"
                                   autofocus>
                        </div>
                        <div class="form-text">
                            <i class="bx bx-info-circle"></i> 
                            El monto no puede superar el saldo disponible del vale
                        </div>
                        <!-- Mensaje de Error -->
                        <div id="errorMontoValeCompra" class="invalid-feedback" style="display: none;">
                        </div>
                    </div>

                </form>

            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- FOOTER -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-footer bg-light">
                <button type="button" 
                        class="btn btn-secondary" 
                        data-bs-dismiss="modal">
                    <i class="bx bx-x me-1"></i>
                    Cancelar
                </button>
                <button type="button" 
                        class="btn btn-golden" 
                        id="btnGuardarDetalleValeCompra">
                    <i class="bx bx-save me-1"></i>
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>