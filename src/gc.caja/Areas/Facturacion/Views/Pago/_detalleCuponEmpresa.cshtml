@*
    ═══════════════════════════════════════════════════════════════
    Modal de Detalle - Cupón/Orden de Empresa (Mutuales)
    ═══════════════════════════════════════════════════════════════

    CAMBIOS v20.4:
    - ✅ Campo Titular → readonly (se carga desde cliente actual)
    - ✅ Campo CUIT → readonly (se carga desde cliente actual)
    - ✅ Validación de CUIT según tipo de cliente (CR/CF)
*@

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: DETALLE CUPÓN EMPRESA v20.4 -->
<!-- ═══════════════════════════════════════════════════════════════ -->

<div class="modal fade"
     id="modalDetalleCuponEmpresa"
     tabindex="-1"
     role="dialog"
     aria-labelledby="modalDetalleCuponEmpresaLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-dialog-centered modal-dialog-elevated" role="document" style="max-width: 650px;">
        <div class="modal-content modal-golden">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- HEADER -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title" id="modalDetalleCuponEmpresaLabel">
                    <i class="bx bx-purchase-tag me-2"></i>
                    Detalle - Orden/Cupón de Empresa
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- BODY -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-body">

                <form id="formDetalleCuponEmpresa">

                    <!-- Información del Instrumento Seleccionado -->
                    <div class="alert alert-info d-flex align-items-center mb-3">
                        <i class="bx bx-info-circle me-2"></i>
                        <div>
                            <strong>Órdenes / Cupones de Empresas</strong>
                            <span class="mx-2">|</span>
                            <span id="lblEmpresaSeleccionada">-</span>
                        </div>
                    </div>

                    <!-- ✅ ACTUALIZADO v20.4: Campo Titular (readonly) -->
                    <div class="mb-3">
                        <label for="txtTitularCupon" class="form-label fw-bold">
                            Titular <span class="text-danger">*</span>
                            <small class="text-muted fw-normal">(Cliente actual)</small>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bx bx-user"></i>
                            </span>
                            <input type="text"
                                   class="form-control bg-light"
                                   id="txtTitularCupon"
                                   name="titular"
                                   placeholder="Se cargará automáticamente"
                                   required
                                   readonly>
                        </div>
                        <small class="form-text text-muted">
                            <i class="bx bx-lock-alt"></i>
                            Campo automático - No editable
                        </small>
                    </div>

                    <!-- Campo: Nro de Orden (sin cambios) -->
                    <div class="mb-3">
                        <label for="txtNroOrdenCupon" class="form-label fw-bold">
                            Nro de Orden <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bx bx-hash"></i>
                            </span>
                            <input type="text"
                                   class="form-control"
                                   id="txtNroOrdenCupon"
                                   name="numeroOrden"
                                   placeholder="Número de orden/cupón"
                                   required>
                        </div>
                    </div>

                    <!-- ✅ ACTUALIZADO v20.4: Campo CUIT (readonly) -->
                    <div class="mb-3">
                        <label for="txtCuitCupon" class="form-label fw-bold">
                            CUIT <span class="text-danger">*</span>
                            <small class="text-muted fw-normal">(Del cliente actual)</small>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bx bx-id-card"></i>
                            </span>
                            <input type="text"
                                   class="form-control bg-light"
                                   id="txtCuitCupon"
                                   name="cuit"
                                   placeholder="Se cargará automáticamente"
                                   maxlength="13"
                                   required
                                   readonly>
                        </div>
                        <!-- ✅ NUEVO: Área para mensajes dinámicos -->
                        <div id="msgCuitCupon" class="form-text" style="display: none;">
                            <!-- Se llenará dinámicamente con JavaScript -->
                        </div>
                    </div>

                    <!-- Campo: Monto (sin cambios) -->
                    <div class="mb-3">
                        <label for="txtMontoCupon" class="form-label fw-bold">
                            Monto <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bx bx-dollar"></i>
                            </span>
                            <input type="text"
                                   class="form-control form-control-lg text-end"
                                   id="txtMontoCupon"
                                   name="monto"
                                   placeholder="$ 0,00"
                                   required
                                   autocomplete="off">
                        </div>
                    </div>

                </form>

            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- FOOTER -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-footer bg-light">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="bx bx-x me-1"></i>
                    Cancelar
                </button>
                <button type="button"
                        class="btn btn-golden"
                        id="btnGuardarDetalleCupon">
                    <i class="bx bx-save me-1"></i>
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Hidden fields -->
<input type="hidden" id="hdnEmpresaIdCupon" name="empresaId" />