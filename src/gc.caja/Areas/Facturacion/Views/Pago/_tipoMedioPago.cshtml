@*
    ═══════════════════════════════════════════════════════════════
    Modal de Selección de Tipo de Medio de Pago
    ═══════════════════════════════════════════════════════════════

    DESCRIPCIÓN:
    Modal para seleccionar el tipo de instrumento de pago (Efectivo, Cheque, 
    Tarjetas, Transferencias, etc.) antes de ingresar los detalles del valor.

    ✅ ACTUALIZADO v20.7: Selección con UN SOLO CLICK
    - Usuario hace click → Opción se confirma automáticamente
    - Botón "Confirmar" ocultado (no es necesario)
    - Mejora UX: Elimina click extra innecesario

    INTERACCIÓN v20.7:
    - Selección por UN SOLO CLIC sobre el ítem
    - Ítem seleccionado se resalta brevemente en azul
    - Automáticamente se abre el modal específico según el tipo elegido

    EVENTOS:
    - Todos los eventos manejados en pagoFactura.js
*@

@using gc.infraestructura.Dtos
@using gc.infraestructura.Dtos.Tipos

@{
    var tiposCuentaFin = ViewBag.TiposCuentaFin as List<TipoCuentaFinDto> ?? new List<TipoCuentaFinDto>();
}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: TIPO DE MEDIO DE PAGO v20.7 -->
<!-- ═══════════════════════════════════════════════════════════════ -->

<div class="modal fade" 
     id="modalTipoMedioPago" 
     tabindex="-1" 
     role="dialog" 
     aria-labelledby="modalTipoMedioPagoLabel" 
     aria-hidden="true" 
     data-bs-backdrop="static" 
     data-bs-keyboard="false">

    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 550px;">
        <div class="modal-content modal-golden">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- HEADER -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title" id="modalTipoMedioPagoLabel">
                    <i class="bx bx-money-check-alt me-2"></i>
                    Tipo de Medio de Pago
                </h5>
                <button type="button" 
                        class="btn-close" 
                        data-bs-dismiss="modal" 
                        aria-label="Cerrar"></button>
            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- BODY -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-body p-0">

                <!-- Header de Columna -->
                <div class="bg-light border-bottom py-2 px-3">
                    <strong class="text-muted">Tipo de Pago</strong>
                </div>

                <!-- Lista de Opciones -->
                <div id="listaTiposMedioPago"
                     class="list-group list-group-flush"
                     style="max-height: 500px; overflow-y: auto;">

                    @if (tiposCuentaFin.Any())
                    {
                        @foreach (var tipo in tiposCuentaFin)
                        {
                            <div class="list-group-item list-group-item-action tipo-medio-pago-item"
                                 data-tcf-id="@tipo.tcf_id"
                                 data-tcf-desc="@tipo.tcf_desc"
                                 style="cursor: pointer; transition: all 0.2s ease;">

                                <!-- Ícono según tipo -->
                                <i class="@ObtenerIconoPorTipo(tipo.tcf_id) me-2 text-muted"></i>

                                <!-- Descripción -->
                                <span class="tipo-medio-pago-desc">@tipo.tcf_desc</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bx bx-exclamation-circle bx-lg mb-3"></i>
                            <p>No hay tipos de medio de pago configurados.</p>
                        </div>
                    }

                </div>

            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ✅ FOOTER ACTUALIZADO v20.7 -->
            <!-- Botón "Confirmar" ocultado (no necesario con selección 1-click) -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-footer bg-light">
                <button type="button" 
                        class="btn btn-secondary" 
                        data-bs-dismiss="modal">
                    <i class="bx bx-x me-1"></i>
                    Cancelar
                </button>
                
                <!-- ✅ OCULTADO v20.7: Botón confirmar (selección ahora es con 1 click) -->
                <button type="button" 
                        class="btn btn-golden d-none" 
                        id="btnConfirmarTipoMedioPago" 
                        disabled>
                    <i class="bx bx-check me-1"></i>
                    Confirmar
                </button>
            </div>

        </div>
    </div>
</div>

@functions {
    // ═══════════════════════════════════════════════════════════════
    // FUNCIÓN AUXILIAR: OBTENER ÍCONO SEGÚN TIPO
    // ═══════════════════════════════════════════════════════════════

    private string ObtenerIconoPorTipo(string tcfId)
    {
        return tcfId?.ToUpper() switch
        {
            "EF" => "bx bx-money-bill-wave",        // Efectivo
            "CH" => "bx bx-money-check",             // Cheques
            "TC" => "bx bx-credit-card",             // Tarjetas de Crédito
            "TD" => "bx bx-credit-card",             // Tarjetas de Débito
            "TB" => "bx bx-transfer",                // Transferencias Bancarias
            "MP" => "bx bx-mobile-alt",              // Mercado Pago
            "VA" => "bx bx-gift",                    // Vales
            "CP" => "bx bx-purchase-tag",            // Cupones
            "CR" => "bx bx-file-blank",              // Créditos Impositivos
            "CC" => "bx bx-receipt",                 // Cuenta Corriente
            _ => "bx bx-circle"                      // Genérico
        };
    }
}