                </div>

                <!-- Estado: Sin vales -->
                <div id="sinValesCompra" class="text-center py-5 text-muted d-none">
                    <i class="bx bx-exclamation-circle bx-lg mb-3"></i>
                    <p>No hay vales de compra disponibles.</p>
                </div>

            </div>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- FOOTER -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <div class="modal-footer bg-light">
                <button type="button" 
                        class="btn btn-secondary" 
                        data-bs-dismiss="modal">
                    <i class="bx bx-x me-1"></i>
                    Cancelar
                </button>
                <button type="button" 
                        class="btn btn-golden" 
                        id="btnConfirmarValeCompra" 
                        disabled>
                    <i class="bx bx-check me-1"></i>
                    Confirmar
