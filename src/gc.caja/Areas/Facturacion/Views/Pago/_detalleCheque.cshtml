@*
    ═══════════════════════════════════════════════════════════════
    Modal de Detalle - Cheque
    ═══════════════════════════════════════════════════════════════

    ✅ ACTUALIZADO v24.4 - CORRECCIÓN CRÍTICA: InputMask removido
    
    CAMBIOS v24.4:
    - Input de monto SIN InputMask (conflicto con teclado digital)
    - Formato minimalista: type="text" + inputmode="decimal"
    - Parseo manual en JavaScript con parseFloat()
    - Validación nativa HTML5
    
    PROBLEMA RESUELTO:
    - Teclado digital escribía números al revés (327 → 723)
    - InputMask interfería con el orden de entrada de dígitos
*@

<div class="modal fade"
     id="modalDetalleCheque"
     tabindex="-1"
     role="dialog"
     aria-labelledby="modalDetalleChequeLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-dialog-centered modal-dialog-elevated" role="document" style="max-width: 650px;">
        <div class="modal-content modal-golden">

            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title" id="modalDetalleChequeLabel">
                    <i class="bx bx-receipt me-2"></i>
                    Detalle - Cheque
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <form id="formDetalleCheque">

                    <!-- Información del Tipo e Instrumento -->
                    <div class="alert alert-info d-flex align-items-center mb-3">
                        <i class="bx bx-info-circle me-2"></i>
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong id="lblTipoMedioPagoCheque">-</strong>
                                    <span class="mx-2">|</span>
                                    <span id="lblInstrumentoCheque">-</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Campo: Banco -->
                    <div class="mb-3">
                        <label for="selectBancoCheque" class="form-label fw-bold">
                            <i class="bx bx-buildings"></i> Banco <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-golden text-white">
                                <i class="bx bx-buildings"></i>
                            </span>
                            <select class="form-select"
                                    id="selectBancoCheque"
                                    name="bancoId"
                                    required
                                    disabled>
                                <option value="" disabled selected>Cargando bancos...</option>
                            </select>
                        </div>
                        <small class="form-text text-muted">
                            <i class="bx bx-info-circle"></i> Seleccione el banco emisor del cheque
                        </small>
                    </div>

                    <!-- Campo: Nro Cheque -->
                    <div class="mb-3">
                        <label for="txtNroCheque" class="form-label fw-bold">
                            <i class="bx bx-hash"></i> Nro Cheque <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-golden text-white">
                                <i class="bx bx-hash"></i>
                            </span>
                            <input type="text"
                                   class="form-control jsteclado"
                                   id="txtNroCheque"
                                   name="numeroCheque"
                                   placeholder="Ej: 12345678"
                                   maxlength="8"
                                   required
                                   autocomplete="off"
                                   autofocus>
                        </div>
                        <small class="form-text text-muted">
                            <i class="bx bx-info-circle"></i> Número del cheque (máximo 8 dígitos)
                        </small>
                    </div>

                    <!-- Campo: Fecha -->
                    <div class="mb-3">
                        <label for="txtFechaCheque" class="form-label fw-bold">
                            <i class="bx bx-calendar"></i> Fecha de Vencimiento <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-golden text-white">
                                <i class="bx bx-calendar"></i>
                            </span>
                            <input type="date"
                                   class="form-control"
                                   id="txtFechaCheque"
                                   name="fecha"
                                   required>
                        </div>
                        <small class="form-text text-muted">
                            <i class="bx bx-info-circle"></i> Fecha de vencimiento del cheque (>= hoy, <= 365 días)
                        </small>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ✅ CAMPO MONTO CORREGIDO v24.4: SIN InputMask -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="mb-3">
                        <label for="txtMontoCheque" class="form-label fw-bold">
                            <i class="bx bx-dollar"></i> Monto <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-golden text-white">
                                <i class="bx bx-dollar"></i>
                            </span>
                            <!-- ✅ CORREGIDO v24.4: Input MINIMALISTA SIN InputMask -->
                            <input type="text"
                                   class="form-control form-control-lg text-end jsteclado jsdecimal"
                                   id="txtMontoCheque"
                                   name="monto"
                                   placeholder="0.00"
                                   inputmode="decimal"
                                   pattern="[0-9]*\.?[0-9]{0,2}"
                                   step="0.01"
                                   min="0.01"
                                   required
                                   autocomplete="off">
                        </div>
                        <small class="form-text text-muted">
                            <i class="bx bx-info-circle"></i> Importe del cheque
                        </small>
                    </div>

                </form>

            </div>

            <div class="modal-footer bg-light">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="bx bx-x me-1"></i>
                    Cancelar
                </button>
                <button type="button"
                        class="btn btn-golden"
                        id="btnGuardarDetalleCheque">
                    <i class="bx bx-save me-1"></i>
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>