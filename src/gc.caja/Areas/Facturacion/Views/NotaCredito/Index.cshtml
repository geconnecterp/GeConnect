@{
    ViewData["Title"] = "Nota de Crédito por Devolución";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">

            <div class="card shadow-sm">

                <div class="card-header bg-gradient-golden">
                    <h4 class="mb-0 text-white">
                        <i class="bx bx-undo me-1"></i>
                        Nota de Crédito por Devolución
                    </h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-success mb-4"
                         role="alert">

                        <i class="bx bx-check-circle me-1"></i>
                        <strong>Caja validada correctamente.</strong>
                        Identifique el comprobante original para iniciar la devolución.
                    </div>

                    <div id="ncDevolucionEstadoInicial">

                        <div class="row">

                            <div class="col-md-6">
                                <h5 class="mb-3">
                                    Información de Caja
                                </h5>

                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        <i class="bx bx-user me-1"></i>
                                        Usuario:
                                        <strong>@ViewBag.Usuario</strong>
                                    </li>

                                    <li class="mb-2">
                                        <i class="bx bx-store me-1"></i>
                                        Caja:
                                        <strong>@ViewBag.CajaNombre</strong>
                                    </li>

                                    <li>
                                        <i class="bx bx-time me-1"></i>
                                        Fecha:
                                        <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </li>
                                </ul>
                            </div>

                            <div class="col-md-6 mt-4 mt-md-0">

                                <div class="border rounded bg-light p-3 h-100">

                                    <h5 class="mb-3">
                                        <i class="bx bx-info-circle text-primary me-1"></i>
                                        Primer paso
                                    </h5>

                                    <p class="text-muted mb-0">
                                        El sistema validará el comprobante original,
                                        determinará el tipo de Nota de Crédito a emitir
                                        y verificará que la devolución esté habilitada.
                                    </p>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div id="ncDevolucionResumenModalidadCarga"
                         class="alert alert-info d-none mt-4 mb-0"
                         role="alert">

                        <div class="alert alert-success d-flex align-items-start"
                             role="alert">

                            <i class="bx bx-check-circle fs-3 me-3"></i>

                            <div>
                                <strong>Comprobante original validado.</strong>
                                <div class="small mt-1">
                                    La información se guardó de manera aislada para la
                                    operación de Nota de Crédito por Devolución.
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">

                            <div class="col-lg-6">
                                <div class="card border h-100">
                                    <div class="card-header bg-light">
                                        <strong>
                                            <i class="bx bx-receipt me-1"></i>
                                            Comprobante Original
                                        </strong>
                                    </div>

                                    <div class="card-body"
                                         id="ncDevolucionDatosComprobante">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="card border h-100">
                                    <div class="card-header bg-light">
                                        <strong>
                                            <i class="bx bx-file-blank me-1"></i>
                                            Nota de Crédito a Emitir
                                        </strong>
                                    </div>

                                    <div class="card-body"
                                         id="ncDevolucionDatosNc">
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@await Html.PartialAsync("_IdentificarComprobanteOrigenModal")
@await Html.PartialAsync("_SeleccionComprobanteRepetidoModal")
@await Html.PartialAsync("_ProductoDevolucion")

@section Scripts {
    <script>
        var ncDevolucionObtenerTiposUrl =
            '@Url.Action("ObtenerTiposComprobante", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionValidarComprobanteUrl =
            '@Url.Action("ValidarComprobanteOrigen", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionSeleccionarRepetidoUrl =
            '@Url.Action("SeleccionarComprobanteRepetido", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionDefinirModalidadCargaUrl =
            '@Url.Action("DefinirModalidadCargaInicial", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionCargarDetalleCompletoUrl =
            '@Url.Action("CargarDetalleCompleto", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionAgregarProductoManualUrl =
            '@Url.Action("AgregarProductoManual", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionObtenerProductosUrl =
            '@Url.Action("ObtenerProductosDevolucion", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionCancelarOperacionUrl =
            '@Url.Action("CancelarOperacion", "NotaCredito", new { area = "Facturacion" })';

        var ncDevolucionMenuCajaUrl =
            '@Url.Action("Index", "Home", new { area = "" })';

        var ncDevolucionIndexUrl =
            '@Url.Action("Index", "NotaCredito", new { area = "Facturacion" })';
    </script>

    <script src="~/js/app/ncDevolucion.js"
            asp-append-version="true">
    </script>
    <script src="~/js/app/ncDevolucionProductos.js"
            asp-append-version="true">
    </script>
}