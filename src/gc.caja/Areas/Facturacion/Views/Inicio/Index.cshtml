@{
    ViewData["Title"] = "Facturación";
    Layout = "~/Views/Shared/_Layout.cshtml";
    BusquedaProducto busquedaProducto = new();
}
@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
}
<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-gradient-golden">
                    <h4 class="mb-0 text-white">
                        <i class='bx bx-receipt'></i>
                        Módulo de Facturación
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-success" role="alert">
                        <i class='bx bx-check-circle'></i>
                        <strong>¡Bienvenido al módulo de Facturación!</strong>
                        <p class="mb-0">Los datos de la caja han sido validados correctamente.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5>Información de Caja</h5>
                            <ul class="list-unstyled">
                                <li><i class='bx bx-user'></i> Usuario: <strong>@ViewBag.Usuario</strong></li>
                                <li><i class='bx bx-store'></i> Caja: <strong>@ViewBag.CajaId</strong></li>
                                <li><i class='bx bx-time'></i> Fecha: <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong></li>
                            </ul>
                        </div>

                        @*  <div class="col-md-6">
                            <h5>Acciones Disponibles</h5>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success btn-lg">
                                    <i class='bx bx-plus-circle'></i> Nueva Factura
                                </button>
                                <button class="btn btn-primary btn-lg">
                                    <i class='bx bx-search'></i> Consultar Facturas
                                </button>
                                <button class="btn btn-secondary btn-lg">
                                    <i class='bx bx-arrow-back'></i> Volver al Menú
                                </button>
                            </div>
                        </div> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@await Html.PartialAsync("_IdentificarClienteModal")
@await Html.PartialAsync("_ClienteUpdate")
@await Html.PartialAsync("~/Areas/Facturacion/Views/ProductoFact/_productoFactura.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/ProductoFact/_busquedaAdvanceV02.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/ProductoFact/_productoFacturaCalculo.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/shared/_cambiarListaPreciosModal.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/shared/_prefacturaModal.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/shared/_cotizacionModal.cshtml")
@await Html.PartialAsync("~/Areas/Facturacion/Views/pago/_pagoModal.cshtml")

@section Scripts {
    <script>
        // ✅ CRÍTICO: Lista de precios por defecto
        // ⚠️ TODO: Obtener dinámicamente según cliente/caja
        var admLp_id = "001"; // Lista de precios por defecto (Mayorista)
         //parapaginacion
        let totalRegs = 0;
        let pagRegs = 0;
        let pags = 0;
        let pagina = 1;
        let funcCallBack = null;
        var dataBak = {};
        var dataBakV02 = {};
        // ═══════════════════════════════════════════════════════════
        // ✅ URLs DEL BACKEND (JavaScript Global Variables)
        // ═══════════════════════════════════════════════════════════

        // URLs de Cliente
        var BuscarClienteUrl = '@Url.Action("BuscarCliente", "Cliente", new { area = "Facturacion" })';
        var TraerGrillaClientesUrl = '@Url.Action("TraerGrillaClientes", "Cliente", new { area = "Facturacion" })';
        var LimpiarSesionClientesUrl = '@Url.Action("LimpiarSesionClientes", "Cliente", new { area = "Facturacion" })';
        var ObtenerClienteActualUrl = '@Url.Action("ObtenerClienteActual", "Cliente", new { area = "Facturacion" })';
        var ActualizarConsumidorFinalUrl = '@Url.Action("ActualizarConsumidorFinal", "Cliente", new { area = "Facturacion" })';
        var ObtenerProductoDatosUrl = '@Url.Action("ObtenerProductoDatos", "ProductoFact", new { area = "Facturacion" })';
        // URLs de Menú
        var MenuCajaUrl = '@Url.Action("Index", "Home", new { area = "" })';

        //funcionalidad busqueda avanzada controlador común
        let productoBase = null; //se hidrata en busquedas.
        let p_id_selected = "";
        let funcionBusquedaAvanzada = true;
        let busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun" })";
        let busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzadaV02", "ProductoFact", new { area = "Facturacion" })";

        // ✅ NUEVO: URL para calcular filas

        var CalcularFilasUrl = '@Url.Action("CalcularFilas", "ProductoFact", new { area = "Facturacion" })';
        var ObtenerPreFacturasUrl = '@Url.Action("ObtenerPreFacturas", "ProductoFact", new { area = "Facturacion" })';
        var CargarPreFacturaUrl = '@Url.Action("CargarPreFactura", "ProductoFact", new { area = "Facturacion" })';
        var ObtenerProductosDatosPrefacturaUrl = '@Url.Action("ObtenerProductosDatosPrefactura", "ProductoFact", new { area = "Facturacion" })'; // ← NUEVA


        var ObtenerCotizacionesUrl = '@Url.Action("ObtenerCotizaciones", "ProductoFact", new { area = "Facturacion" })';
        var CargarCotizacionUrl = '@Url.Action("CargarCotizacion", "ProductoFact", new { area = "Facturacion" })';

        var DiferirFacturaUrl =  '@Url.Action("DiferirFactura", "ProductoFact", new { area = "Facturacion" })';
        var DiferirPagoUrl = '@Url.Action("DiferirPago", "ProductoFact", new { area = "Facturacion" })';

         var EliminarProductoBackupUrl = '@Url.Action("EliminarProductoBackup", "ProductoFact", new { area = "Facturacion" })';

    </script>
    <script src="~/js/plugins/jquery.simplePagination.js"></script>

    <!-- Módulo de gestión de reportes v10.0 -->
    <!-- ✅ CRÍTICO: Cargar PRIMERO el módulo de reportes -->
    <script src="~/js/app/reportes.js" asp-append-version="true"></script>

    <script src="~/js/app/busquedas.js" asp-append-version="true"></script>
    <script src="~/js/app/busquedasV02.js" asp-append-version="true"></script>

    <script src="~/js/app/prodfactcalc.js" asp-append-version="true"></script>
    <script src="~/js/app/prodfact.js" asp-append-version="true"></script>

    <script src="~/js/app/fact.js" asp-append-version="true"></script>

    <script src="~/js/app/factListaPrecio.js" asp-append-version="true"></script>
    <script src="~/js/app/factPreFactura.js" asp-append-version="true"></script>
    <script src="~/js/app/factCotizacion.js" asp-append-version="true"></script>
    <script src="~/js/app/pagoFactura.js" asp-append-version="true"></script>



    <script>
        // ════════════════════════════════════════════════════════════
        // ✅ SCRIPT DE DIAGNÓSTICO - REMOVER EN PRODUCCIÓN
        // ════════════════════════════════════════════════════════════
        $(document).ready(function() {
            console.log('═══════════════════════════════════════════════════');
            console.log('🔍 DIAGNÓSTICO DE MÓDULOS CARGADOS');
            console.log('═══════════════════════════════════════════════════');

            // Verificar jQuery
            console.log(`jQuery: ${typeof jQuery !== 'undefined' ? '✅ Cargado' : '❌ NO cargado'}`);
            if (typeof jQuery !== 'undefined') {
                console.log(`   Versión: ${jQuery.fn.jquery}`);
            }

            // Verificar Bootstrap
            console.log(`Bootstrap: ${typeof bootstrap !== 'undefined' ? '✅ Cargado' : '❌ NO cargado'}`);
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                console.log(`   Bootstrap Modal: ✅ Disponible`);
            }

            // Verificar módulos de facturación
            const modulos = [
                'ModuloReportes',
                'PagoFactura',
                'procesarPagoFactura',
                'abrirModalCalculoFactura'
            ];

            modulos.forEach(modulo => {
                const existe = typeof window[modulo] !== 'undefined';
                console.log(`${modulo}: ${existe ? '✅ Disponible' : '❌ NO disponible'}`);

                if (existe && typeof window[modulo] === 'object') {
                    console.log(`   Métodos:`, Object.keys(window[modulo]));
                }
            });

            // Verificar existencia del modal en el DOM
            const $modalPago = $('#modalPago');
            console.log(`#modalPago en DOM: ${$modalPago.length > 0 ? '✅ Encontrado' : '❌ NO encontrado'}`);

            if ($modalPago.length > 0) {
                console.log(`   Clases: ${$modalPago.attr('class')}`);
                console.log(`   Backdrop: ${$modalPago.data('bs-backdrop')}`);
            }

            console.log('═══════════════════════════════════════════════════');
        });
    </script>
}
