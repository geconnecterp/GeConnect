@using gc.infraestructura.Dtos.Cajas.Response
@model CalculaFilasResDto

<!-- ✅ Modal Cálculo de Factura - TEMA GOLDEN MEJORADO v2.1 -->
<div class="modal fade modal-golden" id="modalCalculoFactura" tabindex="-1" aria-labelledby="modalCalculoFacturaLabel" 
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ✅ HEADER CON DATOS DEL CLIENTE (VISTA PARCIAL) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            @{
                ViewData["SufijoId"] = "Calc";
                ViewData["MostrarTipoComprobante"] = true;
                ViewData["TipoComprobanteTexto"] = "FACTURA A";
            }
            @await Html.PartialAsync("_datosClienteComun")

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- BODY -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="modal-body p-4">
                <div class="row">
                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- SECCIÓN IZQUIERDA: Conceptos -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <div class="col-md-8">
                        <!-- ╔══════════════════════════════════════════════╗ -->
                        <!-- ║  TABLA DE CONCEPTOS - GOLDEN                 ║ -->
                        <!-- ╚══════════════════════════════════════════════╝ -->
                        <div class="card card-golden shadow-sm">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class='bx bx-list-ul'></i> Detalle de Conceptos
                                </h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive table-calc-conceptos">
                                    <table class="table table-golden table-hover mb-0" id="tbConceptosCalculo">
                                        <thead class="table-golden-header sticky-top-modal-calc">
                                            <tr>
                                                <th class="text-start" style="width: 60%;">Concepto</th>
                                                <th class="text-end" style="width: 40%;">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyConceptosCalculo">
                                            <!-- Las filas se cargarán dinámicamente desde el JSON -->
                                            <tr>
                                                <td colspan="2" class="text-center text-muted py-4">
                                                    <i class='bx bx-loader-alt bx-spin'></i> Cargando conceptos...
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="table-golden-footer fw-bold">
                                            <tr class="total-row-golden">
                                                <td class="text-start fs-4 fw-bold">TOTAL</td>
                                                <td class="text-end text-success fw-bold total-final-calc" id="tdTotalFinal">$ 0.00</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- SECCIÓN DERECHA: Sorteos -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <div class="col-md-4">
                        <div class="card card-golden shadow-sm h-100">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class='bx bx-gift'></i> Sorteos
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive table-calc-sorteos">
                                    <table class="table table-golden table-sm table-borderless mb-0" id="tbSorteos">
                                        <tbody id="tbodySorteos">
                                            <!-- Las filas se cargarán dinámicamente desde el JSON -->
                                            <tr>
                                                <td class="text-center text-muted py-4">
                                                    <i class='bx bx-info-circle'></i> No hay sorteos disponibles
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- FOOTER MEJORADO CON 3 BOTONES GOLDEN -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="modal-footer bg-light footer-calc-factura">
                <div class="d-flex justify-content-between align-items-center w-100 gap-3">
                    
                    <!-- ✅ Botón VOLVER (a la izquierda) -->
                    <button type="button" class="btn btn-secondary btn-lg" id="btnVolverCalculoFactura">
                        <i class='bx bx-arrow-back'></i> VOLVER
                    </button>

                    <!-- ✅ Grupo de botones de acción (a la derecha) -->
                    <div class="d-flex gap-3 botones-accion-calc">
                        <!-- ✅ Botón Diferir Pago (Golden) -->
                        <button type="button" 
                                class="btn btn-golden btn-lg" 
                                id="btnDiferirPago" 
                                title="Diferir o anticipar el pago">
                            <i class='bx bx-time-five'></i> Diferir Pago
                        </button>

                        <!-- ✅ Botón Diferir Factura (Golden) -->
                        <button type="button" 
                                class="btn btn-golden btn-lg" 
                                id="btnDiferirFactura" 
                                title="Guardar factura para pago posterior">
                            <i class='bx bx-save'></i> Diferir Factura
                        </button>

                        <!-- ✅ Botón PAGAR (Verde Success - más prominente) -->
                        <button type="button" class="btn btn-success btn-lg px-5" id="btnPagarFactura">
                            <i class='bx bx-dollar-circle'></i> PAGAR
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

