@*
    ============================================
    MODAL: SELECCIÓN DE PRODUCTO
    ============================================
    Se muestra cuando hay múltiples productos encontrados
    Permite seleccionar uno para agregarlo a la factura
    ✅ Productos con respuesta != 0 se muestran deshabilitados
*@

<!-- ====== MODAL SELECCIÓN DE PRODUCTO ====== -->
<div class="modal fade" 
     id="modalSeleccionProducto" 
     data-bs-backdrop="static" 
     data-bs-keyboard="false" 
     tabindex="-1" 
     aria-labelledby="modalSeleccionProductoTitle" 
     aria-hidden="true">
    
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            
            <!-- ====== HEADER ====== -->
            <div class="modal-header bg-gradient-golden">
                <h5 class="modal-title text-white" id="modalSeleccionProductoTitle">
                    <i class='bx bx-package'></i>
                    SELECCIONAR PRODUCTO
                </h5>
                <button type="button" 
                        class="btn-close btn-close-white" 
                        data-bs-dismiss="modal" 
                        aria-label="Close">
                </button>
            </div>

            <!-- ====== BODY ====== -->
            <div class="modal-body p-3">
                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class='bx bx-info-circle bx-lg me-2'></i>
                    <div>
                        <strong>Se encontraron múltiples productos.</strong><br>
                        <small>Seleccione el producto que desea agregar a la factura. Los productos no disponibles aparecen deshabilitados.</small>
                    </div>
                </div>

                <!-- Tabla de productos -->
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-golden-header sticky-top">
                            <tr>
                                <th style="width: 10%;">Código</th>
                                <th style="width: 12%;">Cód. Barras</th>
                                <th style="width: 35%;">Descripción</th>
                                <th class="text-center" style="width: 8%;">Unid. Pres.</th>
                                <th class="text-end" style="width: 10%;">Precio Unit.</th>
                                <th class="text-center" style="width: 15%;">Estado</th>
                                <th class="text-center" style="width: 10%;">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tbodySeleccionProducto">
                            <!-- Se llena dinámicamente desde JavaScript -->
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">
                                    <i class='bx bx-loader-alt bx-spin bx-lg'></i>
                                    <p class="mb-0 mt-2">Cargando productos...</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ====== FOOTER ====== -->
            <div class="modal-footer bg-light">
                <button type="button" 
                        class="btn btn-secondary" 
                        data-bs-dismiss="modal">
                    <i class='bx bx-x'></i> Cancelar
                </button>
            </div>

        </div>
    </div>
</div>