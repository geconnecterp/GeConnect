@model List<ProductoListaDto>

<div class="modal modal-golden" 
    id="busquedaModal" 
    tabindex="-1" 
    role="dialog" 
    aria-labelledby="buscTitulo" 
    aria-hidden="true" 
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    style="z-index: 999999;">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            
            <!-- ✅ HEADER COMPACTO -->
            <div class="modal-header py-2">
                <h5 class="modal-title mb-0" id="buscTitulo">
                    <i class="bx bx-search-alt me-2"></i>
                    Búsqueda de Productos
                </h5>
                <button type="button" 
                        class="btn-close buscAdv" 
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>
            
            <!-- ✅ BODY OPTIMIZADO -->
            <div class="modal-body p-2">
                
                <!-- ✅ FILTROS HIDDEN (no ocupan espacio visual) -->
                @Html.Hidden("chkActivos", true)
                @Html.Hidden("chkDisc", false)
                @Html.Hidden("chkInact", false)
                
                <!-- ✅ BARRA DE BÚSQUEDA COMPACTA -->
                <div class="bg-golden-search p-2 rounded mb-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-9">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-golden text-white border-0">
                                    <i class="bx bx-search"></i>
                                </span>
                                <input type="text" 
                                       class="form-control form-control-sm inputEditable jsteclado" 
                                       name="Search" 
                                       id="Search" 
                                       placeholder="Código, descripción o código de barras..." 
                                       autofocus />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button type="button" 
                                    class="btn btn-golden btn-sm w-100" 
                                    id="btnBuscarProd">
                                <i class="bx bx-search me-1"></i>
                                Buscar
                                <span id="spnBuscarProd" 
                                      class="spinner-border spinner-border-sm ms-2 d-none" 
                                      role="status" 
                                      aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ✅ GRID COMPACTO (sin card wrapper extra) -->
                <div class="border border-golden rounded">
                    <div id="divBusquedaAvanzada" class="p-0">
                        <!-- Aquí se carga el grid dinámicamente -->
                        <div class="text-center text-muted py-3">
                            <i class="bx bx-info-circle me-2"></i>
                            Ingrese un criterio de búsqueda
                        </div>
                    </div>
                    @Html.Hidden("pagEstado", false)
                </div>

                <!-- ✅ PAGINACIÓN COMPACTA -->
                <div class="mt-2">
                    <div id="divPaginacionAdv" class="d-flex justify-content-center"></div>
                </div>
            </div>
        </div>
    </div>
</div>
