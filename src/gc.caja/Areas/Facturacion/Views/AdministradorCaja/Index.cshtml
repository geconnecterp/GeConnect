@{
    ViewData["Title"] = "Administrador de Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="~/css/pages/reimpresion-z.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/administrador-caja.css" asp-append-version="true" />
}
<section class="rz-page" aria-labelledby="admTitulo">
    <header class="rz-header">
        <span class="rz-icon"><i class="bx bx-shield-quarter" aria-hidden="true"></i></span>
        <div><p class="rz-eyebrow">GESTIÓN DE LA SUCURSAL</p><h1 id="admTitulo">Administrador de Caja</h1>
        <p>Habilitación, cierre general y gestión de valores de la sucursal.</p></div>
    </header>
    <div class="rz-context"><span><i class="bx bx-store-alt" aria-hidden="true"></i> Sucursal <strong>@ViewBag.Sucursal</strong></span>
        <span>Disponible sin apertura de un puesto</span></div>
    <section class="rz-card mb-3" aria-labelledby="admCustodiaTitulo">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div><h2 id="admCustodiaTitulo" class="h5 mb-1"><i class="bx bx-lock-alt" aria-hidden="true"></i> Valores en custodia</h2>
                <p class="mb-0">Prepare la entrega de rendiciones parciales y finales, revise importes y obtenga el acuse.</p></div>
            <a class="btn btn-primary" href="@Url.Action("Index", "Custodia", new { area = "Facturacion" })">Entrega de valores <i class="bx bx-chevron-right" aria-hidden="true"></i></a>
        </div>
    </section>
    <form id="admCaja" class="rz-card" data-puestos="@Url.Action("Puestos")" data-apertura="@Url.Action("Apertura")"
          data-cierre="@Url.Action("Cierre")" data-solicitud="@Guid.NewGuid()" data-sucursal="@ViewBag.Sucursal">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <div id="admSeccionApertura" class="col-12" hidden><h2 class="h5">Apertura general de cajas</h2>
                <p>Habilita la operación de la sucursal y obtiene el número de proceso de cobro. Cada cajero realiza luego la apertura de su puesto.</p>
                <button id="admAbrir" disabled type="button" class="btn btn-success"><i class="bx bx-lock-open-alt" aria-hidden="true"></i> Habilitar cajas</button>
            </div>
            <div id="admSeccionCierre" class="col-12" hidden><h2 class="h5">Cierre general de cajas</h2>
                <p>Primero deben cerrarse todos los puestos. Esta operación no reemplaza la rendición ni el cierre individual.</p>
                <button id="admCerrar" type="button" class="btn btn-danger" disabled><i class="bx bx-lock-alt" aria-hidden="true"></i> Cierre general</button>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center gap-2 my-3">
            <p id="admConsulta" class="mb-0" role="status" aria-live="polite">Consultando habilitación de la sucursal…</p>
            <button id="admActualizar" type="button" class="btn btn-outline-secondary"><i class="bx bx-refresh" aria-hidden="true"></i> Actualizar</button>
        </div>
        <section id="admSeccionPuestos" hidden aria-labelledby="admTituloPuestos">
            <h2 id="admTituloPuestos" class="h5">Puestos abiertos</h2>
            <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Cierre N.º</th><th>Punto de venta</th><th>Cajero</th></tr></thead>
                <tbody id="admPuestos"></tbody></table></div>
        </section>
        <div id="admEstado" role="status" aria-live="polite"></div>
        <div class="rz-actions"><a id="admVolver" class="btn btn-outline-secondary" href="@Url.Action("Index", "Home", new { area = "" })"><i class="bx bx-arrow-back" aria-hidden="true"></i> Volver al inicio</a></div>
    </form>
</section>
@section scripts { <script src="~/js/app/administrador-caja.js" asp-append-version="true"></script> }
