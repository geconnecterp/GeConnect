@model QueryFilters
@{
    var titulo = Model.TituloLeyend;
}

<div class="filter-golden">
    <div class="filter-golden-header mb-2">
        <h5 class="mb-0" id="tituloLegend">Filtros </h5>
    </div>
    <div class="filter-golden-body">

        @if (Model.Modelo.Equals(ModeloFilter.MEDIOS_DE_PAGO))
        {
            var list = new List<ComboGenDto>();
            var ls03 = new SelectList(list, "Id", "Descripcion");
            <div class="row">
                <div class="col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel03" />
                            <label class="form-check-label" for="chkRel03" id="lbRel03"></label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-1">
                <div class="col-md-6" >
                    <div class="input-group input-group-sm" id="divLs03">
                        <span class="input-group-text">Nombre</span>
                        @Html.DropDownListFor(m => m.Tipo, ls03, "Seleccionar", new { @id = "listaLs03", disabled = "disabled", @class = "form-control inputEditable activable" })
                    </div>
                </div>
                <div class="col-sm-6">
                    @Html.ListBox("Rel03List", null, new { @class = "form-control", @disabled = "disabled" })
                </div>
            </div>
            <div class="row  mb-3 mt-1">
                <div class=" col-md-4 col-sm-12">
                    <div class="d-flex align-items-center">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDescr" />
                            <label class="form-check-label" for="chkDescr" id="lbChkDescr"></label>
                        </div>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" id="lbDescr">Descr:</span>
                        <input type="text" class="form-control inputEditable" asp-for="Buscar" placeholder="Ingresar descripción a buscar" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                    </div>
                </div>
                <div class=" col-sm-8">
                    <div class="row">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
                                <label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
                            </div>
                        </div>
                        <div class=" col-sm-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text" id="lbIdDesde">Id Desde:</span>
                                <input type="text" class="form-control inputEditable" asp-for="Id" placeholder="Ingresar Id a buscar" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                            </div>
                        </div>
                        <div class=" col-sm-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text" id="lbIdHasta">Id Hasta:</span>
                                <input type="text" class="form-control inputEditable" asp-for="Id2" placeholder="Ingresar otro Id (no obligatorio)" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.Modelo.Equals(ModeloFilter.ETIQUETA))
        {
            <div class="row mb-1 mt-1">
                <div class="col-12">
                    <label class="text-danger">La selección de los criterios son independientes entre sí.</label>
                </div>
            </div>
            <div class="row  mb-1 mt-1">
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkTipoEtiq" checked readonly />
                            <label class="form-check-label" for="chkTipoEtiq" id="lbTipoEtiq">Tipo de Etiqueta</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Tipo</span>
                        @Html.DropDownList("TipoEtiqueta", null, new { @class = "form-control", style = "width:50px;" })
                    </div>
                </div>
            </div>

            <div class="row  mb-1 mt-1">
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkSinImprimir" />
                            <label class="form-check-label" for="chkSinImprimir" id="lbSinImprimir">Sin Imprimir</label>
                        </div>
                    </div>
                </div>
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkOferta" />
                            <label class="form-check-label" for="chkOferta" id="lbOferta">Oferta</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row  mb-1 mt-1">
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkCargaPrevia" checked readonly />
                            <label class="form-check-label" for="chkCargaPrevia" id="lbCargaPrevia"></label>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Carga Previa</span>
                        @Html.DropDownList("CargaPrevia", null, "Seleccionar...", new { @class = "form-control", style = "width:50px;" })
                    </div>
                </div>
            </div>
        }


        @if (Model.Modelo.Equals(ModeloFilter.D_IMPOSITIVO))
        {
            <div class="row  mb-1 mt-1">
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkCondIva" checked />
                            <label class="form-check-label" for="chkCondIva" id="lbCondIva">Condición IVA</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"></span>
                        @Html.DropDownList("CondicionIva", null, "Seleccionar...", new { @class = "form-control", style = "width:50px;" })
                    </div>
                </div>
            </div>
            <div class="row  mb-1 mt-1">
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkAlicIva" disabled />
                            <label class="form-check-label" for="chkAlicIva" id="lbAlicIva">Alicuota IVA</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"></span>
                        @Html.DropDownList("AlicuotaIva", null, "Seleccionar...", new { @class = "form-control", style = "width:50px;" })
                    </div>
                </div>
            </div>
            <div class="row  mb-1 mt-1">
                <div class=" col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkConII" />
                            <label class="form-check-label" for="chkConII" id="lbConII">Con Impuesto Interno</label>
                        </div>
                    </div>
                </div>
            </div>
        }


        @if (Model.Rel01 != null && Model.Modelo.Equals(ModeloFilter.ORDEN_DE_COMPRA))
        {
            <div class="row  mb-1 mt-1">
                <div class=" col-md-6 col-sm-12">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel01" />
                            <label class="form-check-label" for="chkRel01" id="lbRel01"></label>
                        </div>
                    </div>
                    <div class="input-group  input-group-sm">
                        <span class="input-group-text">Nombre</span>
                        <input type="text" class="form-control inputEditable" name="Rel01" id="Rel01" disabled />
                        @Html.Hidden("Rel01Item")
                    </div>
                </div>
                <div class=" col-sm-6" id="divLstOcPendiente">
                </div>
            </div>
        }


        @if (Model.Modelo.Equals(ModeloFilter.ORDEN_DE_PAGO_DIRECTA))
        {
            <div class=" col-sm-6" id="divLstTipoOrdenDePago">
            </div>
        }
        else if (Model.Modelo.Equals(ModeloFilter.PROMO_COMBO) ||
        Model.Modelo.Equals(ModeloFilter.OF_REPORTE))
        {
            <div class="row mb-3">
                <div class="col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkTipo" checked />
                            <label class="form-check-label" for="chkTipo" id="lbTipo"></label>
                        </div>
                    </div>
                </div>
          
                <div class=" col-md-4 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Tipo</span>
                        @Html.DropDownListFor(x => x.Tipo, null, "Seleccionar...", new { @class = "form-control", style = "width:50px;" })
                    </div>
                </div>
            </div>
            
            @if (!Model.Modelo.Equals(ModeloFilter.OF_REPORTE))
            {
                <div class="row mb-3">
                    <div class="col-md-2 col-sm-6 ">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkEstado" checked />
                                <label class="form-check-label" for="chkTipo" id="lbTipo"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Estado</span>
                            @Html.DropDownListFor(x => x.Estado, null, "Seleccionar...", new { @class = "form-control", style = "width:50px;" })
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row mb-3">
                    <div class="col-md-2 col-sm-6 ">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="radio" name="ofrepo" id="rbOferta" value="1" checked />
                                <label class="form-check-label" for="rbOferta" id="lbOferta">Oferta</label>
                            </div>
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="radio" name="ofrepo" id="rbCombo" value="2"/>
                                <label class="form-check-label" for="rbCombo" id="lbCombo">Combos</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @*AGREGAR SECCION FECHA*@
        
        
        @if (Model.Modelo.Equals(ModeloFilter.ORDEN_DE_COMPRA_CONSULTA) ||
                Model.Modelo.Equals(ModeloFilter.PRESUPUESTO) ||
                Model.Modelo.Equals(ModeloFilter.ETIQUETA) ||
                Model.Modelo.Equals(ModeloFilter.PRECIO_LISTA) ||
                Model.Modelo.Equals(ModeloFilter.MODIF_PRECIO) ||
                Model.Modelo.Equals(ModeloFilter.PROV_SIN_MOD) ||
                Model.Modelo.Equals(ModeloFilter.ORDEN_DE_PAGO_CONSULTA) ||
                Model.Modelo.Equals(ModeloFilter.CARGA_INVENTARIO))
        {
            <div class="row mb-3 mt-3">
                <div class="col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
                            <label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
                        </div>
                    </div>
                </div>
                @*             </div>
            <div class="row mb-3"> *@
                <div class="col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" id="lbIdDesde">Desde:</span>
                        <input type="date" class="form-control inputEditable" asp-for="Date1" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                    </div>
                </div>
                @if (!Model.Modelo.Equals(ModeloFilter.PROV_SIN_MOD))
                {
                    <div class="col-md-2 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text" id="lbIdHasta">Hasta:</span>
                            <input type="date" class="form-control inputEditable" asp-for="Date2" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.Modelo.Equals(ModeloFilter.PRECIO_LISTA))
        {
            <div class="row mb-3 mt-3">
                <div class="col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkInCosto" />
                            <label class="form-check-label" for="chkInCosto" id="lbChkInCosto"></label>
                        </div>
                    </div>
                </div>
            </div>
            if (Model.Rel04 != null)
            {
                <div class="row mt-3">
                    <div class="col-sm-6">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkRel04" />
                                <label class="form-check-label" for="chkRel04" id="lbRel04">Listas de Precio</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6" id="divLs04">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text" id="lbNombreRel03">Listas</span>
                            @Html.DropDownList("Rel04", null, "Seleccionar...", new { @class = "form-control", @disabled = "disabled" })
                            @Html.Hidden("Rel04Item")
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        @Html.ListBox("Rel04List", null, new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            }
        }


        @if (!Model.Modelo.Equals(ModeloFilter.ORDEN_DE_PAGO_DIRECTA) &&
                !Model.Modelo.Equals(ModeloFilter.CONSULTAS) &&
                !Model.Modelo.Equals(ModeloFilter.ORDEN_DE_COMPRA_CONSULTA) &&
                !Model.Modelo.Equals(ModeloFilter.COMPROBANTE_DE_COMPRA) &&
                !Model.Modelo.Equals(ModeloFilter.VALORIZACION_COMPROBANTE) &&
                !Model.Modelo.Equals(ModeloFilter.ORDEN_DE_PAGO_A_PROVEEDORES) &&
                !Model.Modelo.Equals(ModeloFilter.ORDEN_DE_PAGO_CONSULTA) &&
                !Model.Modelo.Equals(ModeloFilter.MEDIOS_DE_PAGO) &&
                !Model.Modelo.Equals(ModeloFilter.ANULACION_DE_COMPROBANTE_Y_VALORIZACION) &&
                !Model.Modelo.Equals(ModeloFilter.PROMO_COMBO) &&
                !Model.Modelo.Equals(ModeloFilter.PRESUPUESTO) &&
                !Model.Modelo.Equals(ModeloFilter.RELACIONAR_COMPROBANTE_SIN_RP) &&
                !Model.Modelo.Equals(ModeloFilter.PRECIO_LISTA) &&
                !Model.Modelo.Equals(ModeloFilter.MODIF_PRECIO) &&
                !Model.Modelo.Equals(ModeloFilter.PROV_SIN_MOD) &&
                !Model.Modelo.Equals(ModeloFilter.OF_REPORTE) &&
                !Model.Modelo.Equals(ModeloFilter.D_IMPOSITIVO) &&
                !Model.Modelo.Equals(ModeloFilter.ETIQUETA) &&
                !Model.Modelo.Equals(ModeloFilter.CARGA_INVENTARIO))
        {
            <div class="row  mb-3 mt-1">
                <div class=" col-md-4 col-sm-12">
                    <div class="d-flex align-items-center">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDescr" />
                            <label class="form-check-label" for="chkDescr" id="lbChkDescr"></label>
                        </div>
                        @if (Model.Modelo.Equals(ModeloFilter.PRODUCTO_CARGA_PRECIO))
                        {
                            <div class="form-check form-switch mb-2 me-5">
                                <input class="form-check-input" type="checkbox" id="chkIncluir" @(Model.Opt1 == true ? "checked" : "")>
                                <label class="form-check-label fw-medium" for="chkIncluir">Incluir Discontinuos</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkFile" @(Model.Opt2 == true ? "checked" : "")>
                                <label class="form-check-label fw-medium" for="chkFile">Archivo</label>
                            </div>
                        }
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" id="lbDescr">Descr:</span>
                        <input type="text" class="form-control inputEditable" asp-for="Buscar" placeholder="Ingresar descripción a buscar" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                    </div>
                </div>
                <div class=" col-sm-8">
                    <div class="row">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
                                <label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
                            </div>
                        </div>
                        <div class=" col-sm-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text" id="lbIdDesde">Id Desde:</span>
                                <input type="text" class="form-control inputEditable" asp-for="Id" placeholder="Ingresar Id a buscar" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                            </div>
                        </div>
                        <div class=" col-sm-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text" id="lbIdHasta">Id Hasta:</span>
                                <input type="text" class="form-control inputEditable" asp-for="Id2" placeholder="Ingresar otro Id (no obligatorio)" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        
        @if (Model.Modelo.Equals(ModeloFilter.PLAN_CUENTA))
        {
            var list = new List<ComboGenDto> {
                new ComboGenDto { Id = "%", Descripcion = "TODOS" },
                new ComboGenDto { Id = "1", Descripcion = "ACTIVO" },
                new ComboGenDto { Id = "2", Descripcion = "PASIVO" },
                new ComboGenDto { Id = "3", Descripcion = "PATRIMONIO" },
                new ComboGenDto { Id = "4", Descripcion = "INGRESOS" },
                new ComboGenDto { Id = "5", Descripcion = "EGRESOS" },
                };
            var tipo = new SelectList(list, "Id", "Descripcion");
            <div class="row mb-3">
                <div class="col-md-2 col-sm-6">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkTipo" checked />
                            <label class="form-check-label" for="chkTipo" id="lbTipo"></label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class=" col-md-4 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Activo</span>
                        @Html.DropDownListFor(x => x.Tipo, @tipo, new { @class = "form-control", style = "width:50px;" })
                    </div>
                </div>
            </div>
        }


        @*---------------------------BUSQUEDA DE PROVEEDORES---------------------------*@


        @if (Model.Rel01 != null &&
                !Model.Modelo.Equals(ModeloFilter.ORDEN_DE_COMPRA) &&
                !Model.Modelo.Equals(ModeloFilter.VALORIZACION_COMPROBANTE) &&
                !Model.Modelo.Equals(ModeloFilter.PLAN_CUENTA) &&
                !Model.Modelo.Equals(ModeloFilter.MEDIOS_DE_PAGO) &&
                !Model.Modelo.Equals(ModeloFilter.ORDEN_DE_PAGO_DIRECTA) &&
                !Model.Modelo.Equals(ModeloFilter.CARGA_INVENTARIO))
        {
            if (Model.Modelo.Equals(ModeloFilter.PRESUPUESTO) ||
            Model.Modelo.Equals(ModeloFilter.ETIQUETA))
            {
                <div class="row">
                    <div class="col-md-6 col-sm-6">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel011" />
                                <label class="form-check-label" for="chkRel011" id="lbRel011"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-sm-6" id="divLs01">
                        <div class="input-group  input-group-sm">
                            <span class="input-group-text">Nombre</span>
                            <input type="text" class="form-control inputEditable" name="Rel011" id="Rel011" disabled />
                            @Html.Hidden("Rel011Item")
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        @Html.ListBox("Rel011List", null, new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            }
            else
            {
                <div class="row mb-3 mt-3">
                    <div class="col-md-2 col-sm-6">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel01" />
                                <label class="form-check-label" for="chkRel01" id="lbRel01"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-sm-6" id="divLs01">
                        <div class="input-group  input-group-sm">
                            <span class="input-group-text">Nombre</span>
                            <input type="text" class="form-control inputEditable" name="Rel01" id="Rel01" disabled />
