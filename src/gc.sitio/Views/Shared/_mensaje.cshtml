<!-- Modal de Mensajes -->
<div class="modal" id="msjModal" tabindex="-1" aria-labelledby="msjTitulo" 
     data-bs-keyboard="false" data-bs-backdrop="static"
     style="z-index: 999999;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- Encabezado del mensaje -->
            <div id="msjHeader" class="modal-header">
                <span id="msjIcono" style="margin-top: -2px; margin-right: 5px;"></span>
                <h5 id="msjTitulo" class="modal-title">¡Atención!</h5>
                <button type="button" class="btn-close" onclick="AceptarMensaje('NO');" aria-label="Cerrar"></button>
            </div>
            <!-- Contenido del mensaje -->
            <div id="msjContenido" class="modal-body">
            </div>
            <!-- Botones del mensaje -->
            <div class="modal-footer">
                <button id="btnMensajeAceptar" type="button" class="btn btn-primary">Aceptar</button>
                <button id="btnMensajeAlternativa" type="button" class="btn btn-info">Otro</button>
                <button id="btnMensajeCancelar" type="button" class="btn btn-secondary" 
                        data-bs-dismiss="modal" onclick="CerrarMensaje('NO');">Cancelar</button>
            </div>
        </div>
    </div>
</div>