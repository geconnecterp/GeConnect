@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
@section styles {
    <link rel="stylesheet" href="~/css/modules/iva-compras-cierre.css" asp-append-version="true" />
}
<section id="iva-compras-cierre" class="container-fluid" data-estado="@Url.Action("Estado")" data-cerrar="@Url.Action("Cerrar")" data-descarga="@Url.Action("Rg3685")" data-disponible="@(ViewBag.Error == null ? "true" : "false")">
    <form id="icc-token" hidden>@Html.AntiForgeryToken()</form>
    <nav class="icc-toolbar" aria-label="Acciones del cierre IVA Compras">
        <button id="icc-actualizar" type="button" class="btn btn-primary btn-sm" disabled><i class="bx bx-refresh" aria-hidden="true"></i> Actualizar</button>
        <a id="icc-salir" href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-secondary btn-sm"><i class="bx bx-exit" aria-hidden="true"></i> Salir</a>
        <div class="icc-main-actions">
            <button id="icc-rg" type="button" class="btn btn-primary btn-sm" disabled><i class="bx bx-download" aria-hidden="true"></i> Descargar RG 3685</button>
            <button id="icc-cerrar" type="button" class="btn btn-warning btn-sm" disabled><i class="bx bx-lock-alt" aria-hidden="true"></i> Cerrar IVA</button>
        </div>
    </nav>
    @if (ViewBag.Error != null) { <div class="alert alert-warning" role="alert">@ViewBag.Error</div> }
    <div id="icc-mensaje" role="status" aria-live="polite"></div>
    <div id="icc-contenido">
        <div id="icc-resultado"></div>
        <div id="icc-esperando" role="status" aria-live="polite" hidden>
            <span class="spinner-border" aria-hidden="true"></span><span id="icc-espera-texto"></span>
        </div>
    </div>
    <p class="icc-download-help">RG 3685 descarga un ZIP con Cabecera y Detalle completos del período seleccionado. Puede demorar. Los archivos se generan con los comprobantes actuales.</p>
    <div id="icc-confirmacion" class="modal fade" tabindex="-1" aria-labelledby="icc-confirmacion-titulo" aria-describedby="icc-confirmacion-texto" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h2 id="icc-confirmacion-titulo" class="modal-title fs-5"><i class="bx bx-error-circle" aria-hidden="true"></i> Confirmar cierre de IVA Compras</h2></div>
            <div class="modal-body">
                <p id="icc-confirmacion-texto">Vas a registrar el cierre del libro correspondiente al período <strong id="icc-periodo-confirmar"></strong>.</p>
                <p>Verificá que la revisión de sus comprobantes e importes esté finalizada antes de continuar.</p>
                <p>Esta pantalla no permite deshacer el cierre. El procedimiento también admite períodos sin movimientos.</p>
                <p class="icc-confirm-note">Al completar el cierre se actualizará el historial y quedará disponible el próximo período.</p>
            </div>
            <div class="modal-footer">
                <button id="icc-cancelar" type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
                <button id="icc-confirmar" type="button" class="btn btn-warning"><i class="bx bx-lock-alt" aria-hidden="true"></i> Confirmar cierre</button>
            </div>
        </div></div>
    </div>
</section>
@section scripts {
    <script src="~/js/app/libros/iva-compras-cierre.js" asp-append-version="true"></script>
}

