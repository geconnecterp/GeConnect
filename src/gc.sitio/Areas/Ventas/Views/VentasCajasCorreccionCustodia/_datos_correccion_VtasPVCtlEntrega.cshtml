@model GridCoreSmart<VtasPVCtlEntregaDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#tbVtasPVCtlEntrega thead th {
		text-align: center !important;
		vertical-align: middle !important;
		white-space: nowrap;
	}
</style>
<div class="table-responsive table-wrapper-500">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbVtasPVCtlEntrega">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="text-center" style="width: 40px;">
					<input type="checkbox" id="chkSelectAll" />
				</th>
				<th class="text-center">Sucursal</th>
				<th class="text-center">Entrega</th>
				<th class="text-center" title="Comprobante de Retiro">Comp. de Ret.</th>
				<th class="text-center" title="Fecha de Retiro">Fec. de Ret.</th>
				<th class="text-center">Estado</th>
				<th class="text-center">Importe</th>
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="7" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-entrega"
						data-ent-compte="@item.ent_compte"
						data-ent-estado="@item.ent_estado"
						data-ent-actu="@item.ent_actu"
						data-ent-actu-bool="@item.ent_actu_bool"
						data-tcf-id="@item.tcf_id">
						<td class="text-center">
							<input type="checkbox" class="chkRow" />
						</td>
						<td class="text-start">@item.adm_nombre</td>
						<td class="text-center">@item.ent_fecha.ToString("dd/MM/yy")</td>
						<td class="text-center">@item.ent_compte_retiro</td>
						<td class="text-center">@item.ent_fecha.ToString("dd/MM/yy")</td> @* Consultar con carlos sobre este campo porque no viene en el SP *@
						<td class="text-start">@item.estado_desc</td>
						<td class="text-end">@GridHelper.FormatearPrecio(item.ent_importe, TipoPrecio.Venta)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="mt-3 text-center">
	<button id="btnConfirmacionContable" class="btn btn-sm btn-primary">
		<i class="bx bx-check"></i> Volver a Pendiente Entregas Seleccionadas
	</button>
</div>