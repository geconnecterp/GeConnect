@model FiltroCtlCustodiaModel
<style>
	.hidden {
		display: none !important;
	}

</style>
<div class="filter-golden w-50" style="margin-left: 25%;">
	<div class="filter-golden-body">
		<div class="row mb-3 mt-3">
			<div class="col-12">
				<div class="row">
					<div class="col-sm-12">
						<div class="input-group input-group-sm">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkSucursales" />
								<label class="form-check-label" for="chkSucursales" id="lbSucursales"></label>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Nombre</span>
							@Html.DropDownListFor(m => m.SucursalSeleccionada, Model.ListaSucursales, "Seleccionar", new { @id = "listaSucursales", disabled = "disabled", @class = "form-control inputEditable activable" })
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row mt-3">
			<div class="col-12">
				<div class="input-group input-group-sm">

					<div class="form-check form-check-inline">
						<input class="form-check-input" type="radio"
							   name="TipoEntrega" id="rbSinConfirmar" value="P" checked>
						<label class="form-check-label" for="rbSinConfirmar">
							Entregas sin Confirmar
						</label>
					</div>

					<div class="form-check form-check-inline ms-4">
						<input class="form-check-input" type="radio"
							   name="TipoEntrega" id="rbConfirmadas" value="C">
						<label class="form-check-label" for="rbConfirmadas">
							Entregas Confirmadas no Acreditadas
						</label>
					</div>

				</div>
			</div>
		</div>
		<div class="filter-golden-footer">
			<div class="row m-3">
				<div class="d-flex justify-content-around">
					<button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializa</button>
					<button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
				</div>
			</div>
		</div>
	</div>
</div>
