@model InitializeViewCusModel
@{
}
@Html.Hidden("TipoEntrega", Model.TipoEntrega)
<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="row mb-1">
		<div class="col-12">
			<div class="p-1 border rounded bg-light">
				<div class="d-flex justify-content-between align-items-center flex-wrap">
					<div class="d-flex flex-wrap gap-4">

						<div><strong>Sucursal:</strong> @Model.Sucursal</div>

					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-md-5" style="padding-right: 0px;">
			<div class="card mb-3">
				<div class="card-header fw-bold">Entregas en Custodia</div>
				<div class="card-body p-2">
					<div id="divVtasPVCtlCierres">
						@Html.Partial("_datos_correccion_VtasPVCtlEntrega", Model.GrillaVtasPVCtlEntrega)
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-7" style="padding-right: 0px;padding-left: 5px;">
			<div class="card mb-3">
				<div class="card-header fw-bold">Rendiciones</div>
				<div class="card-body p-2">
					<div id="divVtasPVCtlRend">
						@Html.Partial("_datos_correccion_VtasPVCtlEntregaRend", Model.GrillaVtasPVCtlEntregaRend)
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
