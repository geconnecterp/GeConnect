@model SorteoCargaDatosDto

<div id="divSorteoDatos" class="card mb-2">
	<div class="card-header py-1">
		<h6 class="mb-0">Datos del Pedido</h6>
	</div>
	<div class="card-body p-2">
		<div class="row g-2">
			<div class="row">
				<div class="col-md-2">
					<label for="so_sorteo" class="form-label form-label-sm mb-1">ID</label>
					<input type="text" class="form-control form-control-sm" id="so_sorteo" name="so_sorteo"
						   value="@Model?.so_sorteo" readonly />
				</div>
				<div class="col-md-10">
					<label for="so_desc" class="form-label form-label-sm mb-1">Nombre</label>
					<input type="text" class="form-control form-control-sm" id="so_desc" name="so_desc"
						   value="@Model?.so_desc" readonly />
				</div>
			</div>
			<div class="row">
				<div class="col-md-3">
					<label for="so_desde" class="form-label form-label-sm mb-1">Desde</label>
					<input type="date" class="form-control form-control-sm" id="so_desde" name="so_desde"
						   value="@Model?.so_desde.ToString("yyyy-MM-dd")" readonly />
				</div>
				<div class="col-md-3">
					<label for="so_hasta" class="form-label form-label-sm mb-1">Hasta</label>
					<input type="date" class="form-control form-control-sm" id="so_hasta" name="so_hasta"
						   value="@Model?.so_hasta.ToString("yyyy-MM-dd")" readonly />
				</div>
				<input type="hidden" id="cta_id" name="cta_id" value="@Model?.cta_id" />
				<div class="col-md-6">
					@if (Model.modo_lectura)
					{
						<label for="cta_denominacion" class="form-label form-label-sm mb-1">Proveedor</label>
						<input type="text" class="form-control form-control-sm" id="cta_denominacion" name="cta_denominacion"
							   value="@Model?.cta_denominacion" readonly />
					}
					else
					{
						<label for="Rel01B" class="form-label form-label-sm mb-1">Proveedor</label>
						<input type="text" class="form-control inputEditable" name="Rel01B" id="Rel01B" readonly />
						@Html.Hidden("Rel01BItem")
					}
				</div>
			</div>
			<div class="row">
				<div class="col-md-8">
					<div class="form-check form-check-inline form-switch mb-2">
						<input asp-for="todos_los_prod_del_prov" class="form-check-input" type="checkbox" disabled />
						<label asp-for="todos_los_prod_del_prov" class="form-check-label">Todos los Productos del Proveedor</label>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-md-8">
					<label for="tipo_valor" class="form-label form-label-sm mb-1">Evalúa:</label>
					<select id="tipo_valor" name="tipo_valor" class="form-select form-select-sm" disabled>
						<option value="I" selected="@(Model?.so_inclusion_tipo == 'I')">Importe</option>
						<option value="C" selected="@(Model?.so_inclusion_tipo == 'C')">Cantidad</option>
					</select>
					<label for="tipo_valor" class="form-label form-label-sm mb-1">En Condición de:</label>
					<select id="tipo_valor" name="tipo_valor" class="form-select form-select-sm" disabled>
						<option value="T" selected="@(Model?.so_inclusion_tipo == 'T')">Para todos los Productos</option>
						<option value="P" selected="@(Model?.so_inclusion_tipo == 'P')">Para cada Producto</option>
					</select>
				</div>
				<div class="col-md-4">
					<label for="so_inclusion_valor" class="form-label form-label-sm mb-1">Valor:</label>
					<input type="text" class="form-control form-control-sm" id="so_inclusion_valor" name="so_inclusion_valor"
						   value="@Model?.so_inclusion_valor" readonly />
				</div>
			</div>
		</div>
	</div>
</div>
