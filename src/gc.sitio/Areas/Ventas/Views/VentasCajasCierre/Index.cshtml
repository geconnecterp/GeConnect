@model IndexModel
@{
	var alt = true;
	string clase = string.Empty;
}
@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	.btn-golden-option {
		background-color: #f8f9fa;
		border: 1px solid #d0d0d0;
		font-weight: 700;
		padding: 12px 16px;
		font-size: 1rem;
		text-align: left;
	}

	.btn-golden-exit {
		background-color: #fff0f0;
		border: 1px solid #d0b0b0;
		font-weight: 700;
		padding: 12px 16px;
		font-size: 1rem;
		text-align: left;
	}

		.btn-golden-option i,
		.btn-golden-exit i {
			font-size: 1.4rem;
		}

</style>
<div class="filter-golden mt-3 w-25 mx-auto">
	<div class="filter-golden-header">
		<h5 class="mb-0">Opciones</h5>
	</div>
	<div class="filter-golden-body">
		<div class="table-responsive table-wrapper-200">
			<table class="table table-sm table-hover mb-0 table-golden" id="tbCajasAbiertas">
				<thead class="sticky-top table-golden-header-compact">
					<tr class="header">
						<th>Cierre Nro</th>
						<th>PV</th>
						<th>Cajero</th>
					</tr>
				</thead>
				<tbody>
					@if (Model == null || Model.ListaCajasAbiertas == null || Model.ListaCajasAbiertas.ListaDatos == null || !Model.ListaCajasAbiertas.ListaDatos.Any())
					{
						<tr class="fila-vacia">
							<td colspan="3" class="text-center text-muted py-2">
								<i class="bx bx-info-circle me-1"></i>
								No hay detalles para mostrar.
							</td>
						</tr>
					}
					else
					{
						foreach (var item in Model.ListaCajasAbiertas.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							<tr data-caja-id="@item.caja_id"
								data-caja-nro-cierre="@item.caja_nro_cierre"
								data-caja-estado="@item.caja_estado">
								<td class="text-center">@item.caja_nro_cierre</td>
								<td class="text-center">@item.caja_id</td>
								<td class="text-left">@item.usu_apellidoynombre</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		<div class="d-flex flex-column gap-3">
			<button id="btnCierreGeneralCaja" type="button" class="btn btn-success d-flex align-items-center">
				<i class="bx bx-user-circle"></i> CIERRE GENERAL de CAJAS
			</button>
			<button id="btnSalir" type="button" class="btn btn-danger d-flex align-items-center">
				<i class="bx bx-x-circle"></i> Salir
			</button>
		</div>
	</div>
</div>
@section scripts {
	<script type="text/javascript">
		let cerrarCajasUrl = '@Url.Action("CerrarCajas", "ventascajascierre", new { area = "Ventas" })'
	</script>
	<script src="~/js/app/areas/ventas/cajahabilitar/cajac.js"></script>
}