@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	.btn-golden-option {
		background-color: #f8f9fa;
		border: 1px solid #d0d0d0;
		font-weight: 700;
		padding: 12px 16px;
		font-size: 1rem;
		text-align: left;
	}

	.btn-golden-exit {
		background-color: #fff0f0;
		border: 1px solid #d0b0b0;
		font-weight: 700;
		padding: 12px 16px;
		font-size: 1rem;
		text-align: left;
	}

		.btn-golden-option i,
		.btn-golden-exit i {
			font-size: 1.4rem;
		}

</style>
<div class="filter-golden mt-3 w-25 mx-auto">
	<div class="filter-golden-header">
		<h5 class="mb-0">Opciones</h5>
	</div>
	<div class="filter-golden-body">
		<div class="d-flex flex-column gap-3">
			<button id="btnHabilitacionGeneralCaja" type="button" class="btn btn-success d-flex align-items-center">
				<i class="bx bx-user-circle"></i> HABILITACIÓN GENERAL de CAJAS
			</button>
			<button id="btnSalir" type="button" class="btn btn-danger d-flex align-items-center">
				<i class="bx bx-x-circle"></i> Salir
			</button>
		</div>
	</div>
</div>
@section scripts {
	<script type="text/javascript">
		let habilitarCajasUrl = '@Url.Action("HabilitarCajas", "ventascajashabilitacion", new { area = "Ventas" })'
	</script>
	<script src="~/js/app/areas/ventas/cajahabilitar/cajah.js"></script>
}
