@model GridCoreSmart<FaltanteDeCajaDetalleDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#tbFaltantesDetalle thead th {
		text-align: center !important;
		vertical-align: middle !important;
		white-space: nowrap;
	}

	#tbFaltantesDetalle td,
	#tbFaltantesDetalle th {
		/* padding: 0.15rem 0.35rem !important; */
		vertical-align: middle !important;
		/* line-height: 1.1; */
	}
</style>
<div class="grid-golden" style="padding-left: 0px; padding-right: 0px;">
	<div class="grid-golden-header">
		<div class="row align-items-md-center">
			<div class="col-md-10 col-sm-6 d-flex align-items-center">
				<h5 class="mb-0 flex-grow-1">
					<i class="bx bx-package me-2"></i>
					<strong>Detalle</strong>
				</h5>
			</div>
		</div>
	</div>
	<div class="grid-golden-body">
		<div class="table-responsive table-wrapper-700-full-width">
			<table class="table table-sm table-hover mb-0 table-golden" id="tbFaltantesDetalle">
				<thead class="sticky-top table-golden-header-compact">
					<tr class="header">
						<th style="width:15%;">Día</th>
						<th style="width:15%;">Parte</th>
						<th style="width:15%;">Cierre</th>
						<th style="width:15%;">Faltante</th>
						<th style="width:15%;">Sobrante</th>
						<th style="width:15%;">Acumulado</th>
					</tr>
				</thead>
				<tbody>
					@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
					{
						<tr class="fila-vacia">
							<td colspan="6" class="text-center text-muted py-2">
								<i class="bx bx-info-circle me-1"></i>
								No hay items para mostrar.
							</td>
						</tr>
					}
					else
					{
						foreach (var item in Model.ListaDatos)
						{
							// Alternancia de filas
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

							<tr class="@clase fila-control-"
								data-usu-id="@item.usu_id"
								data-adm-id="@item.adm_id"
								data-caja-nro-proceso="@item.caja_nro_proceso"
								data-caja-nro-cierre="@item.caja_nro_cierre">
								<td class="text-center">@item.dia.ToString("dd/MM/yyyy")</td>
								<td class="text-center">@item.caja_nro_proceso</td>
								<td class="text-center">@item.caja_nro_cierre</td>
								<td class="text-end">@GridHelper.FormatearDato(item.faltante, GridHelper.FormatDato.Monto, true)</td>
								<td class="text-end">@GridHelper.FormatearDato(item.sobrante, GridHelper.FormatDato.Monto, true)</td>
								<td class="text-end">@GridHelper.FormatearDato(item.acumulado, GridHelper.FormatDato.Monto, true)</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>