@model MedioDePagoCIModel
@{
}
<style>
	.min-width {
		width: 30% !important;
		max-width: 30% !important;
	}
</style>
@Html.Hidden("ins_dato1_desc", Model.Item?.ins_dato1_desc)
@Html.Hidden("ins_dato2_desc", Model.Item?.ins_dato2_desc)
@Html.Hidden("ins_dato3_desc", Model.Item?.ins_dato3_desc)
@Html.Hidden("rend_dato1_valor", Model.Item?.rend_dato1_valor)
@Html.Hidden("rend_dato2_valor", Model.Item?.rend_dato2_valor)
@Html.Hidden("rend_dato3_valor", Model.Item?.rend_dato3_valor)
@Html.Hidden("ins_id", Model.Item?.ins_id)
@Html.Hidden("ins_desc", Model.Item?.ins_desc)
@Html.Hidden("rend_fecha_valor", Model.Item?.rend_fecha_valor)
@Html.Hidden("rend_importe_ok", Model.Item?.rend_importe_ok)
@Html.Hidden("rend_item", Model.Item?.rend_item)
@Html.Hidden("cta_id", Model.Item?.cta_id)
<div class="modal-header">
	<h5 class="modal-title" id="modalCenterTitle">Crédito Impositivo</h5>
	<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-90 justify-content-end">Certificado: </span>
		<input type="text" asp-for="Certificado" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-90 justify-content-end">CUIT: </span>
		<input type="text" asp-for="CUIT" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-90 justify-content-end">Razon Social: </span>
		<input type="text" class="form-control inputEditable min-width-ca" name="Rel01" id="Rel01" />
		@Html.Hidden("Rel01Item")
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-90 justify-content-end">Fecha Emisión: </span>
		<input type="date" asp-for="FechaEmision" value="@Model.FechaEmision.ToString("yyyy-MM-dd")" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-90 justify-content-end">Importe: </span>
		<input type="text" asp-for="Importe" class="form-control activable inputEditable text-start min-width" />
	</div>
</div>
<div class="modal-footer">
	<div class="input-group input-group-sm">
		<button type="button" class="btn btn-info btn-sm ms-1" id="btnAceptarDesdeModalValores">
			<i class="bx bx-edit"></i> Aceptar
		</button>
		<button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="btnSalir" data-bs-dismiss="modal">
			<i class="bx bx-log-out-circle"></i> Cancelar
		</button>
	</div>
</div>
