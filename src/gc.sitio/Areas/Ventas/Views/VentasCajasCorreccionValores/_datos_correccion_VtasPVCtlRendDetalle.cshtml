@using System.Globalization
@model GridCoreSmart<VtasPVCtlRendDetalleDto>
@{
	var alt = true;
	string clase = string.Empty;
	var pendiente = false;
	if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
		pendiente = Model.ListaDatos.First().pendiente;
}
<style>
	#tbVtasPVCtlRendDetalle {
		table-layout: fixed;
		width: 100%;
	}
	#tbVtasPVCtlRendDetalle thead th {
		text-align: center !important;
		vertical-align: middle !important;
		white-space: nowrap;
	}
	/* Medio de Pago: 20% + elipsis */
	#tbVtasPVCtlRendDetalle td.col-mp,
	#tbVtasPVCtlRendDetalle th.col-mp {
		width: 20%;
		max-width: 20%;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Importe / Arqueo / Diferencia: 10% */
	#tbVtasPVCtlRendDetalle td.col-num,
	#tbVtasPVCtlRendDetalle th.col-num {
		width: 13%;
		max-width: 13%;
		white-space: nowrap;
	}

	/* Valores: ocupa el espacio restante */
	#tbVtasPVCtlRendDetalle td.col-valores,
	#tbVtasPVCtlRendDetalle th.col-valores {
		width: auto;
	}

	/* Botón: 2% */
	#tbVtasPVCtlRendDetalle td.col-btn,
	#tbVtasPVCtlRendDetalle th.col-btn {
		width: 8%;
		max-width: 8%;
		white-space: nowrap;
		padding-left: 2px;
		padding-right: 2px;
		padding-top: 2px;
		padding-bottom: 2px;
	}

	.editable-importe[data-pendiente="True"] {
		cursor: pointer;
	}

	.editable-importe input {
		width: 100%;
		text-align: right;
		padding: 0 4px;
	}

	#tbVtasPVCtlRendDetalle .input-importe {
		height: 18px !important; /* más bajo */
		padding: 0 1px !important; /* mínimo padding */
		font-size: 0.72rem !important; /* igual a texto de tabla */
		line-height: 16px !important; /* alinea verticalmente */
		font-weight: normal !important;
		border-radius: 2px !important;
	}

	#tbVtasPVCtlRendDetalle .btnEditarValor {
		padding: 0 4px !important; /* menos padding horizontal */
		height: 20px !important; /* más bajo */
		line-height: 18px !important; /* alinea el ícono */
		font-size: 0.70rem !important; /* ícono más chico */
		border-radius: 2px !important; /* más compacto */
	}

		#tbVtasPVCtlRendDetalle .btnEditarValor i {
			font-size: 0.85rem !important; /* ícono más pequeño */
			line-height: 1 !important;
		}

	#tbVtasPVCtlRendDetalle td,
	#tbVtasPVCtlRendDetalle th {
		padding-top: 2px !important;
		padding-bottom: 2px !important;
	}
</style>
<div class="table-responsive table-wrapper-500">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbVtasPVCtlRendDetalle">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="col-mp" title="Medio de Pago">Medio de Pago</th>
				<th class="col-num">Importe</th>
				<th class="col-num">Arqueo</th>
				<th class="col-num" title="Diferencia">Dif.</th>
				<th class="col-valores">Valores</th>
				@if (pendiente)
				{
					<th class="col-btn"></th>
				}
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="5" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					var conceptoVacio = string.Empty;
					var dif = item.rend_importe_ok - item.rend_importe_arq;
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-pedido"
						data-ins-id="@item.ins_id"
						data-tcf-id="@item.tcf_id"
						data-ins-detalle="@item.ins_detalle_bool">
						<td class="col-mp text-start" title="@item.ins_desc">@item.ins_desc</td>
						<td class="col-num text-end editable-importe"
							data-ins-id="@item.ins_id"
							data-tcf-id="@item.tcf_id"
							data-rend-item="@item.rend_item"
							data-pendiente="@item.pendiente">

							@if (item.pendiente)
							{
								<input type="text"
									   class="form-control form-control-sm input-importe"
									   value="@GridHelper.FormatearPrecio(item.rend_importe_ok ?? 0, TipoPrecio.Venta)"
									   data-original="@((item.rend_importe_ok ?? 0).ToString(CultureInfo.InvariantCulture))" />
							}
							else
							{
								<span>@GridHelper.FormatearPrecio(item.rend_importe_ok ?? 0, TipoPrecio.Venta)</span>
							}
						</td>
						<td class="col-num text-end">@GridHelper.FormatearPrecio(item.rend_importe_arq ?? 0, TipoPrecio.Venta)</td>
						<td class="col-num text-end">@GridHelper.FormatearPrecio(dif ?? 0, TipoPrecio.Venta)</td>
						<td class="col-valores text-start">
							@if (item.ins_detalle_bool)
							{
								@item.concepto_valor
							}
							else
							{
								@conceptoVacio
							}
						</td>
						@if (item.pendiente)
						{
							<td class="col-btn text-center">
								<button type="button"
										class="btn btn-sm btn-info btnEditarValor"
										data-ins-id="@item.ins_id"
										data-tcf-id="@item.tcf_id"
										data-ins-detalle="@item.ins_detalle_bool"
										title="Editar valores">
									<i class="bx bx-edit"></i>
								</button>
							</td>
						}
					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="mt-3 d-flex justify-content-center gap-3">
	<button id="btnGuardarValores" class="btn btn-sm btn-primary">
		<i class="bx bx-save"></i> Guardar Valores
	</button>
	<button id="btnAgregarValor" class="btn btn-sm btn-success">
		<i class="bx bx-plus"></i>
	</button>
</div>