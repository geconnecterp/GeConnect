@model InitializeViewModel
@{
}
<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="row mb-1">
		<div class="col-12">
			<div class="p-1 border rounded bg-light">

				<div class="d-flex justify-content-between align-items-center flex-wrap">

					<!-- IZQUIERDA: textos -->
					<div class="d-flex flex-wrap gap-4">

						<div><strong>Sucursal:</strong> @Model.Sucursal</div>
						<div><strong>Fecha:</strong> @Model.Fecha</div>
						<div><strong>Nro. Proceso:</strong> @Model.NroProceso</div>

					</div>

					<!-- DERECHA: botones -->
					<div class="d-flex align-items-center gap-2">

						<button id="btnVolver" class="btn btn-success btn-sm btn-or">
							<i class="bx bx-mobile-back"></i> Volver
						</button>

					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-md-2" style="padding-right: 0px;">
			<div class="card mb-3">
				<div class="card-header fw-bold">Cierres</div>
				<div class="card-body p-2">
					<div id="divVtasPVCtlCierres">
						@Html.Partial("_datos_correccion_VtasPVCtlCierres", Model.GrillaVtasPVCtlCierres)
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-4" style="padding-right: 0px;padding-left: 5px;">
			<div class="card mb-3">
				<div class="card-header fw-bold">Medios de Pago</div>
				<div class="card-body p-2">
					<div id="divVtasPVCtlRend">
						@Html.Partial("_datos_correccion_VtasPVCtlRend", Model.GrillaVtasPVCtlRend)
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-6" style="padding-left: 5px;">
			<div class="card mb-3">
				<div class="card-header fw-bold">Detalle Arqueo</div>
				<div class="card-body p-2">
					<div id="divVtasPVCtlRendDetalle">
						@Html.Partial("_datos_correccion_VtasPVCtlRendDetalle", Model.GrillaVtasPVCtlRendDetalle)
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
