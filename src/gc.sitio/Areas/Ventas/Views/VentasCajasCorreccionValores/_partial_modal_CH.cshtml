@model MedioDePagoCHModel
@{
}
<style>
	.min-width {
		width: 30% !important;
		max-width: 30% !important;
	}

	.min-width-ca {
		width: 50% !important;
		max-width: 50% !important;
	}
</style>
<div class="modal-header">
	<h5 class="modal-title" id="modalCenterTitle">Cheques</h5>
	<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
	<div class="input-group input-group-sm">
		<span class="input-group-text d-flex align-items-center justify-content-end lbl-sm fixed-width-80">Tarjeta: </span>
		@Html.DropDownListFor(m => m.BcoCheqsSeleccionado, Model.ListaBcoCheqs, "Seleccionar", new { @id = "listaBcoCheqs", @class = "form-control inputEditable activable" })
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-80 justify-content-end">N° Cheque: </span>
		<input type="text" asp-for="NroCheque" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-80 justify-content-end">Plaza: </span>
		<input type="text" asp-for="Plaza" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-80 justify-content-end">Fecha Vto.: </span>
		<input type="date" asp-for="FechaVto" value="@Model.FechaVto.ToString("yyyy-MM-dd")" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-80 justify-content-end">Importe: </span>
		<input type="text" asp-for="Importe" class="form-control activable inputEditable text-start min-width" />
	</div>
	<div class="input-group input-group-sm mt-2">
		<span class="input-group-text fixed-width-80 justify-content-end">Cliente: </span>
		<input type="text" class="form-control inputEditable min-width-ca" name="Rel01" id="Rel01" />
		@Html.Hidden("Rel01Item")
	</div>
</div>
<div class="modal-footer">
	<div class="input-group input-group-sm">
		<button type="button" class="btn btn-info btn-sm ms-1" id="btnAceptarDesdeModalValores">
			<i class="bx bx-edit"></i> Aceptar
		</button>
		<button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="btnSalir" data-bs-dismiss="modal">
			<i class="bx bx-log-out-circle"></i> Cancelar
		</button>
	</div>
</div>
