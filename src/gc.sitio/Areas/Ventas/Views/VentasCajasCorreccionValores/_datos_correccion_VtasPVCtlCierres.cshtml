@model GridCoreSmart<VtasPVCtlCierresDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#tbVtasPVCtlCierres thead th {
		text-align: center !important;
		vertical-align: middle !important;
		white-space: nowrap;
	}
	/* Columna ID más ancha y sin salto de línea */
	#tbVtasPVCtlCierres td.col-id,
	#tbVtasPVCtlCierres th.col-id {
		min-width: 50px; /* Ajustá este valor a gusto */
		white-space: nowrap; /* Evita salto de línea */
	}
</style>
<div class="table-responsive table-wrapper-500">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbVtasPVCtlCierres">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th title="Cierre">Ci.</th>
				<th>PV</th>
				<th>Cajero</th>
				<th>Ok</th>
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="6" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-pedido"
						data-caja-nro-proceso="@item.caja_nro_proceso"
						data-caja-nro-cierre="@item.caja_nro_cierre"
						data-caja-id="@item.caja_id"
						data-pendientes-bool="@item.pendientes_bool">
						<td class="text-center">@item.caja_nro_cierre</td>
						<td class="text-center">@item.caja_id</td>
						<td class="text-start">@item.usu_id</td>
						<td class="text-center">
							@if (item.pendientes_bool)
							{
								<i class="bx bx-x-circle text-danger" title="Pendiente"></i>
							}
							else
							{
								<i class="bx bx-check-circle text-success" title="OK"></i>
							}
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="mt-3 text-center">
	<button id="btnConfirmacionContable" class="btn btn-sm btn-primary">
		<i class="bx bx-check"></i> Confirmación Contable
	</button>
</div>