@model EdicionTipoValoresDeTercerosEnCarteraModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
		z-index: 1; /* suficiente para estar sobre las filas */
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		/*max-height: 400px;  o lo que necesites */
		overflow-y: auto;
		position: relative;
	}
</style>
<div class="row col-md-12">
	@Html.HiddenFor(x => x.ctaf_id)
	@Html.HiddenFor(x => x.ctaf_denominacion)
	@Html.HiddenFor(x => x.ban_razon_social)
	<div class="table-responsive table-wrapper-225-full" id="containerValoresEnCartera" style="padding-right: 0px;">
		<table class="table table-bordered table-hover table-golden" id="tbValoresEnCartera" disabled>
			<thead>
				<tr class="header">
					<th style="width:10%;" class="col-header-small align-center tiny-row">Fecha Valor</th>
					<th style="width:10%;" class="col-header-small align-center tiny-row">Carga</th>
					<th style="width:35%;" class="col-header-small align-center tiny-row">Banco</th>
					<th style="width:20%;" class="col-header-small align-center tiny-row">Nro. Cheque</th>
					<th style="width:15%;" class="col-header-small align-center tiny-row">Importe</th>
					<th style="width:1%;" class="col-header-small align-center tiny-row"><input name="select_all" value="1" type="checkbox"></th>
					<th style="width:0%; display:none;">ins_dato1_desc</th>
					<th style="width:0%; display:none;">ins_dato2_desc</th>
					<th style="width:0%; display:none;">fc_dato3_valor</th>
					<th style="width:0%; display:none;">ins_dato3_desc</th>
					<th style="width:0%; display:none;">fc_compte</th>
					<th style="width:0%; display:none;">fc_item</th>
					<th style="width:0%; display:none;">dia_movi</th>
					<th style="width:0%; display:none;">fc_fecha_valor</th>
					<th style="width:0%; display:none;">cta_id</th>
					<th style="width:0%; display:none;">cta_denominacion</th>
				</tr>
			</thead>
			<tbody>
				@if (Model != null && Model != null && Model.GrillaValoresEnCartera.ListaDatos != null && Model.GrillaValoresEnCartera.ListaDatos.Count > 0)
				{
					@foreach (var item in Model.GrillaValoresEnCartera.ListaDatos)
					{
						if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
						var nombre = "chk" + item.fc_dato2_valor;
						<tr class="@clase" onclick="seleccionarValoresEnCartera(this)" title="@item.concepto_valor">
							<td class="align-center tiny-row">@Model.GrillaValoresEnCartera.FormatearDato(item.fc_fecha_valor, FormatDato.Fecha)</td>
							<td class="align-center tiny-row">@Model.GrillaValoresEnCartera.FormatearDato(item.fc_fecha, FormatDato.Fecha)</td>
							<td class="align-left tiny-row">@Model.GrillaValoresEnCartera.FormatearDato(item.fc_dato1_valor, FormatDato.Ninguno)</td>
							<td class="align-center tiny-row">@Model.GrillaValoresEnCartera.FormatearDato(item.fc_dato2_valor, FormatDato.Ninguno)</td>
							<td class="align-right tiny-row">@Model.GrillaValoresEnCartera.FormatearDato(item.fc_importe, FormatDato.Monto)</td>
							<td style="padding-top: 7px;padding-bottom: 2px;">
								<input type="checkbox" name=@nombre />
							</td>
							<td style="display:none;">@item.ins_dato1_desc</td>
							<td style="display:none;">@item.ins_dato2_desc</td>
							<td style="display:none;">@item.fc_dato3_valor</td>
							<td style="display:none;">@item.ins_dato3_desc</td>
							<td style="display:none;">@item.fc_compte</td>
							<td style="display:none;">@item.fc_item</td>
							<td style="display:none;">@item.dia_movi</td>
							<td style="display:none;">@item.fc_fecha_valor.Value.ToString("yyyy-MM-dd")</td>
							<td style="display:none;">@item.cta_id</td>
							<td style="display:none;">@item.cta_denominacion</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
	@* <div class="mt-2">
		<div class="form-check form-check-inline form-switch" style="margin-bottom: 0px;margin-left: 10px;">
			<input class="form-check-input activable" type="checkbox" asp-for="VerSoloValoresVencidos" value="" id="chkVerSoloValoresVencidos">
			<label class="form-check-label" for="chkVerSoloValoresVencidos"> Ver solo valores vencidos</label>
		</div>
	</div> *@
</div>
