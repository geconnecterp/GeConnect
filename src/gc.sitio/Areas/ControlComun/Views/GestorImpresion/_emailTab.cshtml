<div class="row">
    <div class="col-md-12">
        <!-- Selector de Proveedor de Email (Compactado) -->
        <div class="mb-3 p-2 bg-light rounded">
            <label class="form-label fw-bold mb-2">Método de envío:</label>
            <div class="btn-group w-100" role="group" aria-label="Selector de proveedor">
                <input type="radio" class="btn-check" name="emailProvider" id="gmailProvider" value="gmail" checked autocomplete="off">
                <label class="btn btn-outline-danger btn-sm" for="gmailProvider">
                    <i class="bx bxl-gmail"></i> Gmail
                </label>

                <input type="radio" class="btn-check" name="emailProvider" id="outlookWebProvider" value="outlookweb" autocomplete="off">
                <label class="btn btn-outline-primary btn-sm" for="outlookWebProvider">
                    <i class="bx bx-world"></i> Outlook Web
                </label>

                <input type="radio" class="btn-check" name="emailProvider" id="outlookDesktopProvider" value="outlookdesktop" autocomplete="off">
                <label class="btn btn-outline-info btn-sm" for="outlookDesktopProvider">
                    <i class="bx bxl-microsoft"></i> Outlook Local
                </label>
            </div>
            
            <!-- Información colapsable -->
            <div class="mt-2">
                <small class="text-muted d-block">
                    <i class="bx bx-info-circle"></i> 
                    <span id="providerInfo">Gmail (smtp.gmail.com:587)</span>
                    <a href="#" class="text-decoration-none ms-2" data-bs-toggle="collapse" data-bs-target="#providerDetails">
                        <i class="bx bx-help-circle"></i> Ver detalles
                    </a>
                </small>
                
                <!-- Panel colapsable con advertencias -->
                <div class="collapse mt-2" id="providerDetails">
                    <div class="alert alert-sm py-2 mb-0" id="providerWarning">
                        <!-- Contenido dinámico según proveedor -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario de Email (Compactado) -->
        <form id="emailForm">
            <div class="mb-2">
                <label for="emailTo" class="form-label mb-1">Para <span class="text-danger">*</span></label>
                <input type="email" class="form-control form-control-sm" id="emailTo" placeholder="destinatario@ejemplo.com" required>
            </div>
            
            <div class="mb-2">
                <label for="emailSubject" class="form-label mb-1">Asunto <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm" id="emailSubject" placeholder="Asunto del correo" required>
            </div>
            
            <div class="mb-2">
                <label for="emailBody" class="form-label mb-1">Mensaje</label>
                <textarea class="form-control form-control-sm" id="emailBody" rows="3" placeholder="Escribe tu mensaje..."></textarea>
            </div>
            
            <!-- Información de archivos (compactada) -->
            @* <div class="mb-3" id="emailFileInfoContainer">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-muted">
                        <i class="bx bx-paperclip"></i> 
                        <span id="emailFileInfo">Sin archivos</span>
                    </small>
                    <small class="text-muted" id="fileHelp">
                        <i class="bx bx-help-circle"></i> Máx: 25MB
                    </small>
                </div>
            </div> *@
        </form>
        
        <button type="button" class="btn btn-golden btn-sm w-100" id="btnEnviarEmail">
            <i class="bx bx-send"></i> Enviar Email
        </button>
    </div>
</div>