@using gc.infraestructura.ViewModels
@using gc.infraestructura.EntidadesComunes.Options
@model DocumentManagerViewModel

@{
    // ✅ CORREGIDO: Usar los tipos correctos de DocsManager
    var mensajeriaTemplate = ViewBag.MensajeriaTemplate as MensajeriaTemplate;
    var emailTemplate = ViewBag.EmailTemplate as EmailTemplate;
    var whatsappTemplate = ViewBag.WhatsAppTemplate as WhatsAppTemplate;
    var moduloId = ViewBag.ModuloId as string ?? "";
    var moduloTitulo = ViewBag.ModuloTitulo as string ?? "";
    
    // ✅ Datos de la empresa
    var empresaNombre = ViewBag.EmpresaNombre as string ?? "GeCoNet";
    var empresaTelefono = ViewBag.EmpresaTelefono as string ?? "";
    var empresaEmail = ViewBag.EmpresaEmail as string ?? "";
    var empresaDireccion = ViewBag.EmpresaDireccion as string ?? "";
    var empresaLocalidad = ViewBag.EmpresaLocalidad as string ?? "";
    var empresaProvincia = ViewBag.EmpresaProvincia as string ?? "";
}

<!-- ✅ Script de configuración global para JavaScript -->
<script type="text/javascript">
    // Configuración del módulo actual
    window.currentModuleConfig = {
        moduloId: '@moduloId',
        moduloTitulo: '@moduloTitulo',
        
        // ✅ NUEVO: Configuración de MENSAJERÍA (común para Email y WhatsApp)
        mensajeriaTemplate: @if (mensajeriaTemplate != null)
        {
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                mensajeTemplate = mensajeriaTemplate.MensajeTemplate,
                tipoDestinatario = mensajeriaTemplate.TipoDestinatario,
                esPersonalizado = mensajeriaTemplate.EsPersonalizado,
                saludoGenerico = mensajeriaTemplate.SaludoGenerico
            }))
        }
        else
        {
            @:null
        },
        
        // ✅ Configuración de EMAIL (solo asunto)
        emailTemplate: @if (emailTemplate != null)
        {
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                asuntoTemplate = emailTemplate.AsuntoTemplate
            }))
        }
        else
        {
            @:null
        },
        
        // ✅ NUEVO (opcional futuro): Configuración de WHATSAPP
        whatsappTemplate: @if (whatsappTemplate != null)
        {
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                prefijoMensaje = whatsappTemplate.PrefijoMensaje,
                usarEmojis = whatsappTemplate.UsarEmojis
            }))
        }
        else
        {
            @:null
        },
        
        empresa: {
            nombre: '@empresaNombre',
            telefono: '@empresaTelefono',
            email: '@empresaEmail',
            direccion: '@empresaDireccion',
            localidad: '@empresaLocalidad',
            provincia: '@empresaProvincia'
        }
    };
    
    console.log('📋 Configuración del módulo cargada:', window.currentModuleConfig);
</script>

<div class="modal" id="docmgrmodal" tabindex="-1" role="dialog" aria-labelledby="docmgrmodalLabel"
     data-bs-backdrop="static" data-bs-keyboard="false"
     style="z-index:9999;">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="docmgrmodalLabel">@Model.Titulo</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 d-flex justify-content-start align-items-center " style="overflow-x:scroll;">
                        <!--Acá se insertará un arbol con los archivos disponibles a operar-->
                        <div id="archivosDispuestos" class="jstree-container mb-3"></div>
                    </div>
                    <div class="col-md-6 d-flex justify-content-center align-items-baseline">
                        <div class="row">
                            <div class="col-md-12">
                                <ul class="nav nav-tabs" id="documentManagerTabs" role="tablist">
                                    @if (Model.ShowPrintOption)
                                    {
                                        <li class="nav-item">
                                            <button type="button" class="nav-link active" id="print-tab" data-bs-toggle="tab" href="#print" role="tab" aria-controls="print" aria-selected="true">
                                                <i class="bx bx-printer text-warning"></i> Imprimir
                                            </button>
                                        </li>
                                    }
                                    @if (Model.ShowExportOption)
                                    {
                                        <li class="nav-item">
                                            <button type="button" class="nav-link" id="export-tab" data-bs-toggle="tab" data-bs-target="#export" role="tab" aria-controls="export" aria-selected="false">
                                                <i class="bx bxs-file-export text-primary"></i> Exportar
                                            </button>
                                        </li>
                                    }
                                    @if (Model.ShowEmailOption)
                                    {
                                        <li class="nav-item">
                                            <button type="button" class="nav-link" id="email-tab" data-bs-toggle="tab" data-bs-target="#email" role="tab" aria-controls="email" aria-selected="false">
                                                <i class="bx bx-envelope text-danger"></i> Email
                                            </button>
                                        </li>
                                    }
                                    @if (Model.ShowWhatsAppOption)
                                    {
                                        <li class="nav-item">
                                            <button type="button" class="nav-link" id="whatsapp-tab" data-bs-toggle="tab" data-bs-target="#whatsapp" role="tab" aria-controls="whatsapp" aria-selected="false">
                                                <i class="bx bxl-whatsapp text-success"></i> WhatsApp
                                            </button>
                                        </li>
                                    }
                                </ul>
                                <div class="tab-content" id="documentManagerTabContent">
                                    @if (Model.ShowPrintOption)
                                    {
                                        <div class="tab-pane fade show active" id="print" role="tabpanel" aria-labelledby="print-tab">
                                            <partial name="_printTab" />
                                        </div>
                                    }
                                    @if (Model.ShowExportOption)
                                    {
                                        <div class="tab-pane fade" id="export" role="tabpanel" aria-labelledby="export-tab">
                                            <partial name="_exportTab" />
                                        </div>
                                    }
                                    @if (Model.ShowEmailOption)
                                    {
                                        <div class="tab-pane fade" id="email" role="tabpanel" aria-labelledby="email-tab">
                                           <partial name="_emailTab" /> 
                                        </div>
                                    }
                                    @if (Model.ShowWhatsAppOption)
                                    {
                                        <div class="tab-pane fade" id="whatsapp" role="tabpanel" aria-labelledby="whatsapp-tab">
                                             <partial name="_whatsAppTab"  />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCancelarGD" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
