<div class="row">
    <div class="col-md-12">
        <div class="form-check form-switch mb-2 d-flex justify-content-center align-items-center gap-2">
            <input class="form-check-input m-0" type="checkbox" role="switch"
                   id="chkImpresionGlobal" checked>
            <label class="form-check-label" for="chkImpresionGlobal">
                Unificar seleccionados en un solo PDF
            </label>
        </div>
        <div id="impresionGlobalAyuda" class="small text-muted text-center mb-3">
            Recomendado para imprimir varios reportes en una sola operación.
        </div>
        <div id="impresionGlobalAdvertencia" class="alert alert-warning py-2 px-3 d-none" role="alert"></div>
        <div class="d-flex justify-content-center align-items-center">
            <button type="button" class="btn btn-warning" id="btnArchImprimir">
                <i class="bx bx-printer text-warning"></i> Imprimir
            </button>
        </div>
        <div id="colaImpresionIndividual" class="mt-3 d-none">
            <div class="fw-semibold mb-2">Documentos generados individualmente</div>
            <div id="colaImpresionIndividualLista" class="list-group"></div>
        </div>
    </div>
</div>
