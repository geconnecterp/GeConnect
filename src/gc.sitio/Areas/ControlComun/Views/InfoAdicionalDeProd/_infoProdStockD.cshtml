@model BuscarInfoProdStkDModel
@{
	var alt = true;
	string clase = string.Empty;
	var sucursales = Model.ComboSucursales;
}
<div class="row" style="max-width: 85%;">
	<div class="input-group input-group-sm">
		<span class="input-group-text" style="width: 13%;text-align: left;padding-left: 2px;font-size: 10px;">Sucursal: </span>
		@Html.DropDownListFor(m => m.selectedValue, sucursales, "Seleccionar", new { @id = "listaSucursalesD", @class = "form-control fixed-width", style = "font-size: 10px;" })
	</div>
</div>
<div class="table-responsive text-nowrap table-wrapper-200-full" style="width: 80%;">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbInfoProdStkD">
		<thead>
			<tr class="header">
				<th style="width:40%;" class="tiny-row align-center">Depósito</th>
				<th style="width:10%;" class="tiny-row align-center">Stk</th>
				<th style="width:20%;" class="tiny-row align-center">Vencimiento</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaInfoProdStkD.ListaDatos != null && Model.GrillaInfoProdStkD.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaInfoProdStkD.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaInfoProdStkD(this)">
						<td class="align-left tiny-row">@item.Depo_nombre</td>
						<td class="align-right tiny-row">@item.ps_stk</td>
						<td class="align-center tiny-row">@item.Vto?.ToString("dd/MM/yy")</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>