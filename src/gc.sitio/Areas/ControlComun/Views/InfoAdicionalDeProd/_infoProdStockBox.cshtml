@model BuscarInfoProdStkBoxModel
@{
	var alt = true;
	string clase = string.Empty;
	var sucursales = Model.ComboSucursales;
}
<div class="row">
	<div class="input-group input-group-sm">
		<span class="input-group-text fixed-width">Sucursal: </span>
		@Html.DropDownListFor(m => m.selectedValue, sucursales, "Seleccionar", new { @id = "listaSucursalesX", @class = "form-control fixed-width" })
	</div>
</div>
<div class="table-responsive text-nowrap table-wrapper-200-full">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbInfoProdStkD">
		<thead>
			<tr class="header">
				<th style="width:30%;" class="tiny-row align-center">Depósito</th>
				<th style="width:30%;" class="tiny-row align-center">Box</th>
				<th style="width:10%;" class="tiny-row align-center">Stk</th>
				<th style="width:20%;" class="tiny-row align-center">Vencimiento</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaInfoProdStkBox.ListaDatos != null && Model.GrillaInfoProdStkBox.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaInfoProdStkBox.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaInfoProdStkBox(this)">
						<td class="align-left tiny-row">@item.Depo_nombre</td>
						<td class="align-left tiny-row">@item.Box_id</td>
						<td class="align-center tiny-row">@item.Ps_stk</td>
						<td class="align-center tiny-row">@item.Vto?.ToString("dd/MM/yyyy")</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>