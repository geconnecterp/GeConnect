@model BuscarInfoProdMovSemModel
@{
	var alt = true;
	string clase = string.Empty;
	var sucursales = Model.ComboSucursales;
}
<div class="row">
	<div class="input-group">
		<span class="input-group-text fixed-width">Sucursal: </span>
		@Html.DropDownListFor(m => m.selectedValue, sucursales, "Seleccionar", new { @id = "listaSucursalesS", @class = "form-control fixed-width" })
		<span class="input-group-text fixed-width-75">Semanas: </span>
		@Html.TextBoxFor(m => m.Semanas, new { @id = "txtSemanas", @class = "fixed-width-50 align-right", type = "number" })
	</div>
</div>
<div class="table-responsive text-nowrap table-wrapper-200-full">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbInfoProdMovSem">
		<thead>
			<tr>
				<th style="width:12%;" class="col-header-x-small align-center">Semana</th>
				<th style="width:12%;" class="col-header-x-small align-center">Comp.</th>
				<th style="width:15%;" class="col-header-x-small align-center">Trans.</th>
				<th style="width:12%;" class="col-header-x-small align-center">Otros</th>
				<th style="width:2%;" class="col-header-x-small align-center"></th>
				<th style="width:12%;" class="col-header-x-small align-center">Vtas.</th>
				<th style="width:15%;" class="col-header-x-small align-center">Trans.</th>
				<th style="width:12%;" class="col-header-x-small align-center">Otros</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaInfoProdMovSem.ListaDatos != null && Model.GrillaInfoProdMovSem.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaInfoProdMovSem.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaInfoProdMovSem(this)">
						<td class="align-center tiny-row">@item.desde.ToString("dd/MM/yy")-@item.hasta.ToString("dd/MM/yy")</td>
						<td class="align-center tiny-row">@item.e_compra</td>
						<td class="align-center tiny-row">@item.e_ri</td>
						<td class="align-center tiny-row">@item.e_otros</td>
						<td class="align-center tiny-row"></td>
						<td class="align-center tiny-row">@item.s_ventas</td>
						<td class="align-center tiny-row">@item.s_ri</td>
						<td class="align-center tiny-row">@item.s_otros</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>