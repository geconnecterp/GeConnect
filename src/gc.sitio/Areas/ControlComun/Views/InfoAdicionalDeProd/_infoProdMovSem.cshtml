@model BuscarInfoProdMovSemModel
@{
	var alt = true;
	string clase = string.Empty;
	var sucursales = Model.ComboSucursales;
}
<style>
	.col-entrada {
		background-color: #f8d7da !important;
		color: #721c24 !important;
	}

	.col-salida {
		background-color: #d6eaf8 !important;
		color: #154360 !important;
	}

	.col-separador {
		background-color: #fdfdfd !important;
		width: 7px !important;
		padding: 0 !important;
	}

	.th-ingresos {
		background-color: #f8d7da !important; 
		color: #721c24 !important;
	}

	.th-egresos {
		background-color: #d6eaf8 !important;
		color: #154360 !important;
	}

	.selected-row td {
		background-color: #ffe599 !important;
		color: #000 !important;
	}
	
	#tbInfoProdMovSem td.col-separador,
	#tbInfoProdMovSem th.col-separador {
		border-top: none !important;
		border-bottom: none !important;
	}

</style>
<div class="row" style="width: 96%;">
	<div class="input-group input-group-sm">
		<span class="input-group-text" style="width: 11%;text-align: left;padding-left: 2px;font-size: 10px;">Sucursal: </span>
		@Html.DropDownListFor(m => m.selectedValue, sucursales, "Seleccionar", new { @id = "listaSucursalesS", @class = "form-control fixed-width", style = "font-size: 10px;" })
		<span class="input-group-text" style="width: 11%;text-align: left;padding-left: 2px;font-size: 10px;">Semanas: </span>
		@Html.TextBoxFor(m => m.Semanas, new { @id = "txtSemanas", @class = "fixed-width-50 align-right", type = "number", style = "font-size: 10px;" })
	</div>
</div>
<div class="table-responsive text-nowrap table-wrapper-200-full" style="width: 90%;">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbInfoProdMovSem">
		<thead>
			<tr>
				<th rowspan="2" class="tiny-row align-center">Período</th>
				<th colspan="3" class="tiny-row align-center th-ingresos">Ingresos</th>
				<th rowspan="2" class="tiny-row align-center col-separador"></th>
				<th colspan="3" class="tiny-row align-center th-egresos">Egresos</th>
			</tr>
			<tr>
				<th style="width:11%;" class="tiny-row align-center col-entrada">Comp.</th>
				<th style="width:14%;" class="tiny-row align-center col-entrada">RI</th>
				<th style="width:11%;" class="tiny-row align-center col-entrada">Otros</th>
				<th style="width:11%;" class="tiny-row align-center col-salida">Vtas.</th>
				<th style="width:14%;" class="tiny-row align-center col-salida">RI</th>
				<th style="width:11%;" class="tiny-row align-center col-salida">Otros</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaInfoProdMovSem.ListaDatos != null && Model.GrillaInfoProdMovSem.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaInfoProdMovSem.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaInfoProdMovSem(this)">
						<td class="align-center tiny-row">@item.desde.ToString("dd/MM/yy")-@item.hasta.ToString("dd/MM/yy")</td>
						<td class="align-right tiny-row col-entrada" title="@item.GetIngresoFull()">
							@(item.e_compra == 0 ? "" : item.e_compra.ToString())
						</td>
						<td class="align-right tiny-row col-entrada" title="@item.GetIngresoFull()">
							@(item.e_ri == 0 ? "" : item.e_ri.ToString())
						</td>
						<td class="align-right tiny-row col-entrada" title="@item.GetIngresoFull()">
							@(item.e_otros == 0 ? "" : item.e_otros.ToString())
						</td>
						<td class="align-center tiny-row col-separador"></td>
						<td class="align-right tiny-row col-salida" title="@item.GetEgresoFull()">
							@(item.s_ventas == 0 ? "" : item.s_ventas.ToString())
						</td>
						<td class="align-right tiny-row col-salida" title="@item.GetEgresoFull()">
							@(item.s_ri == 0 ? "" : item.s_ri.ToString())
						</td>
						<td class="align-right tiny-row col-salida" title="@item.GetEgresoFull()">
							@(item.s_otros == 0 ? "" : item.s_otros.ToString())
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>