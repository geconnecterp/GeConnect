@model BuscarInfoProdMovSemModel
@{
	var alt = true;
	string clase = string.Empty;
	var sucursales = Model.ComboSucursales;
}
<style>
	.col-entrada {
		background-color: #f8d7da !important;
		color: #721c24 !important;
	}

	.col-salida {
		background-color: #d6eaf8 !important;
		color: #154360 !important;
	}

	.col-separador {
		background-color: #fdfdfd !important; /* blanco casi puro */
		width: 7px !important; /* o 15px si querés más separación */
		padding: 0 !important;
	}

	.th-ingresos {
		background-color: #f8d7da !important; /* mismo que col-entrada */
		color: #721c24 !important;
	}

	.th-egresos {
		background-color: #d6eaf8 !important; /* mismo que col-salida */
		color: #154360 !important;
	}

	.selected-row td {
		background-color: #ffe599 !important; /* amarillo suave */
		color: #000 !important;
	}
	/* Quita bordes superior e inferior de la columna separadora */
	#tbInfoProdMovSem td.col-separador,
	#tbInfoProdMovSem th.col-separador {
		border-top: none !important;
		border-bottom: none !important;
	}

</style>
<div class="row">
	<div class="input-group input-group-sm">
		<span class="input-group-text fixed-width">Sucursal: </span>
		@Html.DropDownListFor(m => m.selectedValue, sucursales, "Seleccionar", new { @id = "listaSucursalesS", @class = "form-control fixed-width" })
		<span class="input-group-text fixed-width-75">Semanas: </span>
		@Html.TextBoxFor(m => m.Semanas, new { @id = "txtSemanas", @class = "fixed-width-50 align-right", type = "number" })
	</div>
</div>
<div class="table-responsive text-nowrap table-wrapper-200-full">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbInfoProdMovSem">
		<thead>
			<tr>
				<th rowspan="2" class="tiny-row align-center">Período</th>
				<th colspan="3" class="tiny-row align-center th-ingresos">Ingresos</th>
				<th rowspan="2" class="tiny-row align-center col-separador"></th>
				<th colspan="3" class="tiny-row align-center th-egresos">Egresos</th>
			</tr>
			<tr>
				<th style="width:12%;" class="tiny-row align-center col-entrada">Comp.</th>
				<th style="width:15%;" class="tiny-row align-center col-entrada">RI</th>
				<th style="width:12%;" class="tiny-row align-center col-entrada">Otros</th>
				<th style="width:12%;" class="tiny-row align-center col-salida">Vtas.</th>
				<th style="width:15%;" class="tiny-row align-center col-salida">RI</th>
				<th style="width:12%;" class="tiny-row align-center col-salida">Otros</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaInfoProdMovSem.ListaDatos != null && Model.GrillaInfoProdMovSem.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaInfoProdMovSem.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaInfoProdMovSem(this)">
						<td class="align-center tiny-row">@item.desde.ToString("dd/MM/yy")-@item.hasta.ToString("dd/MM/yy")</td>
						<td class="align-center tiny-row col-entrada">@item.e_compra</td>
						<td class="align-center tiny-row col-entrada">@item.e_ri</td>
						<td class="align-center tiny-row col-entrada">@item.e_otros</td>
						<td class="align-center tiny-row col-separador"></td>
						<td class="align-center tiny-row col-salida">@item.s_ventas</td>
						<td class="align-center tiny-row col-salida">@item.s_ri</td>
						<td class="align-center tiny-row col-salida">@item.s_otros</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>