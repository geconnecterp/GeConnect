@model List<ProductoListaDto>

<div class="modal modal-golden" 
    id="busquedaModal" 
    tabindex="-1" 
    role="dialog" 
    aria-labelledby="buscTitulo" 
    aria-hidden="true" 
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    style="z-index: 999999;">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="buscTitulo">
                    <i class="bx bx-search-alt me-2"></i>
                    Búsqueda Avanzada de Productos
                </h5>
                <button type="button" 
                        class="btn-close buscAdv" 
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">@* &times; *@</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Filtros de búsqueda -->
                <div class="filter-golden mb-3">
                    <div class="filter-golden-header">
                        <h6 class="mb-0">
                            <i class="bx bx-filter-alt me-2"></i>Filtros de Búsqueda
                        </h6>
                    </div>
                    <div class="filter-golden-body">
                        <div class="row g-2">
                            <div class="col-md-4 col-sm-12">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Proveedor</span>
                                    <input type="text" class="form-control inputEditable" name="Rel01B2" id="Rel01B2" />
                                    @Html.Hidden("Rel01B2Item")
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-12">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text" id="lbNombreRel03B2">Familia</span>
                                    @Html.DropDownList("Rel03B2", null, new { @class = "form-control", @disabled = "disabled" })
                                    @Html.Hidden("Rel03B2Item")
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-12">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Rubro</span>
                                    @Html.DropDownList("Rel02B2", null, "Seleccionar...", new { @class = "form-control", @disabled = "disabled" })
                                    @* <input type="text" class="form-control inputEditable" name="Rel02B2" id="Rel02B2" /> *@
                                    @Html.Hidden("Rel02B2Item")
                                </div>
                            </div>
                           
                        </div>
                        
                        <div class="row g-2 mt-2">
                            <div class="col-md-8">
                                <div class="d-flex gap-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkActivos" checked />
                                        <label class="form-check-label fw-medium" for="chkActivos">Activos</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="EstadoDiscont" id="chkDisc" />
                                        <label class="form-check-label fw-medium" for="chkDisc">Discontinuos</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="EstadoInactivo" id="chkInact" />
                                        <label class="form-check-label fw-medium" for="chkInact">Inactivos</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" name="ConStock" type="radio" value="true" id="rdConStk" checked>
                                        <label class="form-check-label fw-medium" for="rdConStk">Con Stock</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" name="ConStock" type="radio" value="false" id="rdSinStk">
                                        <label class="form-check-label fw-medium" for="rdSinStk">Sin Stock</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="busqueda-productos-toolbar mt-2">
                            <div class="input-group input-group-sm busqueda-productos-search">
                                <span class="input-group-text">Buscar</span>
                                <input type="text" class="form-control inputEditable" name="Search" id="Search"
                                       placeholder="Ingrese texto a buscar..." />
                            </div>

                            <button type="button"
                                    class="btn btn-success btn-sm busqueda-productos-action"
                                    id="btnBuscarProd">
                                <i class="bx bx-search me-1"></i>
                                <span>Buscar</span>
                                <span id="spnBuscarProd" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                            </button>

                            <div id="seccionSeleccionMultiple" class="busqueda-productos-selection" style="display: none;">
                                <div class="busqueda-productos-selection-inner">
                                    <div class="busqueda-productos-counter">
                                        <i class="bx bx-check-square text-success me-1"></i>
                                        <span class="fw-medium text-success">
                                            <span id="contadorSeleccionados">0</span> productos seleccionados
                                        </span>
                                    </div>
                                    <button type="button"
                                            id="btnAgregarSeleccionados"
                                            class="btn btn-primary btn-sm busqueda-productos-action">
                                        <i class="bx bx-plus-circle me-1"></i>Agregar Seleccionados
                                    </button>
                                    <button type="button"
                                            id="btnLimpiarSeleccionBusqueda"
                                            class="btn btn-outline-warning btn-sm busqueda-productos-action">
                                        <i class="bx bx-refresh me-1"></i>Limpiar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grid de resultados -->
                <div class="card card-golden">
                    <div class="card-body p-2">
                        <div id="divBusquedaAvanzada">
                            <!-- Aquí se carga el grid dinámicamente -->
                        </div>
                        @Html.Hidden("pagEstado", false)
                    </div>
                </div>

                <!-- Paginación -->
                <div class="row mt-3">
                    <div class="col-md-12 d-flex justify-content-center">
                        <div id="divPaginacionAdv"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
