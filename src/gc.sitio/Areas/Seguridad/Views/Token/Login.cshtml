<!DOCTYPE html>

@model gc.infraestructura.Dtos.Seguridad.LoginDto
<html lang="es" class="light-style">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Ingresar | GeCoNet</title>
    <meta name="description" content="Acceso al sistema de gestión comercial GeCoNet de Café América Mayorista S.A." />
    <meta name="theme-color" content="#0d4050" />

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/fonts/boxicons/basic/boxicons.css" />
    <link rel="stylesheet" href="~/css/extra.css" />
    <link rel="stylesheet" href="~/css/core.css" />
    <link rel="stylesheet" href="~/css/theme-default.css" />
    <link rel="stylesheet" href="~/lib/lobibox/css/lobibox.min.css" />
    <link rel="stylesheet" href="~/css/pages/login-geconet.css" asp-append-version="true" />
</head>

<body class="geco-login-page" data-pathbase="@Context.Request.PathBase">
    <main class="geco-login-shell" id="formulario" style="display:none">
        <section class="geco-login-presentation" aria-label="Presentación de GeCoNet">
            <div class="geco-login-brand geco-login-brand--light">
                <span class="geco-login-brand__mark">
                    <img src="~/img/gc.png" alt="" />
                </span>
                <span>GeCoNet</span>
            </div>

            <div class="geco-login-presentation__content">
                <p class="geco-login-eyebrow">Sistema de gestión comercial</p>
                <h1>Todo el negocio.<br />En un solo lugar.</h1>
                <p class="geco-login-lead">
                    Información, operaciones y decisiones conectadas para acompañar
                    el trabajo diario de Café América.
                </p>
            </div>

            <div class="geco-login-company geco-login-company--light">
                <span class="geco-login-company__logo">
                    <img src="~/img/Circulo CA.svg" alt="" />
                </span>
                <span>
                    <small>Empresa</small>
                    <strong>Café América Mayorista S.A.</strong>
                </span>
            </div>

            <div class="geco-login-rings" aria-hidden="true"></div>
        </section>

        <section class="geco-login-access" aria-labelledby="login-title">
            <div class="geco-login-card">
                <div class="geco-login-mobile-header" aria-label="GeCoNet, Café América">
                    <div class="geco-login-brand">
                        <span class="geco-login-brand__mark">
                            <img src="~/img/gc.png" alt="" />
                        </span>
                        <span>GeCoNet</span>
                    </div>
                    <span class="geco-login-mobile-header__divider" aria-hidden="true"></span>
                    <img class="geco-login-mobile-header__company" src="~/img/Circulo CA.svg" alt="Café América" />
                </div>

                <div class="geco-login-access__icon" aria-hidden="true">
                    <i class="bx bx-shield-quarter"></i>
                </div>
                <p class="geco-login-eyebrow geco-login-eyebrow--gold">Bienvenido</p>
                <h2 id="login-title">Ingresá a GeCoNet</h2>
                <p class="geco-login-intro">
                    Seleccioná tu administración e ingresá tus credenciales para continuar.
                </p>

                <form class="geco-login-form" asp-area="Seguridad" asp-action="Login" asp-controller="Token" method="post">
                    <div asp-validation-summary="ModelOnly" class="geco-login-validation" role="alert"></div>

                    <div class="geco-login-field">
                        <label for="Admid">Administración</label>
                        <div class="geco-login-control geco-login-control--select">
                            <i class="bx bx-building" aria-hidden="true"></i>
                            @Html.DropDownList("Admid", null, "Seleccione una administración...", new
                            {
                                @class = "form-select",
                                required = "required",
                                autocomplete = "organization",
                                aria_describedby = "AdmidHelp"
                            })
                        </div>
                        <span id="AdmidHelp" asp-validation-for="Admid" class="geco-login-field__error"></span>
                    </div>

                    <div class="geco-login-field">
                        <label for="UserName">Usuario</label>
                        <div class="geco-login-control">
                            <i class="bx bx-user" aria-hidden="true"></i>
                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Ingresá tu usuario"
                                   autocomplete="username"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   autofocus />
                        </div>
                        <span asp-validation-for="UserName" class="geco-login-field__error"></span>
                    </div>

                    <div class="geco-login-field">
                        <label for="Password">Contraseña</label>
                        <div class="geco-login-control">
                            <i class="bx bx-lock" aria-hidden="true"></i>
                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Ingresá tu contraseña"
                                   autocomplete="current-password" />
                            <button class="geco-login-password-toggle"
                                    id="togglePassword"
                                    type="button"
                                    aria-label="Mostrar contraseña"
                                    aria-pressed="false">
                                <i class="bx bx-eye-slash" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="geco-login-field__error"></span>
                    </div>

                    <button class="geco-login-submit" type="submit">
                        <span>Ingresar</span>
                        <span class="geco-login-submit__arrow" aria-hidden="true">&rarr;</span>
                    </button>
                </form>

                <div class="geco-login-security">
                    <i class="bx bx-shield" aria-hidden="true"></i>
                    <span>Acceso protegido a la plataforma de Café América</span>
                </div>
                <p class="geco-login-date">@Model.FechaNN</p>
            </div>
        </section>
    </main>

    <noscript>
        <style>#formulario { display: grid !important; }</style>
    </noscript>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/popper.js/umd/popper.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/lib/lobibox/js/lobibox.min.js"></script>
    <script src="~/lib/lobibox/js/messageboxes.min.js"></script>
    <script src="~/lib/lobibox/js/notifications.min.js"></script>
    <script src="~/js/site.js"></script>

    <script type="text/javascript">
        var MensajeErrorTempData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["error"]?.ToString()));
        var MensajeInfoTempData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["info"]?.ToString()));
        var MensajeWarnTempData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["warn"]?.ToString()));
        var MensajeSuccessTempData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["succ"]?.ToString()));
        var MensajeBlock = "<h3><i class='bx bx-loader-circle bx-spin'></i> Por favor, espere...</h3>";

        (function () {
            var toggle = document.getElementById('togglePassword');
            var password = document.getElementById('Password');

            if (!toggle || !password) return;

            toggle.addEventListener('click', function () {
                var showPassword = password.type === 'password';
                password.type = showPassword ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', showPassword.toString());
                toggle.setAttribute('aria-label', showPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');

                var icon = toggle.querySelector('i');
                icon.classList.toggle('bx-eye-slash', !showPassword);
                icon.classList.toggle('bx-eye', showPassword);
                password.focus();
            });
        })();
    </script>
</body>
</html>












