@model ListadoRankingModel
@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;

	var productos = new List<RepRkgRentabVtasDto>();
}
<style>
	/* El contenedor debe ser el scroll real y generar contexto */
	#containerListaProducto {
		position: relative;
/* 		height: 600px;
		max-height: 600px; */
		max-height: 60vh; /* ocupa como máximo el 80% de la altura visible */
		height: auto; /* deja que se ajuste dinámicamente */
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbGridProductos th,
	#tbGridProductos td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	/* Opcional: altura fija para todas las filas */
	#tbGridProductos tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}

	.grid-golden {
		width: 80%; /* ocupa el 80% del ancho disponible */
		margin: 0 auto; /* centra horizontalmente */
	}

	.grid-golden-body .table-wrapper table {
		width: 100%; /* la tabla se ajusta al ancho del contenedor */
	}

	.badge.bg-secondary {
		font-size: 0.70rem;
		padding: 0.20rem 0.35rem;
		border-radius: 0.25rem;
	}

	/* Hover del doble-chevron */
	#toggleFiltros:hover {
		color: #000;
		transform: scale(1.15);
	}
</style>

<div class="grid-golden">
	<div class="grid-golden-header">
		<div class="row align-items-md-center">
			<div class="col-md-10 col-sm-6 d-flex align-items-center">
				<h5 class="mb-0 flex-grow-1">
					<i class="bx bx-package me-2"></i>
					<strong>Ranking agrupado por Sector</strong>
				</h5>

				<!-- Doble-chevron toggle -->
				<i class="bx bx-chevrons-down fs-4 ms-2"
				   id="toggleFiltros"
				   data-bs-toggle="collapse"
				   data-bs-target="#filtrosCollapse"
				   role="button"
				   data-bs-placement="top"
				   title="Haz click acá para conocer los filtros aplicados"
				   style="
					cursor:pointer;
					transition: transform .25s ease, color .25s ease;
					color:#666;
					">
				</i>
			</div>

			<div class="col-md-2 col-sm-6">
				<div class="d-flex justify-content-sm-end"></div>
			</div>
		</div>
	</div>

	<!-- Contenedor colapsable (ocupa CERO espacio cuando está oculto) -->
	<div class="collapse" id="filtrosCollapse">
		<div class="mt-2">
			<span class="badge bg-secondary me-1">@Model.LeyendaFechas</span>
			<span class="badge bg-secondary me-1">@Model.LeyendaSuc</span>
			<span class="badge bg-secondary me-1">@Model.LeyendaProv</span>
			<span class="badge bg-secondary me-1">@Model.LeyendaFam</span>
			<span class="badge bg-secondary me-1">@Model.LeyendaRub</span>
		</div>
	</div>
	<div class="grid-golden-body">
		<div class="table-wrapper" id="containerListaProducto">
			<table class="table table-sm table-golden" id="tbGridProductos">
				<thead>
					<tr class="header">
						<th class="text-center" style="width: 6%;">ID</th>
						<th class="text-center" style="width: 32%;">Sector</th>
						<th class="text-center" style="width: 10%;" title="Cantidad Vendida">Cant. Vend.</th>
						<th class="text-center" style="width: 10%;">%Cant/Total</th>
						<th class="text-center" style="width: 10%;">Facturado</th>
						<th class="text-center" style="width: 10%;">%Fac/Total</th>
						<th class="text-center" style="width: 10%;">Ventas Netas</th>
						<th class="text-center" style="width: 10%;">Costo</th>
						<th class="text-center" style="width: 10%;">Rentabilidad</th>
						<th class="text-center" style="width: 10%;">%Rent/Total</th>
						<th class="text-center" style="width: 10%;">%Rent/Costo</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.GrillaProductoRnk != null && Model.GrillaProductoRnk.ListaDatos != null && Model.GrillaProductoRnk.ListaDatos.Count > 0)
					{
						productos = Model.GrillaProductoRnk.ListaDatos.OrderBy(x => x.sec_id).ToList();

						@foreach (var item in productos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							<tr class="@clase" onclick="selectReg(this, 'tbGridProductos')">
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.sec_id) align-center cell-fit-content">@Model.GrillaProductoRnk.FormatearDato(item.sec_id, FormatDato.Ninguno)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.sec_desc) cell-fit-content">@Model.GrillaProductoRnk.FormatearDato(item.sec_desc, FormatDato.Ninguno)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_cantidad) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_cantidad, GridHelper.FormatDato.Monto, false)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_cantidad_porc) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_cantidad_porc, GridHelper.FormatDato.Monto, false)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_facturacion) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_facturacion, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_facturacion_porc) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_facturacion_porc, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_neto) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_neto, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_costo) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_costo, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_rentabilidad) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_rentabilidad, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_rentabilidad_porc) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_rentabilidad_porc, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaProductoRnk.ObtenerClase(item.vtas_renta_costo_porc) text-right cell-fit-content">@GridHelper.FormatearDato(item.vtas_renta_costo_porc, FormatDato.Monto, true)</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="11" class="text-center text-muted py-4">
								<i class="bx bx-info-circle me-2"></i>
								No se encontraron productos con los criterios especificados
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="row mt-3">
			<div class="offset-md-3 col-md-6">
				<div id="divPaginacion" class="">
				</div>
			</div>
		</div>

	</div>
</div>
