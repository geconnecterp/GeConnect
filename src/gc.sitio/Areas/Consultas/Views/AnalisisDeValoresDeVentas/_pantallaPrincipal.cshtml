@model PrincipalModel
@{
}
<style>
	.tab-disabled {
		pointer-events: none;
		opacity: 0.5;
	}

	.tab-content-compact {
		/* padding: 0.75rem 0; */
		border-radius: 0.375rem;
		background-color: transparent;
		padding-bottom: 0.75rem;
		padding-right: 0;
		padding-left: 0;
		padding-top: 0.25rem;
	}

	/* Asegurar que los dropdowns de filtros flotantes se muestren por encima del menú principal */
	#filtrosAplicadosFloating {
		overflow: visible;
		z-index: 1050;
		flex-wrap: nowrap;
		white-space: nowrap;
		overflow-x: visible;
	}

		#filtrosAplicadosFloating .dropdown-menu {
			z-index: 3000 !important;
		}
	/* Si el header global tiene un z-index muy alto, forzamos el menu del filtro encima */
	.navbar, .main-header {
		z-index: 1100;
	}
</style>
<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="d-flex align-items-center w-100 mt-2">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsAnalisisDeVentasPrincipal">
			<li class="nav-item" role="presentation" id="tabMensual">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-mens" aria-controls="navs-top-mens" aria-selected="true" id="btnTabMensual">
					Mensual
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabDetalleMes">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-det" aria-controls="navs-top-det" aria-selected="false" tabindex="-1" id="btnTabDetalleMes">
					Detalle Mes
				</button>
			</li>
		</ul>
		<!-- Contenedor flotante para filtros aplicados -->
		<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center" style="position:absolute; right:100px; left:auto; top:170px; height:auto; width:auto; border-color:#d9534f; background-color:#fff; z-index:1050; padding:6px 10px; overflow:visible; gap:6px; display:inline-flex; white-space:nowrap;">
			<!-- Badges rellenadas por JS -->
		</div>
	</div>
	<div class="tab-content tab-content-compact">
		<div class="tab-pane fade tab-content-golden show active" id="navs-top-mens" role="tabpanel">
			<div id="divAnalisisMensual">
			</div>
		</div>
		<div class="tab-pane fade tab-content-golden" id="navs-top-det" role="tabpanel">
			<div id="divAnalisisDetalleMes">
			</div>
		</div>
	</div>
</div>