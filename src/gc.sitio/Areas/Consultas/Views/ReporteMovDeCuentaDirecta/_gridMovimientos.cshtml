@using static gc.infraestructura.Helpers.GridHelper
@model GridCoreSmart<MovimientoListaDto>
@{
    var alt = true;
    string clase = string.Empty;

    string grupoActual = string.Empty;
    string grupoAnterior = string.Empty;
    string leyendaAgrupador = string.Empty;
}
<style>
    thead th {
        position: sticky;
        top: 0px;
        z-index: 1; /* suficiente para estar sobre las filas */
        background: linear-gradient(to bottom, #b8860b, #daa520) !important;
        color: #fff !important;
    }

    .table-wrapper {
        /*max-height: 400px;  o lo que necesites */
        overflow-y: auto;
        position: relative;
    }

    #containerGridMovimientos {
        position: relative;
        height: 650px;
        max-height: 650px;
        overflow-y: auto;
        overflow-x: hidden !important;
        z-index: auto;
        margin-left: auto;
        margin-right: auto;
    }

    .container-auto {
        height: auto !important;
        max-height: none !important;
        overflow-x: hidden !important;
    }

    .table-golden {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .table-golden thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(to bottom, #b8860b, #daa520) !important;
            color: #fff !important;
        }

            .table-golden thead th {
                position: sticky;
                top: 0;
                z-index: 4;
                background: linear-gradient(to bottom, #b8860b, #daa520);
                color: #fff;
                box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
                background-clip: padding-box;
            }

            .table-golden thead,
            .table-golden thead th {
                /*background-color: #b8860b;  tu dorado */
                /* color: #333; */
            }

    #tbMovimientos th,
    #tbMovimientos td {
        padding: 0.01rem 0.15rem !important;
        line-height: 1.2 !important;
        height: auto !important;
    }

    #tbMovimientos tr {
        height: 1.6rem !important;
    }
</style>

<div class="card w-75 mx-auto" style="padding-left: 0px;padding-right: 0px;">
    <div class="card-body p-1">
        <div class="table-responsive text-nowrap  table-wrapper-500" id="containerGridMovimientos">
            <table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbMovimientos">
                <thead>
                    <tr class="header">
                        <th style="width:10%;" class="text-sm-center" scope="col">OP N°</th>
                        <th style="width:5%;" class="text-sm-center" scope="col">FECHA</th>
                        <th style="width:10%;" class="text-sm-center" scope="col">COMPROBANTE</th>
                        <th style="width:30%;" class="text-sm-center" scope="col">RAZON SOCIAL</th>
                        <th style="width:10%;" class="text-sm-center" scope="col">CUIT</th>
                        <th style="width:20%;" class="text-sm-center" scope="col">CONCEPTO</th>
                        <th style="width:10%;" class="text-sm-center" scope="col">IMPORTE</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
                    {
                        var registros = Model.ListaDatos.OrderBy(x => x.ctag_id).ToList();

                        @foreach (var item in Model.ListaDatos)
                        {
                            grupoActual = item.ctag_id;

                            // Si cambia la cuenta, insertamos una fila de encabezado para la cuenta
                            if (grupoActual != grupoAnterior)
                            {
                                leyendaAgrupador = $"Cuenta {item.ctag_id} - {item.ctag_denominacion}";
                                <tr class="table-secondary fw-bold">
                                    <td colspan="7" class="text-center">
                                        <i class="bx bx-folder me-1"></i>
                                        @leyendaAgrupador
                                    </td>
                                </tr>
                                grupoAnterior = grupoActual;
                                alt = true; // Reiniciar alternancia de colores después de cada familia
                            }

                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                            <tr class="@clase" onclick="selectReg(this,'tbMovimientos')">
                                <td class="@Model.ObtenerClase(item.op_compte) align-center">@Model.FormatearDato(item.op_compte, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.op_fecha) align-center">@Model.FormatearDato(item.op_fecha, FormatDato.Fecha)</td>
                                <td class="@Model.ObtenerClase(item.cm_compte) align-center">@Model.FormatearDato(item.cm_compte, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.cm_nombre) align-left">@Model.FormatearDato(item.cm_nombre, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.cm_cuit) align-center">@Model.FormatearDato(item.cm_cuit, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.ctag_motivo) align-left">@Model.FormatearDato(item.ctag_motivo, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.cc_importe) align-right">@Model.FormatearDato(item.cc_importe, FormatDato.Monto)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="fila-vacia">
                            <td colspan="6" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>
                                No hay items para mostrar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>