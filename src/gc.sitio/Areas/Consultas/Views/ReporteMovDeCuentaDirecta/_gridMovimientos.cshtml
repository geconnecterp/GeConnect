@using static gc.infraestructura.Helpers.GridHelper
@model ListadoMovDeCtaDtaModel
@{
    var alt = true;
    string clase = string.Empty;

    string grupoActual = string.Empty;
    string grupoAnterior = string.Empty;
    string leyendaAgrupador = string.Empty;
}
<style>
    thead th {
        position: sticky;
        top: 0px;
        z-index: 1; /* suficiente para estar sobre las filas */
        background: linear-gradient(to bottom, #b8860b, #daa520) !important;
        color: #fff !important;
    }

    .table-wrapper {
        /*max-height: 400px;  o lo que necesites */
        overflow-y: auto;
        position: relative;
    }

    #containerGridMovimientos {
        position: relative;
        height: 650px;
        max-height: 650px;
        overflow-y: auto;
        overflow-x: hidden !important;
        z-index: auto;
        margin-left: auto;
        margin-right: auto;
    }

    .container-auto {
        height: auto !important;
        max-height: none !important;
        overflow-x: hidden !important;
    }

    .table-golden {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .table-golden thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(to bottom, #b8860b, #daa520) !important;
            color: #fff !important;
        }

            .table-golden thead th {
                position: sticky;
                top: 0;
                z-index: 4;
                background: linear-gradient(to bottom, #b8860b, #daa520);
                color: #fff;
                box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
                background-clip: padding-box;
            }

            .table-golden thead,
            .table-golden thead th {
                /*background-color: #b8860b;  tu dorado */
                /* color: #333; */
            }

    #tbMovimientos th,
    #tbMovimientos td {
        padding: 0.01rem 0.15rem !important;
        line-height: 1.2 !important;
        height: auto !important;
    }

    #tbMovimientos tr {
        height: 1.6rem !important;
    }

    .badge.bg-secondary {
        font-size: 0.70rem;
        padding: 0.20rem 0.35rem;
        border-radius: 0.25rem;
    }

    /* Hover del doble-chevron */
    #toggleFiltros:hover {
        color: #000;
        transform: scale(1.15);
    }
</style>
<div class="grid-golden w-75 mx-auto">
    <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-10 col-sm-6 d-flex align-items-center">
                <h5 class="mb-0 flex-grow-1">
                    <i class="bx bx-package me-2"></i>
                    <strong>Reporte</strong>
                </h5>

                <!-- Doble-chevron toggle -->
                <i class="bx bx-chevrons-down fs-4 ms-2"
                   id="toggleFiltros"
                   data-bs-toggle="collapse"
                   data-bs-target="#filtrosCollapse"
                   role="button"
                   data-bs-placement="top"
                   title="Haz click acá para conocer los filtros aplicados"
                   style="
                    cursor:pointer;
                    transition: transform .25s ease, color .25s ease;
                    color:#666;
                    ">
                </i>
            </div>

            <div class="col-md-2 col-sm-6">
                <div class="d-flex justify-content-sm-end"></div>
            </div>
        </div>
    </div>

    <!-- Contenedor colapsable (ocupa CERO espacio cuando está oculto) -->
    <div class="collapse" id="filtrosCollapse">
        <div class="mt-2">
            <span class="badge bg-secondary me-1">@Model.LeyendaFechas</span>
            <span class="badge bg-secondary me-1">@Model.LeyendaCuentas</span>
        </div>
    </div>
    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap" id="containerGridMovimientos">
            <table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbMovimientos">
                <thead>
                    <tr class="header">
                        <th style="width:10%;" class="text-sm-center" scope="col">OP N°</th>
                        <th style="width:5%;" class="text-sm-center" scope="col">FECHA</th>
                        <th style="width:10%;" class="text-sm-center" scope="col">COMPROBANTE</th>
                        <th style="width:30%;" class="text-sm-center" scope="col">RAZON SOCIAL</th>
                        <th style="width:10%;" class="text-sm-center" scope="col">CUIT</th>
                        <th style="width:20%;" class="text-sm-center" scope="col">CONCEPTO</th>
                        <th style="width:10%;" class="text-sm-center" scope="col">IMPORTE</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.GrillaProducto != null && Model.GrillaProducto.ListaDatos != null && Model.GrillaProducto.ListaDatos.Count > 0)
                    {
                        var registros = Model.GrillaProducto.ListaDatos.OrderBy(x => x.ctag_id).ToList();

                        @foreach (var item in Model.GrillaProducto.ListaDatos)
                        {
                            grupoActual = item.ctag_id;

                            // Si cambia la cuenta, insertamos una fila de encabezado para la cuenta
                            if (grupoActual != grupoAnterior)
                            {
                                leyendaAgrupador = $"Cuenta {item.ctag_id} - {item.ctag_denominacion}";
                                <tr class="table-secondary fw-bold">
                                    <td colspan="7" class="text-center">
                                        <i class="bx bx-folder me-1"></i>
                                        @leyendaAgrupador
                                    </td>
                                </tr>
                                grupoAnterior = grupoActual;
                                alt = true; // Reiniciar alternancia de colores después de cada familia
                            }

                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                            <tr class="@clase" onclick="selectReg(this,'tbMovimientos')">
                                <td class="@Model.GrillaProducto.ObtenerClase(item.op_compte) align-center">@Model.GrillaProducto.FormatearDato(item.op_compte, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaProducto.ObtenerClase(item.op_fecha) align-center">@Model.GrillaProducto.FormatearDato(item.op_fecha, FormatDato.Fecha)</td>
                                <td class="@Model.GrillaProducto.ObtenerClase(item.cm_compte) align-center">@Model.GrillaProducto.FormatearDato(item.cm_compte, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaProducto.ObtenerClase(item.cm_nombre) align-left">@Model.GrillaProducto.FormatearDato(item.cm_nombre, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaProducto.ObtenerClase(item.cm_cuit) align-center">@Model.GrillaProducto.FormatearDato(item.cm_cuit, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaProducto.ObtenerClase(item.ctag_motivo) align-left">@Model.GrillaProducto.FormatearDato(item.ctag_motivo, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaProducto.ObtenerClase(item.cc_importe) align-right">@Model.GrillaProducto.FormatearDato(item.cc_importe, FormatDato.Monto)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="fila-vacia">
                            <td colspan="6" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>
                                No hay items para mostrar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>