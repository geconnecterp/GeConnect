@model ProyFinanModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	int semanaActual = 0;
	int semanaAnterior = 0;

	var alt = true;
	string clase = string.Empty;
}
<div class="card">
	<div class="card-body" style="padding: 5px;">
		<div class="row">
			<div class="col-12">
				<div class="card mb-3">
					<div class="">
						<div class="row g-3">
							<div class="col-md-3 col-sm-6">
								<div class="p-2 rounded bg-light d-flex flex-column justify-content-between h-100">
									<div>
										<label class="form-label">Saldos Bancarios Disponibles (Según Extracto):</label>
									</div>
									<div>
										<span class="form-control-plaintext text-end">@Model.SaldoBancarioDisponible.ToString("C")</span>
									</div>
								</div>
							</div>
							<div class="col-md-3 col-sm-6">
								<div class="p-2 rounded bg-secondary-subtle d-flex flex-column justify-content-between h-100">
									<div>
										<label class="form-label">Saldos en Descubierto (Según Extracto):</label>
									</div>
									<div>
										<span class="form-control-plaintext text-end">@Model.SaldoBancarioEnDescubierto.ToString("C")</span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-sm-6">
								<div class="p-2 rounded bg-light d-flex flex-column justify-content-between h-100">
									<div>
										<label class="form-label">Valores al Cobro no acreditados:</label>
									</div>
									<div>
										<span class="form-control-plaintext text-end">@Model.ValoresAlCobroNoAcreditados.ToString("C")</span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-sm-6">
								<div class="p-2 rounded bg-secondary-subtle d-flex flex-column justify-content-between h-100">
									<div>
										<label class="form-label">Documentos a Cobrar Vencidos (30 días):</label>
									</div>
									<div>
										<span class="form-control-plaintext text-end">@Model.DocumentosACobrarVencidos.ToString("C")</span>
									</div>
								</div>
							</div>
							<div class="col-md-2 col-sm-6">
								<div class="p-2 rounded bg-light d-flex flex-column justify-content-between h-100">
									<div>
										<label class="form-label">Proyección de Ventas Diarias:</label>
									</div>
									<div>
										<span class="form-control-plaintext text-end">@Model.ProyeccionDeVentasDiarias.ToString("C")</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive table-wrapper-400-full-width">
					<table class="table table-bordered table-sm mb-0 table-golden" id="tbGridProyFinan">
						<thead>
							<tr class="header">
								<th class="align-center">Fecha</th>
								<th class="align-center">Cheques Emi + Transf. Bco.</th>
								<th class="align-center">Cheques Emi No Entregados</th>
								<th class="align-center">Obligaciones a Pagar</th>
								<th class="align-center">Proyección Gastos</th>
								<th class="align-center">Total Proyección Egresos</th>
								<th style="width:1%; background-color:#f8f9fa;"></th> <!-- columna en blanco -->
								<th class="align-center">Cheques en Cartera</th>
								<th class="align-center">Valores al Cobro</th>
								<th class="align-center">Documentos a Cobrar</th>
								<th class="align-center">Total Proy. Ingresos</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.GrillaProyFinan != null && Model.GrillaProyFinan.ListaDatos != null && Model.GrillaProyFinan.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.GrillaProyFinan.ListaDatos)
								{
									semanaActual = item.semana;
									if (semanaActual != semanaAnterior)
									{
										<tr class="table-secondary fw-bold">
											<td colspan="13" class="text-center">
												<i class="bx bx-folder me-1"></i>
												@item.leyendaSemana
											</td>
										</tr>
										semanaAnterior = semanaActual;
										alt = true;
									}
									if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
									<tr class="@clase" onclick="selectReg(this, 'tbGridProyFinan')">
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.desde) align-center cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.desde, FormatDato.Fecha)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.cheque_emit_mas_trans_bco) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.cheque_emit_mas_trans_bco, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.che_emi_nent) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.che_emi_nent, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.apagar) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.apagar, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.proy_gastos) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.proy_gastos, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.total_proy_egresos) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.total_proy_egresos, FormatDato.Monto)</td>
										<td style="background-color:#f8f9fa;"></td> <!-- celda en blanco -->
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.che_cartera) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.che_cartera, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.che_depo) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.che_depo, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.valores_alcobro) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.valores_alcobro, FormatDato.Monto)</td>
										<td class="@Model.GrillaProyFinan.ObtenerClase(item.total_proy_ingresos) align-right cell-fit-content">@Model.GrillaProyFinan.FormatearDato(item.total_proy_ingresos, FormatDato.Monto)</td>
									</tr>
								}
							}
							else
							{
								<tr>
									<td colspan="18" class="text-center">No se han encontrado datos para los criterios especificados.</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>