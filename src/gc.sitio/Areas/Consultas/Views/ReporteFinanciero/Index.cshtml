@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<div class="container mt-2">
	<div id="divDetalle" style="">
		<div class="d-flex align-items-center w-100 mt-2">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsReporteFinanciero">
				<li class="nav-item" role="presentation" id="tabProyeccionFinanciera">
					<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabProyeccionFinanciera">
						Proyección Financiera
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabSaldoDeCuenta">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabSaldoDeCuenta">
						Saldo de Cuenta
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabFlujoDeIngreso">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-cat" aria-controls="navs-top-cat" aria-selected="false" tabindex="-2" id="btnTabFlujoDeIngreso">
						Flujo de Ingreso
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabProyeccionDeEgreso">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-dog" aria-controls="navs-top-dog" aria-selected="false" tabindex="-3" id="btnTabProyeccionDeEgreso">
						Proyección de Egreso
					</button>
				</li>
			</ul>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Desde:</span>
							<input type="date" class="form-control" id="fechaDesdeProyeccionFinanciera" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaProyeccionFinanciera" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarProyeccionFinanciera"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirProyeccionFinanciera"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div id="divProyeccionFinanciera">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaSaldoDeCuenta" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarSaldoDeCuenta"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirSaldoDeCuenta"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div id="divSaldoDeCuenta">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-cat" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Desde:</span>
							<input type="date" class="form-control" id="fechaDesdeFlujoDeIngreso" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaFlujoDeIngreso" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarFlujoDeIngreso"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirFlujoDeIngreso"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div id="divFlujoDeIngreso">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-dog" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarProyeccionDeEgreso"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirProyeccionDeEgreso"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div class="row col-12">
					<div class="col-4" id="divProyeccionDeEgresoGroup">
					</div>
					<div class="col-8" id="divProyeccionDeEgresoDetail">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">

		var buscarProyeccionFinancieraURL = "@Url.Action("BuscarProyeccionFinanciera", "ReporteFinanciero", new { area = "Consultas" })";
		var buscarSaldoDeCuentasURL = "@Url.Action("BuscarSaldoDeCuentas", "ReporteFinanciero", new { area = "Consultas" })";
		var buscarFlujoDeIngresoURL = "@Url.Action("BuscarFlujoDeIngreso", "ReporteFinanciero", new { area = "Consultas" })";
		var buscarPoyeccionEgresoGroupURL = "@Url.Action("BuscarPoyeccionEgresoGroup", "ReporteFinanciero", new { area = "Consultas" })";
		var buscarPoyeccionEgresoDetailURL = "@Url.Action("BuscarPoyeccionEgresoDetail", "ReporteFinanciero", new { area = "Consultas" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>

	<script src="~/js/app/areas/Consultas/reportefinanciero/repfinan.js" type="text/javascript"></script>
}