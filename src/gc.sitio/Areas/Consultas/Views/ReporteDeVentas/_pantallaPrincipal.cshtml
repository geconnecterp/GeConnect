@model PrincipalModel
@{
}
<style>
	.tab-disabled {
		pointer-events: none;
		opacity: 0.5;
	}

	.tab-content-compact {
		/* padding: 0.75rem 0; */
		border-radius: 0.375rem;
		background-color: transparent;
		padding-bottom: 0.75rem;
		padding-right: 0;
		padding-left: 0;
		padding-top: 0.25rem;
	}
</style>
<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="row mb-1">
		<div class="col-12">
			<div class="p-1 border rounded bg-light">
				<div class="d-flex justify-content-between align-items-center flex-wrap">
					<div class="d-flex flex-wrap gap-4">
						<div><strong>Filtros:</strong> @Model.Titulo</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="d-flex align-items-center w-100 mt-2">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsReporteDeVentasPrincipal">
			<li class="nav-item" role="presentation" id="tabProcesosDeCaja">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-proc" aria-controls="navs-top-proc" aria-selected="true" id="btnTabProcesosDeCaja">
					Procesos de Caja
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabRendicionCierre">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-rend" aria-controls="navs-top-rend" aria-selected="false" tabindex="-1" id="btnTabRendicionCierre">
					Rendición Cierre
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabAnaliticoOperacion">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-ana" aria-controls="navs-top-ana" aria-selected="false" tabindex="-1" id="btnTabAnaliticoOperacion">
					Analítico de Operación
				</button>
			</li>
		</ul>
	</div>
	<div class="tab-content tab-content-compact">
		<div class="tab-pane fade tab-content-golden show active" id="navs-top-proc" role="tabpanel">
			<div id="divProcesosDeCaja">
			</div>
		</div>
		<div class="tab-pane fade tab-content-golden" id="navs-top-rend" role="tabpanel">
			<div id="divRendicionCierre">
			</div>
		</div>
		<div class="tab-pane fade tab-content-golden" id="navs-top-ana" role="tabpanel">
			<div id="divAnaliticoOperacion">
			</div>
		</div>
	</div>
</div>