@using gc.infraestructura.Dtos
@model GridCoreSmart<CajaProcesoCierresListaDto>
@{
}
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#divProcesos {
		margin-left: auto;
		margin-right: auto;
	}

	.tabla-desactivada {
		pointer-events: none;
		opacity: 0.5;
	}

	.disabled-row {
		cursor: not-allowed !important;
	}

	.table-wrapper-full {
		max-height: calc(100vh - 250px); /* ajustá 250px según lo que ocupe tu header, filtros, etc */
		overflow-y: auto;
	}

	.table-wrapper-small {
		max-height: 150px !important; /* o el tamaño que quieras */
		overflow-y: auto;
	}
</style>
<div class="grid-golden h-100">
	<div class="grid-golden-body p-1">
		<div id="divProcesos" class="table-responsive table-wrapper-full">
			<table class="table table-sm table-hover mb-0 table-golden" id="tbGridCierres">
				<thead class="sticky-top table-golden-header-compact">
					<tr class="header">
						<th class="text-center th-compact">Cierre</th>
						<th class="text-center th-compact">PV</th>
						<th class="text-center th-compact">Cajero</th>
						<th class="text-center th-compact">Estado</th>
					</tr>
				</thead>
				<tbody>
					@if (Model?.ListaDatos?.Any() == true)
					{
						foreach (var item in Model.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }
							<tr class="@clase"
								data-caja-nro-proceso="@item.caja_nro_proceso"
								data-caja-nro-cierre="@item.caja_nro_cierre"
								data-caja-id="@item.caja_id"
								data-cierre-estado="@item.estado">
								<td class="text-center">
									@item.caja_nro_cierre
								</td>
								<td class="text-center">
									@item.caja_id
								</td>
								<td class="text-start">
									@item.usu_apellidoynombre
								</td>
								<td class="text-start">
									@item.estado
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="5" class="text-center text-muted py-2">
								<i class="bx bx-info-circle me-1"></i>No hay cierres de caja disponibles
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
<div class="row">
	<div class="offset-md-3 col-md-6">
		<div id="divPaginacion">
		</div>
	</div>
</div>