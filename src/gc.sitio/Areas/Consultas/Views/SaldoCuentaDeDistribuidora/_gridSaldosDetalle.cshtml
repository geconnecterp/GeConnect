@using static gc.infraestructura.Helpers.GridHelper
@model GridCoreSmart<SaldoDetalleDto>
@{
	var alt = true;
	string clase = string.Empty;

	string grupoActual = string.Empty;
	string grupoAnterior = string.Empty;
	string leyendaAgrupador = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
		z-index: 1; /* suficiente para estar sobre las filas */
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		/*max-height: 400px;  o lo que necesites */
		overflow-y: auto;
		position: relative;
	}

	#containerGridDetalleSaldos {
		position: relative;
		height: 650px;
		max-height: 650px;
		overflow-y: auto;
		overflow-x: hidden !important;
		z-index: auto;
		margin-left: auto;
		margin-right: auto;
	}

	.container-auto {
		height: auto !important;
		max-height: none !important;
		overflow-x: hidden !important;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbDetalleDeSaldos th,
	#tbDetalleDeSaldos td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbDetalleDeSaldos tr {
		height: 1.6rem !important;
	}

	/* Oculta bordes internos de las dos primeras columnas */
	tr.sin-bordes td:nth-child(1),
	tr.sin-bordes td:nth-child(2) {
		border-top: 0 !important;
		border-bottom: 0 !important;
	}

	tr.fila-grupo td {
		font-weight: bold !important;
	}
</style>
<div class="card mx-auto" style="padding-left: 0px;padding-right: 0px;">
	<div class="card-body p-1">
		<div class="table-responsive text-nowrap  table-wrapper-500" id="containerGridDetalleSaldos">
			<table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbDetalleDeSaldos">
				<thead>
					<tr class="header">
						<th style="width:30%;" class="text-sm-center" scope="col">CUENTA</th>
						<th style="width:10%;" class="text-sm-center" scope="col">TOTAL</th>
						<th style="width:10%;" class="text-sm-center" scope="col">COMPROBANTE</th>
						<th style="width:5%;" class="text-sm-center" scope="col">CUOTA</th>
						<th style="width:5%;" class="text-sm-center" scope="col">ESTADO</th>
						<th style="width:10%;" class="text-sm-center" scope="col">EMITIDO</th>
						<th style="width:10%;" class="text-sm-center" scope="col">DÍAS ATR.</th>
						<th style="width:10%;" class="text-sm-center" scope="col">VENCIMIENTO</th>
						<th style="width:10%;" class="text-sm-center" scope="col">IMPORTE</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
					{
						var registros = Model.ListaDatos.OrderBy(x => x.ve_id).ToList();
						var acumulados = Model.ListaDatos.GroupBy(x => new { x.ve_id, x.cta_id })
														.ToDictionary(
															g => new { g.Key.ve_id, g.Key.cta_id },
															g => g.Sum(z => z.cv_importe)
														);
						var primeraFilaMostrada = new HashSet<string>();
						@foreach (var item in Model.ListaDatos)
						{
							grupoActual = item.ve_id;

							var key = new { item.ve_id, item.cta_id };
							var groupKey = $"{item.ve_id}-{item.cta_id}";

							bool esPrimeraFila = !primeraFilaMostrada.Contains(groupKey);
							var claseInterna = esPrimeraFila ? "" : "sin-bordes";
							var claseGrupo = esPrimeraFila ? "fila-grupo" : "";

							var cuenta = esPrimeraFila ? $"{item.cta_denominacion} ({item.cta_id})" : "";
							var sum = esPrimeraFila ? acumulados[key] : (decimal?)null;

							if (esPrimeraFila)
								primeraFilaMostrada.Add(groupKey);

							// Si cambia la cuenta, insertamos una fila de encabezado para la cuenta
							if (grupoActual != grupoAnterior)
							{
								leyendaAgrupador = $"Vendedor {item.ve_id} - {item.ve_nombre}";
								<tr class="table-secondary fw-bold">
									<td colspan="9" class="text-center">
										<i class="bx bx-folder me-1"></i>
										@leyendaAgrupador
									</td>
								</tr>
								grupoAnterior = grupoActual;
								alt = true; // Reiniciar alternancia de colores después de cada familia
							}
							//var cuenta = $"{item.cta_denominacion} ({item.cta_id})";
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							<tr class="@clase @claseInterna @claseGrupo" onclick="selectReg(this,'tbDetalleDeSaldos')">
								<td class="@Model.ObtenerClase(cuenta) align-left">@Model.FormatearDato(cuenta, FormatDato.Ninguno)</td>
								<td class="@Model.ObtenerClase(sum) align-right">@Model.FormatearDato(sum, FormatDato.Monto)</td>
								<td class="@Model.ObtenerClase(item.cm_compte) align-center">@Model.FormatearDato(item.cm_compte, FormatDato.Ninguno)</td>
								<td class="@Model.ObtenerClase(item.cm_compte_cuota) align-center">@Model.FormatearDato(item.cm_compte_cuota, FormatDato.Ninguno)</td>
								<td class="@Model.ObtenerClase(item.cv_estado) align-center">@Model.FormatearDato(item.cv_estado, FormatDato.Ninguno)</td>
								<td class="@Model.ObtenerClase(item.cv_fecha_carga) align-center">@Model.FormatearDato(item.cv_fecha_carga, FormatDato.Fecha)</td>
								<td class="@Model.ObtenerClase(item.atraso) align-right">@Model.FormatearDato(item.atraso, FormatDato.Ninguno)</td>
								<td class="@Model.ObtenerClase(item.cv_fecha_vto) align-center">@Model.FormatearDato(item.cv_fecha_vto, FormatDato.Fecha)</td>
								<td class="@Model.ObtenerClase(item.cv_importe) align-center">@Model.FormatearDato(item.cv_importe, FormatDato.Monto)</td>
							</tr>
						}
					}
					else
					{
						<tr class="fila-vacia">
							<td colspan="9" class="text-center text-muted py-2">
								<i class="bx bx-info-circle me-1"></i>
								No hay items para mostrar.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>