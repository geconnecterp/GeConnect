@model FiltroMovYCarteraDeCuentaFinanModel
<style>
	.hidden {
		display: none !important;
	}

</style>
<div class="filter-golden w-50">
	<div class="filter-golden-body">
		<div class="row mb-3 mt-3">
			<div class="col-12">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
						<label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
					</div>
				</div>
				<div class="row">
					<div class="col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text fixed-lbl-for-abm-70" id="lbIdDesde">Desde:</span>
							<input type="date" class="form-control inputEditable" asp-for="Desde"
								   style="background-color:rgb(251,255,195);font-weight:900;" />
						</div>
					</div>

					<div class="col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text fixed-lbl-for-abm-70" id="lbIdHasta">Hasta:</span>
							<input type="date" class="form-control inputEditable" asp-for="Hasta"
								   style="background-color:rgb(251,255,195);font-weight:900;" />
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row mb-3 mt-3">
			<div class="col-12">
				<div class="row">
					<div class="col-sm-12">
						<div class="input-group input-group-sm">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkTipoCuenta" />
								<label class="form-check-label" for="chkTipoCuenta" id="lbTipoCuenta"></label>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="input-group input-group-sm" id="divListaTipoCuenta">
							@Html.DropDownListFor(m => m.TipoCuentaSeleccionada, Model.ListaTipoCuenta, "Seleccionar", new { @id = "listaTipoCuenta", @class = "form-control inputEditable activable" })
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row mb-3 mt-3">
			<div class="col-12">
				<div class="row">
					<div class="col-sm-12">
						<div class="input-group input-group-sm">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkCuentaFin" />
								<label class="form-check-label" for="chkCuentaFin" id="lbCuentaFin"></label>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12" id="divListaCuentaFin">
						<div class="input-group input-group-sm">
							@Html.DropDownListFor(m => m.CuentaFinancieraSeleccionada, Model.ListaCuentaFinanciera, "Seleccionar", new { @id = "listaCuentaFin", @class = "form-control inputEditable activable" })
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="filter-golden-footer">
			<div class="row m-3">
				<div class="d-flex justify-content-around">
					<button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializa</button>
					<button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
				</div>
			</div>
		</div>
	</div>
</div>