@using gc.sitio.Areas.Mstk.Models.ConsultaDeRecepcionDeProveedores
@model PrincipalConsultaDeTransfInternaDeStockModel
@{
}
<style>
	.tab-disabled {
		pointer-events: none;
		opacity: 0.5;
		transition: opacity 0.25s ease-in-out, transform 0.15s ease-in-out;
	}

		.tab-disabled.tab-clicked {
			transform: scale(0.97);
			opacity: 0.35;
		}

	.tab-content-compact {
		/* padding: 0.75rem 0; */
		border-radius: 0.375rem;
		background-color: transparent;
		padding-bottom: 0.75rem;
		padding-right: 0;
		padding-left: 0;
		padding-top: 0.25rem;
	}

	/* Asegurar que los dropdowns de filtros flotantes se muestren por encima del menú principal */
	#filtrosAplicadosFloating {
		overflow: visible;
		z-index: 1050;
		flex-wrap: nowrap;
		white-space: nowrap;
		overflow-x: visible;
	}

		#filtrosAplicadosFloating .dropdown-menu {
			z-index: 3000 !important;
		}
	/* Si el header global tiene un z-index muy alto, forzamos el menu del filtro encima */
	.navbar, .main-header {
		z-index: 1100;
	}
</style>
<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="d-flex align-items-center w-100 mt-2">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsConsultaDevolucionAProveedores">
			<li class="nav-item" role="presentation" id="tabDevoluciones">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-devs" aria-controls="navs-top-devs" aria-selected="true" id="btnTabDevoluciones">
					Devoluciones
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabDetalle">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-det" aria-controls="navs-top-det" aria-selected="false" tabindex="-1" id="btnTabDetalle">
					Detalle
				</button>
			</li>
		</ul>
		<!-- Contenedor flotante para filtros aplicados -->
		<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center" style="position:absolute; right:125px; left:auto; top:175px; height:auto; width:auto; border-color:#d9534f; background-color:#fff; z-index:1050; padding:6px 10px; overflow:visible; gap:6px; display:inline-flex; white-space:nowrap;">
			<!-- Badges rellenadas por JS -->
		</div>
	</div>
	<div class="tab-content tab-content-compact">
		<div class="tab-pane fade tab-content-golden show active" id="navs-top-devs" role="tabpanel">
			<div id="divDevoluciones">
			</div>
		</div>
		<div class="tab-pane fade tab-content-golden" id="navs-top-det" role="tabpanel">
			<div id="divDetalleDevolucion">
			</div>
		</div>
	</div>
</div>