@using gc.infraestructura.Helpers
@model ProductosEnValorizacionModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	/* El contenedor debe ser el scroll real y generar contexto */
	#containerValorGridProductos {
		position: relative;
		height: 500px;
		max-height: 500px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbValorGridProductos td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	#tbValorGridProductos thead th {
		/* padding: .5rem .5rem !important; */
	}


	/* Opcional: altura fija para todas las filas */
	#tbValorGridProductos tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}

</style>
<div class="table-wrapper" id="containerValorGridProductos">
	<table class="table table-sm table-golden" id="tbValorGridProductos">
		@if (Model.MostrarConteoGrupo2)
		{
			<thead>
				<tr class="header">
					<th class="text-center" style="width: 5%;">ID</th>
					<th class="text-center" style="width: 41%;">Descripción</th>
					<th class="text-center" style="width: 10%;">STK</th>
					<th class="text-center" style="width: 17%;">Conteo Grupo 1</th>
					<th class="text-center" style="width: 17%;">Conteo Grupo 2</th>
					<th class="text-center" style="width: 10%;">Dif</th>
				</tr>
			</thead>
		}
		else
		{
			<thead>
				<tr class="header">
					<th class="text-center" style="width: 5%;">ID</th>
					<th class="text-center" style="width: 45%;">Descripción</th>
					<th class="text-center" style="width: 10%;">STK</th>
					<th class="text-center" style="width: 20%;">Conteo Grupo 1</th>
					<th class="text-center" style="width: 10%;">Dif</th>
				</tr>
			</thead>
		}
		
		<tbody>
			@if (Model != null && Model.GrillaProductos != null && Model.GrillaProductos.ListaDatos != null && Model.GrillaProductos.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaProductos.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbValorGridProductos')" data-p-id="@item.p_id" data-inv-nro="@item.inv_nro" data-ps-ajuste="@item.ps_ajuste">
						<td class="@Model.GrillaProductos.ObtenerClase(item.p_id) align-center cell-fit-content">@Model.GrillaProductos.FormatearDato(item.p_id, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaProductos.ObtenerClase(item.p_desc) cell-fit-content">@Model.GrillaProductos.FormatearDato(item.p_desc, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaProductos.ObtenerClase(item.ps_stk) cell-fit-content">@GridHelper.FormatearDato(item.ps_stk, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.GrillaProductos.ObtenerClase(item.planillas_conteo1) cell-fit-content">@Model.GrillaProductos.FormatearDato(item.planillas_conteo1, FormatDato.Monto)</td>
						@if (Model.MostrarConteoGrupo2)
						{
							<td class="@Model.GrillaProductos.ObtenerClase(item.planillas_conteo2) cell-fit-content">@Model.GrillaProductos.FormatearDato(item.planillas_conteo2, FormatDato.Monto)</td>
						}
						@* <td class="@Model.GrillaProductos.ObtenerClase(item.planillas_conteo2) cell-fit-content">@Model.GrillaProductos.FormatearDato(item.planillas_conteo2, FormatDato.Monto)</td> *@
						<td class="@Model.GrillaProductos.ObtenerClase(item.ps_conteo) cell-fit-content">@Model.GrillaProductos.FormatearDato(item.ps_conteo, FormatDato.Monto)</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="6" class="text-center text-muted py-4">
						<i class="bx bx-info-circle me-2"></i>
						No se encontraron productos con los criterios especificados
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>