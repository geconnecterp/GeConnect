@model InventarioCargaGrillaRubrosModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#containerGrillaRubros {
		flex: 1; /* se estira para ocupar todo el espacio */
		overflow-y: auto; /* scroll si hay muchas filas */
	}

</style>
<div class="table-responsive table-wrapper-200-full-width flex-grow-1" id="containerGrillaRubros">
	<table class="table table-bordered table-hover table-golden h-50" id="tbListaRubros">
		<thead>
			<tr class="header">
				<th class="text-center" scope="col">Rubros</th>
				<th style="width:4%;"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaRubros != null && Model.GrillaRubros.ListaDatos != null && Model.GrillaRubros.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaRubros.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase"
						onclick="selectItemGrillaRubro(this);">
						<td class="@Model.GrillaRubros.ObtenerClase(item.rub_desc)">@Model.GrillaRubros.FormatearDato(item.rub_desc, FormatDato.Ninguno)</td>
						<td class="text-center align-middle">
							<div class="d-flex justify-content-center gap-1">
								<button type="button" class="btn btn-danger btn-icon-compact" title="Quitar rubro" onclick="eliminarItemRubro('@item.inv_nro','@item.rub_id')">
									<i class="bx bx-trash"></i>
								</button>
							</div>
						</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="2" class="text-center text-muted">No hay rubros cargados</td>
				</tr>
			}
		</tbody>
	</table>
</div>