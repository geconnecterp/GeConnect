@model InventarioCargaGrillaUsuariosModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>

	.disabled-row {
		pointer-events: none; /* bloquea clicks */
		opacity: 0.6; /* opcional: se ve apagado */
	}

	/* Compactar filas de la tabla */
	#tbListaUsuarios td,
	#tbListaUsuarios th {
		padding: 0.25rem 0.5rem; /* menos espacio interno */
		line-height: 1.2; /* altura de línea más baja */
		vertical-align: middle; /* centrar contenido verticalmente */
	}

</style>
<div class="table-responsive table-wrapper-200-full-width flex-grow-1" id="containerGrillaUsuarios">
	<table class="table table-bordered table-hover table-golden h-50" id="tbListaUsuarios">
		<thead>
			<tr class="header">
				<th class="text-center" scope="col" style="width: 75%;">Usuario</th>
				<th class="text-center" scope="col">Grupo</th>
				<th style="width:10%;"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaUsuarios != null && Model.GrillaUsuarios.ListaDatos != null && Model.GrillaUsuarios.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaUsuarios.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase"
						onclick="selectItemGrillaUsuarios(this, 'tbListaUsuarios');">
						<td class="@Model.GrillaUsuarios.ObtenerClase(item.usu_apellidoynombre)">@Model.GrillaUsuarios.FormatearDato(item.usu_apellidoynombre, FormatDato.Ninguno)</td>
						<td class="text-end">@Model.GrillaUsuarios.FormatearDato(item.inv_grupo, FormatDato.Ninguno)</td>
						<td class="text-center align-middle">
							<div class="d-flex justify-content-center gap-1">
								<button type="button" class="btn btn-danger btn-eliminar-item" title="Quitar rubro" onclick="eliminarItemUsuario('@item.inv_nro','@item.usu_id')">
									<i class="bx bx-trash"></i>
								</button>
							</div>
						</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="3" class="text-center text-muted">No hay usuarios cargados</td>
				</tr>
			}
		</tbody>
	</table>
</div>