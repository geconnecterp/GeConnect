@model InventarioCargaDatosModel

<fieldset class="border rounded p-2 mb-3">
	<legend class="float-none w-auto px-2 fw-bold text-primary">Datos de Inventario</legend>


	<div class="row mb-2">
		<div class="input-group input-group-sm">
			<span class="input-group-text fixed-width">Depósito:</span>
			@Html.DropDownListFor(m => m.ListaDepositos, Model.ListaDepositos,
			new { @class = "form-select form-select-sm", @id = "listaDepositos" })
		</div>
	</div>

	<div class="row mb-2">
		<div class="input-group input-group-sm">
			<span class="input-group-text fixed-width">Conteo:</span>
			@Html.DropDownListFor(m => m.ListaConteos, Model.ListaConteos,
						new { @class = "form-select form-select-sm", @id = "listaConteos" })
		</div>
	</div>

	<div class="row mb-2">
		<div class="input-group input-group-sm">
			<span class="input-group-text fixed-width">Descripción:</span>
			@Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control form-control-sm", @id = "txtDescripcion" })
		</div>
	</div>

	<div class="row mb-2">
		<div class="input-group input-group-sm">
			<span class="input-group-text fixed-width">Estado:</span>
			@Html.DropDownListFor(m => m.ListaEstado, Model.ListaEstado,
						new { @class = "form-select form-select-sm", @id = "listaEstados" })
		</div>
	</div>

	<div class="row mb-2">
		<div class="input-group input-group-sm">
			<span class="input-group-text fixed-width">Apertura:</span>
			@Html.TextBoxFor(m => m.AperturaDesde, new { @class = "form-control form-control-sm", @type = "date", @id = "dtAperturaDesde" })
			<span class="input-group-text">hasta</span>
			@Html.TextBoxFor(m => m.AperturaHasta, new { @class = "form-control form-control-sm", @type = "date", @id = "dtAperturaHasta" })
		</div>
	</div>

	<div class="row mb-2">
		<div class="input-group input-group-sm">
			<span class="input-group-text fixed-width">AS N°:</span>
			@Html.TextBoxFor(m => m.AS_N, new { @class = "form-control form-control-sm", @id = "txtAS_N" })
		</div>
	</div>
</fieldset>