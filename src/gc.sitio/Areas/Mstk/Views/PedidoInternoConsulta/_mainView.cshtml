@{
}
<style>
	/* Se deshabilitan los tab de RTR para en el futuro agregar el desarrollo*/
	#tabRtrAsociadas {
		display: none !important;
	}

	#navs-top-editar-rtr {
		display: none !important;
	}
	/* Asegurar que los dropdowns de filtros flotantes se muestren por encima del menú principal */
	#filtrosAplicadosFloating {
		overflow: visible;
		z-index: 1050;
		flex-wrap: nowrap;
		white-space: nowrap;
		overflow-x: visible;
	}

		#filtrosAplicadosFloating .dropdown-menu {
			z-index: 3000 !important;
		}

	.filtros-clase {
		position: absolute;
		right: 260px;
		left: auto;
		top: 175px;
		height: auto;
		width: auto;
		border-color: #d9534f;
		background-color: #fff;
		z-index: 1050;
		padding: 6px 10px;
		overflow: visible;
		gap: 6px;
		display: inline-flex;
		white-space: nowrap;
	}
</style>
<div class="grid-golden">
	<div class="grid-golden-body">
		<div class="d-flex align-items-center w-100 mt-2">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsConsultaPedidosInterno">
				<li class="nav-item" role="presentation" id="tabPedidosInternos">
					<button type="button"
							class="nav-link active"
							role="tab"
							data-bs-toggle="tab"
							data-bs-target="#navs-top-pi"
							aria-controls="navs-top-pi"
							aria-selected="true"
							id="btnTabPedidosInternos">
						Pedidos Internos
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabDetalleDePedidoInterno">
					<button type="button"
							class="nav-link"
							role="tab"
							data-bs-toggle="tab"
							data-bs-target="#navs-top-det"
							aria-controls="navs-top-det"
							aria-selected="false"
							tabindex="-1"
							id="btnTabDetalleDePedidoInterno">
						Detalle
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabRtrAsociadas">
					<button type="button"
							class="nav-link"
							role="tab"
							data-bs-toggle="tab"
							data-bs-target="#navs-top-editar-rtr"
							aria-controls="navs-top-editar-rtr"
							aria-selected="false"
							id="btnTabRtrAsociadas">
						RTR Asociadas
					</button>
				</li>

			</ul>
			<!-- Contenedor flotante para filtros aplicados -->
			<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center filtros-clase">
				<!-- Badges rellenadas por JS -->
			</div>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-pi" role="tabpanel">
				<div id="divPedidosInternos">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-det" role="tabpanel">
				<div id="divDetalleDePedidoInterno">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-editar-rtr" role="tabpanel">
				<div id="divRtrAsociadas">
				</div>
			</div>
		</div>
	</div>
</div>