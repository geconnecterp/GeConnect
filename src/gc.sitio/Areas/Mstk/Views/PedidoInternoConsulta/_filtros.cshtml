@model FiltrosModel
@{
}
<style>
	.hidden {
		display: none !important;
	}

</style>
<div class="filter-golden gc-filter pi-filter" aria-labelledby="tituloLegend">
	<div class="filter-golden-body">
		<div class="gc-filter-heading">
			<h2 id="tituloLegend">Filtros de consulta</h2>
		</div>
		<div class="gc-filter-grid">
			<div class="gc-filter-field pi-filter-dates">
				<div class="form-check form-check-inline form-switch">
					<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
					<label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
				</div>
				<div class="gc-filter-range">
					<div class="input-group input-group-sm">
						<label class="input-group-text" id="lbIdDesde" for="FechaDesde">Desde:</label>
						<input type="date" class="form-control inputEditable" asp-for="FechaDesde" />
					</div>
					<div class="input-group input-group-sm">
						<label class="input-group-text" id="lbIdHasta" for="FechaHasta">Hasta:</label>
						<input type="date" class="form-control inputEditable" asp-for="FechaHasta" />
					</div>
				</div>
			</div>
			<div class="gc-filter-field">
				<div class="form-check form-check-inline form-switch">
					<input class="form-check-input" type="checkbox" name="chkSucursales" id="chkSucursales" />
					<label class="form-check-label" for="chkSucursales" id="lbSucursales"></label>
				</div>
				<div class="input-group input-group-sm" id="divListaSucursales">
					@Html.DropDownListFor(m => m.SucursalSeleccionada, Model.ListaSucursales, "Seleccionar", new { @id = "listaSucursales", disabled = "disabled", @class = "form-control inputEditable activable", aria_label = "Sucursal que genera" })
				</div>
				<label class="gc-filter-list-label" for="SucursalesList">Sucursales seleccionadas</label>
				@Html.ListBox("SucursalesList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
			</div>
			<div class="gc-filter-field">
				<div class="form-check form-check-inline form-switch">
					<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkEstados" />
					<label class="form-check-label" for="chkEstados" id="lbEstados"></label>
				</div>
				<div class="input-group input-group-sm">
					@Html.DropDownListFor(m => m.EstadoSeleccionado, Model.ListaEstados, "Seleccionar", new { @id = "listaEstados", disabled = "disabled", @class = "form-control inputEditable activable", aria_label = "Estado" })
				</div>
				<label class="gc-filter-list-label" for="EstadosList">Estados seleccionados</label>
				@Html.ListBox("EstadosList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
			</div>
		</div>
	</div>
	<div class="filter-golden-footer">
		<div class="gc-filter-actions">
			<button type="button" id="btnCancel" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializar</button>
			<button type="button" id="btnBuscar" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
		</div>
	</div>
</div>
