@using gc.sitio.Areas.Consultas
@{
}
<style>
	.tab-disabled {
		pointer-events: none;
		opacity: 0.5;
	}

	.tab-content-compact {
		/* padding: 0.75rem 0; */
		border-radius: 0.375rem;
		background-color: transparent;
		padding-bottom: 0.75rem;
		padding-right: 0;
		padding-left: 0;
		padding-top: 0.25rem;
	}
</style>
<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="d-flex align-items-center w-100 mt-2">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsConRecDeProv">
			<li class="nav-item" role="presentation" id="tabRecepciones">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-rec" aria-controls="navs-top-rec" aria-selected="true" id="btnTabRecepciones">
					Recepciones
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabDetalle">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-det" aria-controls="navs-top-det" aria-selected="false" tabindex="-1" id="btnTabDetalle">
					Detalle
				</button>
			</li>
		</ul>
	</div>
	<div class="tab-content tab-content-compact">
		<div class="tab-pane fade tab-content-golden show active" id="navs-top-rec" role="tabpanel">
			<div id="divRecepciones">
			</div>
		</div>
		<div class="tab-pane fade tab-content-golden" id="navs-top-det" role="tabpanel">
			<div id="divRecepcionesDetalle">
			</div>
		</div>
	</div>
</div>