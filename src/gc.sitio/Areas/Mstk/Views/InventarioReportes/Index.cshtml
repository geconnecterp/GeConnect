@model InventarioReporteModel
@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<div class="container mt-2">
	<div class="row mb-2">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>

				<button class="btn btn-primary btn-sm mt-1 me-1" type="button" id="btnDetalle" data-bs-toggle="collapse" data-bs-target="#divDetalle" aria-expanded="true" aria-controls="divDetalle" hidden>
					<i class="bx bx-caret-down"></i>
				</button>

				<button class="btn btn-light btn-sm mt-1 me-1" type="button" id="btnImprimir" title="Imprimir">
					<i class="bx bx-printer"></i> Imprimir
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltros">
		<div class="row justify-content-center">
			<partial name="_filtros" model="Model" />
			@Html.Hidden("pagEstado", false);
		</div>
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div id="divInventarioReporte">
		</div>
	</div>
</div>

<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		let inicializarPantallPrincipalURL = "@Url.Action("InicializarPantallPrincipal", "inventarioreportes", new { area = "mstk" })";
		let buscarInventarioListaURL = "@Url.Action("BuscarInventarioLista", "inventarioreportes", new { area = "mstk" })";
		let obtenerUsuariosDelInventarioURL = "@Url.Action("ObtenerUsuariosDelInventario", "inventarioreportes", new { area = "mstk" })";
		let setearTipoDeReporteUrl = "@Url.Action("SetearTipoDeReporte", "inventarioreportes", new { area = "mstk" })";
		let inicializarTabRepoValorPorSecURL = "@Url.Action("InicializarTabRepoValorPorSec", "inventarioreportes", new { area = "mstk" })";
		let inicializarTabRepoValorPorRubURL = "@Url.Action("InicializarTabRepoValorPorRub", "inventarioreportes", new { area = "mstk" })";
		let inicializarTabRepoConteosPorUsuURL = "@Url.Action("InicializarTabRepoConteosPorUsu", "inventarioreportes", new { area = "mstk" })";
		let inicializarTabRepoValorDetalleURL = "@Url.Action("InicializarTabRepoValorDetalle", "inventarioreportes", new { area = "mstk" })";
		let inicializarTabRepoStkVsConteoURL = "@Url.Action("InicializarTabRepoStkVsConteo", "inventarioreportes", new { area = "mstk" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>
	<script src="~/js/plugins/jquery.simplePagination.js"></script>

	<script src="~/js/app/areas/mstk/inventarioreporte/inventariorepo.js" type="text/javascript"></script>
}