@model RepoValPorSecModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;

	var totalProdRubro = Model.GrillaRepoValPorSec.ListaDatos.Sum(x => x.prod_sec);
	var totalProdConConteo = Model.GrillaRepoValPorSec.ListaDatos.Sum(x => x.prod_sec_cont);
	var totalStkCant = Model.GrillaRepoValPorSec.ListaDatos.Sum(x => x.stk_cant);
	var totalPlaniCant = Model.GrillaRepoValPorSec.ListaDatos.Sum(x => x.plani_cant);
	var totalDifCant = totalStkCant - totalPlaniCant;
	var totalStkVal = Model.GrillaRepoValPorSec.ListaDatos.Sum(x => x.stk_val);
	var totalPlaniVal = Model.GrillaRepoValPorSec.ListaDatos.Sum(x => x.plani_val);
	var totalDifVal = totalStkVal - totalPlaniVal;

}
<style>
	/* El contenedor debe ser el scroll real y generar contexto */
	#containerListaInvValorPorSec {
		position: relative;
		height: 500px;
		max-height: 500px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbGridInvValorPorSec td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	#tbGridInvValorPorSec thead th {
		/* padding: .5rem .5rem !important; */
	}


	/* Opcional: altura fija para todas las filas */
	#tbGridInvValorPorSec tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}

</style>
<div class="grid-golden">
	<div class="grid-golden-header">
		<div class="row align-items-md-center">
			<div class="col-md-10 col-sm-6">
				<h5 class="mb-0">
					<i class="bx bx-package me-2"></i>
					<strong>Valorizado por Sector</strong>
				</h5>
			</div>
			<div class="col-md-2 col-sm-6">
				<div class="d-flex justify-content-sm-end">
				</div>
			</div>
		</div>
	</div>
	<div class="grid-golden-body">
		<div class="table-wrapper" id="containerListaInvValorPorSec">
			<table class="table table-sm table-golden" id="tbGridInvValorPorSec">
				<thead>
					<tr class="header">
						<th class="text-center" rowspan="2" style="width: 15%;">Sectores</th>
						<th class="text-center" rowspan="2" style="width: 15%;">Prod. Rubro</th>
						<th class="text-center" rowspan="2" style="width: 15%;">Prod. con Conteo</th>
						<th class="text-center" colspan="3" style="width: 25%;">Cantidades</th>
						<th class="text-center" colspan="3" style="width: 25%;">Valorización</th>
					</tr>
					<tr class="header">
						<th class="text-center">Stk</th>
						<th class="text-center">Conteo</th>
						<th class="text-center">Dif</th>
						<th class="text-center">Stk</th>
						<th class="text-center">Conteo</th>
						<th class="text-center">Dif</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.GrillaRepoValPorSec != null && Model.GrillaRepoValPorSec.ListaDatos != null && Model.GrillaRepoValPorSec.ListaDatos.Count > 0)
					{
						@foreach (var item in Model.GrillaRepoValPorSec.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							var dif_cant = item.stk_cant - item.plani_cant;
							var dif_val = item.stk_val - item.plani_val;
							<tr class="@clase" onclick="selectReg(this, 'tbGridInvValorPorSec')" data-inv-nro="@item.inv_nro" data-inve-id="@item.inve_id" data-invt-id="@item.invt_id">
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.sec_desc) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.sec_desc, FormatDato.Ninguno)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.prod_sec) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.prod_sec, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.prod_sec_cont) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.prod_sec_cont, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.stk_cant) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.stk_cant, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.plani_cant) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.plani_cant, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(dif_cant) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(dif_cant, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.stk_val) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.stk_val, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(item.plani_val) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(item.plani_val, FormatDato.Monto)</td>
								<td class="@Model.GrillaRepoValPorSec.ObtenerClase(dif_val) cell-fit-content">@Model.GrillaRepoValPorSec.FormatearDato(dif_val, FormatDato.Monto)</td>
							</tr>
						}
						<tr class="table-success fw-bold">
							<td colspan="1" class="text-start pe-2">Total</td>

							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalProdRubro) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalProdRubro, FormatDato.Monto)
							</td>
							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalProdConConteo) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalProdConConteo, FormatDato.Monto)
							</td>

							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalStkCant) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalStkCant, FormatDato.Monto)
							</td>
							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalPlaniCant) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalPlaniCant, FormatDato.Monto)
							</td>
							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalDifCant) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalDifCant, FormatDato.Monto)
							</td>

							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalStkVal) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalStkVal, FormatDato.Monto)
							</td>
							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalPlaniVal) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalPlaniVal, FormatDato.Monto)
							</td>
							<td class="@Model.GrillaRepoValPorSec.ObtenerClase(totalDifVal) cell-fit-content">
								@Model.GrillaRepoValPorSec.FormatearDato(totalDifVal, FormatDato.Monto)
							</td>
						</tr>
					}
					else
					{
						<tr>
							<td colspan="9" class="text-center text-muted py-4">
								<i class="bx bx-info-circle me-2"></i>
								No se encontraron datos
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>