@using gc.infraestructura.Helpers
@model GridCoreSmart<ProductoModel>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.btn-table {
		padding: 0.15rem 0.35rem;
		font-size: 0.70rem;
		line-height: 1;
	}
</style>
<div class="table-responsive table-wrapper-700">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbProdElab">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="text-center">ID</th>
				<th class="text-center">Descripción</th>
				<th class="text-center">Ingreso</th>
				<th class="text-center"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="4" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-prod-elab"
						data-p-id="@item.p_id">
						<td class="text-center">@item.p_id</td>
						<td class="text-start">@item.p_desc</td>
						<td class="text-right">@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-center">
							<div class="d-flex justify-content-center gap-1">
								<button class="btn btn-danger btn-table btn-sm btnQuitarPedido"
										data-id="@item.p_id"
										title="Quitar Producto">
									<i class="bx bx-minus"></i>
								</button>
							</div>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
