@model GridCoreSmart<BoxInfoExtendedDto>

@using X.PagedList.Web.Common



@{
    var dataMod = new BoxInfoExtendedDto();
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
}
<style>
    #containerGridBoxes {
        height: 600px; /* o el alto que necesites */
        max-height: 600px;
        overflow-y: auto;
        position: relative;
    }

    .table-golden {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .table-golden thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(to bottom, #b8860b, #daa520) !important;
            color: #fff !important;
        }

            .table-golden thead th {
                position: sticky;
                top: 0;
                z-index: 4;
                background: linear-gradient(to bottom, #b8860b, #daa520);
                color: #fff;
                box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
                background-clip: padding-box;
            }

            .table-golden thead,
            .table-golden thead th {
                /*background-color: #b8860b;  tu dorado */
                /* color: #333; */
            }

    #tbGridBoxes th,
    #tbGridBoxes td {
        padding: 0.4rem 0.15rem !important;
        line-height: 1.2 !important;
        height: auto !important;
    }
</style>
<div class="table-responsive table-wrapper text-nowrap" id="containerGridBoxes">
    <table class="table table-sm mb-0 table-golden" id="tbGridBoxes">
        <thead>
            <tr class="header">
                <th class="text-sm-center" scope="col">BOX</th>
                <th class="text-sm-center" scope="col">GONDOLA</th>
                <th class="text-sm-center" scope="col">NIVEL</th>
                <th class="text-sm-center" scope="col">RACK</th>
                <th class="text-sm-center" scope="col">ZONA</th>
                <th class="text-sm-center" scope="col">ZONA</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaDatos)
            {
                if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

                <tr class="@clase" 
                    data-box-id="@item.Box_id">
                    <td class="text-sm-start corta-linea">@item.Box_id</td>
                    <td class="text-sm-center">@item.Box_gondola.Trim()</td>
                    <td class="text-sm-center">@item.Box_nivel.Trim()</td>
                    <td class="text-sm-center">@item.Box_rack.Trim()</td>
                    <td class="text-sm-center">@item.Box_zona.Trim()</td>
                    <td class="text-sm-center">
                        @if (item.Boxe_id.Equals("O"))
                        {
                            <span>OCUPADO</span>
                        }
                        else
                        {
                            <span>Libre</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
