@using gc.infraestructura.Helpers
@model GridCoreSmart<BoxInfoMovStkDto>


@{
    var dataMod = new BoxInfoMovStkDto();
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
}
<style>
    #containerInfoMovStk {
        height: 600px; /* o el alto que necesites */
        max-height: 600px;
        overflow-y: auto;
        position: relative;
    }

    .table-golden {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .table-golden thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(to bottom, #b8860b, #daa520) !important;
            color: #fff !important;
        }

            .table-golden thead th {
                position: sticky;
                top: 0;
                z-index: 4;
                background: linear-gradient(to bottom, #b8860b, #daa520);
                color: #fff;
                box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
                background-clip: padding-box;
            }

            .table-golden thead,
            .table-golden thead th {
                /*background-color: #b8860b;  tu dorado */
                /* color: #333; */
            }

    #tbGridInfoMovStk th,
    #tbGridInfoMovStk td {
        padding: 0.4rem 0.15rem !important;
        line-height: 1.2 !important;
        height: auto !important;
    }
</style>
<div class="table-responsive table-wrapper text-nowrap" id="containerInfoMovStk">
    <table class="table table-sm mb-0 table-golden table-wrapper-fixed-head" id="tbGridInfoMovStk">
        <thead>
            <tr class="header">
                <th class="text-sm-center" scope="col" style="width:20%;">FECHA</th>
                <th class="text-sm-center" scope="col" style="width:20%;">ID</th>
                <th class="text-sm-start" scope="col" style="width:40%;">DESC.PROD</th>
                <th class="text-sm-center" scope="col" style="width:20%;">E/S</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaDatos)
            {
                if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

                <tr class="@clase">
                    <td class="text-sm-center">@item.Sm_Fecha</td>
                    <td class="text-sm-center corta-linea">@item.P_id</td>
                    <td class="text-sm-start">@item.Tco_id</td>
                    <td class="text-sm-end">@GridHelper.FormatearDato(item.Sm_es, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
