@model ConsultaDeStockCompensadosModel
@{
}
<style>
	.hidden {
		display: none !important;
	}

</style>
<div class="card card-golden" style="padding-left: 0px;padding-right: 0px;">
	<div class="card-header mb-2">
		<h5 class="mb-0" id="tituloLegend">Filtros </h5>
	</div>
	<div class="card-body">
		<div class="row">
			<div class="row">
				<div class="col-md-6 col-sm-6">
					<div class="input-group input-group-sm">
						<div class="form-check form-check-inline form-switch mb-2">
							<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel01" />
							<label class="form-check-label" for="chkRel01" id="lbRel01"></label>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-md-6 col-sm-6" id="divLs01">
					<div class="input-group  input-group-sm">
						<input type="text" class="form-control inputEditable" name="Rel01" id="Rel01" disabled />
						@Html.Hidden("Rel01Item")
					</div>
				</div>
				<div class="col-md-6 col-sm-6">
					@Html.ListBox("Rel01List", null, new { @class = "form-control", @disabled = "disabled" })
				</div>
			</div>
		</div>
		<div class="row">
			<div class="row">
				<div class="col-sm-12">
					<div class="input-group input-group-sm">
						<div class="form-check form-check-inline form-switch mb-2">
							<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRubro" />
							<label class="form-check-label" for="chkRubro" id="lbRubro"></label>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-6" id="divRubros">
					<div class="input-group input-group-sm">
						@Html.DropDownListFor(m => m.RubroSeleccionado, Model.ListaRubros, "Seleccionar", new { @id = "listaRubros", disabled = "disabled", @class = "form-control inputEditable activable" })
					</div>
				</div>
				<div class="col-sm-6">
					@Html.ListBox("RubrosList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-sm-6 mt-3" id="divStockEstado">
				<div class="card card-golden">
					<div class="card-body p-2">
						<div class="row">
							<div class="col-sm-6">
								<label class="fw-bold mb-1">Estado</label>
								<div class="form-check">
									<input class="form-check-input" type="checkbox" id="chkEstadoActivo" checked />
									<label class="form-check-label" for="chkEstadoActivo">Activos</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="checkbox" id="chkEstadoDiscontinuo" checked />
									<label class="form-check-label" for="chkEstadoDiscontinuo">Discontinuos</label>
								</div>
							</div>
						</div>
					</div>
				</div>

			</div>
			<div class="col-sm-6 mt-3" id="divDiferencia" style="padding-left: unset;padding-right: 35px;">
				<div class="input-group input-group-sm mb-2">
					<span class="input-group-text fw-bold">Diferencia <= a: </></span>
					<input type="text" class="form-control inputEditable" id="txtDiferencia" name="Diferencia" style="width: 25%;max-width: 25%;" />
				</div>
			</div>
		</div>
	</div>
</div>
<div class="row m-3">
	<div class="d-flex justify-content-around">
		<button type="button" id="btnCancel" class="btn btn-sm btn-danger">
			<i class="bx bx-x-circle"></i>Cancelar
		</button>
		<button type="button" id="btnBuscar" class="btn btn-sm btn-primary">
			<i class="bx bx-search"></i>Buscar
		</button>
	</div>
</div>