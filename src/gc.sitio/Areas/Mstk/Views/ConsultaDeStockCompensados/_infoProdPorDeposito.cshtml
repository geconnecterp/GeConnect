@using gc.infraestructura.Helpers
@model InfoAdicionalModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.table-wrapper-200-full {
		max-height: 200px;
		max-width: 97%;
		overflow: auto;
	}
</style>
<div class="table-wrapper-200-full">
	<table class="table table-sm table-golden" id="tbInfoProdStkD">
		<thead>
			<tr class="header">
				<th style="width:10%;" class="align-center">Depósito</th>
				<th style="width:5%;" class="align-center">Stk</th>
				<th style="width:5%;" class="align-center">Vencimiento</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaProdStkD != null && Model.GrillaProdStkD.ListaDatos != null && Model.GrillaProdStkD.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaProdStkD.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaInfoProdStkD(this)">
						<td class="text-left">@item.Depo_nombre</td>
						<td class="text-right" style="text-align: right;">@GridHelper.FormatearDato(item.ps_stk, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-center">@item.Vto?.ToString("dd/MM/yyyy")</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>