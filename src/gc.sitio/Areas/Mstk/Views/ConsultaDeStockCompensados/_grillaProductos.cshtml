@using gc.infraestructura.Dtos.Mstk
@using gc.infraestructura.Helpers
@model ProductoStkCompensadoListaModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	string grupoActual = string.Empty;
	string grupoAnterior = string.Empty;
	string leyendaAgrupador = string.Empty;

	var alt = true;
	string clase = string.Empty;

	var productos = new List<ProductoStkCompensadoDto>();
}
<style>
	/* El contenedor debe ser el scroll real y generar contexto */
	#containerListaProducto {
		position: relative;
		height: 540px;
		max-height: 540px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbGridProductos th,
	#tbGridProductos td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	/* Opcional: altura fija para todas las filas */
	#tbGridProductos tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}

</style>
<div class="table-wrapper" id="containerListaProducto">
	<table class="table table-sm table-golden" id="tbGridProductos">
		<thead>
			<tr class="header">
				<th class="text-center" style="width: 10%;">Código</th>
				<th class="text-center" style="width: 10%;">Barrado</th>
				<th class="text-center" style="width: 30%;">Descripción</th>
				<th class="text-center" style="width: 10%;">Stock +</th>
				<th class="text-center" style="width: 10%;">Stock -</th>
				<th class="text-center" style="width: 10%;">Diferencia</th>
				<th class="text-center" style="width: 10%;">Compensa</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaProductoStkComp != null && Model.GrillaProductoStkComp.ListaDatos != null && Model.GrillaProductoStkComp.ListaDatos.Count > 0)
			{
				
				productos = Model.GrillaProductoStkComp.ListaDatos.OrderBy(x=>x.p_id).ToList();
				@foreach (var item in productos)
				{
					grupoActual = item.rub_id;
					leyendaAgrupador = $"({item.rub_id}) {item.rub_desc}";

					// Si cambia la cuenta, insertamos una fila de encabezado para la cuenta
					if (grupoActual != grupoAnterior)
					{
						<tr class="table-secondary fw-bold">
							<td colspan="8" class="text-center">
								<i class="bx bx-folder me-1"></i>
								@leyendaAgrupador
							</td>
						</tr>
						grupoAnterior = grupoActual;
						alt = true; // Reiniciar alternancia de colores después de cada familia
					}

					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbGridProductos')" data-p-id="@item.p_id">
						<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.p_id) align-center cell-fit-content">@Model.GrillaProductoStkComp.FormatearDato(item.p_id, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.p_id_barrado) align-center cell-fit-content">@Model.GrillaProductoStkComp.FormatearDato(item.p_id_barrado, FormatDato.Ninguno)</td>
						@if (item.p_activo_bool)
						{
							<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.p_desc) cell-fit-content">@Model.GrillaProductoStkComp.FormatearDato(item.p_desc, FormatDato.Ninguno)</td>
						}
						else
						{
							<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.p_desc) cell-fit-content">@Model.GrillaProductoStkComp.FormatearDato(item.p_desc, FormatDato.Ninguno)<span style="float:right;" title="Producto discontínuo"><i class="bx bx-dislike"></i></span></td>
						}
						<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.stk_positivo) cell-fit-content">@GridHelper.FormatearDato(item.stk_positivo, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.st_negativo) cell-fit-content">@GridHelper.FormatearDato(item.st_negativo, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.stk_diferencia) cell-fit-content">@GridHelper.FormatearDato(item.stk_diferencia, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.GrillaProductoStkComp.ObtenerClase(item.stk_diferencia) cell-fit-content">@GridHelper.FormatearDato(item.stk_diferencia, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="7" class="text-center text-muted py-4">
						<i class="bx bx-info-circle me-2"></i>
						No se encontraron productos con los criterios especificados
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
<div class="row mt-3">
	<div class="offset-md-3 col-md-6">
		<div id="divPaginacion" class="">
		</div>
	</div>
</div>