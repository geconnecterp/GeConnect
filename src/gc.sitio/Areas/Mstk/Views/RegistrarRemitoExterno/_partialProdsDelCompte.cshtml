@using gc.infraestructura.Helpers
@model GridCoreSmart<RemitoExternoValidaDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#Busqueda {
		width: 70px !important;
		max-width: 70px !important;
		min-width: 70px !important;
	}
</style>
@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Any())
{
	var h = Model.ListaDatos.First();

	<div id="infoComprobanteRendered" class="accordion mb-2">
		<div class="accordion-item">
			<h2 class="accordion-header">
				<button class="accordion-button collapsed py-1" type="button" data-bs-toggle="collapse" data-bs-target="#accInfoBody">
					Información del Comprobante
				</button>
			</h2>
			<div id="accInfoBody" class="accordion-collapse collapse">
				<div class="accordion-body small py-2">

					<div class="row g-2">
						<div class="col-md-2">
							<label class="fw-bold">ID Presupuesto:</label>
							<span>@h.pre_id</span>
						</div>

						<div class="col-md-2">
							<label class="fw-bold">Estado:</label>
							<span>@h.pree_desc</span>
						</div>

						<div class="col-md-5">
							<label class="fw-bold">Cliente:</label>
							<span>@h.cta_id - @h.cta_denominacion</span>
						</div>

						<div class="col-md-3">
							<label class="fw-bold">Comprobante:</label>
							<span>@h.tco_desc @h.cm_compte</span>
						</div>

						<div class="col-md-6">
							<label class="fw-bold">Obs. Pago:</label>
							<span>@h.pre_obs_pago</span>
						</div>

						<div class="col-md-6">
							<label class="fw-bold">Obs. Entrega:</label>
							<span>@h.pre_obs_entrega</span>
						</div>
					</div>

				</div>
			</div>
		</div>
	</div>
}
<div class="table-wrapper" id="containerListaProducto">
	<table class="table table-sm table-golden" id="tbGridProductos">
		<thead>
			<tr class="header">
				<th class="text-center fw-bold">ID</th>
				<th class="text-center fw-bold">Descripción</th>
				<th class="text-center fw-bold">ID Prov</th>
				<th class="text-center fw-bold">Box</th>
				<th class="text-center fw-bold" title="Cantidad Comprada">Cant. Comp.</th>
				<th class="text-center fw-bold" title="Ya entregado">Ya Entr.</th>
				<th class="text-center fw-bold" title="A entregar">A Entr.</th>
				<th class="text-center fw-bold" title="A remitir">A Rem.</th>
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="8" class="text-center text-muted py-4">
						<i class="bx bx-info-circle me-2"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					var a_entregar = item.pre_cantidad - item.pre_cantidad_ent;
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-ajuste"
						data-p-id="@item.p_id"
						data-pre-id="@item.pre_id"
						data-pree-id="@item.pree_id"
						data-pret-od="@item.pret_id">
						<td class="text-center">@item.p_id</td>
						<td class="text-start">@item.p_desc</td>
						<td class="text-center">@item.p_id_prov</td>
						<td class="text-center">@item.box_id</td>
						<td class="text-end">@GridHelper.FormatearDato(item.pre_cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end">@GridHelper.FormatearDato(item.pre_cantidad_ent, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end">@GridHelper.FormatearDato(a_entregar, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end">@GridHelper.FormatearDato(item.a_remitir, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
