@model InitCargaRegExt
@{
	Layout = "~/views/shared/_Layout.cshtml";
	BusquedaProducto busquedaProducto = new();
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css"   />
}
<style>
	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	.filter-golden-body {
		padding: 0 !important;
	}

	#btnBusquedaBase {
		z-index: 1;
	}

	.input-compact {
		padding: .15rem .25rem !important;
		font-size: .8rem !important;
		height: calc(1.8rem) !important;
		line-height: 1.2 !important;
	}

	.radio-block {
		width: 164px; /* Ajustá según tu imagen */
		display: flex;
		align-items: center;
		justify-content: flex-start;
		white-space: nowrap; /* Evita saltos de línea */
	}

	.radio-controls {
		margin-left: 12px; /* Ajustá según tu imagen */
		flex: 1 !important; /* OCUPA TODO EL ANCHO DISPONIBLE */
	}

	.input-full {
		flex: 1 !important;
	}

	.label-block {
		width: 65px; /* Ajustá según tu imagen */
		display: flex;
		align-items: center;
		justify-content: flex-end;
		white-space: nowrap;
	}

	.input-uniform {
		flex: 1 !important;
	}

	.row-block {
		min-height: 32px; /* Ajustá según tu captura */
		display: flex;
		align-items: center;
	}

	.input-small {
		width: 80px !important;
	}

	#ProdUP,
	#ProdBto {
		width: 60px !important;
		max-width: 60px !important;
		min-width: 60px !important;
	}

	.input-id {
		width: 120px !important;
	}

	#Busqueda {
		width: 100px !important;
		max-width: 100px !important;
		min-width: 100px !important;
	}

	.width-select-depo {
		width: 40% !important;
		max-width: 40% !important;
	}

	.ancho-boton {
		width: 100px;
	}

	.ancho-divs {
		width: 98%;
		margin-left: 5px;
	}

	.input2Editable {
		border-color: rgb(70, 196, 104);
		text-align: left;
		font-weight: 700;
	}

	.input-simul-disabled {
		background-color: #e9ecef !important; /* gris Bootstrap */
		color: #6c757d !important; /* texto apagado */
		pointer-events: none !important; /* bloquea interacción */
		opacity: 1 !important; /* evita efecto de transparencia */
		cursor: not-allowed !important; /* cursor de disabled */
	}

</style>
<div class="card">
	<div class="container">
		<div class="row g-2">
			<!-- Columna Izquierda -->
			<div class="row col-6" style="padding-top: 8px;">
				<fieldset style="margin: 2px;padding: 2px;">
					<!-- Desde Factura -->
					<div class="d-flex align-items-center mb-2 row-block">
						<div class="radio-block">
							<input class="form-check-input me-1" type="radio" name="TipoRelacion" id="DesdeFactura" value="Factura" checked>
							<label class="form-check-label" for="DesdeFactura">Desde Factura</label>
						</div>

						<div class="radioinput-group input-group-sm radio-controls d-flex align-items-center">
							<span class="input-group-text">Tipo: </span>
							@Html.DropDownList("id", Model.TipoComprobantes, "Seleccionar...", new { @id = "listaTipoComprobante", @class = "form-select form-select-sm w-auto input2Editable" })
							<span class="input-group-text">N°: </span>
							<input type="text" id="PtoVta" name="PtoVta" class="input-group input-group-sm input-compact w-auto input2Editable" style="max-width:60px;" />
							<span class="mx-1">-</span>
							<input type="text" id="NroComprobante" name="NroComprobante" class="input-group input-group-sm input-compact w-auto input2Editable" style="min-width:120px;" />
						</div>
					</div>
					<!-- Desde Cotización -->
					<div class="d-flex align-items-center mb-2 row-block">
						<div class="radio-block">
							<input class="form-check-input me-1" type="radio" name="TipoRelacion" id="DesdeCotizacion" value="Cotizacion">
							<label class="form-check-label" for="DesdeCotizacion">Desde Cotización</label>
						</div>

						<div class="radioinput-group input-group-sm radio-controls d-flex align-items-center">
							<span class="input-group-text">N°: </span>
							<input type="text" id="NroCotizacion" name="NroCotizacion" class="input-group input-group-sm input-compact w-auto input2Editable" style="min-width:120px;" />
						</div>
					</div>
					<!-- Sin Relación -->
					<div class="d-flex align-items-center mb-2 row-block">
						<div class="radio-block">
							<input class="form-check-input me-1" type="radio" name="TipoRelacion" id="SinRelacion" value="SinRelacion">
							<label class="form-check-label" for="SinRelacion">Sin Relación</label>
						</div>
						<div class="radioinput-group input-group-sm radio-controls d-flex align-items-center me-2">
							<input type="text" class="input-group input-group-sm input2Editable input-compact input-full" name="Rel03" id="Rel03" disabled />

							<input id="Rel03Item" name="Rel03Item" type="hidden" value="">
						</div>
					</div>
				</fieldset>
			</div>
			<!-- Columna Derecha -->
			<div class="row col-6" style="padding-top: 8px;">
				<fieldset style="margin: 2px;padding: 2px;">
					<div class="row col-12" style="margin-left: -7px;">
						<div class="col-6" style="padding-right: 0px;">
							<div class="input-group input-group-sm mb-2 row-block">
								<span class="input-group-text fixed-width-80">Depósito: </span>
								@Html.DropDownList("id", Model.ComboDepositos, "Seleccionar...", new { @id = "listaDeposito", @class = "form-select form-select-sm input-uniform input2Editable" })
							</div>
						</div>
						<div class="col-6" style="padding-right: 0px;">
							<div class="input-group input-group-sm mb-2 row-block" id="divComboBoxes">
								<span class="input-group-text fixed-width-80">Box: </span>
								@Html.DropDownList("id", Model.ComboBoxes, "Seleccionar...", new { @id = "listaBoxes", @class = "form-select form-select-sm input-uniform input2Editable" })
							</div>
						</div>
					</div>
					<!-- Obs -->
					<div class="row col-12" style="margin-left: -7px;">
						<div class="input-group input-group-sm row-block" style="padding-right: 0px;">
							<span class="input-group-text fixed-width-80" style="height: 30px;">Obs: </span>
							<input type="text" id="Obs" name="Obs" class="form-control form-control-sm input-compact input-uniform input2Editable" />
						</div>
					</div>
					<!-- Botones arriba -->
					<div class="d-flex justify-content-end gap-2 mt-2 me-1">
						<button type="button" class="btn btn-success btn-sm mt-1 me-1" style="width:100px;" id="btnCargar">
							<i class="bx bx-search"></i> Cargar
						</button>
						<button type="button" class="btn btn-success btn-sm mt-1 me-1" style="width:100px;" id="btnConfirmar">
							<i class="bx bx-badge-check"></i> Confirmar
						</button>
						<button type="button" class="btn btn-danger btn-sm mt-1 me-1" style="width:100px;" id="btnCancelar">
							<i class="bx bx-x-circle"></i> Cancelar
						</button>
					</div>
				</fieldset>
			</div>
		</div>
		<div id="infoComprobanteContainer"></div>
		<!-- Sección: Detalle de Productos -->
		<div class="row g-1 mt-1" style="width: 96.7%;">
			<fieldset style="margin: 2px;padding: 2px;">
				<legend style="margin-bottom: 0px;">
					<h5>Detalle de Productos</h5>
				</legend>
				<div class="row col-12">
					<div class="col-2" style="padding-right: 0px;">
						<partial name="~/areas/ControlComun/views/producto/_ctrBuscarProducto.cshtml" model="@busquedaProducto" />
					</div>
					<div class="col-9" style="padding-right: 0px;padding-left: 0px;width: 75%;">
						<div class="input-group input-group-sm">
							<input id="ProdID" name="ProdID" type="hidden" value="">
							<input id="UpID" name="UpID" type="hidden" value="">
							<input id="BarradoID" name="BarradoID" type="hidden" value="">
							<input id="ProvID" name="ProvID" type="hidden" value="">
							<input id="BoxID" name="BoxID" type="hidden" value="">
							<input id="DepoID" name="DepoID" type="hidden" value="">
							<span class="input-group-text">ID: </span>
							<input type="text" id="txtIdProd" class="form-control form-control-sm" style="width:10%;display: none;" readonly />
							<input type="text" id="txtProDescripcion" class="form-control form-control-sm" style="width: 40%;height: 32px;" readonly />
							<span class="input-group-text">UP: </span>
							<input type="number" id="txtUP" class="form-control form-control-sm activable text-end" />
							<span class="input-group-text">Bto: </span>
							<input type="number" id="txtBto" class="form-control form-control-sm activable text-end" min="0" />
							<span class="input-group-text">Unid: </span>
							<input type="text" id="txtUnid" class="form-control form-control-sm activable text-end" />
							<input type="text" id="txtUP_ID" style="display:none;" />
							<input type="text" id="txtBARRADO_ID" style="display:none;" />
							<input type="text" id="txtID_PROV" style="display:none;" />
						</div>
					</div>
					<div class="col-1 text-center align-middle">
						<button type="button" class="btn btn-primary btn-sm" id="btnAddProd" title="Agregar Producto">
							<i class="bx bx-plus-circle"></i> Agregar
						</button>
					</div>
				</div>
				<div class="grid-golden-body" id="divProductos">
					<div class="table-wrapper" id="containerListaProducto">
						<table class="table table-sm table-golden" id="tbGridProductos">
							<thead>
								<tr class="header">
									<th class="text-center fw-bold">ID</th>
									<th class="text-center fw-bold">Descripción</th>
									<th class="text-center fw-bold">ID Prov</th>
									<th class="text-center fw-bold">Box</th>
									<th class="text-center fw-bold" title="Cantidad Comprada">Cant. Comp.</th>
									<th class="text-center fw-bold" title="Ya entregado">Ya Entr.</th>
									<th class="text-center fw-bold" title="A entregar">A Entr.</th>
									<th class="text-center fw-bold" title="A remitir">A Rem.</th>
									<th class="text-center fw-bold">Acción</th>
								</tr>
							</thead>
							<tbody>
							</tbody>
						</table>
					</div>
				</div>
			</fieldset>
		</div>
	</div>
</div>

<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		let totalRegs = 0;
		let pagRegs = 0;
		let pags = 0;
		let pagina = 1;
		let search = "";
		var funcionBusquedaAvanzada = true;

		var BuscarBoxesDesdeDepositoURL = "@Url.Action("ObtenerBoxesDesdeDeposito", "RegistrarRemitoExterno", new { area = "mstk" })";
		var autoComRel03Url = "@Url.Action("BuscarCuentas", "RegistrarRemitoExterno", new { area = "mstk" })";
		let validarExistenciaDeProdsURL = "@Url.Action("VerificarExistenciaDeProductosDesdeComprobantes", "RegistrarRemitoExterno", new { area = "mstk" })";
		let cargarProductosDesdeComprobanteURL = "@Url.Action("CargarProductosDesdeComprobante", "RegistrarRemitoExterno", new { area = "mstk" })";
		let limpiarProductosCargadosURL = "@Url.Action("LimpiarProductosCargados", "RegistrarRemitoExterno", new { area = "mstk" })";
		let validarExistenciaDeProductoUrl = "@Url.Action("ValidarExistenciaDeProducto", "RegistrarRemitoExterno", new { area = "mstk" })";
		let confirmarRemitoExternoUrl = "@Url.Action("ConfirmarRemitoExterno", "RegistrarRemitoExterno", new { area = "mstk" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";

		//Busqueda de productos
		var busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun", validarPertenenciaDeProveedor = false })";
		var autoComRel01Url = "@Url.Action("BuscarProvs", "abmproducto", new { area = "abms" })";
		var autoComRel02Url = "@Url.Action("BuscarRubros", "abmproducto", new { area = "abms" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "abmproducto", new { area = "abms" })";
		var busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzada", "producto", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>
	<script src="~/js/plugins/jquery.simplePagination.js"></script>
	<script src="~/js/app/busquedas.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/infoRpr.js" type="text/javascript"></script>

	<script src="~/js/app/areas/mstk/registrarremitoexterno/regremexterno.js" type="text/javascript"></script>
}
