@model InitCargaRegExt
@{
	Layout = "~/views/shared/_Layout.cshtml";
	BusquedaProducto busquedaProducto = new();
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css"   />
}
<style>
	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	.filter-golden-body {
		padding: 0 !important;
	}

	#btnBusquedaBase {
		z-index: 1;
	}

	.input-compact {
		padding: .15rem .25rem !important;
		font-size: .8rem !important;
		height: calc(1.6rem) !important;
		line-height: 1.2 !important;
	}

	.radio-block {
		width: 180px; /* Ajustá según tu imagen */
		display: flex;
		align-items: center;
		justify-content: flex-start;
		white-space: nowrap; /* Evita saltos de línea */
	}

	.radio-controls {
		margin-left: 12px; /* Ajustá según tu imagen */
		flex: 1 !important; /* OCUPA TODO EL ANCHO DISPONIBLE */
	}

	.input-full {
		flex: 1 !important;
	}

	.label-block {
		width: 90px; /* Ajustá según tu imagen */
		display: flex;
		align-items: center;
		justify-content: flex-end;
		white-space: nowrap;
	}

	.input-uniform {
		flex: 1 !important;
	}

	.row-block {
		min-height: 32px; /* Ajustá según tu captura */
		display: flex;
		align-items: center;
	}

	.input-small {
		width: 80px !important;
	}

	#ProdUP,
	#ProdBto {
		width: 60px !important;
		max-width: 60px !important;
		min-width: 60px !important;
	}
	.input-id {
		width: 120px !important;
	}

	#Busqueda {
		width: 70px !important;
		max-width: 70px !important;
		min-width: 70px !important;
	}
</style>
<div class="card mx-auto w-75" style="padding-left:0;padding-right:0;">
	<div class="card-body p-2">
		<div class="row g-2">
			<!-- Columna Izquierda -->
			<div class="col-md-7">
				<!-- Desde Factura -->
				<div class="d-flex align-items-center mb-2 row-block">
					<div class="radio-block">
						<input class="form-check-input me-1" type="radio" name="TipoRelacion" id="DesdeFactura" value="Factura" checked>
						<label class="form-check-label" for="DesdeFactura">Desde Factura</label>
					</div>

					<div class="radio-controls d-flex align-items-center">
						<label class="me-2 mb-0">Tipo:</label>

						@Html.DropDownList("id",
						Model.TipoComprobantes,
												"Seleccionar...",
												new { @id = "listaTipoComprobante", @class = "form-select form-select-sm w-auto" })

						<label class="ms-3 me-2 mb-0">N°:</label>

						<input type="text"
							   id="PtoVta"
							   name="PtoVta"
							   class="form-control form-control-sm input-compact w-auto"
							   style="max-width:60px;" />

						<span class="mx-1">-</span>

						<input type="text"
							   id="NroComprobante"
							   name="NroComprobante"
							   class="form-control form-control-sm input-compact w-auto"
							   style="min-width:120px;" />
					</div>
				</div>
				<!-- Desde Cotización -->
				<div class="d-flex align-items-center mb-2 row-block">
					<div class="radio-block">
						<input class="form-check-input me-1" type="radio" name="TipoRelacion" id="DesdeCotizacion" value="Cotizacion">
						<label class="form-check-label" for="DesdeCotizacion">Desde Cotización</label>
					</div>

					<div class="radio-controls d-flex align-items-center">
						<label class="me-2 mb-0">N°:</label>
						<input type="text"
							   id="NroCotizacion"
							   name="NroCotizacion"
							   class="form-control form-control-sm input-compact w-auto"
							   style="min-width:120px;" />
					</div>
				</div>
				<!-- Sin Relación -->
				<div class="d-flex align-items-center mb-2 row-block">
					<div class="radio-block">
						<input class="form-check-input me-1" type="radio" name="TipoRelacion" id="SinRelacion" value="SinRelacion">
						<label class="form-check-label" for="SinRelacion">Sin Relación</label>
					</div>
					<div class="radio-controls d-flex align-items-center">
						<input type="text"
							   class="form-control inputEditable form-control-sm input-compact input-full"
							   name="Rel03"
							   id="Rel03"
							   disabled />

						<input id="Rel03Item" name="Rel03Item" type="hidden" value="">
					</div>
				</div>
			</div>
			<!-- Columna Derecha -->
			<div class="col-md-5">
				<!-- Depósito -->
				<div class="d-flex align-items-center mb-2 row-block">
					<div class="label-block">
						<label class="mb-0" for="listaDeposito">Depósito:</label>
					</div>
					@Html.DropDownList("id",
										Model.ComboDepositos,
										"Seleccionar...",
										new { @id = "listaDeposito", @class = "form-select form-select-sm input-uniform" })
				</div>
				<!-- Box -->
				<div class="d-flex align-items-center mb-2 row-block" id="divComboBoxes">
					<div class="label-block">
						<label class="mb-0" for="listaBoxes">BOX:</label>
					</div>
					@Html.DropDownList("id",
										Model.ComboBoxes,
										"Seleccionar...",
										new { @id = "listaBoxes", @class = "form-select form-select-sm input-uniform" })
				</div>
				<!-- Obs -->
				<div class="d-flex align-items-center mb-2 row-block">
					<div class="label-block">
						<label class="mb-0" for="Obs">Obs:</label>
					</div>

					<input type="text"
						   id="Obs"
						   name="Obs"
						   class="form-control form-control-sm input-compact input-uniform" />
				</div>
				<!-- Botones arriba -->
				<div class="d-flex justify-content-end gap-2 mt-2">
					<button type="button" class="btn btn-success btn-sm" id="btnCargar">Cargar</button>
					<button type="button" class="btn btn-success btn-sm" id="btnConfirmar" disabled>Confirmar</button>
					<button type="button" class="btn btn-danger btn-sm" id="btnCancelar" disabled>Cancelar</button>
				</div>
			</div>
		</div>
		<div id="infoComprobanteContainer"></div>
		<!-- Sección: Detalle de Productos a Ajustar -->
		<div class="grid-golden mt-3">
			<!-- Encabezado -->
			<div class="grid-golden-header">
				<div class="row align-items-md-center">
					<div class="col-md-10 col-sm-6">
						<h5 class="mb-0">
							<i class="bx bx-package me-2"></i>
							<strong>Detalle de Productos a Ajustar</strong>
						</h5>
					</div>
				</div>
			</div>
			<!-- Controles -->
			<div class="p-2">
				<div class="row g-2 align-items-center">
					<div class="col-2 align-items-center">
						<partial name="~/areas/ControlComun/views/producto/_ctrBuscarProducto.cshtml" model="@busquedaProducto" />
					</div>
					<!-- ID -->
					<input id="ProdID" name="ProdID" type="hidden" value="">
					<input id="UpID" name="UpID" type="hidden" value="">
					<input id="BarradoID" name="BarradoID" type="hidden" value="">
					<input id="ProvID" name="ProvID" type="hidden" value="">
					<input id="BoxID" name="BoxID" type="hidden" value="">
					<input id="DepoID" name="DepoID" type="hidden" value="">
					<!-- Nombre dinámico -->
					<div class="col d-flex align-items-center">
						<label class="me-2 mb-0">Nombre:</label>
						<span id="ProdNombre" class="fw-bold text-primary flex-grow-1"></span>
					</div>
					<!-- UP -->
					<div class="col-auto d-flex align-items-center">
						<label class="me-2 mb-0">UP:</label>
						<input type="text"
							   id="ProdUP"
							   name="ProdUP"
							   class="form-control form-control-sm input-compact input-small text-end" />
					</div>
					<!-- Bto -->
					<div class="col-auto d-flex align-items-center">
						<label class="me-2 mb-0">Bto.:</label>
						<input type="text"
							   id="ProdBto"
							   name="ProdBto"
							   class="form-control form-control-sm input-compact input-small text-end" />
					</div>
					<!-- Unid -->
					<div class="col-auto d-flex align-items-center">
						<label class="me-2 mb-0">Unid.:</label>
						<input type="text"
							   id="ProdUnid"
							   name="ProdUnid"
							   class="form-control form-control-sm input-compact input-small text-end" />
					</div>
					<!-- Botones -->
					<div class="col-auto d-flex align-items-center gap-2">
						<button type="button"
								id="btnAgregarProducto"
								class="btn btn-sm btn-primary btn-icon-compact"
								title="Agregar producto">
							<i class="bx bx-plus"></i>
						</button>
					</div>
				</div>
			</div>
			<!-- Tabla -->
			<div class="grid-golden-body" id="divProductos">
				<div class="table-wrapper" id="containerListaProducto">
					<table class="table table-sm table-golden" id="tbGridProductos">
						<thead>
							<tr class="header">
								<th class="text-center fw-bold">ID</th>
								<th class="text-center fw-bold">Descripción</th>
								<th class="text-center fw-bold">ID Prov</th>
								<th class="text-center fw-bold">Box</th>
								<th class="text-center fw-bold" title="Cantidad Comprada">Cant. Comp.</th>
								<th class="text-center fw-bold" title="Ya entregado">Ya Entr.</th>
								<th class="text-center fw-bold" title="A entregar">A Entr.</th>
								<th class="text-center fw-bold" title="A remitir">A Rem.</th>
								<th class="text-center fw-bold">Acción</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td colspan="9" class="text-center text-muted py-4">
									<i class="bx bx-info-circle me-2"></i>
										No hay items para mostrar.
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

		</div>

	</div>
</div>

<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		let totalRegs = 0;
		let pagRegs = 0;
		let pags = 0;
		let pagina = 1;
		let search = "";
		var funcionBusquedaAvanzada = true;

		var BuscarBoxesDesdeDepositoURL = "@Url.Action("ObtenerBoxesDesdeDeposito", "RegistrarRemitoExterno", new { area = "mstk" })";
		var autoComRel03Url = "@Url.Action("BuscarProvs", "RegistrarRemitoExterno", new { area = "mstk" })";
		let validarExistenciaDeProdsURL = "@Url.Action("VerificarExistenciaDeProductosDesdeComprobantes", "RegistrarRemitoExterno", new { area = "mstk" })";
		let cargarProductosDesdeComprobanteURL = "@Url.Action("CargarProductosDesdeComprobante", "RegistrarRemitoExterno", new { area = "mstk" })";
		let limpiarProductosCargadosURL = "@Url.Action("LimpiarProductosCargados", "RegistrarRemitoExterno", new { area = "mstk" })";
		let validarExistenciaDeProductoUrl = "@Url.Action("ValidarExistenciaDeProducto", "RegistrarRemitoExterno", new { area = "mstk" })";
		let confirmarRemitoExternoUrl = "@Url.Action("ConfirmarRemitoExterno", "RegistrarRemitoExterno", new { area = "mstk" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";

		//Busqueda de productos
		var busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun", validarPertenenciaDeProveedor = false })";
		var autoComRel01Url = "@Url.Action("BuscarProvs", "abmproducto", new { area = "abms" })";
		var autoComRel02Url = "@Url.Action("BuscarRubros", "abmproducto", new { area = "abms" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "abmproducto", new { area = "abms" })";
		var busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzada", "producto", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>
	<script src="~/js/plugins/jquery.simplePagination.js"></script>
	<script src="~/js/app/busquedas.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/infoRpr.js" type="text/javascript"></script>

	<script src="~/js/app/areas/mstk/registrarremitoexterno/regremexterno.js" type="text/javascript"></script>
}
