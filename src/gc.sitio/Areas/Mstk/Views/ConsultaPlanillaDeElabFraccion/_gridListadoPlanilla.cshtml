@using gc.infraestructura.Helpers
@model PlanillaModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
</style>
<div class="table-responsive table-wrapper-700">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbPlanilla">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="text-center">EF Nro.</th>
				<th class="text-center">Fecha</th>
				<th class="text-center">Sucursal</th>
				<th class="text-center">Motivo</th>
				<th class="text-center">Usuario</th>
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.Grilla == null || Model.Grilla.ListaDatos == null || !Model.Grilla.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="5" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.Grilla.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-planilla"
						data-ep-compte="@item.ep_compte"
						ondblclick="SeleccionarPlanilla(this,'tbPlanilla')">
						<td class="text-center">@item.ep_compte</td>
						<td class="text-center">@item.ep_fecha.ToString("dd/MM/yy")</td>
						<td class="text-start">@item.adm_nombre</td>
						<td class="text-start td-nowrap-ellipsis" title="@item.ep_motivo">
							@item.ep_motivo
						</td>
						<td class="text-start">@item.usu_apellidoynombre</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="row mt-3">
	<div class="offset-md-3 col-md-6">
		<div id="divPaginacion" class="">
		</div>
	</div>
</div>
