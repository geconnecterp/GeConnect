@model ConsultaDeInfDeULModel
@{
}
<style>
    .hidden {
        display: none !important;
    }

    .checkbox-readonly {
        pointer-events: none;
        opacity: 1 !important;
    }
</style>
<div class="card card-golden w-75" style="padding-left: 0px;padding-right: 0px;">
    <div class="card-header mb-2">
        <h5 class="mb-0" id="tituloLegend">Filtros </h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-12">

                <!-- UL por Fecha -->
                <div class="d-flex align-items-center mb-2">

                    <div class="form-check form-check-inline">
                        @Html.RadioButtonFor(m => m.TipoUL, "FECHA", new { @id = "rbULPorFecha", @class = "form-check-input" })
                        <label class="form-check-label ms-1" for="rbULPorFecha">UL por Fecha</label>
                    </div>

                    <!-- Fechas -->
                    <div id="divFechas" class="d-flex align-items-center ms-3">
                        <span class="input-group-text">Desde:</span>
                        @Html.TextBoxFor(m => m.FechaDesde, "{0:yyyy-MM-dd}",
                        new { @type = "date", @class = "form-control form-control-sm", @id = "FechaDesde", style = "width:150px;" })

                        <span class="input-group-text ms-2">Hasta:</span>
                        @Html.TextBoxFor(m => m.FechaHasta, "{0:yyyy-MM-dd}",
                                                new { @type = "date", @class = "form-control form-control-sm", @id = "FechaHasta", style = "width:150px;" })
                    </div>

                </div>

                <!-- UL sin Almacén -->
                <div class="form-check form-check-inline">
                    @Html.RadioButtonFor(m => m.TipoUL, "SIN_ALMACEN", new { @id = "rbULSinAlmacen", @class = "form-check-input" })
                    <label class="form-check-label ms-1" for="rbULSinAlmacen">UL sin Almacén</label>
                </div>

            </div>
        </div>


        <div class="filter-golden-footer">
            <div class="row m-3">
                <div class="d-flex justify-content-around">
                    <button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializa</button>
                    <button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
                </div>
            </div>
        </div>
    </div>
</div>
