<style>
	.tab-disabled {
		pointer-events: none;
		opacity: 0.5;
		transition: opacity 0.25s ease-in-out, transform 0.15s ease-in-out;
	}

		.tab-disabled.tab-clicked {
			transform: scale(0.97);
			opacity: 0.35;
		}

	.tab-content-compact {
		/* padding: 0.75rem 0; */
		border-radius: 0.375rem;
		background-color: transparent;
		padding-bottom: 0.75rem;
		padding-right: 0;
		padding-left: 0;
		padding-top: 0.25rem;
	}

	.navbar, .main-header {
		z-index: 1100;
	}

	#filtrosAplicadosFloating{
		position: absolute;
		right: 0px;
		z-index: 2000;
		background-color: rgba(108,117,125,0.05);
		display: inline-flex;
		gap: 8px;
		white-space: nowrap;
	}
</style>
<div class="container-fluid min-vh-100 d-flex flex-column w-75">
	<div class="position-relative d-flex align-items-center w-100 mt-2" id="tabsWrapper">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsConsultaDeInfDeUL">
			<li class="nav-item" role="presentation" id="tabUL">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-ul" aria-controls="navs-top-ul" aria-selected="true" id="btnTabUL">
					UL
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabDetalle">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-det" aria-controls="navs-top-det" aria-selected="false" tabindex="-1" id="btnTabDetalle">
					Detalle
				</button>
			</li>
		</ul>
		<!-- Contenedor flotante para mostrar filtros aplicados (fallback en partials: #filtrosAplicadosContainer) -->
