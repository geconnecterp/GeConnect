@model ConsultaDeMovDeStockModel
@{
}
<style>
    .hidden {
        display: none !important;
    }

    .checkbox-readonly {
        pointer-events: none;
        opacity: 1 !important;
    }
</style>
<div class="card card-golden w-75" style="padding-left: 0px;padding-right: 0px;">
    <div class="card-header mb-2">
        <h5 class="mb-0" id="tituloLegend">Filtros </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-6 mb-3 mt-3">
                <div class="row">
                    <div class="input-group input-group-sm">
                        <div class="form-check form-check-inline form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
                            <label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
                        </div>
                    </div>
                    <div class=" col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text" id="lbIdDesde">Desde:</span>
                            <input type="date" class="form-control inputEditable" asp-for="FechaDesde" style="background-color:rgb(251,255,195);font-weight:900;" autofocus />
                        </div>
                    </div>
                    <div class=" col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text" id="lbIdHasta">Hasta:</span>
                            <input type="date" class="form-control inputEditable" asp-for="FechaHasta" style="background-color:rgb(251,255,195);font-weight:900;" autofocus />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 mb-3 mt-3">
                <div class="d-flex align-items-center">
                    <div class="form-check form-check-inline form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDescr" />
                        <label class="form-check-label" for="chkDescr" id="lbChkDescr"></label>
                    </div>
                </div>
                <div class="input-group input-group-sm">
                    <span class="input-group-text" id="lbDescr">Descr:</span>
                    <input type="text" class="form-control inputEditable" asp-for="Texto" placeholder="Ingresar ID de Producto o Descripción a buscar" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-12 mb-3 mt-3">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkTipo" />
                                <label class="form-check-label" for="chkTipo" id="lbTipo"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Nombre</span>
                            @Html.DropDownListFor(m => m.TipoMovimientoSeleccionado, Model.ListaTipoMovimientos, "Seleccionar", new { @id = "listaTipoMovimientos", disabled = "disabled", @class = "form-control inputEditable activable" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        @Html.ListBox("TipoMovimientosList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDepositos" />
                                <label class="form-check-label" for="chkDepositos" id="lbDepositos"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="input-group input-group-sm">
                            @Html.DropDownListFor(m => m.DepositoSeleccionado, Model.ListaDepositos, "Seleccionar", new { @id = "listaDepositos", disabled = "disabled", @class = "form-control inputEditable activable" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        @Html.ListBox("DepositosList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkBox" />
                                <label class="form-check-label" for="chkBox" id="lbBox"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6" id="divBoxes">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Nombre</span>
                            @Html.DropDownListFor(m => m.BoxSeleccionado, Model.ListaBoxs, "Seleccionar", new { @id = "listaBoxs", disabled = "disabled", @class = "form-control inputEditable activable" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        @Html.ListBox("BoxsList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="input-group input-group-sm">
                            <div class="form-check form-check-inline form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel01" />
                                <label class="form-check-label" for="chkRel01" id="lbRel01"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 col-sm-6" id="divLs01">
                    <div class="input-group  input-group-sm">
                        <input type="text" class="form-control inputEditable" name="Rel01" id="Rel01" disabled />
                        @Html.Hidden("Rel01Item")
                    </div>
                </div>
                <div class="col-md-6 col-sm-6">
                    @Html.ListBox("Rel01List", null, new { @class = "form-control", @disabled = "disabled" })
                </div>
            </div>
        </div>
        <div class="filter-golden-footer">
            <div class="row m-3">
                <div class="d-flex justify-content-around">
                    <button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializa</button>
                    <button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
                </div>
            </div>
        </div>
    </div>
</div>
