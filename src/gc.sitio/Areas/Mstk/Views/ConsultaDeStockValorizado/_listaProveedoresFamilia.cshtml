@model ProveedoresFamiliaValorizadoModel
@{
	var familiaProveedores = Model.ListaFamilias;
}
<div class="input-group input-group-sm">
	@Html.DropDownListFor(m => m.FamiliaSeleccionada, familiaProveedores, "Seleccionar", new { @id = "listaFamilia", disabled = "disabled", @class = "form-control inputEditable activable" })
</div>