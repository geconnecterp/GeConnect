@model ConsultaDeTransfInternaDeStockModel
@{
}
<style>
	.hidden {
		display: none !important;
	}

</style>
<div class="card card-golden w-75" style="padding-left: 0px;padding-right: 0px;">
	<div class="card-header mb-2">
		<h5 class="mb-0" id="tituloLegend">Filtros </h5>
		@* <div id="filtrosAplicadosContainer" class="d-inline-flex align-items-center" style="gap:8px; white-space:nowrap;"></div> *@
	</div>
	<div class="card-body">
		<div class="row">
			<div class="col-6 mb-3 mt-3">
				<div class="row">
					<div class="input-group input-group-sm">
						<div class="form-check form-check-inline form-switch mb-2">
							<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
							<label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
						</div>
					</div>
					<div class=" col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text" id="lbIdDesde">Desde:</span>
							<input type="date" class="form-control inputEditable" asp-for="Desde" style="background-color:rgb(251,255,195);font-weight:900;" autofocus />
						</div>
					</div>
					<div class=" col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text" id="lbIdHasta">Hasta:</span>
							<input type="date" class="form-control inputEditable" asp-for="Hasta" style="background-color:rgb(251,255,195);font-weight:900;" autofocus />
						</div>
					</div>
				</div>
			</div>
			<div class="col-6 mb-3 mt-3">
				<div class="row">
					<div class="col-sm-12">
						<div class="input-group input-group-sm">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkTipo" />
								<label class="form-check-label" for="chkTipo" id="lbTipo"></label>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Nombre</span>
							@Html.DropDownListFor(m => m.TipoSeleccionada, Model.ListaTipos, "Seleccionar", new { @id = "listaTipos", disabled = "disabled", @class = "form-control inputEditable activable" })
						</div>
					</div>
					<div class="col-sm-6">
						@Html.ListBox("TiposList", null, new { @class = "form-control listbox-sm hidden", @disabled = "disabled" })
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-12">
				<div class="row">
					<div class="col-sm-12">
						<div class="input-group input-group-sm">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkSucursalesEnvia" />
								<label class="form-check-label" for="chkSucursalesEnvia" id="lbSucursalesEnvia"></label>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Nombre</span>
							@Html.DropDownListFor(m => m.SucursalEnviaSeleccionada, Model.ListaSucursalesEnvia, "Seleccionar", new { @id = "listaSucursalesEnvia", disabled = "disabled", @class = "form-control inputEditable activable" })
						</div>
					</div>
					<div class="col-sm-6">
						@Html.ListBox("SucursalesEnviaList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-12">
				<div class="row">
					<div class="col-sm-12">
						<div class="input-group input-group-sm">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkSucursalesRecibe" />
								<label class="form-check-label" for="chkSucursalesRecibe" id="lbSucursalesRecibe"></label>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Nombre</span>
							@Html.DropDownListFor(m => m.SucursalRecibeSeleccionada, Model.ListaSucursalesRecibe, "Seleccionar", new { @id = "listaSucursalesRecibe", disabled = "disabled", @class = "form-control inputEditable activable" })
						</div>
					</div>
					<div class="col-sm-6">
						@Html.ListBox("SucursalesRecibeList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
					</div>
				</div>
			</div>
		</div>
		<div class="filter-golden-footer">
			<div class="row m-3">
				<div class="d-flex justify-content-around">
					<button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializa</button>
					<button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
				</div>
			</div>
		</div>
	</div>
</div>
