@using gc.infraestructura.Dtos.Almacen.AjusteDeStock
@using gc.infraestructura.Helpers
@model AjusteDeStockDetalleModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
</style>
<div class="row mb-1">
	<div class="col-12">
		<strong>Ajuste N°:</strong> @Model.Leyenda
	</div>
</div>
<div class="table-responsive table-wrapper-700" style="width: 65%;">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbDetalle">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="text-center">Id</th>
				<th class="text-center">Descripción</th>
				<th class="text-center">Stk</th>
				<th class="text-center">Ajuste</th>
				<th class="text-center">Costo</th>
				<th class="text-center">Total</th>
			</tr>
		</thead>
		<tbody>
			@if (Model == null || Model.GrillaAjusteDetalle==null || Model.GrillaAjusteDetalle.ListaDatos == null || !Model.GrillaAjusteDetalle.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="9" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay items para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.GrillaAjusteDetalle.ListaDatos)
				{
					var total = item.as_stock * item.as_pcosto;
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-detalle-ajuste"
						data-as-compte="@item.as_compte"
						data-p-id="@item.p_id">
						<td class="text-center">@item.p_id</td>
						<td class="text-start">@item.p_desc</td>
						<td class="text-end">@GridHelper.FormatearDato(item.as_stock, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end">@GridHelper.FormatearDato(item.as_ajuste, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end">@GridHelper.FormatearDato(item.as_pcosto, GridHelper.FormatDato.Monto, true)</td>
						<td class="text-end">@GridHelper.FormatearDato(total, GridHelper.FormatDato.Monto, true)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
