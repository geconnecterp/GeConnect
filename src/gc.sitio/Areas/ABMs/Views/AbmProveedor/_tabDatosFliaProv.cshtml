@model ProveedorABMFliaGrupoModel
@{
}
<style>
	#containerProveedorFliaProv {
		position: relative;
		max-height: 60vh;
		height: auto;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
			}

</style>
<div class="row">
	<div class="col-md-8">
		<div class="row">
			<div class="card">
				<div class="card-body mt-1">
					<div class="table-wrapper-300-full" id="containerProveedorFliaProv">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbProveedorFliaProv">
							<thead>
								<tr class="header">
									<th class="col-header-small align-center">ID</th>
									<th class="col-header-small align-center">Familia</th>
									<th style="width:0%; display:none;">usu_id</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.ListaProveedorGrupo != null && Model.ListaProveedorGrupo.ListaDatos != null && Model.ListaProveedorGrupo.ListaDatos.Count > 0)
								{
									@foreach (var item in Model.ListaProveedorGrupo.ListaDatos)
									{
										<tr onclick="selectRegCli(this, 'tbProveedorFliaProv')" ondblclick="selectRegDbl(this, 'tbProveedorFliaProv')">
											<td class="align-left">@item.pg_id</td>
											<td class="align-left">@item.pg_desc</td>
											<td style="display:none;">@item.cta_id</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		<div id="divDatosDeFamiliaSelected">
			<div class="row" style="padding-top: 10px;">
				@Html.HiddenFor(x => x.ProveedorGrupo.Cta_Id)
				<div class="row mt-1">
					<div class="input-group input-group-sm">
						<span class="input-group-text fixed-lbl-for-abm-70">ID: </span>
						<input type="text" asp-for="ProveedorGrupo.Pg_Id" class="form-control activable" />
					</div>
				</div>
				<div class="row mt-1">
					<div class="input-group input-group-sm">
						<span class="input-group-text fixed-lbl-for-abm-70">Familia: </span>
						<input type="text" asp-for="ProveedorGrupo.Pg_Desc" class="form-control activable" />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

