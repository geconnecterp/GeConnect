@using static gc.infraestructura.Constantes.Constantes
@model QueryFilters
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var filtro = new QueryFilters() 
	{ 
		Rel01 = null, 
		Rel02 = null,
		Modelo = ModeloFilter.ABM_CLIENTES
	};
}

@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
}

<div class="container">
	<input type="text" id="IdSelected" style="display:none;" />
	<partial name="_botonera" model="filtro" />

	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtroBase" model="filtro" />
		@Html.Hidden("pagEstado", false);
	</div>
	<div class="collapse" id="divDetalle" style="">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsAbmCliente">
			<li class="nav-item" role="presentation" id="tabCliente">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabCliente">
					Cliente
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabFormaDePago">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabFormasDePago">
					Formas de Pago
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabOtrosContactos">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-messages" aria-controls="navs-top-messages" aria-selected="false" tabindex="-1" id="btnTabOtrosContactos">
					Otros Contactos
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabNotas">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-notes" aria-controls="navs-top-notes" aria-selected="false" tabindex="-1" id="btnTabNotas">
					Notas
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabObservaciones">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-obs" aria-controls="navs-top-obs" aria-selected="false" tabindex="-1" id="btnTabObservaciones">
					Observaciones
				</button>
			</li>
		</ul>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div id="divDatosCliente">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div id="divFormasDePago">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-messages" role="tabpanel">
				<div id="divOtrosContactos">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-notes" role="tabpanel">
				<div id="divNotas">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-obs" role="tabpanel">
				<div id="divObservaciones">
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		@* <partial name="_gridAbmProds"  /> *@
		<div id="divGrilla">
			<p style="background-color:gray">
				<h5>No se han especificado datos aún.</h5>
			</p>
		</div>
	</div>
	<div class="row d-flex p-2 flex-fill">
		<div class="col-2"></div>
		<div id="divPaginacion" class="">
		</div>
		<div class="col-2"></div>
	</div>



</div>


@section scripts {
	<script type="text/javascript">
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "buscarClientes";
		var dataBak = {};
		var ctaId = "";
		var destinoDeOperacion = "";
		var tipoDeOperacion = "";
		var buscarUrl = "@Url.Action("buscar", "abmcliente", new { area = "abms" })";
		var buscarProveedorUrl = "@Url.Action("Buscar", "proveedor", new { area = "gestion" })";
		var autoComRel01Url = "@Url.Action("BuscarR01", "abmcliente", new { area = "abms" })";
		var autoComRel02Url = "@Url.Action("BuscarR02", "abmcliente", new { area = "abms" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "abmcliente", new { area = "abms" })";
		var buscarClienteUrl = "@Url.Action("BuscarCliente", "abmcliente", new { area = "abms" })";
		var buscarClienteCargadoUrl = "@Url.Action("BuscarClienteCargado", "abmcliente", new { area = "abms" })";
