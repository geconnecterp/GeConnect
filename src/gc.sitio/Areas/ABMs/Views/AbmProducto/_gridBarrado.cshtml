@model GridCoreSmart<ProductoBarradoDto>

@{
    var dataMod = new ProductoBarradoDto();
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
}

<div class="grid-golden">
    <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-10 col-sm-6">
                <h5 class="mb-0">
                    <i class="bx bx-honey"></i>
                    <strong>Detalle de Barrados</strong>
                </h5>
            </div>
        </div>
    </div>
    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap table-wrapper table-wrapper-300">
            <table class="table table-sm mb-0 table-hover  table-golden" id="tbGridBarr">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center th-compact" scope="col">Barrado</th>
                        <th class="text-center th-compact" scope="col">T.Barra</th>
                        <th class="text-center th-compact" scope="col">Un.Pres.</th>
                        <th class="text-center th-compact" scope="col">Un.Bto</th>
                        <th class="text-center th-compact" scope="col">Bto.Piso</th>
                        <th class="text-center th-compact" scope="col">Piso.Plt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListaDatos)
                    {
                        if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                        <!--ondblclick="selectAbmRegDbl(this,'tbGridBarr')"-->
                        <tr class="@clase" onclick="selectRegProd(this,'tbGridBarr')" >
                            <td class="text-sm-center">@item.p_id_barrado</td>
                            <td class="text-sm-start">@item.tba_desc</td>
                            <td class="text-sm-end">@item.p_unidad_pres</td>
                            <td class="text-sm-end">@item.p_unidad_x_bulto</td>
                            <td class="text-sm-end">@item.p_bulto_x_piso</td>
                            <td class="text-sm-end">@item.p_piso_x_pallet</td>                           
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>