@model GridCoreSmart<LimiteStkDto>

@{
    var dataMod = new LimiteStkDto();
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
}

<div class="grid-golden">
    @* <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-10 col-sm-6">
                <h5 class="mb-0">
                    <i class="bx bx-honey"></i>
                    <strong>Stock</strong>
                </h5>
            </div>
        </div>
    </div> *@
    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap table-wrapper" style="max-height: 200px;">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridLim">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center th-compact" scope="col">Sucursal</th>
                        <th class="text-center th-compact" scope="col">Nombre</th>
                        <th class="text-center th-compact" scope="col">Stk Min</th>
                        <th class="text-center th-compact" scope="col">Stk Max</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListaDatos)
                    {
                        if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                        @* ondblclick = "selectAbmRegDbl(this,'tbGridLim')" *@
                        <tr class="@clase" onclick="selectReg(this,'tbGridLim')" > 
                            <td class="text-sm-center">@item.adm_id</td>
                            <td class="text-sm-start">@item.adm_lista</td>
                            <td class="text-sm-end">@item.p_stk_min</td>
                            <td class="text-sm-end">@item.p_stk_max</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>