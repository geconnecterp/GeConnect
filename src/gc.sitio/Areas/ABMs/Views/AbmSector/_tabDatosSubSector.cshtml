@model SectorABMSubSectorModel
@{
	var alt = true;
	string clase = string.Empty;
}
<div class="row">
	<div class="col-md-8">
		<div class="row">
			<div class="grid-golden">
				<div class="grid-golden-body mt-1">
					<div class="table-responsive text-nowrap table-wrapper" style="max-height: 200px;">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbSubSectorEnTab">
							<thead class="sticky-top table-golden-header-compact">
								<tr class="header">
									<th class="text-center th-compact">ID</th>
									<th class="text-center th-compact">Sub Sector</th>
									<th style="width:0%; display:none;">Sec.</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.SectorSubSector != null && Model.SectorSubSector.ListaDatos != null)
								{
									@foreach (var item in Model.SectorSubSector.ListaDatos)
									{
										if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

										<tr action="clase" onclick="selectRegCli(this, 'tbSubSectorEnTab')" ondblclick="selectRegDbl(this, 'tbSubSectorEnTab')">
											<td class="align-left">@item.Rubg_Id</td>
											<td class="align-left">@item.Rubg_Desc</td>
											<td style="display:none;">@item.Sec_Id</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		<div id="divDatosDeSubSectorSelected">
			<div class="row" style="padding-top: 10px;">
				<div class="row mt-1">
					<div class="input-group input-group-sm">
						<span class="input-group-text fixed-lbl-for-abm-70">ID: </span>
						<input type="text" asp-for="SubSector.Rubg_Id" class="form-control activable" maxlength="4"/>
					</div>
				</div>
				<div class="row mt-1">
					<div class="input-group input-group-sm">
						<span class="input-group-text fixed-lbl-for-abm-70">Sub Sector: </span>
						<input type="text" asp-for="SubSector.Rubg_Desc" class="form-control activable" />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

