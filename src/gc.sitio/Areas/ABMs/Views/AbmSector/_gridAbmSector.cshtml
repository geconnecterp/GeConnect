@model GridCoreSmart<ABMSectorSearchDto>
@{
    var dataMod = new ABMSectorSearchDto();
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
}
<style>
    thead th {
        position: sticky;
        top: 0px;
    }
</style>
<div class="grid-golden">
    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap  table-golden  table-wrapper" style="max-height: 500px;">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridSector">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center th-compact" scope="col">ID</th>
                        <th class="text-left th-compact" scope="col">Sector</th>
                    </tr>
                </thead>
                <tbody>
					@if (Model != null && Model.ListaDatos != null)
					{
                        @foreach (var item in Model.ListaDatos)
                        {
                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

                            <tr class="@clase" onclick="selectReg(this, 'tbGridSector')">
                                <td class="text-sm-center">@item.sec_id</td>
                                <td class="text-sm-start">@item.sec_desc.ToUpper()</td>
                            </tr>
                        }
					}
                </tbody>
            </table>
        </div>
    </div>
</div>