@model QueryFilters
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var filtro = new QueryFilters() { };
}

@section styles {
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
	<link rel="stylesheet" href="~/css/simplePagination.css" />
}

<div class="container">
	<input type="text" id="IdSelected" style="display:none;" />

	<partial name="_botonera" model="filtro" />

	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtroBase" model="filtro" />
		@Html.Hidden("pagEstado", false)
	</div>

	<div class="collapse" id="divDetalle" style="">
		<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsAbmSector">
			<li class="nav-item" role="presentation" id="tabBanco">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabBanco">
					Bancos
				</button>
			</li>
		</ul>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div id="divDatosBanco">
				</div>
			</div>
		</div>
	</div>
	<div class="collapse row" id="divGrilla">
		<p style="background-color:gray">
			<h5>No se han especificado datos aún.</h5>
		</p>
	</div>
	<div class="collapse row d-flex p-2 flex-fill">
		<div class="col-3"></div>
		<div id="divPaginacion" class="collapse">
		</div>
		<div class="col-3"></div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "buscarBancos";
		var dataBak = {};
		var ctafId = "";
		var ctafIdRow = null;
		var destinoDeOperacion = "";
		var tipoDeOperacion = "";
		var buscarUrl = "@Url.Action("buscar", "abmbanco", new { area = "abms" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "abmbanco", new { area = "abms" })";
		var buscarBancoUrl = "@Url.Action("BuscarBanco", "abmbanco", new { area = "abms" })";
		var nuevoBancoUrl = "@Url.Action("NuevoBanco", "abmbanco", new { area = "abms" })";
		var dataOpsBancoUrl = "@Url.Action("DataOpsBanco", "abmbanco", new { area = "abms" })";
		var buscarBancoCargadoUrl = "@Url.Action("BuscarBancoCargado", "abmbanco", new { area = "abms" })";

		// Añadir la URL para el plan de cuentas
		var buscarPlanCuentasUrl = '@Url.Action("Buscar", "ABMPlanCuenta", new { area = "ABMs" })';

		// Asignar la URL al cargar la página
		$(function() {
			// Configurar la URL para el selector de cuentas
			window.buscarPlanCuentasUrl = buscarPlanCuentasUrl;
		});
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>
	<script src="~/js/app/areas/abms/abmsettings.js" type="text/javascript"></script>
	<script src="~/js/app/areas/abms/abmcommons.js" type="text/javascript"></script>
	<script src="~/js/app/areas/abms/abmbanco.js" type="text/javascript"></script>
}
