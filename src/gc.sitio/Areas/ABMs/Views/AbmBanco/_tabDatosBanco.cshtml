@model BancoAbmModel
@{
	var mon = Model.Moneda;
	var tcb = Model.TipoCuenta;
	var gas = Model.CuentaGasto;
	var con = Model.CuentaContable;
}
<div class="row">
	@Html.HiddenFor(x => x.Banco.Ccb_Desc)
	@Html.HiddenFor(x => x.Banco.Ccb_Id)
	@Html.HiddenFor(x => x.Banco.Ccb_Desc_Diferido)
	@Html.HiddenFor(x => x.Banco.Ccb_Id_Diferido)
	<div class="col-md-6" style="margin-left:15px;">
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">ID:</span>
				<input type="text" asp-for="Banco.Ctaf_Id" class="form-control" disabled />
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">Banco:</span>
				<input type="text" asp-for="Banco.Ban_Razon_Social" class="form-control activable inputEditable" />
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">Tipo de Cuenta: </span>
				@Html.DropDownListFor(m => m.Banco.Tcb_Id, tcb, "Seleccionar...", new { @id = "listaTcb", @class = "form-control activable" })
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">N° Cuenta:</span>
				<input type="text" asp-for="Banco.Ban_Cuenta_Nro" class="form-control activable inputEditable" />
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">CBU:</span>
				<input type="text" asp-for="Banco.Ban_Cuenta_Cbu" class="form-control activable inputEditable" />
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">Moneda: </span>
				@Html.DropDownListFor(m => m.Banco.Mon_Codigo, mon, "Seleccionar...", new { @id = "listaMoneda", @class = "form-control activable" })
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">CUIT:</span>
				<input type="text" asp-for="Banco.Ban_Cuit" class="form-control activable inputEditable" />
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">Cuenta Gasto: </span>
				@Html.DropDownListFor(m => m.Banco.Ctag_Id, gas, "Seleccionar...", new { @id = "listaCtaGas", @class = "form-control activable" })
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">Cuenta Contable: </span>
				<input type="text" class="form-control activable" id="cuentaContable" name="cuentaContable"
					   placeholder="Cuenta contable..." readonly
					   data-bs-toggle="tooltip" title="Haga clic en la lupa para seleccionar una cuenta" />
				<input type="hidden" id="cuentaContableId" name="cuentaContableId" />
				<button class="btn btn-outline-secondary btnBuscarCuenta activable"
						type="button"
						data-target="cuentaContable"
						data-target-id="cuentaContableId">
					<i class="bx bx-search"></i>
				</button>
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-130">Cuenta Contable Dif.: </span>
				<input type="text" class="form-control activable" id="cuentaContableDif" name="cuentaContableDif"
					   placeholder="Cuenta contable dif..." readonly
					   data-bs-toggle="tooltip" title="Haga clic en la lupa para seleccionar una cuenta" />
				<input type="hidden" id="cuentaContableDifId" name="cuentaContableDifId" />
				<button class="btn btn-outline-secondary btnBuscarCuenta activable"
						type="button"
						data-target="cuentaContableDif"
						data-target-id="cuentaContableDifId">
					<i class="bx bx-search"></i>
				</button>
			</div>
		</div>
		<div class="row mt-1" id="divDatosChequeraActual">
			<fieldset>
				<legend>
					Chequera Actual
				</legend>
				<div class="input-group input-group-sm">
					<span class="input-group-text fixed-lbl-for-abm-100">N° Che. Desde:</span>
					<input type="number" asp-for="Banco.Ban_Che_Desde" class="form-control activable" />
					<span class="input-group-text fixed-lbl-for-abm-100">N° Che. Hasta:</span>
					<input type="number" asp-for="Banco.Ban_Che_Hasta" class="form-control activable" />
					<span class="input-group-text fixed-lbl-for-abm-100">N° Che. a Emitir:</span>
					<input type="number" asp-for="Banco.Ban_Che_Nro" class="form-control activable" />
				</div>
			</fieldset>
		</div>
	</div>
</div>

<div class="modal fade modal-golden" id="selectorPlanCuentasModal" tabindex="-1" aria-labelledby="selectorPlanCuentasModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="selectorPlanCuentasModalLabel">
					<i class="bx bx-list-ul"></i> Seleccionar Cuenta Contable
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="mb-3">
					<div class="input-group">
						<span class="input-group-text"><i class="bx bx-search"></i></span>
						<input type="text" class="form-control" id="txtBuscarCuentaPlan" placeholder="Buscar cuenta mientras escribe...">
					</div>
					<small class="form-text text-muted">La búsqueda se realiza automáticamente mientras escribe</small>
				</div>

				<div id="resultadosBusqueda" class="mb-2" style="display: none;"></div>

				<div id="cuentasTree" class="tree-container-golden jstree-golden" style="max-height: 350px; overflow-y: auto;"></div>
				<div class="mt-3 small">
					<div class="d-flex flex-wrap text-muted">
						<span class="me-2 d-flex align-items-center">
							<i class="bx bx-wallet text-success me-1"></i> Activo
						</span>
						<span class="me-2 d-flex align-items-center">
							<i class="bx bx-trending-down text-danger me-1"></i> Pasivo
						</span>
						<span class="me-2 d-flex align-items-center">
							<i class="bx bx-building-house text-purple me-1"></i> Patrimonio
						</span>
						<span class="me-2 d-flex align-items-center">
							<i class="bx bx-dollar-circle text-warning me-1"></i> Ingresos
						</span>
						<span class="me-2 d-flex align-items-center">
							<i class="bx bx-money-withdraw text-info me-1"></i> Egresos
						</span>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
					<i class="bx bx-x me-1"></i> Cerrar
				</button>
				<button type="button" class="btn btn-golden" id="btnSeleccionarCuenta" disabled>
					<i class="bx bx-check me-1"></i> Seleccionar
				</button>
			</div>
		</div>
	</div>
</div>

<style>
	.jstree-anchor.tipo-movimiento {
		font-weight: bold;
	}

	.jstree-anchor.cuenta-activo {
		color: #28a745;
	}

	.jstree-anchor.cuenta-pasivo {
		color: #dc3545;
	}

	.jstree-anchor.cuenta-patrimonio {
		color: #6f42c1;
	}

	.jstree-anchor.cuenta-ingresos {
		color: #fd7e14;
	}

	.jstree-anchor.cuenta-egresos {
		color: #17a2b8;
	}

	.modal-golden .modal-header {
		background-color: #f0ad4e;
		color: white;
		border-bottom: 3px solid #eea236;
	}

	.modal-golden .modal-footer {
		border-top: 2px solid #f5f5f5;
		background-color: #fcf8e3;
	}

	.btn-golden {
		background-color: #f0ad4e;
		border-color: #eea236;
		color: white;
	}

		.btn-golden:hover, .btn-golden:focus {
			background-color: #ec971f;
			border-color: #d58512;
			color: white;
		}

		.btn-golden:disabled {
			background-color: #f8d9ac;
			border-color: #f5c879;
		}

	.tree-container-golden {
		border: 1px solid #f0ad4e;
		border-radius: 0.25rem;
		padding: 0.5rem;
	}
</style>