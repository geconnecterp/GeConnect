@using gc.infraestructura.Dtos.Almacen.Tr.Transferencia
@model OrdenDeRepartoPonerEnCursoModel

@{
	var alt = true;
	string clase = string.Empty;
	var or = Model.OrdenDeReparto;
	var listaDepositos = Model.ListaDepositos?.ListaDatos?.ToList() ?? new List<TRAutDepoDto>();
}

<div class="container-fluid min-vh-100 d-flex flex-column">

	<!-- ============================
		 FILA SUPERIOR: DATOS DE LA OR
		 ============================ -->
	<div class="row mb-1">
		<div class="col-12">
			<div class="p-1 border rounded bg-light">
				<div class="row">
					<div class="col-md-2">
						<strong>ID OR:</strong> @or.or_compte
					</div>
					<div class="col-md-3">
						<strong>Repartidor:</strong> @or.rp_nombre
					</div>
					<div class="col-md-2">
						<strong>Estado:</strong> @or.ore_desc
					</div>
					<div class="col-md-2">
						<strong>Fecha:</strong> @or.or_fecha.ToString("dd/MM/yyyy")
					</div>
					<div class="col-md-3">
						<strong>Obs:</strong> @or.or_obs
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ============================
		 FILA PRINCIPAL: 2 COLUMNAS
		 ============================ -->
	<div class="row gx-2 flex-grow-1 h-100">

		<!-- COLUMNA IZQUIERDA -->
		<div class="col-md-2 d-flex flex-column h-100">

			<div class="card h-100 d-flex flex-column">

				<div class="card-header fw-bold">
					Depósitos de Envío
				</div>

				<div class="card-body p-0 flex-grow-1 overflow-auto">
					<div class="table-responsive table-wrapper-200">
						<table class="table table-sm table-hover mb-0 table-golden" id="tbDepositos">
							<thead class="sticky-top table-golden-header-compact">
								<tr class="header">
									<th>Depósito</th>
									<th class="text-center">
										<input type="checkbox" id="chkDepoMaster" class="form-check-input" />
									</th>
									<th style="width:10%;" class="align-center">Solo si<br />no hay stk</th>
									<th style="width:0%; display:none;">depo_id</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var d in listaDepositos)
								{
									if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
									<tr class="@clase"
										data-depo-id="@d.depo_id">
										<td>@d.depo_nombre</td>
										<td class="text-center">
											<input type="checkbox"
												   class="form-check-input chkDeposito"
												   @(d.seleccionado ? "checked" : "") />
										</td>
										<td class="text-center td-solo-si-no-hay-stk">
											@* Celda gestionada por JS: si el checkbox de la fila está marcado, se inserta aquí un checkbox hijo (inicialmente desmarcado). *@
										</td>
										<td style="width:0%; display:none;">@d.depo_id</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Botonera dentro del card -->
				<div class="card-footer d-flex flex-column gap-2 mt-auto">
					<button id="btnAnalizarPonerEnCurso" class="btn btn-primary d-flex align-items-center">
						<i class="bx bx-search-alt me-1"></i> Analizar OR
					</button>

					<button id="btnConfirmarPonerEnCurso" class="btn btn-success d-flex align-items-center" disabled>
						<i class="bx bx-refresh me-1"></i> Poner En Curso
					</button>

					<button id="btnCancelarPonerEnCurso" class="btn btn-danger d-flex align-items-center">
						<i class="bx bx-x-circle me-1"></i> Cancelar
					</button>
				</div>

			</div>

		</div>

		<!-- COLUMNA DERECHA -->
		<div class="col-md-10 d-flex flex-column h-100">
			<div class="d-flex justify-content-between align-items-center mb-2">
				<!-- TABS -->
				<ul class="nav nav-tabs" id="tabAnalisisDeStk" role="tablist">
					<li class="nav-item" role="presentation">
						<button class="nav-link active" id="tab-analisis-tab" data-bs-toggle="tab"
								data-bs-target="#tab-analisis" type="button" role="tab">
							Análisis de Stk y Recolección
						</button>
					</li>
					<li class="nav-item" role="presentation">
						<button class="nav-link" id="tab-sinstock-tab" data-bs-toggle="tab"
								data-bs-target="#tab-sinstock" type="button" role="tab">
							Sin Stock
						</button>
					</li>
				</ul>
			</div>
			<!-- CONTENIDO DE LOS TABS -->
			<div class="tab-content tab-content-no-padding" id="tabAnalisisDeStkContent" style="padding: 0px;">
				<!-- TAB #1: ANALISIS DE STK -->
				<div class="tab-pane fade show active" id="tab-analisis" role="tabpanel" style="padding: 5px;">
					<div id="cardGrillaAnalizaAut">
						<div class="table-responsive table-wrapper-400-full-width">
							<!-- TABLA VACÍA INICIAL -->
							<table class="table table-sm table-hover mb-0 table-golden" id="tbGrillaAnalizaAut">
								<thead class="sticky-top table-golden-header-compact">
									<tr class="header">
										<th class="text-center" style="width:4%;">ID</th>
										<th>Descripción</th>
										<th class="text-center" style="width:4%;">ID Prov</th>
										<th class="text-center col-num" style="width:6%;">STK Suc</th>
										<th class="text-center col-num" style="width:5%;">Pedido</th>
										<th class="text-center col-num" style="width:6%;">A Enviar</th>
										<th class="text-center col-num" style="width:6%;">Dif.</th>
										<th class="text-center" style="width:8%;">PC N°</th>
										<th class="text-center" style="width:7%;">BOX</th>
										<th class="text-center col-num" style="width:8%;">A Enviar BOX</th>
									</tr>
								</thead>
								<tbody>
									<tr class="fila-vacia">
										<td colspan="11" class="text-center text-muted py-2">
											<i class="bx bx-info-circle me-1"></i>
											No hay datos para mostrar. Seleccione depósitos y presione <strong>Analizar OR</strong>.
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- TAB #2: SIN STOCK -->
				<div class="tab-pane fade" id="tab-sinstock" role="tabpanel" style="padding: 5px;">
					<!-- Tabla Sin Stock -->
					<div id="divNuevaAutListaProductosSinStock">
						<div class="table-responsive text-nowrap table-wrapper">
							<table class="table table-sm mb-0 table-hover table-golden" id="tbNuevaAutListaProductosSinStock">
								<thead>
									<tr class="header">
										<th style="width:5%;" class="align-center">ID</th>
										<th style="width:25%;" class="align-center">Descripción</th>
										<th style="width:10%;" class="align-center">ID Prov.</th>
										<th style="width:10%;" class="align-center">Comprobante</th>
										<th style="width:10%;" class="align-center">Stock</th>
										<th style="width:10%;" class="align-center">Pedido</th>
									</tr>
								</thead>
								<tbody>
									<tr class="fila-vacia">
										<td colspan="11" class="text-center text-muted py-2">
											<i class="bx bx-info-circle me-1"></i>
											No hay datos para mostrar.
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
