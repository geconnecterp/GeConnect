@model GridCoreSmart<AConsolidarPedidoClienteDetalleDto>
@{
    var alt = true;
    string clase = string.Empty;
}
<style>
    .dif-positivo {
        background-color: #ffb3b3 !important; /* rojo suave */
        font-weight: bold;
    }

    .dif-negativo {
        background-color: #ffe0b3 !important; /* naranja suave */
        font-weight: bold;
    }

    .input-cantidad {
        width: 60px !important;
        text-align: right !important;
        padding: 0 4px !important;
        height: 22px !important; /* 🔥 Ajustá este valor a gusto */
        line-height: 22px !important;
        font-size: 0.75rem !important; /* Más compacto */
    }

    td.celda-a-enviar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    #tbConsolidarDetalleConteo tbody tr td {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
    }

</style>
<div class="table-responsive table-wrapper-400">
    <table class="table table-sm table-hover mb-0 table-golden" id="tbConsolidarDetalleConteo">
        <thead class="sticky-top table-golden-header-compact">
            <tr class="header">
                <th>Item</th>
                <th>Código</th>
                <th>Descripción</th>
                <th>Pedido</th>
                <th>A Enviar</th>
                <th>Dif.</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
            {
                <tr class="fila-vacia">
                    <td colspan="6" class="text-center text-muted py-2">
                        <i class="bx bx-info-circle me-1"></i>
                        No hay detalles del conteo.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.ListaDatos)
                {
                    var dif = item.cantidad - item.pcd_pedida;
                    var claseDif = dif > 0 ? "dif-positivo" : (dif < 0 ? "dif-negativo" : "");
                    if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                    <tr class="@clase row-detalle-conteo-conteo"
                        data-p-id="@item.p_id"
                        data-or-compte="@item.or_compte"
                        data-pc-compte="@item.pc_compte"
                        data-permite-decimales="@(item.PermiteDecimales.ToString().ToLower())">

                        <td>@item.pcd_item</td>
                        <td>@item.p_id</td>
                        <td>@item.p_desc</td>
                        <td class="text-end">@GridHelper.FormatearDato(item.pcd_pedida, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                        <td class="text-end celda-a-enviar">
                            <input type="text"
                                   class="form-control form-control-sm editor-celda input-cantidad"
                                   value="@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)"
                                   data-original="@item.cantidad"
                                   data-permite-decimales="@(item.PermiteDecimales.ToString().ToLower())"
                                   disabled />
                        </td>
                        <td class="text-end celda-dif @claseDif">@GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $("#tbDetalleConteo tbody tr.row-detalle-conteo").on("click", function () {
        const p_id = $(this).data("p-id");
        $(document).trigger("rowSelectedDetalleConteo", p_id);
    });
</script>
