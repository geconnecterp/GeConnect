@model OrdenDeRepartoABMModel
<style>
    .btn-or {
        min-width: 120px;
    }

</style>
<div class="container-fluid">

    <!-- ===========================
         ENCABEZADO DE LA OR
    ============================ -->
    <div class="card mb-3">
        <div class="card-body">

            <div class="row g-3">

                <input type="hidden" id="accion" name="accion" value="@Model?.Accion" />

                <div class="col-md-2">
                    <label class="form-label fw-bold">ID OR</label>
                    <input type="text" class="form-control form-control-sm" id="or_compte"
                           value="@Model.OrdenDeReparto.or_compte" readonly>
                </div>

                <div class="col-md-2">
                    <input type="hidden" id="ore_id" name="ore_id" value="@Model?.OrdenDeReparto.ore_id" />
                    <label class="form-label fw-bold">Estado</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@Model.OrdenDeReparto.ore_desc" readonly>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Fecha</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@Model.OrdenDeReparto.or_fecha.ToString("dd/MM/yyyy")" readonly>
                </div>

                <!-- ===========================
                     REPARTIDOR (editable SIEMPRE)
                ============================ -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Repartidor</label>

                    @if (Model.Accion == 'A')
                    {
                        <!-- Alta: sin selección -->
                        @Html.DropDownListFor(
                            m => m.RepartidorSeleccionado,
                            Model.ListaRepartidores,
                            "-- Seleccione --",
                            new { @class = "form-select" }
                        )
                    }
                    else
                    {
                        <!-- Modificación: seleccionar rp_id -->
                        @Html.DropDownListFor(
                            m => m.RepartidorSeleccionado,
                            new SelectList(Model.ListaRepartidores, "Value", "Text", Model.OrdenDeReparto.rp_id),
                            new { @class = "form-select" }
                        )
                    }
                </div>

                <!-- ===========================
                     OBSERVACIONES (editable SIEMPRE)
                ============================ -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Observaciones</label>
                    @Html.TextAreaFor(
                        m => m.OrdenDeReparto.or_obs,
                        new { @class = "form-control form-control-sm", rows = "2" }
                    )
                </div>

            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success btn-sm btn-or" id="btnConfirmarORenABM">
                    <i class="bx bx-check-circle"></i> Confirmar OR
                </button>

                <button class="btn btn-danger btn-sm btn-or" id="btnCancelarORenABM">
                    <i class="bx bx-x-circle"></i> Cancelar
                </button>
            </div>

        </div>
    </div>


    <!-- ===========================
         TABLAS PRINCIPALES
    ============================ -->
    <div class="row g-3">

        <div class="col-md-6" id="divListaPedidosDeLaOrden">
            @await Html.PartialAsync("_gridOR_ABM_PedidosEnOR", Model.ListaPedidosEnOrdenDeReparto)
        </div>

        <div class="col-md-6">
            @await Html.PartialAsync("_gridOR_ABM_PedidosPendientes", Model.ListaPedidosPendientes)
        </div>

    </div>

</div>