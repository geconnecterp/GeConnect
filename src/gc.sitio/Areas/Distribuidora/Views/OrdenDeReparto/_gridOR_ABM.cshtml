@model OrdenDeRepartoABMModel

<div class="container-fluid">

    <!-- ===========================
         ENCABEZADO DE LA OR
    ============================ -->
    <div class="card mb-3">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-2">
                    <label class="form-label fw-bold">ID OR</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@Model.OrdenDeReparto.or_compte" readonly>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Estado</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@Model.OrdenDeReparto.ore_desc" readonly>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Fecha</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@Model.OrdenDeReparto.or_fecha.ToString("dd/MM/yyyy")" readonly>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Repartidor</label>
                    <input type="text" class="form-control form-control-sm"
                           value="@Model.OrdenDeReparto.rp_nombre" readonly>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">Observaciones</label>
                    <textarea class="form-control form-control-sm" rows="2">@Model.OrdenDeReparto.or_obs</textarea>
                </div>

            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success btn-sm">
                    <i class="bx bx-check-circle"></i> Confirmar OR
                </button>

                <button class="btn btn-danger btn-sm">
                    <i class="bx bx-x-circle"></i> Cancelar
                </button>
            </div>

        </div>
    </div>


    <!-- ===========================
         TABLAS PRINCIPALES
    ============================ -->
    <div class="row g-3">

        <!-- IZQUIERDA -->
        <div class="col-md-6">
            @await Html.PartialAsync("_PedidosEnOR", Model.ListaPedidosEnOrdenDeReparto)
        </div>

        <!-- DERECHA -->
        <div class="col-md-6">
            @await Html.PartialAsync("_PedidosPendientes", Model.ListaPedidosPendientes)
        </div>

    </div>

</div>
