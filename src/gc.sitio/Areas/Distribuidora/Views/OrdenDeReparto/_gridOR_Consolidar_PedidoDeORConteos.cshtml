@model GridCoreSmart<AConsolidarConteosDto>
@{
    string rubActual = "";
    string rubAnterior = "";
    var alt = true;
    string clase = string.Empty;
}
<style>
    #containerTbConsolidarConteos {
        max-width: 100% !important;
        overflow-x: hidden !important;
    }

    .cell-zero {
        background-color: #d4edda !important; /* verde suave */
        color: #155724 !important; /* texto verde oscuro */
        font-weight: bold !important;
    }

    /* DIF mayor a 0 → celeste fuerte */
    .cell-up {
        background-color: #79bff2 !important; /* celeste intenso */
        color: #003B57 !important; /* azul oscuro para contraste */
        font-weight: bold;
        text-align: center;
    }

    /* DIF menor a 0 → rojo */
    .cell-down {
        background-color: #dc3545 !important; /* rojo Bootstrap */
        color: #ffffff !important; /* blanco */
        font-weight: 700 !important; /* gruesa */
    }

    .tr-rubro {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        line-height: 1.1 !important;
        font-size: 0.80rem !important;
        text-align: left !important;
    }

        .tr-rubro td {
            padding-top: 1px !important;
            padding-bottom: 1px !important;
            vertical-align: middle !important;
        }

        .tr-rubro i {
            vertical-align: middle !important;
            transform: translateY(1px); /* ajuste fino del baseline */
        }
</style>
<div class="table-responsive table-wrapper-400" id="containerTbConsolidarConteos">
    <table class="table table-sm table-hover mb-0 table-golden" id="tbConsolidarConteos">
        <thead class="sticky-top table-golden-header-compact">
            <tr class="header">
                <th class="text-center">Código</th>
                <th class="text-center">Descripción</th>
                <th class="text-center">Pedido</th>
                <th class="text-center">a Enviar</th>
                <th class="text-center">Ctrl. Salida</th>
                <th class="text-center">Dif.</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
            {
                <tr class="fila-vacia">
                    <td colspan="6" class="text-center text-muted py-2">
                        <i class="bx bx-info-circle me-1"></i>
                        No hay conteos para mostrar.
                    </td>
                </tr>
            }
            else
            {
                var productos = Model.ListaDatos.OrderBy(x => x.rub_desc).ToList();
                foreach (var item in productos)
                {
                    rubActual = item.rub_id;
                    if (rubActual != rubAnterior)
                    {
                        <tr class="table-secondary fw-bold tr-rubro">
                            <td colspan="13" class="text-start">
                                <i class="bx bx-folder me-1"></i>
                                @item.rub_desc
                            </td>
                        </tr>
                        rubAnterior = rubActual;
                        alt = true;
                    }

                    var dif = item.cantidad - item.cantidad_ctl;
                    if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                    <tr class="@clase row-conteo"
                        data-or-compte="@item.or_compte"
                        data-p-id="@item.p_id">
                        <td class="text-center">@item.p_id</td>
                        <td class="text-start">@item.p_desc</td>
                        <td class="text-end">@GridHelper.FormatearDato(item.pcd_pedida, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                        @* <td class="text-end">@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td> *@
                        <td class="table-fontsize" style="font-weight: bold;">
                            <div class="td-conteo">
                                <span class="td-icon">
                                    @if (item.pcd_pedida < item.cantidad)
                                    {
                                        <i class="bx bx-up-arrow-alt text-info icon-arrow"></i>
                                    }
                                    else if (item.pcd_pedida > item.cantidad)
                                    {
                                        <i class="bx bx-down-arrow-alt text-danger icon-arrow"></i>
                                    }
                                </span>

                                <span class="td-value">
                                    @GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)
                                </span>
                            </div>
                        </td>
                        <td class="text-end" style="font-weight: bold;">
                            @GridHelper.FormatearDato(item.cantidad_ctl, GridHelper.FormatDato.Monto, item.PermiteDecimales)
                        </td>
                        @if (dif == 0 && item.pcd_pedida > 0)
                        {
                            <td class="table-fontsize diferencia-cero d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bx bx-check-circle text-success" title="Sin diferencia"></i>
                                </span>
                                <span class="ms-auto">
                                    @GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales)
                                </span>
                            </td>
                        }
                        else
                        {
                            <td class="text-end @(dif > 0 ? "cell-down" : (dif < 0 ? "cell-up" : "cell-zero"))">
                                @GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales)
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $("#tbConteos tbody tr.row-conteo").on("click", function () {
        const conteoId = $(this).data("conteo-id");
        $(document).trigger("rowSelectedConteo", conteoId);
    });
</script>
