@model GridCoreSmart<AConsolidarConteosDto>
@{
    string rubActual = "";
    string rubAnterior = "";
    var alt = true;
    string clase = string.Empty;
}

<div class="table-responsive table-wrapper-400">
    <table class="table table-sm table-hover mb-0 table-golden" id="tbConsolidarConteos">
        <thead class="sticky-top table-golden-header-compact">
            <tr class="header">
                <th>Código</th>
                <th>Descripción</th>
                <th>Pedido</th>
                <th>a Enviar</th>
                <th>Ctrl. Salida</th>
                <th>Dif.</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
            {
                <tr class="fila-vacia">
                    <td colspan="6" class="text-center text-muted py-2">
                        <i class="bx bx-info-circle me-1"></i>
                        No hay conteos para mostrar.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.ListaDatos)
                {
                    rubActual = item.rub_id;
                    if (rubActual != rubAnterior)
                    {
                        <tr class="table-secondary fw-bold">
                            <td colspan="13" class="text-center">
                                <i class="bx bx-folder me-1"></i>
                                @item.rub_desc
                            </td>
                        </tr>
                        rubAnterior = rubActual;
                        alt = true;
                    }

                    var dif = item.pcd_pedida - item.cantidad;
                    if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                    <tr class="@clase row-conteo"
                        data-or-compte="@item.or_compte"
                        data-p-id="@item.p_id">
                        <td>@item.p_id</td>
                        <td>@item.p_desc</td>
                        <td class="text-end">@GridHelper.FormatearDato(item.pcd_pedida, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                        <td class="text-end">@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                        <td class="text-end">@GridHelper.FormatearDato(item.cantidad_ctl, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
                        <td class="text-end">@dif</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $("#tbConteos tbody tr.row-conteo").on("click", function () {
        const conteoId = $(this).data("conteo-id");
        $(document).trigger("rowSelectedConteo", conteoId);
    });
</script>
