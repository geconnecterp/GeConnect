@model GridCoreSmart<PedidoEnOrdenDeRepartoDto>

<div class="card h-100">
    <div class="card-header fw-bold">
        Pedidos de Clientes de la OR
    </div>

    <div class="card-body p-0">
        <div class="table-responsive table-wrapper-400">

            <table class="table table-sm table-hover mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th class="text-center">ID</th>
                        <th>Cliente</th>
                        <th class="text-center">Generado</th>
                        <th>Vendedor</th>
                        <th>Repartidor</th>
                        <th class="text-end">Importe</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.ListaDatos?.Any() == true)
                    {
                        foreach (var p in Model.ListaDatos)
                        {
                            <tr>
                                <td class="text-center">@p.pc_compte</td>
                                <td>@p.cta_denominacion</td>
                                <td class="text-center">@p.pc_fecha.ToString("dd/MM/yyyy")</td>
                                <td>@p.ve_nombre</td>
                                <td>@p.rp_nombre</td>
                                <td class="text-end">@p.cm_total.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>No hay pedidos
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

