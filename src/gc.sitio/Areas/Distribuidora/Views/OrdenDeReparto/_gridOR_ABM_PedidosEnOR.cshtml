@model GridCoreSmart<PedidoEnOrdenDeRepartoDto>
@{
    var alt = true;
    string clase = string.Empty;
}
<style>
    .btn-table {
        padding: 0.15rem 0.35rem;
        font-size: 0.70rem;
        line-height: 1;
    }

    .tabla-bloqueada {
        pointer-events: none;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .td-nowrap {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .table-fixed {
        table-layout: fixed !important;
        width: 100% !important;
    }

    .col-cliente {
        width: 180px;
    }

    .col-vendedor {
        width: 140px;
    }

    .col-repartidor {
        width: 140px;
    }

</style>
<div class="card h-100">
    <div class="card-header fw-bold">
        Pedidos de Clientes de la OR
    </div>

    <div class="card-body p-0">
        <div class="table-responsive table-wrapper-400">

            <table class="table table-sm table-hover mb-0 table-golden table-fixed" id="tbPedidosOR">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center">ID</th>
                        <th>Cliente</th>
                        <th class="text-center">Generado</th>
                        <th>Vendedor</th>
                        <th>Repartidor</th>
                        <th class="text-end">Importe</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.ListaDatos?.Any() == true)
                    {
                        foreach (var p in Model.ListaDatos)
                        {
                            if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }
                            <tr class="@clase">
                                <td class="text-center">@p.pc_compte</td>
                                <td class="td-nowrap col-cliente" title="@p.cta_denominacion">@p.cta_denominacion</td>
                                <td class="text-center">@p.pc_fecha.ToString("dd/MM/yy")</td>
                                <td class="td-nowrap col-vendedor" title="@p.ve_nombre">@p.ve_nombre</td>
                                <td class="td-nowrap col-repartidor" title="@p.rp_nombre">@p.rp_nombre</td>
                                <td class="text-end">@p.pc_precio_tot.ToString("N2")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button class="btn btn-danger btn-table btn-sm btnQuitarPedido"
                                                data-id="@p.pc_compte"
                                                data-cliente="@p.cta_denominacion"
                                                data-fecha="@p.pc_fecha.ToString("yyyy-MM-dd")"
                                                data-vendedor="@p.ve_nombre"
                                                data-repartidor="@p.rp_nombre"
                                                data-importe="@p.cm_total"
                                                title="Quitar pedido de la Orden de Reparto">
                                            <i class="bx bx-minus"></i>
                                        </button>
                                        <button class="btn btn-secondary btn-table btn-sm btnEditarPedido"
                                                data-id="@p.pc_compte"
                                                data-eid="@p.pce_id"
                                                title="Editar pedido">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="fila-vacia">
                            <td colspan="7" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>No hay pedidos
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>



