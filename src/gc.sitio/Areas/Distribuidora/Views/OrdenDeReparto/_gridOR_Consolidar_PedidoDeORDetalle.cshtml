@model GridCoreSmart<AConsolidarPedidoClienteDetalleDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	/* .table-golden td.cell-up {
		background-color: #b6f7b6 !important;
		color: #0f4d0f !important;
		font-weight: bold;
		text-align: center;
	}

	.table-golden td.cell-down {
		background-color: #ffb3b3 !important;
		color: #7a0000 !important;
		font-weight: bold;
		text-align: center;
	} */
	/* DIF = 0 → verde */
	#containerTbConsolidarDetallesPedido {
		max-width: 100% !important;
		overflow-x: hidden !important;
	}

	.cell-zero {
		background-color: #b6f7b6 !important;
		color: #0f4d0f !important;
		font-weight: bold;
		text-align: center;
	}

	/* DIF > 0 → celeste fuerte */
	.cell-up {
		background-color: #79bff2 !important; /* celeste intenso */
		color: #003B57 !important; /* azul oscuro para contraste */
		font-weight: bold;
		text-align: center;
	}

	/* DIF  */
	.cell-down {
		background-color: #ffb3b3 !important;
		color: #7a0000 !important;
		font-weight: bold;
		text-align: center;
	}

</style>
<div class="table-responsive table-wrapper-400" id="containerTbConsolidarDetallesPedido">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbConsolidarDetallesPedido">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="text-center">Item</th>
				<th class="text-center" style="width: 7%;">ID</th>
				<th class="text-center">Descripción</th>
				<th class="text-center">Ori</th>
				<th class="text-center">Pedido</th>
				<th class="text-center">A Enviar</th>
				<th class="text-center">Dif.</th>
			</tr>
		</thead>

		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="7" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay detalles para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					var dif = item.pcd_pedida - item.cantidad;
					var claseDif = dif > 0 ? "dif-positivo" : (dif < 0 ? "dif-negativo" : "");
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-detalle-conteo"
						data-p-id="@item.p_id"
						data-permite-decimales="@(item.PermiteDecimales.ToString().ToLower())">

						<td class="text-center">@item.pcd_item</td>
						<td class="text-center">@item.p_id</td>
						<td>@item.p_desc</td>
						@if (item.pcd_origen == 'P')
						{
							<td>Vendedor</td>
						}
						else
						{
							<td>Cliente</td>
						}
						<td class="text-end">@GridHelper.FormatearDato(item.pcd_pedida, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="table-fontsize" style="font-weight: bold;">
							<div class="td-conteo">
								<span class="td-icon">
									@if (item.pcd_pedida < item.cantidad)
									{
										<i class="bx bx-up-arrow-alt text-info icon-arrow"></i>
									}
									else if (item.pcd_pedida > item.cantidad)
									{
										<i class="bx bx-down-arrow-alt text-danger icon-arrow"></i>
									}
								</span>

								<span class="td-value">
									@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)
								</span>
							</div>
						</td>
						@if (dif == 0 && item.pcd_pedida > 0)
						{
							<td class="table-fontsize diferencia-cero d-flex justify-content-between align-items-center">
								<span>
									<i class="bx bx-check-circle text-success" title="Sin diferencia"></i>
								</span>
								<span class="ms-auto">
									@GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales)
								</span>
							</td>
						}
						else
						{
							<td class="text-end @(dif > 0 ? "cell-down" : (dif < 0 ? "cell-up" : "cell-zero"))">
								@GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales)
							</td>
						}
						
					</tr>
				}
			}
		</tbody>
	</table>
</div>

<script>
	$("#tbDetallesPedido tbody tr.row-detalle").on("click", function () {
		const p_id = $(this).data("p-id");
		$(document).trigger("rowSelectedDetalle", p_id);
	});
</script>
