@model GridCoreSmart<AConsolidarPedidoClienteDetalleDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.table-golden td.cell-up {
		background-color: #b6f7b6 !important; /* verde */
		color: #0f4d0f !important;
		font-weight: bold;
		text-align: center;
	}

	.table-golden td.cell-down {
		background-color: #ffb3b3 !important; /* rojo */
		color: #7a0000 !important;
		font-weight: bold;
		text-align: center;
	}

</style>
<div class="table-responsive table-wrapper-400">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbConsolidarDetallesPedido">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th>Item</th>
				<th>Código</th>
				<th>Descripción</th>
				<th>Ori</th>
				<th>Pedido</th>
				<th>A Enviar</th>
				<th>Dif.</th>
			</tr>
		</thead>

		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="7" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay detalles para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					var dif = item.pcd_pedida - item.cantidad;
					var claseDif = dif > 0 ? "dif-positivo" : (dif < 0 ? "dif-negativo" : "");
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-detalle-conteo"
						data-p-id="@item.p_id"
						data-permite-decimales="@(item.PermiteDecimales.ToString().ToLower())">

						<td>@item.pcd_item</td>
						<td>@item.p_id</td>
						<td>@item.p_desc</td>
						<td>@item.pcd_origen</td>
						<td class="text-end">@GridHelper.FormatearDato(item.pcd_pedida, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end">@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-end @(dif > 0 ? "cell-up" : (dif < 0 ? "cell-down" : ""))">
							@GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales)
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>

<script>
	$("#tbDetallesPedido tbody tr.row-detalle").on("click", function () {
		const p_id = $(this).data("p-id");
		$(document).trigger("rowSelectedDetalle", p_id);
	});
</script>
