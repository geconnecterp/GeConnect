@{
}
<style>
	.tab-disabled {
		pointer-events: none;
		opacity: 0.5; /* opcional, para que se note que está deshabilitado */
	}
	/* Asegurar que los dropdowns de filtros flotantes se muestren por encima del menú principal */
	#filtrosAplicadosFloating {
		overflow: visible;
		z-index: 1050;
		flex-wrap: nowrap;
		white-space: nowrap;
		overflow-x: visible;
	}

		#filtrosAplicadosFloating .dropdown-menu {
			z-index: 3000 !important;
		}
	/* Si el header global tiene un z-index muy alto, forzamos el menu del filtro encima */
	.navbar, .main-header {
		z-index: 1100;
	}
</style>
<div class="grid-golden">
	<div class="grid-golden-body">
		<div class="d-flex align-items-center w-100 mt-2">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsOrdenDeReparto">
				<li class="nav-item" role="presentation" id="tabOrdenesDeReparto">
					<button type="button" 
							class="nav-link active" 
							role="tab" 
							data-bs-toggle="tab" 
							data-bs-target="#navs-top-or" 
							aria-controls="navs-top-or" 
							aria-selected="true" 
							id="btnTabOrdenesDeReparto">
						Ordenes de Reparto
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabPedidosDeCliente">
					<button type="button" 
							class="nav-link" 
							role="tab" 
							data-bs-toggle="tab" 
							data-bs-target="#navs-top-pc" 
							aria-controls="navs-top-pc" 
							aria-selected="false" 
							tabindex="-1" 
							id="btnTabPedidosDeCliente">
						Pedidos de Cliente
					</button>
				</li>
				<li class="nav-item d-none" role="presentation" id="tabEditarPedido">
					<button type="button"
							class="nav-link"
							role="tab"
							data-bs-toggle="tab"
							data-bs-target="#navs-top-editar-pedido"
							aria-controls="navs-top-editar-pedido"
							aria-selected="false"
							id="btnTabEditarPedido">
						Editar Pedido
					</button>
				</li>

			</ul>
			<!-- Contenedor flotante para filtros aplicados -->
			<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center" style="position:absolute; right:30px; left:auto; top:175px; height:auto; width:auto; border-color:#d9534f; background-color:#fff; z-index:1050; padding:6px 10px; overflow:visible; gap:6px; display:inline-flex; white-space:nowrap;">
				<!-- Badges rellenadas por JS -->
			</div>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-or" role="tabpanel">
				<div id="divListaOrdenesDeReparto">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-pc" role="tabpanel">
				<div id="divListaPedidosDeCliente">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-editar-pedido" role="tabpanel">
				<div id="divEditarPedido">
				</div>
			</div>
		</div>
	</div>
</div>