@model OrdenDeRepartoConsolidarModel
@{
	var or = Model.OrdenDeReparto;
}
<style>
    .btn-or {
        min-width: 140px; /* Ajustá el ancho que prefieras */
    }

    .tabla-bloqueada {
        pointer-events: none;
        opacity: 0.6;
    }

</style>

<div class="container-fluid min-vh-100 d-flex flex-column">
	<div class="row mb-1">
        <div class="col-12">
            <div class="p-1 border rounded bg-light">

                <div class="d-flex justify-content-between align-items-center flex-wrap">

                    <!-- IZQUIERDA: textos -->
                    <div class="d-flex flex-wrap gap-4">

                        <div><strong>ID OR:</strong> @or.or_compte</div>
                        <div><strong>Repartidor:</strong> @or.rp_nombre</div>
                        <div><strong>Estado:</strong> @or.ore_desc</div>
                        <div><strong>Fecha:</strong> @or.or_fecha.ToString("dd/MM/yyyy")</div>
                        <div><strong>Obs:</strong> @or.or_obs</div>

                    </div>

                    <!-- DERECHA: botones -->
                    <div class="d-flex align-items-center gap-2">

                        <button id="btnConfirmarConciliacion" class="btn btn-success btn-sm btn-or">
                            <i class="bx bx-check-circle"></i> Consolidar OR
                        </button>

                        <button id="btnCancelarConciliacion" class="btn btn-danger btn-sm btn-or">
                            <i class="bx bx-x-circle"></i> Cancelar
                        </button>

                    </div>

                </div>

            </div>

        </div>
	</div>
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header fw-bold">Pedidos en la Orden</div>
                <div class="card-body p-2">
                    <div id="divConsolidarPedidosEnOrdenDeReparto">
                        @Html.Partial("_gridOR_Consolidar_PedidosDeOR", Model.ListaPedidosEnOrdenDeReparto)
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header fw-bold">Detalle del Pedido Seleccionado</div>
                <div class="card-body p-2">
                    <div id="divConsolidarDetallesPedido">
                        @Html.Partial("_gridOR_Consolidar_PedidoDeORDetalle", Model.ListaDetallesAConsolidar)
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header fw-bold">Conteos del Producto</div>
                <div class="card-body p-2">
                    <div id="divConsolidarConteos">
                        @Html.Partial("_gridOR_Consolidar_PedidoDeORConteos", Model.ListaConteosDeLaOrdenDeReparto)
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                    <span>Detalle del Conteo</span>
                    <div class="d-flex align-items-center gap-2">
                        <button id="btnReasignar"
                                class="btn btn-success btn-sm"
                                disabled>
                            Reasignar
                        </button>
                        <button id="btnConfirmarReasignacion"
                                class="btn btn-primary btn-sm"
                                disabled>
                            <i class="bx bx-check"></i>
                        </button>
                        <button id="btnCancelarReasignacion"
                                class="btn btn-danger btn-sm"
                                disabled>
                            <i class="bx bx-block"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div id="divConsolidarDetalleProductoSeleccionado">
                        @Html.Partial("_gridOR_Consolidar_PedidoDeORConteosDetalle", Model.ListaDetalleProductoSeleccionado)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>