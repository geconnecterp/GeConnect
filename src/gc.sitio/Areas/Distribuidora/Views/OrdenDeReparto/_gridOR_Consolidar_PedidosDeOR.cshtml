@model GridCoreSmart<PedidoEnOrdenDeRepartoDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.table-golden td.cell-up {
		background-color: #d4edda !important;
		color: #155724 !important;
		font-weight: bold;
		text-align: center;
	}

	.table-golden td.cell-down {
		background-color: #f8d7da !important;
		color: #721c24 !important;
		font-weight: bold;
		text-align: center;
	}

	#tbConsolidarPedidos thead th {
		text-align: center !important;
		vertical-align: middle !important;
		white-space: nowrap;
	}

	.col-ellipsis {
		max-width: 140px; /* ajustá el ancho a gusto */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* Columna ID más ancha y sin salto de línea */
	#tbConsolidarPedidos td.col-id,
	#tbConsolidarPedidos th.col-id {
		min-width: 80px; /* Ajustá este valor a gusto */
		white-space: nowrap; /* Evita salto de línea */
	}

</style>

<div class="table-responsive table-wrapper-400">
	<table class="table table-sm table-hover mb-0 table-golden" id="tbConsolidarPedidos">
		<thead class="sticky-top table-golden-header-compact">
			<tr class="header">
				<th class="col-id">ID</th>
				<th>Cliente</th>
				<th title="Generado">Gen.</th>
				<th>Vendedor</th>
				<th>Repartidor</th>
				<th>Importe</th>
				<th>Up</th>
				<th>Dw</th>
			</tr>
		</thead>

		<tbody>
			@if (Model == null || Model.ListaDatos == null || !Model.ListaDatos.Any())
			{
				<tr class="fila-vacia">
					<td colspan="6" class="text-center text-muted py-2">
						<i class="bx bx-info-circle me-1"></i>
						No hay pedidos para mostrar.
					</td>
				</tr>
			}
			else
			{
				foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase row-pedido"
						data-pc-compte="@item.pc_compte">

						<td class="col-id">@item.pc_compte</td>
						<td class="col-ellipsis" title="@item.cta_denominacion">@item.cta_denominacion</td>
						<td>@item.pc_fecha.ToString("dd/MM/yy")</td>
						<td class="col-ellipsis" title="@item.ve_nombre">@item.ve_nombre</td>
						<td class="col-ellipsis" title="@item.rp_nombre">@item.rp_nombre</td>
						<td class="text-end">@item.pc_precio_tot.ToString("N2")</td>
						<td class="@(item.mostrar_up ? "cell-up" : "")">
							@(item.mostrar_up ? "UP" : "")
						</td>

						<td class="@(item.mostrar_down ? "cell-down" : "")">
							@(item.mostrar_down ? "DW" : "")
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>

<script>
	$("#tbPedidos tbody tr.row-pedido").on("click", function () {
		const pc_compte = $(this).data("pc-compte");
		$(document).trigger("rowSelectedPedidos", pc_compte);
	});
</script>
