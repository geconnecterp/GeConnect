}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	.fade-out-row {
		transition: opacity 0.3s ease-out;
		opacity: 0;
	}

	.fade-in-row {
		animation: fadeIn 0.3s ease-out;
	}

	@@keyframes fadeIn {
		from{ opacity: 0; transform: scale(0.98); }
		to { opacity: 1; transform: scale(1); }
	}

	#divInfoAdicionaDeProducto > div:first-child {
		height: 400px;
		max-height: 400px;
		overflow-y: auto;
	}
</style>
<partial name="_botonera" model="filtro" />
<div class="collapse" id="divFiltro">
	<partial name="_filtros" model="Model" />
	@Html.Hidden("pagEstado", false)
</div>
<div class="collapse" id="divDetalle"></div>
<div id="modalGestorDocumental"></div>
<div id="divInfoAdicionaDeProducto" class="collapse"></div>

