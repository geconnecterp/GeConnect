@model GridCoreSmart<PedidoProductoDto>

@{
	var alt = true;
	string clase = string.Empty;
	int cont = 0;

}
<style>
	select.input-pcd_reemplazo {
		-webkit-appearance: none;
		-moz-appearance: none;
		appearance: none;
		background-image: none !important;
		padding-right: 0.5rem;
	}

</style>
<div class="card h-100">
	<div class="card-header py-1 d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Productos del Pedido</h6>

		<button type="button" class="btn btn-sm btn-outline-primary" id="btnAgregarCProducto" title="Agregar Producto" disabled>
			<i class="bx bx-plus"></i>
		</button>
	</div>
	<div class="card-body p-1">
		<div class="table-responsive" style="max-height: 400px;">
			<table class="table table-sm table-hover mb-0 table-golden" id="tbGridPedidoProds">
				<thead class="sticky-top table-golden-header-compact">
					<tr class="header">
						<th class="text-center th-compact">#</th>
						<th class="text-center th-compact">Código</th>
						<th class="text-left th-compact" style="width:35%;">Descripción</th>
						<th class="text-end th-compact">Cantidad</th>
						<th class="text-end th-compact">Enviada</th>
						<th class="text-end th-compact">Venta</th>
						<th class="text-end th-compact">Total</th>
						<th class="text-center th-compact">Remp</th>
						<th class="text-end th-compact">Código</th>
						<th class="text-center th-compact" style="width: 40px;">Acción</th>
					</tr>
				</thead>
				<tbody>
					@if (Model?.ListaDatos?.Any() == true)
					{
						foreach (var item in Model.ListaDatos.OrderBy(x => x.pcd_item).ToList())
						{
							cont++;
							var pre_item = item.pcd_item.Equals("0") ? cont : item.pcd_item;
							if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }
							var totalCalc = (item.pcd_pedida * item.pcd_pvta);
							<tr class="@clase"
								data-pcd-item="@cont"
								data-p-id="@item.p_id"
								data-tipo-precio="Ventadespues me">
								<td class="text-center">@item.pcd_item</td>
								<td class="text-center">@item.p_id</td>
								<td class="input-p_desc">@item.p_desc</td>
								<td class="text-end">
									<div class="input-container">
										<input type="text"
											   id="input-pcd_pedida"
											   class="form-control form-control-sm input-pcd_pedida input-numeric campo-readonly"
											   value="@item.pcd_pedida"
											   data-original-value="@item.pcd_pedida"
											   readonly
											   title="Doble click para editar" />
									</div>
								</td>
								<td class="text-end input-pcd_enviada">@GridHelper.FormatearDato(item.pcd_enviada, FormatDato.Monto, false)</td>
								<td class="text-end input-pcd_pvta">@GridHelper.FormatearPrecio(item.pcd_pvta, TipoPrecio.Venta)</td>
								<td class="text-end input-pcd_pvta_total">@GridHelper.FormatearPrecio(totalCalc, TipoPrecio.Venta)</td>
								<td class="text-center align-middle">
									<input type="checkbox"
										   class="form-check-input m-0 p-0 input-pcd_origen_bool"
										   disabled
										   @(item.pcd_origen_bool ? "checked" : "") />
								</td>
								<td class="text-center">
									@if (item.pcd_origen_bool)
									{
										<select class="form-select form-select-sm input-pcd_reemplazo">
											<option value="">-- Seleccionar --</option>
											@foreach (var prod in Model.ListaDatos.Where(x=>!x.pcd_origen_bool).ToList())
											{
												if (prod.p_id != item.p_id)
												{
													@if (item.p_id_remplazo == prod.p_id)
													{
														<option value="@prod.p_id" selected="selected">@prod.p_id</option>
													}
													else
													{
														<option value="@prod.p_id">@prod.p_id</option>
													}
												}
											}
										</select>
									}
									else
									{
										<span class="text-muted">—</span>
									}
								</td>
								<td class="text-center">
									<button type="button"
											class="btn btn-sm btn-danger btn-eliminar-producto"
											data-p-id="@item.p_id"
											title="Eliminar producto"
											style="display: none;">
										<i class="bx bx-trash"></i>
									</button>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="9" class="text-center text-muted py-2">
								<i class="bx bx-info-circle me-1"></i>No hay productos en este pedido
							</td>
						</tr>
					}
				</tbody>
				@if (Model?.ListaDatos?.Any() == true)
				{
					var total = @Model.ListaDatos.Sum(x => (x.pcd_pedida * x.pcd_pvta));
					<tfoot class="table-golden-footer">
						<tr>
							<td colspan="6" class="text-end fw-bold">Total General:</td>
							<td class="text-end fw-bold">@GridHelper.FormatearPrecio(total, TipoPrecio.Venta)</td>
							<td></td>
							<td></td>
							<td></td>
						</tr>
					</tfoot>
				}
			</table>
		</div>
	</div>
</div>

<script>
	$(function() {
		// ✅ APLICAR INPUTMASK a campos numéricos
		if (typeof Inputmask !== 'undefined') {
			Inputmask({
				alias: "numeric",
				groupSeparator: ",",
				radixPoint: ".",
				autoGroup: true,
				digits: 2,
				digitsOptional: false,
				rightAlign: true,
				allowMinus: false,
				min: 0
			}).mask('.input-pcd_pedida');
		}

		// ✅ CONTROLAR VISIBILIDAD DE BOTONES DE ELIMINACIÓN
		if (typeof aplicarVisibilidadBotonesEliminar === 'function') {
			aplicarVisibilidadBotonesEliminar();
		}
		const productosReemplazables = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
				Model.ListaDatos
						.Where(x => !x.pcd_origen_bool)
						.Select(x => new { x.p_id, x.p_desc })
		));

	});
</script>