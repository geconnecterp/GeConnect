@{
    Layout = "~/views/shared/_Layout.cshtml";
    int indicePrint = ViewBag.ImpresionId != null ? (int)ViewBag.ImpresionId : 0;
}
@section styles {
    <link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<div class="grid-golden">
    <div class="grid-golden-body">
        <div class="row align-items-md-start">
            <div class="col-md-8 col-sm-6">
                <div id="gridOfertasActivas">
                    <p class="text-center text-muted py-4">
                        <i class="bx bx-info-circle me-2"></i>
                        No hay productos seleccionados para ofertas
                    </p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div id="gridCanales"></div>
                <div class="filter-golden">
                    <div class="filter-golden-header">
                        <h5 class="mb-0">Opciones</h5>
                    </div>
                    <div class="filter-golden-body">
                        <button type="button" class="btn btn-primary w-100 mb-2" id="btnCopiarACanal" disabled>
                            <i class="bx bx-copy-alt"></i> Copiar a
                        </button>
                        <button type="button" class="btn btn-outline-danger w-100 mb-2" id="btnEliminarSelec" disabled>
                            <i class="bx bx-trash me-1"></i> Eliminar Seleccionados
                        </button> 
                        <button type="button" class="btn btn-outline-secondary w-100 mb-2" id="btnImprimir">
                            <i class="bx bx-printer me-1"></i> Imprimir
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para selección de canal destino -->
<div class="modal fade" id="modalSeleccionCanalDestino" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bx bx-broadcast me-2"></i>Seleccionar Canal Destino</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bx bx-info-circle me-2"></i>
                    Seleccione el canal destino para copiar las ofertas seleccionadas
                </div>
                <div id="gridCanalesDestino" class="mt-3">
                    <p class="text-center py-3">
                        <i class="bx bx-loader-alt bx-spin"></i> Cargando canales...
                    </p>
                </div>
                <div id="destinoSeleccionInfo" class="d-none mt-2 alert alert-success p-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="bx bx-check-circle me-1"></i> <span id="canalDestinoSeleccionado"></span></span>
                        <button type="button" id="btnCambiarSeleccion" class="btn btn-sm btn-outline-success">
                            <i class="bx bx-refresh"></i> Cambiar
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarCopiaACanal" disabled>
                    <i class="bx bx-copy me-1"></i> Copiar Ofertas
                </button>
            </div>
        </div>
    </div>
</div>
<div id="modalGestorDocumental"></div>
@section scripts {
    <script type="text/javascript">
        var buscarCanalesUrl = "@Url.Action("BuscarCanales", "Ofertas", new { area = "Productos" })";
        var presentarOfertasActivasUrl = "@Url.Action("PresentarOfertasActivas", "OfertaActiva", new { area = "Productos" })";
        var copiarACanalUrl = "@Url.Action("copiarACanal", "OfertaActiva", new { area = "Productos" })";
        var eliminarOfertasActivasUrl = "@Url.Action("EliminarOfertasActivas", "OfertaActiva", new { area = "Productos" })";

        var homeOfertaUrl = "@Url.Action("index", "OfertaActiva", new { area = "Productos" })";

        let indexPrint = parseInt("@indicePrint");
        var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
        var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
        var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
        var enviarEmailUrl =  "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
        var enviarWhatsAppUrl =  "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";

    </script>
    <script src="~/lib/jstree/jstree.min.js"></script>
    <script src="~/js/app/areas/docmngr/docmanager.js"></script>
    <script src="~/js/app/areas/precios/ofertaok.js"></script>
}