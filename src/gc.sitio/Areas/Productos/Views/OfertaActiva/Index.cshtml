@{
    Layout = "~/views/shared/_Layout.cshtml";
    int indicePrint = ViewBag.ImpresionId != null ? (int)ViewBag.ImpresionId : 0;
}
@section styles {
    <link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
    <style>
        .ofertas-activas-layout > div { min-width: 0; }
        .ofertas-activas-info { margin-bottom: .5rem; }
        .ofertas-activas-info .oa-channel-info {
            border: 1px solid #daa520;
            border-radius: 6px;
            overflow: hidden;
            background: #fffdf5;
        }
        .ofertas-activas-info .oa-channel-info-title {
            padding: .3rem .65rem;
            background: linear-gradient(135deg, #b8860b 0%, #daa520 100%);
            color: #fff;
            font-size: .875rem;
            font-weight: 600;
        }
        .ofertas-activas-info .oa-channel-info-data {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .4rem 1rem;
            padding: .35rem .65rem;
            font-size: .875rem;
        }
        .ofertas-activas-info .oa-channel-description {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .ofertas-activas-module .card-golden { margin-bottom: .5rem; }
        .ofertas-activas-module .card-golden .card-body { padding: .35rem !important; }
        .ofertas-activas-module .table-responsive { width: 100%; max-width: 100%; }
        .ofertas-activas-module .table-golden th {
            padding: .35rem .45rem !important;
            font-size: .875rem !important;
            line-height: 1.2 !important;
            vertical-align: middle;
        }
        .ofertas-activas-module .table-golden td {
            padding: .28rem .45rem !important;
            font-size: .875rem !important;
            line-height: 1.2 !important;
            vertical-align: middle;
        }
        .ofertas-activas-canales #tbGridCanales th:nth-child(3),
        .ofertas-activas-canales #tbGridCanales td:nth-child(3) { text-align: left !important; }
        .ofertas-activas-canales #tbGridCanales tr.selected-row {
            background-color: #ffe29a !important;
            border-left: 3px solid #b8860b;
        }
        .ofertas-activas-productos #tbGridOfertasActivas { width: 100%; table-layout: auto; }
        .ofertas-activas-productos #tbGridOfertasActivas th:nth-child(1) { width: 42px; }
        .ofertas-activas-productos #tbGridOfertasActivas th:nth-child(2) { width: 82px; }
        .ofertas-activas-productos #tbGridOfertasActivas th:nth-child(4),
        .ofertas-activas-productos #tbGridOfertasActivas th:nth-child(5),
        .ofertas-activas-productos #tbGridOfertasActivas th:nth-child(6) { width: 105px; }
        .ofertas-activas-productos #tbGridOfertasActivas th:nth-child(7) { width: 205px; }
        .ofertas-activas-productos #tbGridOfertasActivas td:nth-child(3) {
            min-width: 190px;
            max-width: 360px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .ofertas-activas-options .filter-golden-header { padding: .4rem .65rem; }
        .ofertas-activas-options .filter-golden-body {
            display: grid;
            gap: .45rem;
            padding: .55rem;
        }
        .ofertas-activas-options .oa-action-button {
            width: 100%;
            min-height: 38px;
            margin: 0 !important;
            padding: .35rem .5rem;
            font-size: .875rem;
            line-height: 1.15;
            white-space: nowrap;
        }
        @@media (max-width: 991.98px) {
            .ofertas-activas-layout { row-gap: .75rem; }
            .ofertas-activas-productos #tbGridOfertasActivas { min-width: 850px; }
        }
    </style>
}
<div class="grid-golden mt-1 ofertas-activas-module">
    <div class="grid-golden-body">
        <div id="infoSeleccionContainer" class="ofertas-activas-info"></div>
        <div class="row g-2 align-items-md-start ofertas-activas-layout">
            <div class="col-xl-3 col-lg-4 col-12 ofertas-activas-canales">
                <div id="gridCanales"></div>
                <div class="filter-golden ofertas-activas-options">
                    <div class="filter-golden-header">
                        <h5 class="mb-0">Opciones</h5>
                    </div>
                    <div class="filter-golden-body">
                        <button type="button" class="btn btn-primary oa-action-button" id="btnCopiarACanal" disabled>
                            <i class="bx bx-copy-alt"></i> Copiar a
                        </button>
                        <button type="button" class="btn btn-outline-danger oa-action-button" id="btnEliminarSelec" disabled>
                            <i class="bx bx-trash me-1"></i> Eliminar seleccionadas
                        </button> 
                        <button type="button" class="btn btn-outline-secondary oa-action-button" id="btnImprimir" disabled>
                            <i class="bx bx-printer me-1"></i> Imprimir
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-xl-9 col-lg-8 col-12 ofertas-activas-productos">
                <div id="gridOfertasActivas">
                    <p class="text-center text-muted py-4">
                        <i class="bx bx-info-circle me-2"></i>
                        Seleccione un canal para consultar sus ofertas activas
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para selección de canal destino -->
<div class="modal fade" id="modalSeleccionCanalDestino" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bx bx-broadcast me-2"></i>Seleccionar canales destino</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bx bx-info-circle me-2"></i>
                    Seleccione uno o más canales destino para copiar las ofertas seleccionadas
                </div>
                <div id="gridCanalesDestino" class="mt-3">
                    <p class="text-center py-3">
                        <i class="bx bx-loader-alt bx-spin"></i> Cargando canales...
                    </p>
                </div>
                <div id="destinoSeleccionInfo" class="d-none mt-2 alert alert-success p-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="bx bx-check-circle me-1"></i> <span id="canalDestinoSeleccionado"></span></span>
                        <button type="button" id="btnCambiarSeleccion" class="btn btn-sm btn-outline-success">
                            <i class="bx bx-refresh"></i> Cambiar
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarCopiaACanal" disabled>
                    <i class="bx bx-copy me-1"></i> Copiar Ofertas
                </button>
            </div>
        </div>
    </div>
</div>
<div id="modalGestorDocumental"></div>
@section scripts {
    <script type="text/javascript">
        var buscarCanalesUrl = "@Url.Action("BuscarCanales", "Ofertas", new { area = "Productos" })";
        var presentarOfertasActivasUrl = "@Url.Action("PresentarOfertasActivas", "OfertaActiva", new { area = "Productos" })";
        var copiarACanalUrl = "@Url.Action("copiarACanal", "OfertaActiva", new { area = "Productos" })";
        var eliminarOfertasActivasUrl = "@Url.Action("EliminarOfertasActivas", "OfertaActiva", new { area = "Productos" })";

        var homeOfertaUrl = "@Url.Action("index", "OfertaActiva", new { area = "Productos" })";

        let indexPrint = parseInt("@indicePrint");
        var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
        var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
        var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
        var enviarEmailUrl =  "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
        var enviarWhatsAppUrl =  "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";

    </script>
    <script src="~/lib/jstree/jstree.min.js"></script>
    <script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>
    <script src="~/js/app/areas/precios/ofertaok.js" asp-append-version="true" type="text/javascript"></script>
}
