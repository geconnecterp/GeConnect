@model GridCoreSmart<OfertaDto>

@{
    var alt = true;
    string clase = string.Empty;
    var fechaHoy = DateTime.Today;

    // Función que retorna el estado de vigencia
    (string cssClass, string icon, string message) GetVigenciaInfo(DateTime? fechaDesde, DateTime? fechaHasta)
    {
        if (!fechaDesde.HasValue || !fechaHasta.HasValue)
            return (string.Empty, string.Empty, string.Empty);

        int diasRestantes = (fechaHasta.Value - fechaHoy).Days;
        
        // Oferta vencida
        if (diasRestantes < 0)
            return ("bg-danger", "bx-time-five", "Oferta vencida");
        
        // Oferta próxima a vencer
        int diasTotales = (fechaHasta.Value - fechaDesde.Value).Days + 1;
        int diasTranscurridos = Math.Max(0, (fechaHoy - fechaDesde.Value).Days);
        
        if (diasTotales > 0 && diasTranscurridos > diasTotales / 2)
            return ("bg-warning text-dark", "bx-time-five", $"Quedan {diasRestantes} día(s)");
        
        // Oferta vigente normal
        return ("bg-success", "bx-calendar-check", $"Quedan {diasRestantes} día(s)");
    }
}

<div class="card card-golden">
    <div class="card-body p-2">
        <div class="table-responsive text-nowrap table-wrapper-500">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridOfertasSinActivar">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center" style="width: 40px;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkAllOfertas">
                            </div>
                        </th>
                        <th class="text-center th-compact" scope="col">CÓDIGO</th>
                        <th class="text-left th-compact" scope="col">DESCRIPCIÓN</th>
                        <th class="text-right th-compact" scope="col">COSTO</th>
                        <th class="text-right th-compact" scope="col">P. VENTA</th>
                        <th class="text-right th-compact" scope="col">OFERTA</th>
                        <th class="text-center th-compact" scope="col">VIGENCIA</th>
                        @* <th class="text-center" scope="col">ACCIÓN</th> *@
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos?.Any() == true)
                    {
                        @foreach (var item in Model.ListaDatos)
                        {
                            alt = !alt;
                            clase = alt ? string.Empty : "table-row-alt";
                            
                            var (vigenciaCss, vigenciaIcon, vigenciaMsg) = GetVigenciaInfo(item.po_fecha_desde, item.po_fecha_hasta);

                            <tr class="@clase" data-producto-id="@item.p_id">
                                <td class="text-center">
                                    <div class="form-check">
                                        <input class="form-check-input check-oferta" type="checkbox"
                                               data-p-id="@item.p_id"
                                               data-adm-id="@item.adm_id"
                                               data-lp-id="@item.lp_id"
                                               data-fecha-desde="@(item.po_fecha_desde.ToString("yyyy-MM-dd") ?? "")"
                                               data-fecha-hasta="@(item.po_fecha_hasta.ToString("yyyy-MM-dd") ?? "")">
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.p_id)">
                                    @Model.FormatearDato(item.p_id, FormatDato.Ninguno)
                                </td>
                                <td class="@Model.ObtenerClase(item.p_desc)" title="@item.p_desc">
                                    @Model.FormatearDato(item.p_desc, FormatDato.Ninguno)
                                </td>
                                <td class="@Model.ObtenerClase(item.p_pcosto)">
                                    @Model.FormatearDato(item.p_pcosto, FormatDato.Monto)
                                </td>
                                <td class="@Model.ObtenerClase(item.p_pvta)">
                                    @Model.FormatearDato(item.p_pvta, FormatDato.Monto)
                                </td>
                                <td class="@Model.ObtenerClase(item.p_pvta_oferta)">
                                    @Model.FormatearDato(item.p_pvta_oferta, FormatDato.Monto)
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(vigenciaCss))
                                    {
                                        <span class="badge @vigenciaCss" title="@vigenciaMsg">
                                            @Model.FormatearDato(item.po_fecha_desde, FormatDato.Fecha) - @Model.FormatearDato(item.po_fecha_hasta, FormatDato.Fecha)
                                            @* <i class="bx @vigenciaIcon"></i> *@
                                        </span>
                                    }
                                </td>
                               @*  <td class="text-center">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm btn-activar-oferta"
                                            data-p-id="@item.p_id"
                                            data-adm-id="@item.adm_id"
                                            data-lp-id="@item.lp_id"
                                            data-fecha-desde="@(item.po_fecha_desde.ToString("yyyy-MM-dd") ?? "")"
                                            data-fecha-hasta="@(item.po_fecha_hasta.ToString("yyyy-MM-dd") ?? "")"
                                            title="Activar oferta">
                                        <i class="bx bx-check-circle"></i>
                                    </button>
                                </td> *@
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bx bx-info-circle me-2"></i>
                                No hay ofertas pendientes de activación
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ListaDatos?.Any() == true)
        {
            <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                <div class="text-muted small d-flex align-items-center">
                    <i class="bx bx-package me-1"></i>
                    Total: @Model.CantidadReg ofertas sin activar
                    <span class="ms-3 badge bg-primary" id="ofertasSeleccionadas">0</span> seleccionadas
                </div>
               @*  <div class="text-muted small">
                    <button type="button" class="btn btn-primary btn-sm" id="btnActivarOfertas">
                        <i class="bx bx-check-double"></i> Activar Ofertas Seleccionadas
                    </button>
                </div> *@
               @*  <div class="text-muted small">
                    <button type="button" class="btn btn-danger btn-sm mt-1 me-1"
                            id="btnCancelaActivacion" title="Cancelar activación">
                        <i class="bx bx-x-circle"></i>
                        Cancelar
                    </button>
                </div> *@
                <div class="text-muted small">
                    @Model.DatoAux01
                </div>
            </div>
        }
    </div>
</div>