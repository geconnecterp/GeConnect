@using gc.sitio.Areas.Productos.Models
@model ResultadoImportacionViewModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-file-import text-primary"></i>
            Resultados de Importación - @Model.ArchivoOriginal
        </h5>
        <div class="badge-group">
            <span class="badge bg-success me-2">
                <i class="fas fa-check-circle"></i> Exitosos: @Model.RegistrosExitosos
            </span>
            <span class="badge bg-danger">
                <i class="fas fa-exclamation-triangle"></i> Con Error: @Model.RegistrosConError
            </span>
        </div>
    </div>

    <div class="card-body p-0">
        <!-- ✅ AGREGAR: Botón confirmar si no hay errores -->
        @if (Model.PuedeConfirmar)
        {
            <div class="alert alert-success mb-3 mx-3 mt-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>¡Importación exitosa!</strong>
                        Todos los registros se procesaron correctamente.
                    </div>
                    <button type="button"
                            class="btn btn-success btn-sm"
                            onclick="confirmarImportacion('@Model.ProveedorId', '@Model.ArchivoOriginal')"
                            id="btnConfirmarImportacion">
                        <i class="fas fa-check me-1"></i>CONFIRMAR IMPORTACIÓN
                    </button>
                </div>
            </div>
        }
        <div class="table-responsive text-nowrap table-wrapper">
            <table class="table table-sm table-hover mb-0 table-wrapper-fixed-head " id="tbGridResultadosImportacion">
                <thead class="table-dark sticky-top">
                    <tr>
                        <th class="text-center" style="width: 80px;">ESTADO</th>
                        <th style="min-width: 250px;">OBSERVACIONES</th>
                        <th class="text-center" style="width: 60px;">FILA</th>
                        <th style="min-width: 80px;">ID</th>
                        <th style="min-width: 100px;">ID PROV</th>
                        <th style="min-width: 150px;">EAN</th>
                        <th style="min-width: 120px;">EAN OTRO</th>
                        <th style="min-width: 100px;">DUN</th>
                        <th style="min-width: 120px;">MARCA</th>
                        <th style="min-width: 200px;">DESCRIPCIÓN</th>
                        <th style="min-width: 100px;">CAPACIDAD</th>
                        <th style="min-width: 120px;">UNIDAD PRES</th>
                        <th class="text-end" style="width: 120px;">PRECIO LISTA</th>
                        <th class="text-end" style="width: 120px;">COSTO</th>
                        <th class="text-center" style="width: 80px;">DTO 1</th>
                        <th class="text-center" style="width: 80px;">DTO 2</th>
                        <th class="text-center" style="width: 80px;">DTO 3</th>
                        <th class="text-center" style="width: 80px;">DTO 4</th>
                        <th class="text-center" style="width: 80px;">DTO PA</th>
                        <th class="text-center" style="width: 80px;">FLETE</th>
                        <th class="text-center" style="width: 80px;">BONI</th>
                        <th class="text-center" style="width: 120px;">UNID/BULTO</th>
                        <th class="text-center" style="width: 100px;">BULTO/PISO</th>
                        <th class="text-center" style="width: 100px;">PISO/PALLET</th>
                        <th class="text-center" style="width: 80px;">IVA%</th>
                        <th class="text-center" style="width: 80px;">IN%</th>
                        <th style="min-width: 100px;">CTA GECO</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Resultados.Count; i++)
                    {
                        var item = Model.Resultados[i];
                        var claseEstado = item.registro_estado == -1 ? "table-danger": "table-success";
                        var iconoEstado = item.registro_estado == 0 ? "bx bxs-check-circle text-success" : 
                                          item.registro_estado == 2 ? "bx bxs-plus-circle text-primary" :
                        item.registro_estado == 3 ? "bx bx-transfer text-primary" :
                        item.registro_estado == 4 ? "bx bx-pause-circle text-secondary" : "bx bx-help-circl text-secondary";

                        <tr class="@claseEstado" data-fila="@item.p_id">
                            <td class="text-center">
                                <i class="@iconoEstado" title="@item.registro_estado"></i>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.registro_msj))
                                {
                                    <span class="@(item.registro_estado == 1 ? "text-success" : "text-danger")" title="@item.registro_msj">
                                        @(item.registro_msj.Length > 50 ? item.registro_msj.Substring(0, 50) + "..." : item.registro_msj)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-success">Procesado correctamente</span>
                                }
                        </td>
                        <td class="text-center fw-bold">@(i + 2)</td>
                        <td>@item.p_id</td>
                        <td>@item.p_id_prov</td>
                        <td class="font-monospace">@item.p_ean</td>
                        <td class="font-monospace">@item.p_ean_otro</td>
                        <td class="font-monospace">@item.p_dun</td>
                        <td class="fw-semibold">@item.p_marca</td>
                        <td title="@item.p_desc">
                            @(string.IsNullOrEmpty(item.p_desc) ? "-" :
                                                        item.p_desc.Length > 40 ? item.p_desc.Substring(0, 40) + "..." : item.p_desc)
                        </td>
                        <td>@item.p_capacidad</td>
                        <td>@item.p_unidad_pres</td>
                        <td class="text-end font-monospace">@FormatearMoneda(item.p_plista)</td>
                        <td class="text-end font-monospace">@FormatearMoneda(item.p_pcosto)</td>
                        <td class="text-center font-monospace">@item.p_dto1</td>
                        <td class="text-center font-monospace">@item.p_dto2</td>
                        <td class="text-center font-monospace">@item.p_dto3</td>
                        <td class="text-center font-monospace">@item.p_dto4</td>
                        <td class="text-center font-monospace">@item.p_dto_pa</td>
                        <td class="text-center font-monospace">@item.p_porc_flete</td>
                        <td class="text-center font-monospace">@item.p_boni</td>
                        <td class="text-center">@item.p_unidadxbulto</td>
                        <td class="text-center">@item.p_bultoxpiso</td>
                        <td class="text-center">@item.p_pisoxpallet</td>
                        <td class="text-center font-monospace">@item.iva_alicuota</td>
                        <td class="text-center font-monospace">@item.in_alicuota</td>
                        <td>@item.cta_id_geco</td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-light">
        <div class="row">
            <div class="col-md-6">
                <small class="text-muted">
                    <i class="fas fa-clock"></i> Procesado: @Model.FechaProceso.ToString("dd/MM/yyyy HH:mm:ss")
                </small>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">
                    Total de registros: <strong>@Model.TotalRegistros</strong>
                </small>
            </div>
        </div>
    </div>
</div>

@{
    string FormatearPorcentaje(string valor)
    {
        return decimal.TryParse(valor, out var porcentaje) && porcentaje != 0 ? $"{porcentaje:P1}" : "0%";
    }

    string FormatearMoneda(string valor)
    {
        return decimal.TryParse(valor, out var precio) && precio > 0 ? precio.ToString("C2") : "$ 0.00";
    }
}

<style>
    .badge-group .badge {
        font-size: 0.875rem;
    }

    .table th {
        border-bottom: 2px solid #dee2e6;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.875rem;
    }

    .font-monospace {
        font-family: 'Courier New', monospace;
    }

    #tbGridResultadosImportacion {
        font-size: 0.85rem;
    }

    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 10;
    }
</style>
<script>
        $(document).ready(function() {
        // ✅ OPTIMIZAR: Función de confirmación integrada con el patrón del proyecto
        window.confirmarImportacion = function(proveedorId, archivoOriginal) {
            // Validación de parámetros
            if (!proveedorId || !archivoOriginal) {
                showUploadError('Faltan datos para confirmar la importación');
                return;
            }

            // Confirmación usando el patrón del proyecto
            if (typeof AbrirMensaje === 'function') {
                AbrirMensaje("CONFIRMACIÓN",
                    "¿Está seguro de que desea confirmar esta importación?<br><small class='text-muted'>Esta acción no se puede deshacer.</small>",
                    function (respuesta) {
                        $("#msjModal").modal("hide");
                        if (respuesta === "SI") {
                            ejecutarConfirmacionImportacion(proveedorId, archivoOriginal);
                        }
                    },
                    true, ["Confirmar", "Cancelar"], "warn!", null);
            } else {
                // Fallback a confirm nativo si no está disponible AbrirMensaje
                if (confirm('¿Está seguro de que desea confirmar esta importación?\nEsta acción no se puede deshacer.')) {
                    ejecutarConfirmacionImportacion(proveedorId, archivoOriginal);
                }
            }
        };

        // ✅ FUNCIÓN: Ejecutar la confirmación usando jQuery AJAX
        function ejecutarConfirmacionImportacion(proveedorId, archivoOriginal) {
            const $btn = $('#btnConfirmarImportacion');

            if ($btn.length === 0) {
                console.error('Botón de confirmación no encontrado');
                return;
            }

            // Estado de carga
            $btn.prop('disabled', true)
                .html('<i class="bx bx-loader-alt bx-spin me-1"></i>Confirmando...');

            // Preparar datos para envío
            const postData = {
                proveedorId: proveedorId,
                archivoOriginal: archivoOriginal
            };

            // ✅ USAR: jQuery AJAX con patrón consistente del proyecto
            $.ajax({
                url: '/Productos/Importar/ConfirmarImportacion',
                type: 'POST',
                data: postData,
                dataType: 'json',
                beforeSend: function() {
                    console.log('🚀 Enviando confirmación de importación:', postData);
                },
                success: function(response) {
                    console.log('✅ Respuesta de confirmación:', response);

                    if (response.error) {
                        manejarErrorConfirmacion(response.mensaje, $btn);
                    } else {
                        manejarExitoConfirmacion(response, $btn);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ Error AJAX confirmando importación:', { xhr, status, error });

                    let mensajeError = 'Error de comunicación con el servidor';
                    if (xhr.responseJSON && xhr.responseJSON.mensaje) {
                        mensajeError = xhr.responseJSON.mensaje;
                    } else if (xhr.status === 404) {
                        mensajeError = 'Endpoint de confirmación no encontrado';
                    } else if (xhr.status === 500) {
                        mensajeError = 'Error interno del servidor';
                    }

                    manejarErrorConfirmacion(mensajeError, $btn);
                }
            });
        }

        // ✅ FUNCIÓN: Manejar error de confirmación
        function manejarErrorConfirmacion(mensaje, $btn) {
            // Mostrar error usando el sistema del proyecto
            if (typeof AbrirMensaje === 'function') {
                AbrirMensaje("ERROR", mensaje,
                    () => $("#msjModal").modal("hide"),
                    false, ["Aceptar"], "error!", null);
            } else {
                showUploadError('Error: ' + mensaje);
            }

            // Restaurar botón
            $btn.prop('disabled', false)
                .html('<i class="bx bx-check me-1"></i>CONFIRMAR IMPORTACIÓN');
        }

        // ✅ FUNCIÓN: Manejar éxito de confirmación
        function manejarExitoConfirmacion(response, $btn) {
            // Actualizar botón a estado confirmado
            $btn.html('<i class="bx bxs-check-circle me-1"></i>CONFIRMADO')
                .removeClass('btn-success')
                .addClass('btn-outline-success')
                .prop('disabled', true);

            // Actualizar el alert de éxito
            const $alertDiv = $btn.closest('.alert');
            if ($alertDiv.length > 0) {
                const fechaConfirmacion = response.datos && response.datos.fechaConfirmacion
                    ? response.datos.fechaConfirmacion
                    : new Date().toLocaleString();

                $alertDiv.removeClass('alert-success')
                        .addClass('alert-info')
                        .html(`
                            <div class="d-flex align-items-center">
                                <i class="bx bxs-check-circle text-success me-2"></i>
                                <strong>Importación confirmada exitosamente</strong>
                                <span class="ms-2 text-muted">${fechaConfirmacion}</span>
                            </div>
                        `);
            }

            // Mostrar mensaje de éxito usando el sistema del proyecto
            if (typeof AbrirMensaje === 'function') {
                AbrirMensaje("ÉXITO",
                    "La importación ha sido confirmada exitosamente.",
                    () => $("#msjModal").modal("hide"),
                    false, ["Aceptar"], "succ!", null);
            }

            // Log del éxito
            console.log('✅ Importación confirmada exitosamente:', response);

            // ✅ OPCIONAL: Trigger evento personalizado para otros listeners
            $(document).trigger('importacionConfirmada', [response]);
        }

        // ✅ EVENTO: Listener para eventos personalizados (opcional)
        $(document).on('importacionConfirmada', function(event, response) {
            console.log('🎉 Evento importacionConfirmada disparado:', response);
            // Aquí se pueden agregar acciones adicionales tras la confirmación
        });
    });

    // function confirmarImportacion(proveedorId, archivoOriginal) {
