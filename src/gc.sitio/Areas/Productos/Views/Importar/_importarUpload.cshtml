@{
    string uploadId = ViewBag.UploadId ?? "default";
}

<div class="upload-container-golden" id="uploadContainer@(uploadId)">
    <div class="upload-header-golden">
        <i class="bx bx-upload"></i>
        <h6 class="upload-title-golden">Seleccionar Archivo</h6>
    </div>

    <div class="upload-drop-zone-golden" id="dropZone@(uploadId)">
        <div class="upload-content-golden">
            <i class="bx bx-cloud-upload upload-icon-golden"></i>
            <p class="upload-text-golden">Arrastra y suelta tu archivo aquí</p>
            <p class="upload-subtext-golden">o</p>
            <label for="fileInput@(uploadId)" class="btn-upload-golden">
                Explorar Archivos
            </label>
            <input type="file" id="fileInput@(uploadId)" class="file-input-hidden" accept=".xlsx" />
        </div>
    </div>

    <div class="upload-info-golden" id="uploadInfo@(uploadId)" style="display: none;">
        <div class="file-info-golden">
            <i class="bx bx-file upload-file-icon-golden"></i>
            <div class="file-details-golden">
                <span class="file-name-golden" id="fileName@(uploadId)"></span>
                <span class="file-size-golden" id="fileSize@(uploadId)"></span>
            </div>
            <button type="button" class="btn-remove-golden" id="removeFile@(uploadId)">
                <i class="bx bx-x"></i>
            </button>
        </div>
        <div class="upload-progress-golden" id="uploadProgress@(uploadId)" style="display: none;">
            <div class="progress-bar-golden">
                <div class="progress-fill-golden" id="progressFill@(uploadId)"></div>
            </div>
            <span class="progress-text-golden" id="progressText@(uploadId)">0%</span>
        </div>
    </div>
</div>
