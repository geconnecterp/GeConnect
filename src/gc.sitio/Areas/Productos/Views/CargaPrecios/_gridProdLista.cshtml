@using static gc.infraestructura.Helpers.GridHelper
@model GridCoreSmart<ProductoDetalleDto>
@{
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
    string leyend = ViewBag.Leyenda ?? "Detalle de Productos";

    // Variables para agrupar por familia
    string familiaActual = string.Empty;
    string familiaAnterior = string.Empty;
}

<style>
    /* Estilo para alinear a la derecha los inputs numéricos */
    .input-numeric {
        text-align: right;
        padding-right: 5px;
        font-size: 0.85rem; /* Reducir tamaño de fuente para valores grandes */
    }

    /* Ajustar el padding interno para aprovechar mejor el espacio */
    .form-control-sm.input-numeric {
        padding: 0.15rem 0.3rem;
        height: auto;
        min-width: 70px; /* Ancho mínimo para visibilidad */
    }

    /* Campos con 2 decimales */
    .input-tp_margen_lista, .input-tp_pvta_lista {
        font-size: 0.8rem;
        min-width: 70px;
    }

    /* Estilo para campos modificados */
    .campo-modificado {
        background-color: #d4f1f9 !important; /* Celeste pastel claro */
        border-color: #a8e1f5 !important;
    }

    /* Indicador visual de cambio */
    .indicador-cambio {
        position: absolute;
        top: 0;
        right: 0;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 0 8px 8px 0;
        border-color: transparent #4bacc6 transparent transparent;
    }

    /* Contenedor relativo para posicionar el indicador */
    .input-container {
        position: relative;
    }
</style>

<div class="grid-golden">
    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap table-wrapper">
            <table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbProdLista">
                <thead>
                    <tr class="header">
                        <th scope="col">Código</th>
                        <th scope="col">Lista</th>
                        <th scope="col">Mrg</th>
                        <th scope="col">PVta</th>
                        <th scope="col">%Re</th>                       
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos == null || Model.ListaDatos.Count == 0)
                    {
                        <tr>
                            <td colspan="18" class="text-center">No se han encontrado productos para los criterios especificados.</td>
                        </tr>
                    }
                    else
                    {
                        // Filas de datos agrupadas por familia
                        @foreach (var item in Model.ListaDatos)
                        {
                            decimal re = 0M;
                            if(item.p_pvta>0){ re = Math.Round(item.tp_pvta / item.p_pvta, 2); }
                            if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }
                            <tr class="@clase" data-lp-id="@item.lp_id" onclick="selectReg(this,'tbProdDet')">
                                <td class="@Model.ObtenerClase(item.lp_id)">@Model.FormatearDato(item.lp_id, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.lp_desc)">@Model.FormatearDato(item.lp_desc, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.tp_margen)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_margen_lista input-numeric"
                                               value="@(item.tp_margen.ToString("F2"))"
                                               data-lp-id="@item.lp_id"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.p_margen"
                                               readonly />
                                        @Html.Hidden("p_pcosto",item.P_Pcosto)
                                        @Html.Hidden("p_pneto",item.p_pneto)
                                        @Html.Hidden("lp_porc_mg",item.lp_porc_mg)
                                        @Html.Hidden("iva_situacion",item.iva_situacion)
                                        @Html.Hidden("iva_alicuota", item.iva_alicuota)
                                        @Html.Hidden("in_alicuota", item.in_alicuota)
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pvta)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_pvta_lista input-numeric"
                                               value="@(item.tp_pvta.ToString("F2"))"
                                               data-lp-id="@item.lp_id"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.p_pvta"
                                               readonly />
                                        @Html.Hidden("tp_iva", item.tp_iva)
                                        @Html.Hidden("tp_in", item.tp_in)

                                        @Html.Hidden("tp_pneto", item.tp_in)
                                        
                                    </div>
                                </td>
                                
                                <td class="@Model.ObtenerClase(item.p_pvta)">@Model.FormatearDato(re, FormatDato.Monto)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
