@using static gc.infraestructura.Constantes.Constantes
@{
    Layout = "~/views/shared/_Layout.cshtml";
    var filtro = new QueryFilters()
    {
        Rel01 = new List<string>(),
        Rel02 = new List<string>(),
        Rel03 = new List<ComboGenDto>(),
        Modelo = ModeloFilter.PRODUCTO_CARGA_PRECIO,
        Opt1 = true, //destinado a la opcion "Incluir Discontinuos"
        Opt2 = false, //destinados a la opcion "Archivo"
    };
    //sub es el nombre de la variable sufijo para el control que presenta datos de la cuenta.
    string sub = "CPrecio";
}

@section styles {
    <link rel="stylesheet" href="~/css/productocargaprecio.css" />
}

<partial name="_botonera" model="filtro" />

<div class="collapse show" id="divFiltro">
    <partial name="_filtroBase" model="filtro" />
    @Html.Hidden("pagEstado", false)
</div>
<div class="collapse" id="divDetalle">
    <partial name="_n01TabsCP" model="@sub" />
</div>

@section scripts {
    <script type="text/javascript">


        var homeCPUrl = "@Url.Action("Index", "cargaprecios", new { area = "productos" })";
        var buscarProdDetUrl ="@Url.Action("ObtenerProductosDetalle", "cargaprecios", new { area = "productos" })";
        var buscarProdListaUrl ="@Url.Action("ObtenerProductosDetalleLista", "cargaprecios", new { area = "productos" })";
        var calcularCostoUrl = "@Url.Action("CalcularCosto", "cargaprecios", new { area = "productos" })";
        var resguardarCambiosProductoUrl = "@Url.Action("ResguardarCambiosProducto", "cargaprecios", new { area = "productos" })";
        var resguardarCambiosProductoListaUrl = "@Url.Action("ResguardarCambiosProductoLista", "cargaprecios", new { area = "productos" })";
        var confirmarPreciosTemporalesUrl = "@Url.Action("ConfirmarPreciosTemporales", "cargaprecios", new { area = "productos" })";

        var calcularPrecioVentaBaseUrl = "@Url.Action("CalcularPrecioVentaBase", "cargaprecios", new { area = "productos" })";
        var calcularPrecioVentaMargenUrl = "@Url.Action("calcularPrecioVentaMargen", "cargaprecios", new { area = "productos" })";
        var calcularPrecioVentaLinkUrl = "@Url.Action("CalcularPrecioVentaLink", "cargaprecios", new { area = "productos" })";


        var buscarFamiliaUrl = "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel01Url = "@Url.Action("BuscarProvs", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel02Url = "@Url.Action("BuscarRubros", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel03Url = "@Url.Action("BuscarFlias", "cargaprecios", new { area = "productos" })";/**/

        let importarUrl = "@Url.Action("Index", "importar", new { area = "productos" })";
        let seleccionarProveedorUrl = "@Url.Action("SeleccionarProveedor", "cargaprecios", new { area = "productos" })";

        let isInitializing = false;
        //esta variable es para usarla en Js. El (sub) es para usarlo aca nomas
        nnControlCta01 = "@(sub)";

        $(function(){
            //Inicializa el control.
            inicializaCtrl@(sub)();
        });
    </script>

    @* <script src="~/js/app/siteGen.js"></script> *@
    <script src="~/js/app/busquedas.js"></script>
    <script src="~/js/app/areas/precios/productocargaprecio.js"></script>
}
