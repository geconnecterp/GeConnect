@using static gc.infraestructura.Helpers.GridHelper
@model GridCoreSmart<ProductoDetalleDto>
@{
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
    string leyend = ViewBag.Leyenda ?? "Detalle de Productos";

    // Variables para agrupar por familia
    string familiaActual = string.Empty;
    string familiaAnterior = string.Empty;
}

<style>
    /* Estilo para alinear a la derecha los inputs numéricos */
    .input-numeric {
        text-align: right;
        padding-right: 5px;
        font-size: 0.85rem; /* Reducir tamaño de fuente para valores grandes */
    }

    /* Ajustar el padding interno para aprovechar mejor el espacio */
    .form-control-sm.input-numeric {
        padding: 0.15rem 0.3rem;
        height: auto;
        min-width: 70px; /* Ancho mínimo para visibilidad */
    }

    /* Ajustes específicos para la visualización de números grandes */
    .input-tp_plista {
        width: 100%;
        letter-spacing: -0.5px; /* Reduce ligeramente el espacio entre caracteres */
    }

    /* Reducir el ancho de la columna de descripción al 80% */
    #tbProdDet td:nth-child(2) {
        max-width: 200px; /* Establecer ancho máximo */
        width: 80%; /* Reducir al 80% */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Ajustar ancho del campo de bonificación para el patrón 999/999 */
    .input-tp_boni {
        min-width: 70px; /* Mismo ancho mínimo que los otros campos */
        text-align: center; /* Centrar el texto para mejor visualización */
        font-family: monospace; /* Fuente monoespaciada para mejor alineación */
    }

    /* Asegurar que todas las celdas de la tabla tengan un ancho apropiado */
    #tbProdDet th, #tbProdDet td {
        padding: 0.25rem 0.35rem; /* Reducir padding general */
    }
</style>


<div class="grid-golden">
    <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-10 col-sm-6">
                <h5 class="mb-0">
                    <i class="bx bx-package me-2"></i>
                    <strong>@leyend</strong>
                </h5>
            </div>
            <div class="col-md-2 col-sm-6">
                <div class="d-flex justify-content-sm-end">
                    <!-- Botón Imprimir -->
                    <button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" title="Imprimir">
                        <i class="bx bx-printer"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap table-wrapper">
            <table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbProdDet">
                <thead>
                    <tr class="header">
                        <th scope="col">Código</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Cód.Prv</th>
                        <th scope="col">EAN</th>
                        <th scope="col">P.Lista</th>
                        <th scope="col">D1</th>
                        <th scope="col">D2</th>
                        <th scope="col">D3</th>
                        <th scope="col">D4</th>
                        <th scope="col">Dpa</th>
                        <th scope="col">Ft</th>
                        <th scope="col">Bonif</th>
                        <th scope="col" class="text-end">P.Costo</th>
                        <th scope="col" class="text-end">Margen</th>
                        <th scope="col" class="text-end">P.Neto</th>
                        <th scope="col">IVA</th>
                        <th scope="col">II</th>
                        <th scope="col" class="text-end">P.Vta May</th>
                        <th scope="col" class="text-end">%Re</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos == null || Model.ListaDatos.Count == 0)
                    {
                        <tr>
                            <td colspan="18" class="text-center">No se han encontrado productos para los criterios especificados.</td>
                        </tr>
                    }
                    else
                    {
                        // Ordenamos los datos por familia para agruparlos
                        var productosPorFamilia = Model.ListaDatos.OrderBy(p => p.pg_id).ThenBy(p => p.p_id).ToList();

                        // Filas de datos agrupadas por familia
                        @foreach (var item in productosPorFamilia)
                        {
                            familiaActual = item.pg_id;

                            // Si cambia la familia, insertamos una fila de encabezado para la familia
                            if (familiaActual != familiaAnterior)
                            {
                                <tr class="table-secondary fw-bold">
                                    <td colspan="19">
                                        <i class="bx bx-folder me-1"></i>
                                        Familia: @item.pg_id - @item.pg_desc
                                    </td>
                                </tr>
                                familiaAnterior = familiaActual;
                                alt = true; // Reiniciar alternancia de colores después de cada familia
                            }
                            decimal re = 0M;
                            if (item.p_pvta > 0) { re = Math.Round(item.tp_pvta / item.p_pvta, 2); }
                            if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }
                            <tr class="@clase" data-p-id="@item.p_id" onclick="selectReg(this,'tbProdDet')">
                                <td class="@Model.ObtenerClase(item.p_id)">@Model.FormatearDato(item.p_id, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.p_desc)">@Model.FormatearDato(item.p_desc, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.p_id_prov)">@Model.FormatearDato(item.p_id_prov, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.p_id_barrado)">@Model.FormatearDato(item.p_id_barrado, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.tp_plista)">
                                    <input type="text" class="form-control form-control-sm input-tp_plista input-numeric"
                                           value="@(item.tp_plista)"
                                           data-original-value="@(item.tp_plista)" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto1)">
                                    <input type="text" class="form-control form-control-sm input-tp_dto1 input-numeric"
                                           value="@(item.tp_dto1.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_dto1" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto2)">
                                    <input type="text" class="form-control form-control-sm input-tp_dto2 input-numeric"
                                           value="@(item.tp_dto2.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_dto2" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto3)">
                                    <input type="text" class="form-control form-control-sm input-tp_dto3 input-numeric"
                                           value="@(item.tp_dto3.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_dto3" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto4)">
                                    <input type="text" class="form-control form-control-sm input-tp_dto4 input-numeric"
                                           value="@(item.tp_dto4.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_dto4" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto_pa)">
                                    <input type="text" class="form-control form-control-sm input-tp_dto_pa input-numeric"
                                           value="@(item.tp_dto_pa.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_dto_pa" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_porc_flete)">
                                    <input type="text" class="form-control form-control-sm input-tp_porc_flete input-numeric"
                                           value="@(item.tp_porc_flete.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_porc_flete" />
                                </td>
                                <td class="@Model.ObtenerClase('c')">
                                    <input type="text" class="form-control form-control-sm input-tp_boni"
                                           value="@Model.FormatearDato(item.tp_boni, FormatDato.Ninguno)"
                                           data-p-id="@item.p_id"
                                           placeholder="000/000" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pcosto)">
                                    <input type="text" class="form-control form-control-sm input-numeric"
                                           value="@(item.tp_pcosto.ToString("F2"))"
                                           readonly
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_pcosto" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_margen)">
                                    <input type="text" class="form-control form-control-sm input-tp_margen input-numeric"
                                           value="@(item.tp_margen.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_margen" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pneto)">
                                    <input type="text" class="form-control form-control-sm input-numeric"
                                           value="@(item.tp_pneto.ToString("F2"))"
                                           readonly
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_pneto" />
                                </td>
                                <td class="@Model.ObtenerClase('c')">@($"{item.iva_situacion}-{item.iva_alicuota}")</td>
                                <td class="@Model.ObtenerClase(item.tin_alicuota)">
                                    <input type="text" class="form-control form-control-sm input-tin_alicuota input-numeric"
                                           value="@(item.tin_alicuota.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tin_alicuota" />
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pvta)">
                                    <input type="text" class="form-control form-control-sm input-tp_pvta input-numeric"
                                           value="@(item.tp_pvta.ToString("F2"))"
                                           data-p-id="@item.p_id"
                                           data-original-value="@item.tp_pvta" />
                                </td>
                                <td class="@Model.ObtenerClase(item.p_pvta)">@Model.FormatearDato(re, FormatDato.Monto)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
