@using static gc.infraestructura.Helpers.GridHelper
@model GridCoreSmart<ProductoDetalleDto>
@{
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.SortDir.Equals("ASC") ? "DESC" : "ASC";
    string leyend = ViewBag.Leyenda ?? "Detalle de Productos";

    // Variables para agrupar por familia
    string familiaActual = string.Empty;
    string familiaAnterior = string.Empty;
}



<div class="grid-golden">
    <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-10 col-sm-6">
                <h5 class="mb-0">
                    <i class="bx bx-package me-2"></i>
                    <strong>@leyend</strong>
                </h5>
            </div>
            <div class="col-md-2 col-sm-6">
                <div class="d-flex justify-content-sm-end">
                    <!-- Botón Imprimir
                    <button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" title="Imprimir">
                        <i class="bx bx-printer"></i>
                    </button>-->
                </div>
            </div>
        </div>
    </div>

    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap table-wrapper">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbProdDet">
                <thead>
                    <tr class="header">
                        <!-- CORREGIDO: Columna para checkbox de seleccionar todos con mejor estructura -->
                        <th scope="col" class="check-column">
                            <div class="check-producto-container">
                                <input class="form-check-input" type="checkbox" id="checkAllProd" title="Seleccionar todos">
                            </div>
                        </th>
                        <th scope="col">Código</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Cód.Prv</th>
                        <th scope="col">EAN</th>
                        <th scope="col">P.Lista</th>
                        <th scope="col">D1</th>
                        <th scope="col">D2</th>
                        <th scope="col">D3</th>
                        <th scope="col">D4</th>
                        <th scope="col">Dpa</th>
                        <th scope="col">Ft</th>
                        <th scope="col">Bonif</th>
                        <th scope="col" class="text-end">P.Costo</th>
                        <th scope="col" class="text-end">Margen</th>
                        <th scope="col" class="text-end">P.Neto</th>
                        <th scope="col">IVA</th>
                        <th scope="col">II</th>
                        <th scope="col" class="text-end">P.Vta May</th>
                        <th scope="col" class="text-end">%Re</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos == null || Model.ListaDatos.Count == 0)
                    {
                        <tr>
                            <td colspan="20" class="text-center">No se han encontrado productos para los criterios especificados.</td>
                        </tr>
                    }
                    else
                    {
                        // Ordenamos los datos por familia para agruparlos
                        var productosPorFamilia = Model.ListaDatos.OrderBy(p => p.pg_id).ThenBy(p => p.p_desc).ToList();

                        // Filas de datos agrupadas por familia
                        @foreach (var item in productosPorFamilia)
                        {
                            familiaActual = item.pg_id;

                            // Si cambia la familia, insertamos una fila de encabezado para la familia
                            if (familiaActual != familiaAnterior)
                            {
                                <tr class="table-secondary fw-bold">
                                    <td colspan="20">
                                        <i class="bx bx-folder me-1"></i>
                                        Familia: @item.pg_id - @item.pg_desc
                                    </td>
                                </tr>
                                familiaAnterior = familiaActual;
                                alt = true; // Reiniciar alternancia de colores después de cada familia
                            }
                            decimal re = 0M;
                            if (item.p_pvta > 0) { re = Math.Round(item.tp_pvta / item.p_pvta, 2); }
                            if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }

                            // Verificar si estamos en modo de carga temporal
                            bool modoTemporal = item.carga == 1;

                            <tr class="@clase" data-p-id="@item.p_id" data-carga="@item.carga">
                                <!-- CORREGIDO: Celda para checkbox de selección individual con mejor estructura -->
                                <td class="check-column">
                                    <div class="check-producto-container">
                                        <input type="checkbox" class="form-check-input check-producto" data-p-id="@item.p_id">
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.p_id)">@Model.FormatearDato(item.p_id, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.p_desc)" title="@Model.FormatearDato(item.p_desc, FormatDato.Ninguno)">
                                    @Model.FormatearDato(item.p_desc, FormatDato.Ninguno)
                                </td>

                                <td class="@Model.ObtenerClase(item.p_id_prov)">@Model.FormatearDato(item.p_id_prov, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.p_id_barrado)">@Model.FormatearDato(item.p_id_barrado, FormatDato.Ninguno)</td>
                                <td class="@Model.ObtenerClase(item.tp_plista)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_plista input-numeric"
                                               value="@(item.tp_plista.ToString("F3"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@(item.P_Plista)" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto1)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_dto1 input-numeric"
                                               value="@(item.tp_dto1.ToString("F1"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Dto1" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto2)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_dto2 input-numeric"
                                               value="@(item.tp_dto2.ToString("F1"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Dto2" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto3)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_dto3 input-numeric"
                                               value="@(item.tp_dto3.ToString("F1"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Dto3" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto4)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_dto4 input-numeric"
                                               value="@(item.tp_dto4.ToString("F1"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Dto4" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_dto_pa)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_dto_pa input-numeric"
                                               value="@(item.tp_dto_pa.ToString("F1"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Dto_Pa" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_porc_flete)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_porc_flete input-numeric"
                                               value="@(item.tp_porc_flete.ToString("F1"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Porc_Flete" />
                                    </div>
                                </td>
                                @{
                                    bool resBoni = item.P_Boni?.Trim().Equals("0") ?? false;
                                    string bonificacionMostrada = resBoni ? "" : Model.FormatearDato(item.P_Boni, FormatDato.Ninguno);
                                    bool tresBoni = item.tp_boni?.Trim().Equals("0") ?? false;
                                    string tbonificacionMostrada = tresBoni ? "" : Model.FormatearDato(item.tp_boni, FormatDato.Ninguno);

                                }
                                <td class="@Model.ObtenerClase('c')">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_boni"
                                               value="@tbonificacionMostrada"
                                               data-p-id="@item.p_id"
                                               data-original-value="@bonificacionMostrada"
                                               placeholder="000/000" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pcosto)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_pcosto input-numeric"
                                               value="@(item.tp_pcosto.ToString("F3"))"
                                               readonly
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.P_Pcosto" />
                                        @Html.Hidden("lp_prevision_tot", item.lp_prevision_tot)
                                        @Html.Hidden("lp_prevision_pin", item.lp_prevision_pin)
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_margen)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_margen input-numeric"
                                               value="@(item.tp_margen.ToString("F2"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.p_margen" />
                                        @Html.Hidden("p_margen", item.p_margen)
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pneto)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_pneto input-numeric"
                                               value="@(item.tp_pneto.ToString("F3"))"
                                               readonly
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.p_pneto" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase('c')">
                                    @($"{item.iva_situacion}-{item.iva_alicuota}")
                                    @Html.Hidden("iva_situacion", item.iva_situacion)
                                    @Html.Hidden("iva_alicuota", item.iva_alicuota)
                                    @Html.Hidden("in_alicuota", item.in_alicuota)
                                    @Html.Hidden("p_iva", item.p_iva)
                                    @Html.Hidden("p_in", item.p_in)
                                </td>
                                <td class="@Model.ObtenerClase(item.tin_alicuota)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tin_alicuota input-numeric"
                                               value="@(item.tin_alicuota.ToString("F2"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.in_alicuota" />
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.tp_pvta)">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-tp_pvta input-numeric"
                                               value="@(item.tp_pvta.ToString("F2"))"
                                               data-p-id="@item.p_id"
                                               data-original-value="@item.p_pvta" />
                                        @Html.Hidden("tp_iva", item.tp_iva)
                                        @Html.Hidden("tp_in", item.tp_in)
                                    </div>
                                </td>
                                <td class="@Model.ObtenerClase(item.p_pvta) tdRe">@Model.FormatearDato(re, FormatDato.Monto)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $(function() {
        // Esta función aplica los indicadores visuales a los campos modificados en la carga inicial
        $('.campo-modificado').each(function() {
            // Solo si no tiene ya un indicador
            if ($(this).parent('.input-container').find('.indicador-cambio').length === 0) {
                $(this).parent('.input-container').append('<div class="indicador-cambio"></div>');
            }
        });

        // NUEVO: Forzar el ancho de la columna de descripción
        const setDescriptionColumnWidth = function() {
            // Seleccionar todas las celdas de descripción y sus encabezados
            $("#tbProdDet th:nth-child(3), #tbProdDet td:nth-child(3)").each(function() {
                $(this).css({
                    'max-width': '150px',
                    'width': '150px',
                    'white-space': 'nowrap',
                    'overflow': 'hidden',
                    'text-overflow': 'ellipsis'
                });
            });
        };

        // Ejecutar inmediatamente
        setDescriptionColumnWidth();

        // Volver a aplicar después de cualquier redibujado de la tabla
        $(window).on('resize', setDescriptionColumnWidth);

        // CORREGIDO: Funcionalidad para checkbox de seleccionar todos
        $("#checkAllProd").on("change", function() {
            const isChecked = $(this).prop("checked");
            $(".check-producto").prop("checked", isChecked);

            // Aplicar la clase 'selected' a las filas
            $("#tbProdDet tbody tr:not(.table-secondary)").each(function() {
                $(this).toggleClass("selected", isChecked);
            });

            // Si hay productos seleccionados, cargar el primero en la lista
            if (isChecked) {
                const primerProductoId = $("#tbProdDet tbody tr:not(.table-secondary):first").data("p-id");
                if (primerProductoId && typeof destacarFilaSeleccionada === 'function') {
                    destacarFilaSeleccionada(primerProductoId);
                    if (typeof buscarProductoListaOptimizado === 'function') {
                        buscarProductoListaOptimizado(primerProductoId);
                    }
                }
            }
        });

        // CORREGIDO: Evento para checkboxes individuales sin usar 'event' global
        $(document).on("change", ".check-producto", function(e) {
            // Evitar propagación del evento
            e.stopPropagation();

            const $checkbox = $(this);
            const isChecked = $checkbox.prop("checked");
            const $row = $checkbox.closest("tr");

            // Marcar/desmarcar la fila
            $row.toggleClass("selected", isChecked);

            // Si se desmarca uno, desmarcar el "seleccionar todos"
            if (!isChecked) {
                $("#checkAllProd").prop("checked", false);
            } else {
                // Verificar si todos están marcados para actualizar el checkbox principal
                const totalCheckboxes = $(".check-producto").length;
                const totalChecked = $(".check-producto:checked").length;
                $("#checkAllProd").prop("checked", totalCheckboxes === totalChecked);

                // Si seleccionamos un producto, cargar sus listas
                const productoId = $row.data("p-id");
                if (productoId && typeof destacarFilaSeleccionada === 'function') {
                    destacarFilaSeleccionada(productoId);
                    if (typeof buscarProductoListaOptimizado === 'function') {
                        buscarProductoListaOptimizado(productoId);
                    }
                }
            }
        });

        // CORREGIDO: Manejo de clic en la fila para selección
        $(document).on("click", "#tbProdDet tbody tr:not(.table-secondary)", function(e) {
            // No activar si el clic fue en un checkbox o input
            if (!$(e.target).is('input, .check-producto, .check-producto-container')) {
                const $row = $(this);
                const $checkbox = $row.find(".check-producto");
                const productoId = $row.data("p-id");

                // Invertir el estado del checkbox
                const newState = !$checkbox.prop("checked");
                $checkbox.prop("checked", newState);

                // Actualizar selección visual
                $row.toggleClass("selected", newState);

                // Actualizar el checkbox principal
                if (!newState) {
                    $("#checkAllProd").prop("checked", false);
                } else {
                    const totalCheckboxes = $(".check-producto").length;
                    const totalChecked = $(".check-producto:checked").length;
                    $("#checkAllProd").prop("checked", totalCheckboxes === totalChecked);

                    // Si seleccionamos un producto, cargar sus listas
                    if (productoId && typeof destacarFilaSeleccionada === 'function') {
                        destacarFilaSeleccionada(productoId);
                        if (typeof buscarProductoListaOptimizado === 'function') {
                            buscarProductoListaOptimizado(productoId);
                        }
                    }
                }
            }
        });

        // AÑADIDO: Función de ayuda para obtener los IDs de productos seleccionados
        window.obtenerProductosSeleccionados = function() {
            const productosSeleccionados = [];
            $(".check-producto:checked").each(function() {
                const productoId = $(this).data("p-id");
                if (productoId) {
                    productosSeleccionados.push(productoId);
                }
            });
            return productosSeleccionados;
        };
    });
</script>
