                    </div>

                    <!-- Fl -->
                    <div class="campo-edicion">
                        <input class="form-check-input" type="checkbox" id="chkFl" aria-label="Seleccionar Fl">
                        <label class="campo-etiqueta" for="chkFl">Fl</label>
                        <input type="text" class="form-control form-control-sm campo-valor input-mask-1-decimal" id="txtFl" disabled>
                    </div>
                </div>
            </div>
            <div class="col-md-1">
                <div class="d-flex justify-content-md-start">
                    <button type="button" class="btn btn-golden btn-sm me-1" id="btnAplicar">
                        <i class="bx bx-check me-1"></i>Aplicar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

