<!-- Estilos CSS para formato adecuado -->
<style>
    /* Estilos golden grid para compresión eficiente */
    .grid-golden {
        border: 1px solid #f0ad4e;
        border-radius: 0.25rem;
        overflow: hidden;
    }

    .grid-golden-header {
        background-color: #f0ad4e;
        color: white;
        padding: 0.4rem 0.75rem;
        border-bottom: 1px solid #eea236;
        font-weight: 600;
    }

    .grid-golden-body {
        background-color: #fff;
        padding: 0.5rem 0.75rem;
    }

    .btn-golden {
        background-color: #f0ad4e;
        border-color: #eea236;
        color: white;
    }

        .btn-golden:hover, .btn-golden:focus {
            background-color: #ec971f;
            border-color: #d58512;
            color: white;
        }

    .campo-edicion {
        display: flex;
        align-items: center;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background-color: #f8f9fa;
        padding: 0;
        overflow: hidden;
    }

    .campo-etiqueta {
        display: inline-block;
        margin: 0;
        padding: 0.25rem 0.5rem;
        background-color: #e9ecef;
        border-right: 1px solid #ced4da;
        font-size: 0.875rem;
        width: 45px;
        text-align: center;
    }

    .campo-valor {
        border: none;
        border-radius: 0;
        width: 60px;
        text-align: right;
        font-size: 0.6rem;
    }

    /* Estilos específicos para los campos de precio lista */
    #txtPLista, .input-PListaValor {
        width: 100px;
    }

    /* Ajuste responsive */
    @@media (max-width: 992px) {
        .d-flex.flex-row

    {
        flex-wrap: wrap;
    }

    .campo-edicion {
        margin-bottom: 0.25rem;
    }

    }
</style>

<!-- Agregar el script para inicializar las máscaras de entrada -->
<script>
    $(document).ready(function() {
        // Configuración para campos con 3 decimales (PLista)
        $(".input-mask-3-decimals").inputmask({
            alias: "numeric",
            groupSeparator: ",",
            radixPoint: ".",
            autoGroup: true,
            digits: 3,
            digitsOptional: false,
            rightAlign: true,
            prefix: '',
            placeholder: "0",
            clearMaskOnLostFocus: false,
            showMaskOnHover: false,
            showMaskOnFocus: false,
            onBeforeMask: function (value) {
                if (value) {
                    let numValue = parseFloat(value.toString().replace(/,/g, ''));
                    return isNaN(numValue) ? value : numValue.toFixed(3);
                }
                return value;
            }
        });

        // Configuración para campos con 1 decimal (descuentos y flete)
        $(".input-mask-1-decimal").inputmask({
            alias: "numeric",
            groupSeparator: ",",
            radixPoint: ".",
            autoGroup: true,
            digits: 1,
            digitsOptional: false,
            rightAlign: true,
            integerDigits: 2, // Máximo 2 dígitos enteros
            min: 0,
            max: 99.9, // Máximo valor permitido: 99.9
            prefix: '',
            placeholder: "0",
            clearMaskOnLostFocus: false,
            showMaskOnHover: false,
            showMaskOnFocus: false,
            onBeforeMask: function (value) {
                if (value) {
                    let numValue = parseFloat(value.toString().replace(/,/g, ''));
                    if (numValue > 99.9) numValue = 99.9; // Limitar al máximo permitido
                    return isNaN(numValue) ? value : numValue.toFixed(1);
                }
                return value;
            }
        });

        // Configuración para campo de bonificación (formato 999/999)
        $(".input-mask-boni").inputmask({
            mask: "999/999",
            placeholder: "",
            showMaskOnHover: false,
            showMaskOnFocus: false
        });

        // Manejo de habilitación/deshabilitación de campos
        $('#chkPLista, #chkDto1, #chkDto2, #chkDto3, #chkDto4, #chkDpo, #chkBon, #chkFl').on('change', function() {
            const campoId = $(this).attr('id').replace('chk', 'txt');
            const $campo = $('#' + campoId);

            if ($(this).is(':checked')) {
                $campo.prop('disabled', false);
                setTimeout(function() {
                    $campo.focus();
                }, 0);
            } else {
                $campo.prop('disabled', true);
            }
        });
    });
</script>