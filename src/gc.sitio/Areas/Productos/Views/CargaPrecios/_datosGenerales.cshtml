                    <!-- Dto1 actual -->
                    <div class="campo-edicion">
                        <label class="campo-etiqueta">D1</label>
                        <input type="text" class="form-control form-control-sm campo-valor input-Dto1Valor" disabled>
                    </div>
                    <!-- Dto2 actual -->
                    <div class="campo-edicion">
                        <label class="campo-etiqueta">D2</label>
                        <input type="text" class="form-control form-control-sm campo-valor input-Dto2Valor" disabled>
                    </div>
                    <!-- Dto3 actual -->
                    <div class="campo-edicion">
