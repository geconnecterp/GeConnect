                        <input type="text" class="form-control form-control-sm campo-valor input-mask-1-decimal" id="txtDto3" disabled>
                    </div>

                    <!-- Dto4 -->
                    <div class="campo-edicion">
                        <input class="form-check-input" type="checkbox" id="chkDto4" aria-label="Seleccionar Dto4">
                        <label class="campo-etiqueta" for="chkDto4">D4</label>
                        <input type="text" class="form-control form-control-sm campo-valor input-mask-1-decimal" id="txtDto4" disabled>
                    </div>

                    <!-- Dpo -->
                    <div class="campo-edicion">
                        <input class="form-check-input" type="checkbox" id="chkDpo" aria-label="Seleccionar Dpo">
                        <label class="campo-etiqueta" for="chkDpo">DPa</label>
