@{
    Layout = "~/views/shared/_Layout.cshtml";
    var filtro = new QueryFilters() { Modelo = ModeloFilter.PRESUPUESTO, Rel01 = [], Rel02 = [], Rel03 = [] ,Rel04=[]};
    List<ProductoListaDto> listaVacia = new();
    int indicePrint = ViewBag.ImpresionId != null ? (int)ViewBag.ImpresionId : 0;
}

@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
    <link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
    <style>
        /* Botonera operativa uniforme, limitada al módulo Presupuestos. */
        #btnAbmAceptar,
        #btnAbmCancelar,
        #btnImprimir,
        #btnAbmNuevo,
        #btnAbmModif,
        #btnAbmElimi {
            width: 100px !important;
            flex: 0 0 100px;
            height: 31px;
            min-height: 31px;
            padding: 0.25rem 0.5rem !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.25rem;
            line-height: 1.5;
            box-sizing: border-box;
        }
    </style>
}

<partial name="_botonera" model="filtro" />
<div class="collapse" id="divFiltro">
    <partial name="_filtroBase" model="filtro" />
    @Html.Hidden("pagEstado", false)
</div>
<div class="collapse" id="divDetalle"></div>

<div class="row g-2 mt-2 py-1 presupuesto-detalle-layout">
    <div class="col-12" id="divPresDatos" style="display:none">

    </div>
    <div class="col-12" id="divPresProds" style="display:none">

    </div>
</div>
<div id="modalGestorDocumental"></div>
<partial name="~/areas/controlcomun/views/producto/busquedaadvanceV02.cshtml" model="@listaVacia" />


