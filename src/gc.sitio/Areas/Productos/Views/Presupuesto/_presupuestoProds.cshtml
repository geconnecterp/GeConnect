@model GridCoreSmart<PresupuestoProductoDto>

@{
    var alt = true;
    string clase = string.Empty;
    int cont = 0;
    var culturaNumero = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    
}

<div class="grid-golden h-100">
    <div class="grid-golden-header py-1 d-flex align-items-center">
        <h6 class="mb-0">Productos del Presupuesto</h6>

        <!-- Centro (métricas globales) -->
        <div class="flex-grow-1 text-center">
            <span class="fw-bold me-2">Valor de Utilidad Total:</span>
            <span id="spUtilidadTotal" class="text-danger me-4">-</span>

            <span class="fw-bold me-2">Margen Total:</span>
            <span id="spMargenTotal" class="text-danger">-</span>
        </div>

        <button type="button" class="btn btn-sm btn-golden" id="btnAgregarCProducto" title="Agregar Producto" disabled>
            <i class="bx bx-plus"></i>
        </button>
    </div>
    <div class="grid-golden-body p-1">
        <div class="table-responsive" style="max-height: 400px;">
            <table class="table table-sm table-hover mb-0 table-golden" id="tbGridPresupuestoProds">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center th-compact">#</th>
                        <th class="text-center th-compact">Código</th>
                        <th class="text-left th-compact">Descripción</th>
                        <th class="text-end th-compact">Costo</th>
                        <th class="text-end th-compact">Cantidad</th>
                        <th class="text-end th-compact">Mg %</th>
                        <th class="text-end th-compact">Venta</th>
                        <th class="text-end th-compact">Total</th>
                        <th class="text-center th-compact" style="width: 50px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ListaDatos?.Any() == true)
                    {
                        foreach (var item in Model.ListaDatos.OrderBy(x=>x.pre_item).ToList())
                        {
                            cont++;
                            var pre_item = item.pre_item == 0 ? cont : item.pre_item;
                            if (alt) { clase = "alt"; alt = false; } else { clase = ""; alt = true; }
                            var totalCalc = (item.pre_cantidad * item.pre_pvta);
                            <tr class="@clase"
                                data-pre-item="@cont"
                                data-p-id="@item.p_id"
                                data-up-id="@item.up_id"
                                data-pre-pcosto="@item.pre_pcosto"
                                data-p-pcosto-actual="@item.p_pcosto_actual"
                                data-pre-pneto="@item.pre_pneto"
                                data-iva-situacion="@item.iva_situacion"
                                data-iva-alicuota="@item.iva_alicuota"
                                data-in-alicuota="@item.in_alicuota"
                                data-lp-prevision-tot="@item.lp_prevision_tot"
                                data-lp-prevision-pin="@item.lp_prevision_pin">
                                <td class="text-center">@pre_item</td>
                                <td class="text-center">@item.p_id</td>
                                <td>@item.p_des</td>
                                <td class="text-end">@item.pre_pcosto.ToString("N3", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                                <td class="text-end">
                                    <div class="input-container">
                                        <input type="text" 
                                               class="form-control form-control-sm input-pre_cantidad input-numeric campo-readonly"
                                               value="@item.pre_cantidad.ToString(item.up_id == "07" ? "N0" : "N3", culturaNumero)"
                                               data-original-value="@item.pre_cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                               readonly 
                                               title="Doble click para editar" />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="input-container">
                                        <input type="text" 
                                               class="form-control form-control-sm input-pre_margen input-numeric campo-readonly"
                                               value="@item.pre_pmargen"
                                               data-original-value="@item.pre_pmargen"
                                               data-margen-actual="@item.p_margen_actual"
                                               readonly 
                                               title="Doble click para editar" />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="input-container">
                                        <input type="text" 
                                               class="form-control form-control-sm input-pre_pvta input-numeric campo-readonly"
                                               value="@item.pre_pvta"
                                               data-original-value="@item.pre_pvta"
                                               data-pvta-actual="@item.p_pvta_actual"
                                               readonly 
                                               title="Doble click para editar" />
                                    </div>
                                </td>
                                <td class="text-end td-total" data-value="@totalCalc.ToString(System.Globalization.CultureInfo.InvariantCulture)">@totalCalc.ToString("N2", culturaNumero)</td>
                                <td class="text-center">
                                    <button type="button" 
                                            class="btn btn-sm btn-danger btn-eliminar-producto" 
                                            data-p-id="@item.p_id"
                                            title="Eliminar producto"
                                            style="display: none;">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>No hay productos en este presupuesto
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model?.ListaDatos?.Any() == true)
                {
                    <tfoot class="table-golden-footer">
                        <tr>
                            <td colspan="7" class="text-end fw-bold">Total General:</td>
                            <td class="text-end fw-bold">@Model.ListaDatos.Sum(x => (x.pre_cantidad * x.pre_pvta)).ToString("N2", culturaNumero)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<script>
$(function() {
    if (typeof aplicarInputMaskPresupuesto === 'function') {
        aplicarInputMaskPresupuesto();
    }
    
    // ✅ CONTROLAR VISIBILIDAD DE BOTONES DE ELIMINACIÓN
    if (typeof aplicarVisibilidadBotonesEliminar === 'function') {
        aplicarVisibilidadBotonesEliminar();
    }
});
</script>
