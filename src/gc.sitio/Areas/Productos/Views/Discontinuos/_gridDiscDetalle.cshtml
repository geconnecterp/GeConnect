<div class="grid-golden mt-3">
    <div class="grid-golden-header">
        <h5 class="mb-0">
            <i class="bx bx-list-ul"></i>
            Productos Discontinuos
        </h5>
    </div>
    <div class="grid-golden-body">
        <div class="table-wrapper-500-full-width">
            <table class="table table-golden table-sm table-hover mb-0" id="tbGridDiscontinuos">
                <thead class="table-golden-header sticky-top">
                    <tr>
                        <th class="text-center" style="width: 50px;">
                            <input type="checkbox" class="form-check-input" id="chkSelectAll">
                        </th>
                        <th style="width: 120px;">Código</th>
                        <th style="width: 300px;">Descripción</th>
                        <th style="width: 100px;">Estado</th>
                        <th style="width: 300px;">Proveedor</th>
                        <th class="text-end" style="width: 100px;">Stock</th>
                        <th class="text-center" style="width: 60px;">Acción</th>
                    </tr>
                </thead>
                <tbody id="tbodyDiscontinuos">
                    <!-- Los datos se cargarán dinámicamente -->
                </tbody>
            </table>
        </div>
    </div>
</div>
