
@model GridCoreSmart<ActualizaProveedorDto>

@{
    var alt = true;
    string clase = string.Empty;
}

<div class="grid-golden">
    <div class="grid-golden-body">
        <div class="table-responsive text-nowrap table-wrapper-500">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridProveedores">
                <thead class="sticky-top  table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center  th-compact" scope="col" style="width: 50px;">
                            <input type="checkbox" id="selectAllProveedores" class="form-check-input"
                                   title="Seleccionar todos">
                        </th>
                        <th class="text-center  th-compact" scope="col" style="width: 120px;">ID</th>
                        <th class="text-left th-compact" scope="col">DENOMINACIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos != null && Model.ListaDatos.Any())
                    {
                        @foreach (var item in Model.ListaDatos)
                        {
                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

                            <tr class="@clase proveedor-row"
                                data-cta-id="@item.cta_id"
                                data-denominacion="@item.cta_denominacion"
                                onclick="selectRowProveedor(this, 'tbGridProveedores')">
                                <td class="text-center">
                                    <input type="checkbox"
                                           class="form-check-input proveedor-check"
                                           value="@item.cta_id"
                                           data-denominacion="@item.cta_denominacion"
                                           onclick="event.stopPropagation();">
                                </td>
                                <td class="@Model.ObtenerClase(item.cta_id) text-center">
                                    @Model.FormatearDato(item.cta_id, FormatDato.Ninguno)
                                </td>
                                <td class="@Model.ObtenerClase(item.cta_denominacion) text-left">
                                    @Model.FormatearDato(item.cta_denominacion, FormatDato.Ninguno)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-2"></i>
                                No se encontraron proveedores con productos para actualizar
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ListaDatos != null && Model.ListaDatos.Any())
        {
            <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                <div class="text-muted small">
                    <span id="selectedCount">0</span> de @Model.CantidadReg proveedores seleccionados
                </div>
                <div class="text-muted small">
                    Total: @Model.CantidadReg registros
                </div>
            </div>
        }
    </div>
</div>

<style>
    .table-golden {
        --bs-table-hover-bg: rgba(212, 175, 55, 0.075);
    }

    .table-golden-header {
        background-color: #f8f5e4 !important;
        color: #b8941f !important;
        border-bottom: 2px solid #d4af37;
    }

        .table-golden-header th {
            border-color: #d4af37;
            font-weight: 600;
            font-size: 0.875rem;
        }

    .table-row-alt {
        background-color: rgba(212, 175, 55, 0.03);
    }

    .proveedor-row {
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
    }

        .proveedor-row:hover {
            background-color: rgba(212, 175, 55, 0.1) !important;
        }

        .proveedor-row.selected {
            background-color: rgba(212, 175, 55, 0.2) !important;
            border-left: 3px solid #d4af37;
        }

    .form-check-input:checked {
        background-color: #d4af37;
        border-color: #d4af37;
    }

    .form-check-input:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
    }

    .card-golden {
        border: 1px solid #d4af37;
        box-shadow: 0 2px 4px rgba(212, 175, 55, 0.1);
    }

    .table-wrapper-500 {
        max-height: 500px;
        overflow-y: auto;
    }

    .table th {
        position: sticky;
        top: 0;
        z-index: 10;
    }
</style>

<script>
    function selectRowProveedor(row, tableId) {
        // Remover selección previa
        const table = document.getElementById(tableId);
        table.querySelectorAll('tr.selected').forEach(tr => {
            tr.classList.remove('selected');
        });

        // Agregar selección a la fila actual
        row.classList.add('selected');

        // Obtener datos del proveedor
        const ctaId = row.dataset.ctaId;
        const denominacion = row.dataset.denominacion;

        if (ctaId) {
            // Disparar evento personalizado para notificar la selección
            const evento = new CustomEvent('proveedorSeleccionado', {
                detail: { ctaId, denominacion }
            });
            document.dispatchEvent(evento);

            // Log para debugging
            console.log('Proveedor seleccionado:', { ctaId, denominacion });
        }
    }
</script>