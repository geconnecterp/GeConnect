@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card card-golden">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Tabs Navigation -->
                    <ul class="nav nav-tabs nav-tabs-golden" id="actualizarTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="proveedores-tab" data-bs-toggle="tab"
                                    data-bs-target="#proveedores-panel" type="button" role="tab"
                                    aria-controls="proveedores-panel" aria-selected="true">
                                Proveedores con Precios Modificados
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="productos-tab" data-bs-toggle="tab"
                                    data-bs-target="#productos-panel" type="button" role="tab"
                                    aria-controls="productos-panel" aria-selected="false">
                                Productos
                            </button>
                        </li>
                    </ul>

                    <!-- Tabs Content con clase Bootstrap correcta -->
                    <div class="tab-content tab-content-compact" id="actualizarTabsContent">
                        <!-- Tab Proveedores con layout de columnas -->
                        <div class="tab-pane fade show active" id="proveedores-panel" role="tabpanel"
                             aria-labelledby="proveedores-tab">
                            <div class="row mt-3 g-3">
                                <!-- Grid de proveedores - 10/12 columnas -->
                                <div class="col-lg-10 col-md-9 col-12">
                                    <div id="proveedoresContainer">
                                        <!-- El contenido se carga automáticamente -->
                                    </div>
                                </div>

                                <!-- Panel de botones - 2/12 columnas -->
                                <div class="col-lg-2 col-md-3 col-12">
                                    <div class="d-flex flex-column gap-3 sticky-top" style="top: 1rem;">
                                        <!-- Botón Confirmar -->
                                        <button type="button"
                                                class="btn btn-success btn-lg w-100"
                                                id="btnConfirmarActualizacion"
                                                onclick="confirmarActualizacion()"
                                                disabled>
                                            <i class="bx bx-check-circle me-2"></i>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold">CONFIRMAR</span>
                                                <small class="opacity-75">Aplicar cambios</small>
                                            </div>
                                        </button>

                                        <!-- Separador visual -->
                                        <hr class="my-2 opacity-50">

                                        <!-- Botón Cancelar -->
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-lg w-100"
                                                id="btnCancelarActualizacion"
                                                onclick="cancelarActualizacion()">
                                            <i class="bx bx-x-circle me-2"></i>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold">CANCELAR</span>
                                                <small class="opacity-75">Descartar cambios</small>
                                            </div>
                                        </button>

                                        <!-- Panel de información -->
                                        <div class="card card-body bg-light p-3 mt-3">
                                            <div class="text-center">
                                                <i class="bx bx-info-circle text-info fs-4"></i>
                                                <div class="mt-2">
                                                    <small class="text-muted d-block">Proveedores seleccionados</small>
                                                    <span class="badge bg-primary fs-6" id="contadorSeleccionados">0</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Productos (sin cambios) -->
                        <div class="tab-pane fade" id="productos-panel" role="tabpanel"
                             aria-labelledby="productos-tab">
                            <div class="mt-3">
                                <div id="productosContainer">
                                    <div class="alert alert-info" role="alert">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Seleccione un proveedor en la pestaña anterior para ver sus productos.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        let homeActuUrl = '@Url.Action("Index", "ActualizarPP", new { area = "Productos" })';
        let CargarProveedoresUrl = '@Url.Action("CargarProveedores", "ActualizarPP", new { area = "Productos" })';
        let ObtenerProductosProveedorUrl = '@Url.Action("ObtenerProductosProveedor", "ActualizarPP", new { area = "Productos" })';
        let ConfirmarProveedoresUrl = '@Url.Action("ConfirmarProveedores", "ActualizarPP", new { area = "Productos" })';
        
    </script>
    <script src="~/js/app/areas/precios/actualizar.js"></script>
}