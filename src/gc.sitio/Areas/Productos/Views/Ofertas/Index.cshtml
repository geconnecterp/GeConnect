@{
    Layout = "~/views/shared/_Layout.cshtml";
    BusquedaProducto busquedaProducto = new();
}

@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
    <style>
        .ofertas-layout > div { min-width: 0; }
        .ofertas-grid .table-responsive { width: 100%; max-width: 100%; overflow-x: auto; }
        .ofertas-grid table { margin-bottom: 0; }
        .ofertas-grid th { font-size: .875rem !important; padding: .4rem .5rem !important; }
        .ofertas-grid td { font-size: .875rem !important; padding: .35rem .5rem !important; vertical-align: middle; }
        .ofertas-canales table { min-width: 100%; }
        .ofertas-canales th:nth-child(2), .ofertas-canales td:nth-child(2),
        .ofertas-canales th:nth-child(3), .ofertas-canales td:nth-child(3) { text-align: left !important; }
        .ofertas-acciones { gap: .5rem; }
        .ofertas-acciones .btn { min-width: 155px; height: 38px; margin: 0 !important; }
        #btnBusquedaBase, #btnBuscarProd, #btnAgregarSeleccionados, #btnLimpiarSeleccionBusqueda {
            min-width: 120px;
            min-height: 36px;
        }
        @@media (max-width: 991.98px) {
            .ofertas-layout { row-gap: .75rem; }
        }
    </style>
}

<div class="grid-golden mt-1">
    <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-5 col-sm-6">
                <div class="w-100">
                    <partial name="~/areas/ControlComun/views/producto/_ctrBuscarProductoV02.cshtml" model="@busquedaProducto" />
                </div>
            </div>
            <div class="col-md-7 col-sm-6">
               <partial name="_elementosOferta" />         
            </div>
        </div>

    </div>
    <div class="grid-golden-body">
        <div class="row align-items-md-start ofertas-layout g-2">
            <div class="col-lg-8 col-12 ofertas-grid ofertas-productos">
                <div id="gridProductoOferta">
                    <p class="text-center text-muted py-4">
                        <i class="bx bx-info-circle me-2"></i>
                        No hay productos seleccionados para ofertas
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-12 ofertas-grid ofertas-canales">
                <div id="gridCanales"></div>                
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        //funcionalidad busqueda avanzada controlador común
        let productoBase = null; //se hidrata en busquedas.
        let p_id_selected = "";
        let funcionBusquedaAvanzada = true;
        let busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun" })";
        let busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzadaV02", "producto", new { area = "ControlComun" })";

        //parapaginacion
        let totalRegs = 0;
        let pagRegs = 0;
        let pags = 0;
        let pagina = 1;
        let funcCallBack = null;
        var dataBak = {};

        let confirmarAltaOfertaUrl = "@Url.Action("ConfirmacionAltaOferta", "Ofertas", new { area = "Productos" })";
        let presentarProductoOfertaUrl = "@Url.Action("PresentarProductoOferta", "Ofertas", new { area = "Productos" })";
        let buscarCanalesUrl = "@Url.Action("BuscarCanales", "Ofertas", new { area = "Productos" })";
        let obtenerEstadoOfertaProductoUrl = "@Url.Action("ObtenerEstadoOfertaProducto", "Ofertas", new { area = "Productos" })";
                // Agregar al inicio del archivo con las otras URLs
        let presentarProductosOfertaMultipleUrl = "@Url.Action("PresentarProductosOfertaMultiple", "Ofertas", new { area = "Productos" })";
        let quitarProductoOfertaUrl = "@Url.Action("QuitarProductoOferta", "Ofertas", new { area = "Productos" })";
        let buscarMetadataURL = '@Url.Action("ObtenerDatosPaginacion", "ActualizarPP", new { area = "Productos" })';
        let homeOfertaUrl = "@Url.Action("index", "Ofertas", new { area = "Productos" })";

        var buscarFamiliaUrl = "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel01Url = "@Url.Action("BuscarProvs", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel02Url = "@Url.Action("BuscarRubros", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel03Url =  "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "cargaprecios", new { area = "productos" })";/**/
    </script>
    <script src="~/js/plugins/jquery.simplePagination.js"></script>
    <script src="~/js/app/busquedas.js"></script>
    <script src="~/js/app/busquedasV02.js" asp-append-version="true" type="text/javascript"></script>
    <script src="~/js/app/areas/precios/ofertas.js" asp-append-version="true" type="text/javascript"></script>
    

}
