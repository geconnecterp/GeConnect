@{
    Layout = "~/views/shared/_Layout.cshtml";
    BusquedaProducto busquedaProducto = new();
}

@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
}

<div class="grid-golden">
    <div class="grid-golden-header">
        <div class="row align-items-md-center">
            <div class="col-md-5 col-sm-6">
                <partial name="~/areas/ControlComun/views/producto/_ctrBuscarProductoV02.cshtml" model="@busquedaProducto" />             
            </div>
            <div class="col-md-7 col-sm-6">
               <partial name="_elementosOferta" />         
            </div>
        </div>

    </div>
    <div class="grid-golden-body">
        <div class="row align-items-md-center">
            <div class="col-md-8 col-sm-6">
                <div id="gridProductoOferta">
                    <p class="text-center text-muted py-4">
                        <i class="bx bx-info-circle me-2"></i>
                        No hay productos seleccionados para ofertas
                    </p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div id="gridCanales"></div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        //funcionalidad busqueda avanzada controlador común
        let productoBase = null; //se hidrata en busquedas.
        let p_id_selected = "";
        let funcionBusquedaAvanzada = true;
        let busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun" })";
        let busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzada", "producto", new { area = "ControlComun" })";

        //parapaginacion
        let totalRegs = 0;
        let pagRegs = 0;
        let pags = 0;
        let pagina = 1;
        let funcCallBack = null;
        var dataBak = {};

        let presentarProductoOfertaUrl = "@Url.Action("PresentarProductoOferta", "Ofertas", new { area = "Productos" })";
        let buscarCanalesUrl = "@Url.Action("BuscarCanales", "Ofertas", new { area = "Productos" })";
                // Agregar al inicio del archivo con las otras URLs
        let presentarProductosOfertaMultipleUrl = "@Url.Action("PresentarProductosOfertaMultiple", "Ofertas", new { area = "Productos" })";
        let buscarMetadataURL = '@Url.Action("ObtenerDatosPaginacion", "ActualizarPP", new { area = "Productos" })';

    </script>
    <script src="~/js/plugins/jquery.simplePagination.js"></script>
    <script src="~/js/app/busquedasV02.js" type="text/javascript"></script>
    <script src="~/js/app/areas/precios/ofertas.js" type="text/javascript"></script>
    

}