<div id="infoSeleccionCanales" class="card card-golden-subtle mb-2" style="display: none;">
    <div class="card-body p-2">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="bx bx-info-circle text-golden me-1"></i>
                        <small class="fw-medium text-golden">Modo de selección:</small>
                        <span id="modoSeleccion" class="badge bg-golden-light ms-1">No definido</span>
                    </div>
                    <div id="datosCanal" class="ms-3" style="display: none;">
                        <small class="text-muted">
                            <i class="bx bx-store me-1"></i>
                            <span id="canalSeleccionado" class="fw-medium"></span>
                            <span class="mx-1">•</span>
                            <span id="admSeleccionada" class="text-muted"></span>
                            <span class="mx-1">•</span>
                            <span id="lpSeleccionada" class="text-muted"></span>
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <button type="button"
                        id="btnLimpiarSeleccion"
                        class="btn btn-outline-warning btn-sm"
                        title="Limpiar selección de canales">
                    <i class="bx bx-refresh"></i>
                    <span class="d-none d-md-inline">Limpiar</span>
                </button>
            </div>
        </div>
    </div>
</div>