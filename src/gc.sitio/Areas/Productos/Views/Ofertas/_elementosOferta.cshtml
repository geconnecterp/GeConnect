<div class="filter-golden">
    <div class="filter-golden-body">
        <div class="d-flex justify-content-sm-end">
            <div class="row g-2 align-items-center">
                <!-- Campo Precio -->
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="height:31px">Precio:</span>
                        <input type="number"
                               class="form-control input-numeric-golden"
                               id="txtPrecioOferta"
                               placeholder="0,00"
                               step="0.01"
                               min="0"
                               style="width:90px;height:31px"
                               autofocus />
                    </div>
                </div>

                <!-- Periodo Desde -->
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="height:31px">Desde:</span>
                        <input type="date"
                               class="form-control input-numeric-golden"
                               id="txtFechaDesde"
                               style="width:140px;height:31px" />
                    </div>
                </div>

                <!-- Periodo Hasta -->
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="height:31px">Hasta:</span>
                        <input type="date"
                               class="form-control input-numeric-golden"
                               id="txtFechaHasta"
                               style="width:140px;height:31px" />
                    </div>
                </div>

                <!-- Tope de Venta -->
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="height:31px">Tope Vta:</span>
                        <input type="number"
                               class="form-control input-numeric-golden"
                               id="txtTopeVenta"
                               placeholder="0"
                               min="0"
                               step="1"
                               style="width:80px;height:31px" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>