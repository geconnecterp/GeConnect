@model GridCoreSmart<CanalDto>

@{
    var alt = true;
    string clase = string.Empty;
}

<!-- Sección informativa de selección -->
<partial name="_infoSeleccionCanales" />

<div class="card card-golden">
    <div class="card-body p-2">
        <div class="table-responsive text-nowrap table-wrapper-300">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridCanales">
                <thead class="table-golden-header">
                    <tr class="header">
                        <th class="text-center" scope="col">
                            <input type="checkbox" class="form-check-input" id="checkAllCanales" title="Seleccionar todos">
                        </th>
                        <th class="text-center" scope="col">ADM ID</th>
                        <th class="text-center" scope="col">CANAL</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos != null && Model.ListaDatos.Any())
                    {
                        @foreach (var item in Model.ListaDatos)
                        {
                            if (alt) { clase = "table-row-alt"; alt = false; } else { clase = string.Empty; alt = true; }

                            <tr class="@clase canal-seleccionable" style="min-height: 50px; cursor: pointer;"
                                data-adm-id="@item.adm_id"
                                data-lp-id="@item.lp_id"
                                data-canal="@item.canal"
                                data-adm-nombre="@item.adm_nombre" 
                                data-lp-desc="@item.lp_desc">
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input check-canal"
                                           data-adm-id="@item.adm_id"
                                           data-lp-id="@item.lp_id"
                                           data-canal="@item.canal"
                                           data-adm-nombre="@item.adm_nombre"
                                           data-lp-desc="@item.lp_desc"
                                           title="Seleccionar canal"
                                           onclick="event.stopPropagation()">
                                </td>
                                <td class="text-center">
                                    @Model.FormatearDato(item.adm_id, FormatDato.Ninguno)
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-golden-light">@Model.FormatearDato(item.canal, FormatDato.Ninguno)</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="bx bx-info-circle me-2"></i>
                                No hay canales disponibles
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ListaDatos != null && Model.ListaDatos.Any())
        {
            <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                <div class="text-muted small">
                    <i class="bx bx-store me-1"></i>
                    Total: @Model.CantidadReg canales disponibles
                </div>
                <div class="text-muted small">
                    <span id="canalesSeleccionados">0</span> canales seleccionados
                </div>
                <div class="text-muted small">
                    @Model.DatoAux01
                </div>
            </div>
        }
    </div>
</div>