
@{
    Layout = "~/views/shared/_Layout.cshtml";
    var filtro = new QueryFilters() { Modelo = ModeloFilter.ETIQUETA, Rel01 = [], Rel02 = [], Rel03 = [] };
    List<ProductoListaDto> listaVacia = new();
}

@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
    <link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
    <style>
        #divDetalle .etiqueta-grid-card {
            width: 100%;
            max-width: 1100px;
        }

        #tbGridEtiquetaDetalle {
            table-layout: fixed;
        }

        #tbGridEtiquetaDetalle td {
            vertical-align: middle;
        }

        #tbGridEtiquetaDetalle .etiqueta-descripcion {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        #tbGridEtiquetaDetalle .btn-eliminar-etiqueta {
            padding: .15rem .35rem;
            line-height: 1;
        }

        /* En pantallas angostas cada grupo comparte homogéneamente el ancho
           disponible. En móviles pequeños Bootstrap los apila normalmente. */
        @@media (min-width: 576px) and (max-width: 991.98px) {
            .etiqueta-filter-responsive .row > [class*="col-"] {
                flex: 1 1 0;
                width: 0;
                max-width: none;
                min-width: 0;
            }

            .etiqueta-filter-responsive .input-group,
            .etiqueta-filter-responsive select,
            .etiqueta-filter-responsive input,
            .etiqueta-filter-responsive .form-control {
                min-width: 0;
            }
        }
    </style>
}

<partial name="_botonera" model="filtro" />
<div class="collapse" id="divFiltro">
    <partial name="_filtroBase" model="filtro" />
    @Html.Hidden("pagEstado", false)
</div>
<div class="collapse" id="divDetalle"></div>

<div id="modalGestorDocumental"></div>
<partial name="~/areas/controlcomun/views/producto/busquedaadvanceV02.cshtml" model="@listaVacia" />

