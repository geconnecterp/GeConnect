@using gc.infraestructura.Dtos.Productos.Ofertas
@model GridCoreSmart<ComboProductoDto>
@{
    BusquedaProducto busquedaProducto = new();
}
<div class="grid-golden h-100">
    <div class="grid-golden-header promo-subgrid-header">
        <h6 class="mb-0">Productos</h6>
        <button type="button" class="btn btn-sm btn-outline-light promo-subgrid-action" id="btnAgregarCProducto" title="Agregar Producto" disabled>
            <i class="bx bx-plus"></i>
        </button>
        @* <partial name="~/areas/ControlComun/views/producto/_ctrBuscarProductoV02.cshtml" model="@busquedaProducto" /> *@
    </div>
    <div class="grid-golden-body p-1">
        <div class="table-responsive" style="max-height: 300px;">
            <table class="table table-sm table-hover mb-0 table-golden" id="tbGridProductos">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center th-compact">ID</th>
                        <th class="text-left th-compact">Descripción</th>
                        <th class="text-center th-compact">Costo</th>
                        <th class="text-center th-compact">Cantidad</th>
                        <th class="text-center th-compact">Descuento %</th>
                        @* <th class="text-center th-compact">Estado</th> *@
                        <th class="text-center th-compact">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ListaDatos?.Any() == true)
                    {
                        foreach (var item in Model.ListaDatos)
                        {
                            <tr class="@(item.activo == 'D' ? "table-secondary text-muted" : "")"
                                data-producto-id="@item.p_id" data-combo-id="@item.cmb_id" data-up-id="@item.up_id" data-producto-estado="@item.activo">
                                <td class="text-center">
                                    @item.p_id
                                </td>
                                <td class="promo-descripcion" title="@item.p_desc">
                                    @item.p_desc
                                    @if (item.activo == 'D')
                                    {
                                        <span class="badge bg-secondary ms-1">Desactivado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @item.p_pcosto.ToString("N3", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                                </td>
                                <td class="text-end">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-cantidad input-numeric"
                                               value="@(item.cantidad.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("en-US")))"
                                               data-producto-id="@item.p_id"
                                               data-original-value="@item.cantidad"
                                               disabled="@(item.activo == 'D' ? "disabled" : null)"
                                               readonly />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="input-container">
                                        <input type="text" class="form-control form-control-sm input-descuento input-numeric"
                                               value="@(item.dto_porc.ToString("N5", System.Globalization.CultureInfo.GetCultureInfo("en-US")))"
                                               data-producto-id="@item.p_id"
                                               data-original-value="@item.dto_porc"
                                               disabled="@(item.activo == 'D' ? "disabled" : null)"
                                               readonly />
                                    </div>
                                </td>
                                @* <td class="text-center">
                                    <span class="badge @(item.activo == 'A' ? "bg-success" : "bg-danger")">
                                        @(item.activo == 'A' ? "Activo" : "Pendiente")
                                    </span>
                                </td> *@
                                <td class="text-center promo-accion">
                                    @if (item.activo == 'D')
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Producto desactivado" disabled>
                                            <i class="bx bx-block"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-producto"
                                                title="Eliminar producto" data-producto-id="@item.p_id">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>No hay productos disponibles
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Inicialización de campos editables ahora se hace automáticamente desde combo.js
    // Este script solo verifica y asegura que la inicialización se ejecute
    $(function() {
        if (typeof inicializarCamposEditablesProductos === 'function') {
            inicializarCamposEditablesProductos();
        } else {
            console.error("La función inicializarCamposEditablesProductos no está definida");
        }
    });
</script>
