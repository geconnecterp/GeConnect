@using gc.infraestructura.Dtos.Productos.Ofertas
@model GridCoreSmart<ComboProductoDto>
@{
    BusquedaProducto busquedaProducto = new();
}
<div class="card h-100">
    <div class="card-header py-1 d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Productos</h6>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAgregarCProducto" title="Agregar Sustituto" disabled>
            <i class="bx bx-plus"></i>
        </button>
        @* <partial name="~/areas/ControlComun/views/producto/_ctrBuscarProductoV02.cshtml" model="@busquedaProducto" /> *@
    </div>
    <div class="card-body p-1">
        <div class="table-responsive" style="max-height: 250px;">
            <table class="table table-sm table-hover mb-0 table-golden" id="tbGridProductos">
                <thead class="table-golden-header">
                    <tr class="header">
                        <th class="text-center">ID</th>
                        <th class="text-left">Descripción</th>
                        <th class="text-center">Costo</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-center">Descuento %</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ListaDatos?.Any() == true)
                    {
                        foreach (var item in Model.ListaDatos)
                        {
                            <tr data-producto-id="@item.p_id" data-combo-id="@item.cmb_id">
                                <td class="text-center">
                                    @item.p_id
                                </td>
                                <td>
                                    @item.p_desc
                                </td>
                                <td class="text-end">
                                    @item.p_pcosto.ToString("N3")
                                </td>
                                <td class="text-end">
                                    @item.cantidad.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @item.dto_porc.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.activo == 'A' ? "bg-success" : "bg-danger")">
                                        @(item.activo == 'A' ? "Activo" : "Pendiente")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>No hay productos disponibles
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>