@model ComboDatosDto

<div id="divComboDatos" class="card card-sm mb-2" style="display: none;">
    <div class="card-header py-1 d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Datos del Combo</h6>
        @if (Model != null)
        {
            <span class="badge @(Model.pasa_activar ? "bg-success" : "bg-danger")">@(Model.pasa_activar ? "ACTIVADO" : "SIN ACTIVAR")</span>
        }
    </div>
    <div class="card-body p-2">
        <div class="row g-2">
            <div class="col-md-1 col-sm-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">ID</span>
                    <input type="text" class="form-control form-control-sm" id="cmb_id" name="cmb_id" value="@Model?.cmb_id" readonly />
                </div>
            </div>
            
            <div class="col-md-2 col-sm-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Desc.</span>
                    <input type="text" class="form-control form-control-sm" id="cmb_desc" name="cmb_desc" value="@Model?.cmb_desc" readonly />
                </div>
            </div>
            
            <div class="col-md-2 col-sm-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Tipo</span>
                    @Html.DropDownList("cmb_tipo", null, "Seleccionar...", new { @class = "form-select form-select-sm", disabled = "disabled" })
                </div>
            </div>
            
            <div class="col-md-2 col-sm-2">
                <div class="input-group input-group-sm align-items-center">
                    <span class="input-group-text">Estado</span>
                    <div class="form-check form-switch ms-2">
                        <input class="form-check-input" type="checkbox" id="chkEstadoCombo" disabled>
                        <label class="form-check-label ms-1" for="chkEstadoCombo" id="lblEstadoCombo">Activo</label>
                    </div>
                    <input type="hidden" id="cmb_estado" name="cmb_estado" value="@Model?.cmb_estado" />
                </div>
            </div>
            
            <div class="col-md-2 col-sm-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Período</span>
                    <input type="date" class="form-control form-control-sm" id="cmb_desde" name="cmb_desde" value="@(Model?.cmb_desde.ToString("yyyy-MM-dd"))" readonly/>
                    <span class="input-group-text">-</span>
                    <input type="date" class="form-control form-control-sm" id="cmb_hasta" name="cmb_hasta" value="@(Model?.cmb_hasta.ToString("yyyy-MM-dd"))" readonly/>
                </div>
            </div>
        </div>
    </div>
</div>