@using static gc.infraestructura.Constantes.Constantes
@{
    Layout = "~/views/shared/_Layout.cshtml";
    var filtro = new QueryFilters() { Modelo = ModeloFilter.PROMO_COMBO };
}

@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
}

<partial name="_botonera" model="filtro" />
<div class="collapse" id="divFiltro">
    <partial name="_filtroBase" model="filtro" />
    @Html.Hidden("pagEstado", false)
</div>
<div class="collapse" id="divDetalle"></div>

<div id="divTools">
    <div class="row">
        <!-- ComboDatos (20%) -->
        <div class="col-sm-6 mb-2">
            <partial name="_ComboDatos" />
        </div>
        <div class="col-sm-6 mb-2" id="divCanales">
            <!-- Aquí se cargará la vista parcial _gridComboCanales -->
        </div> 
    </div>
    <div class="row">
        <!-- Productos (38%) -->
        <div class="col-sm-6">
            <partial name="_gridProductos" model="new gc.infraestructura.Dtos.Gen.GridCoreSmart<gc.infraestructura.Dtos.Productos.PromoCombo.ComboListaDto>()" />
        </div>
        <!-- Sustitutos (38%) -->
        <div class="col-sm-6">
            <partial name="_gridSustitutos" model="new gc.infraestructura.Dtos.Gen.GridCoreSmart<gc.infraestructura.Dtos.Productos.PromoCombo.ComboListaDto>()" />
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        let totalRegs = 0;
        let pagRegs = 0;
        let pags = 0;
        let pagina = 1;
        let search = "";

        let presentarPromosYCombosUrl = "@Url.Action("presentarPromosYCombos", "promocombo", new { area = "productos" })";
        let obtenerCanalesComboUrl= "@Url.Action("obtenerCanalesCombo", "promocombo", new { area = "productos" })";
        let obtenerComboPorIdUrl = "@Url.Action("obtenerComboPorId", "promocombo", new { area = "productos" })";

        let homeCombo = "@Url.Action("index", "promocombo", new { area = "productos" })";
        let buscarMetadataURL= "@Url.Action("ObtenerDatosPaginacion", "promocombo", new { area = "productos" })";
    </script>
    <script src="~/js/plugins/jquery.simplePagination.js"></script>
    <script src="~/js/app/areas/precios/combo.js"></script>
}