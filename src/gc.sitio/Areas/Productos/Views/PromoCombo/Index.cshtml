@using static gc.infraestructura.Constantes.Constantes
@{
    Layout = "~/views/shared/_Layout.cshtml";
    var filtro = new QueryFilters() { Modelo = ModeloFilter.PROMO_COMBO, Rel03 = null };
    List<ProductoListaDto> listaVacia = new();
}

@section styles {
    <link rel="stylesheet" href="~/css/simplePagination.css" />
    <style>
        #promoComboApp .promo-filtros .input-group-text { min-width: 74px; justify-content: center; }
        #promoComboApp .promo-filtros .form-select { min-width: 190px; }
        #promoComboApp .promo-grid-detalle { min-height: 320px; }
        #promoComboApp .promo-subgrid-header {
            height: 40px;
            min-height: 40px;
            padding: .25rem .75rem !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #fff;
        }
        #promoComboApp .promo-subgrid-header h6 {
            color: #fff !important;
            font-weight: 700;
            text-shadow: 0 1px 1px rgba(0, 0, 0, .25);
        }
        #promoComboApp .promo-subgrid-header label { color: #fff; }
        #promoComboApp .promo-subgrid-action {
            width: 28px;
            height: 28px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            border-color: rgba(255, 255, 255, .85);
        }
        #promoComboApp .promo-subgrid-action:hover {
            color: #8b6914;
            background-color: #fff;
            border-color: #fff;
        }
        #promoComboApp .promo-subgrid-action:disabled {
            color: #fff;
            border-color: rgba(255, 255, 255, .55);
            opacity: .55;
        }
        #promoComboApp .table-golden th,
        #promoComboApp .table-golden td { padding: .3rem .4rem; vertical-align: middle; font-size: .82rem; }
        #promoComboApp .promo-descripcion { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        #promoComboApp .promo-accion { width: 54px; }
        #promoComboApp #divComboDatos .input-group-text { font-weight: 600; }
        #promoComboApp #cmb_tipo { font-weight: 700; }
        #promoComboApp #cmb_desde,
        #promoComboApp #cmb_hasta { min-width: 138px; }
        #promoComboApp .selectedEdit-row > td { background-color: #f8d7da !important; }
        @@media (max-width: 991.98px) {
            #promoComboApp .promo-grid-detalle { min-height: auto; margin-bottom: .75rem; }
        }
    </style>
}

<div id="promoComboApp">
    <partial name="_botonera" model="filtro" />
    <div class="collapse promo-filtros" id="divFiltro">
        <partial name="_filtroBase" model="filtro" />
        @Html.Hidden("pagEstado", false)
    </div>
    <div class="collapse" id="divDetalle"></div>

    <div id="divTools">
        <div class="row mb-2">
            <div class="col-12">
                <partial name="_ComboDatos" />
            </div>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-12 col-lg-3 promo-grid-detalle" id="divCanales">
                <!-- Aquí se cargará la vista parcial _gridComboCanales -->
            </div>
            <div class="col-12 col-lg-5 promo-grid-detalle" id="colComboProducto">
                <div id="divComboProducto" style="display:none;">
                    <partial name="_gridProductos" model="new GridCoreSmart<ComboProductoDto>()" />
                </div>
            </div>
            <div class="col-12 col-lg-4 promo-grid-detalle" id="colComboSustituto">
                <div id="divComboSustituto" style="display:none;">
                    <partial name="_gridSustitutos" model="new GridCoreSmart<ComboSustitutoDto>()" />
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="~/areas/controlcomun/views/producto/busquedaadvanceV02.cshtml" model="@listaVacia" />

@section Scripts {
    <script type="text/javascript">
        let totalRegs = 0;
        let pagRegs = 0;
        let pags = 0;
        let pagina = 1;
        let search = "";

        let presentarPromosYCombosUrl = "@Url.Action("presentarPromosYCombos", "promocombo", new { area = "productos" })";
        let obtenerCanalesComboUrl= "@Url.Action("obtenerCanalesCombo", "promocombo", new { area = "productos" })";
        let obtenerComboPorIdUrl = "@Url.Action("obtenerComboPorId", "promocombo", new { area = "productos" })";
        let obtenerProductosDeComboUrl = "@Url.Action("ObtenerProductosDeCombo", "promocombo", new { area = "productos" })";
        let obtenerProductosSustitutosUrl = "@Url.Action("ObtenerProductosSustitutos", "promocombo", new { area = "productos" })";
        let resguardarRelacionProductoSustitutoUrl = "@Url.Action("ResguardarRelacionProductoSustituto", "promocombo", new { area = "productos" })";
        let retornarProductosSustitutosUrl = "@Url.Action("RetornarProductosSustitutos", "promocombo", new { area = "productos" })";
        let confirmacionComboUrl = "@Url.Action("ConfirmacionCombo", "promocombo", new { area = "productos" })";
        let eliminarSustitutoUrl = "@Url.Action("EliminarSustituto", "promocombo", new { area = "productos" })";
        let limpiarSustitutosTemporalesUrl = "@Url.Action("LimpiarSustitutosTemporales", "promocombo", new { area = "productos" })";
        let obtenerPreajustePromoUrl = "@Url.Action("ObtenerPreajustePromo", "promocombo", new { area = "productos" })";

        let homeCombo = "@Url.Action("index", "promocombo", new { area = "productos" })";
        let buscarMetadataURL= "@Url.Action("ObtenerDatosPaginacion", "promocombo", new { area = "productos" })";

        //var buscarFamiliaUrl = "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "cargaprecios", new { area = "productos" })";/**/
        var autoComRel01Url = "@Url.Action("BuscarProvs", "PromoCombo", new { area = "productos" })";/**/
        var autoComRel02Url = "@Url.Action("BuscarRubros", "PromoCombo", new { area = "productos" })";/**/
        var autoComRel03Url =  "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "cargaprecios", new { area = "productos" })";/**/

        //funcionalidad busqueda avanzada controlador común
        let productoBase = null; //se hidrata en busquedas.
        let p_id_selected = "";
        let funcionBusquedaAvanzada = true;
        let busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun" })";
        let busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzadaV02", "producto", new { area = "ControlComun" })";
    </script>
    <script src="~/js/plugins/jquery.simplePagination.js"></script>
    <script src="~/js/app/busquedasV02.js" type="text/javascript"></script>
    <script src="~/js/app/areas/precios/combo.js" asp-append-version="true"></script>
}
