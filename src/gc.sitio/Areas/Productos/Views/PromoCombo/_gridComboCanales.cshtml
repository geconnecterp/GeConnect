@using gc.infraestructura.Dtos.Productos.PromoCombo
@model gc.infraestructura.Dtos.Gen.GridCoreSmart<ComboCanalDto>

<div class="card h-100">
    <div class="card-header py-1">
        <h6 class="mb-0">Canales del Combo</h6>
    </div>
    <div class="card-body p-1">
        <div class="table-responsive" style="max-height: 300px;">
            <table class="table table-sm table-hover mb-0 table-golden" id="tbGridCanales">
                <thead class="table-golden-header">
                    <tr class="header">
@*                         <th class="text-left">Administración</th>
                        <th class="text-left">Lista de Precios</th> *@
                        <th class="text-center">Canal</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ListaDatos?.Any() == true)
                    {
                        foreach (var item in Model.ListaDatos)
                        {
                            <tr>
@*                                 <td class="text-left">
                                    @item.adm_nombre
                                    <small class="text-muted d-block">@item.adm_id</small>
                                </td>
                                <td class="text-left">
                                    @item.lp_desc
                                </td> *@
                                <td class="text-center">
                                    @item.canal
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.incluida == 'S' ? "bg-success" : "bg-secondary")">
                                        @(item.incluida == 'S' ? "Incluido" : "No incluido")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-2">
                                <i class="bx bx-info-circle me-1"></i>No hay canales disponibles para este combo
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>