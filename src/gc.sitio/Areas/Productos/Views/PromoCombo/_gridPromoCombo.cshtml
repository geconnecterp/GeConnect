@using gc.infraestructura.Dtos.Productos.PromoCombo
@model GridCoreSmart<ComboListaDto>

@{
    var alt = true;
    string clase = string.Empty;
}

<div class="grid-golden">
    <div class="grid-golden-body p-2">
        <div id="divPromoCombo" class="table-responsive text-nowrap table-wrapper" style="max-height:500px;">
            <table class="table table-sm mb-0 table-hover table-golden" id="tbGridPromoCombo">
                <thead class="sticky-top table-golden-header-compact">
                    <tr class="header">
                        <th class="text-center th-compact" scope="col">ID</th>
                        <th class="text-left th-compact" scope="col">DESCRIPCIÓN</th>
                        <th class="text-center th-compact" scope="col">TIPO</th>
                        <th class="text-center th-compact" scope="col">ESTADO</th>
                        <th class="text-center th-compact" scope="col">DESDE</th>
                        <th class="text-center th-compact" scope="col">HASTA</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaDatos?.Any() == true)
                    {
                        @foreach (var item in Model.ListaDatos)
                        {
                            alt = !alt;
                            clase = alt ? string.Empty : "alt";

                            var estadoClass = item.cmb_estado == 'A' ? "bg-success" :
                            (item.cmb_estado == 'H' ? "bg-danger" : "bg-warning");

                            <tr class="@clase" 
                                data-combo-id="@item.cmb_id" 
                                data-descripcion="@item.cmb_desc">
                                <td class="@Model.ObtenerClase(item.cmb_id)">
                                    @Model.FormatearDato(item.cmb_id, FormatDato.Ninguno)
                                </td>
                                <td class="@Model.ObtenerClase(item.cmb_desc)" title="@item.cmb_desc">
                                    @Model.FormatearDato(item.cmb_desc, FormatDato.Ninguno)
                                </td>
                                <td class="text-center" data-tipo-id="@item.cmb_tipo">
                                    <span class="badge bg-info">
                                        @Model.FormatearDato(item.cmb_tipo_desc, FormatDato.Ninguno)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @estadoClass" data-estado-id="@item.cmb_estado">
                                        @Model.FormatearDato(item.cmb_estados_desc, FormatDato.Ninguno)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @Model.FormatearDato(item.cmb_desde, FormatDato.FechaHora)
                                </td>
                                <td class="text-center">
                                    @Model.FormatearDato(item.cmb_hasta, FormatDato.FechaHora)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bx bx-info-circle me-2"></i>
                                No hay promociones o combos disponibles con los filtros seleccionados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

     
    
    </div>
</div>

<div class="row">
    <div class="offset-md-3 col-md-6">
        <div id="divPaginacion">
        </div>
    </div>
</div>