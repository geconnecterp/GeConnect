@using Newtonsoft.Json
@{
    Layout = "~/views/shared/_Layout.cshtml";
    var filtro = new QueryFilters() { Modelo = ModeloFilter.OF_REPORTE };
    var indicePrint = JsonConvert.SerializeObject(ViewBag.ImpresionId ?? Array.Empty<int>());
}

@section styles {
    <link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<partial name="_botonera" model="filtro" />
<div class="collapse" id="divFiltro">
    <partial name="_filtroBase" model="filtro" />
    @Html.Hidden("pagEstado", false)
</div>
<div class="collapse" id="divDetalle"></div>
<div id="modalGestorDocumental"></div>

@section scripts {
    <script type="text/javascript">
         //variables de inicialización

         var admId = "0000";
         var lpId = "001";
         var canal = "SANTA LUCIA - MAYORISTA";

         var estado = {
             canalSeleccionado: null,
             cacheDom: {}, // Cache de elementos DOM frecuentes
             rbRepo: 0,
             report:@Html.Raw(indicePrint),
             cmbEstado: 'A',
             cmbId:'%',
             cmbFecha:"2020-01-01"
         }

         var homeOfertaRepoUrl ="@Url.Action("index", "Ofertareport", new { area = "Productos" })";    
         var presentarOfertasActivasUrl = "@Url.Action("PresentarOfertasActivas", "OfertaActiva", new { area = "Productos" })";
        var presentarCombosActivosUrl = "@Url.Action("ObtenerCombosRepo", "promocombo", new { area = "Productos" })";

         let buscarMetadataURL = '@Url.Action("ObtenerDatosPaginacion", "Presupuesto", new { area = "Productos" })';

         //para imprimir
         let indexPrint = parseInt("@indicePrint");
         var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
         var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
         var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
         var enviarEmailUrl =  "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
         var enviarWhatsAppUrl =  "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";

    </script>

    <script src="~/lib/jstree/jstree.min.js"></script>
    <script src="~/js/plugins/jquery.simplePagination.js"></script>
    <script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>

    <script src="~/js/app/areas/precios/ofertaReport.js"></script>
}