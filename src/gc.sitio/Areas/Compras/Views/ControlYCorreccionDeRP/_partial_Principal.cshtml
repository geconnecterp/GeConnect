@using gc.sitio.Areas.Compras.Models.ControlYCorreccionDeRP
@model InitDetalleDeRecepcionModel
@{
}
<style>
    .btn-cambiar-comp,
    .btn-confirmar-control,
    .btn-cancelar-control {
        width: 175px;
        min-width: 175px;
        font-weight: 600;
        color: white !important;
    }

</style>
<div class="row">

    <div class="col-6">

        <div>
            Proveedor: <strong>@Model.Proveedor</strong>
        </div>

        <div>
            Recepción: <strong>@Model.Recepcion</strong>
        </div>

    </div>

    <div class="col-6">

        <div class="d-flex justify-content-end gap-2">

            <button id="btnCambiarTipoComp"
                    type="button"
                    class="btn btn-sm btn-info btn-cambiar-comp">
                <i class="bx bx-link-alt"></i>
                Cambiar Tipo Comp.
            </button>

            <button id="btnConfirmarControl"
                    type="button"
                    class="btn btn-sm btn-success btn-confirmar-control">
                <i class="bx bx-check-circle"></i>
                Confirmar Control
            </button>

            <button id="btnCancelarControl"
                    type="button"
                    class="btn btn-sm btn-danger btn-cancelar-control">
                <i class="bx bx-x-circle"></i>
                Cancelar
            </button>

        </div>

    </div>

</div>

<div class="row">
    @await Html.PartialAsync("_tbDetalle", Model)
</div>

@*Modal para cargar IVA discriminado o NO discriminado*@
<div class="modal fade modal-golden in" id="modalAgregarProducto" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-x" role="document">
        <div class="modal-content">
            <div id="divAgregarProducto">
            </div>
        </div>
    </div>
</div>