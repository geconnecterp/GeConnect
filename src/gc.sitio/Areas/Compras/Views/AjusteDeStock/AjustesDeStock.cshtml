@model AjusteDeStockDto
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var depositos = Model.ComboDepositos;
	var boxes = Model.ComboBoxes;
	var motivos = Model.ComboMotivos;
	BusquedaProducto busquedaProducto = new();
	var alt = true;
	string clase = string.Empty;
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css"   />
}
<style>

	.filter-golden-body {
		padding: 0 !important;
	}

</style>
<div class="card">
	<div class="container">
		<div class="row">
			<div class="col-4" style="padding-top: 8px;">
				<div class="row">
					<fieldset style="margin: 2px;padding: 2px;">
						<div class="col-5" style="float:left;">
							<div class="d-flex flex-column gap-3">
								<div class="form-check">
									<input class="form-check-input" type="radio" name="btnradio" id="btnradioManual" checked>
									<label class="form-check-label" for="btnradioManual">Manual</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="btnradio" id="btnradioRevertirAjuste">
									<label class="form-check-label" for="btnradioRevertirAjuste">Revertir Ajuste</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="btnradio" id="btnradioCargaPrevia">
									<label class="form-check-label" for="btnradioCargaPrevia">Carga Previa</label>
								</div>
							</div>
							@* <div class="btn-group" role="group" aria-label="Basic radio toggle button group" style="width: 95%;">
								<row style="padding:4px; width: 100% !important">
									<input type="radio" class="btn-check" name="btnradio" id="btnradioManual" checked="">
									<label class="btn btn btn-outline-primary fixed-font-size-xmall" for="btnradioManual">Manual</label>
									<div style="height: 5px;"></div>
									<input type="radio" class="btn-check" name="btnradio" id="btnradioRevertirAjuste">
									<label class="btn btn btn-outline-primary fixed-font-size-xmall" for="btnradioRevertirAjuste">Revertir Ajuste</label>
									<div style="height: 5px;"></div>
									<input type="radio" class="btn-check" name="btnradio" id="btnradioCargaPrevia">
									<label class="btn btn btn-outline-primary fixed-font-size-xmall" for="btnradioCargaPrevia">Carga Previa</label>
								</row>
							</div> *@
						</div>
						<div class="col-7" style="float:left;">
							<div class="row" style="min-height: 37px;">
							</div>
							<div class="row">
								<div class="input-group" id="divRevertirAjuste">
									<span class="input-group-text fixed-width-75" style="height:35px;">N°: </span>
									<input type="text" id="txtNroAjuste" class="align-left" style="width: 50%;" value="" />
									<button type="button" class="btn btn-sm btn-primary btn-sm me-1" style="margin-left:5px;" id="btnRevertirAjuste">
										<i class="bx bx-chevron-left"></i>
									</button>
								</div>
							</div>
							<div class="row" style="padding-top:4px;padding-left:7px;" id="divCargaPrevia">
								<button type="button" class="btn btn-info btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnCargaPrevia">
									<i class="bx bx-upload"></i> Carga Previa
								</button>
							</div>
						</div>
					</fieldset>
				</div>
			</div>
			<div class="col-8" style="padding-top: 8px;">
				<div class="row">
					<div class="col-6">
						<div class="col-sm" id="divDepositos">
							<div class="input-group input-group-sm fixed-padding-top">
								<span class="input-group-text fixed-width">Depósito: </span>
								@Html.DropDownList("id", depositos, "Seleccionar...", new { @id = "listaDeposito", @class = "form-control activable inputEditable" })
							</div>
						</div>
						<div id="divComboBoxes">
							<div class="col-sm" id="divComboBox" aria-disabled="true">
								<div class="input-group input-group-sm fixed-padding-top">
									<span class="input-group-text fixed-width">Box: </span>
									@Html.DropDownList("id", boxes, "Seleccionar...", new { @id = "listaBox", @class = "form-control activable inputEditable" })
								</div>
							</div>
						</div>
					</div>
					<div class="col-6">
						<div class="col-sm" id="divComboMotivos">
							<div class="input-group input-group-sm fixed-padding-top">
								<span class="input-group-text fixed-width">Tipo: </span>
								@Html.DropDownList("id", motivos, "Seleccionar...", new { @id = "listaMotivo", @class = "form-control activable inputEditable" })
							</div>
						</div>
						<div class="input-group input-group-sm" style="padding-top: 5px;">
							<span class="input-group-text fixed-width-75">Nota: </span>
							<input type="text" id="txtNota" class="form-control activable inputEditable" style="width: 80%;" value="" />
						</div>
					</div>
				</div>
				<div class="row" style="padding-top: 5px;">
					@* botones *@
					<div style="text-align: right;align-content: center;">
@* 						<button type="button" class="btn btn-secondary btn-sm mt-1 me-1" id="btnRegresar">
							<i class="bx bx-chevron-left"></i> Regresar
						</button> *@
						<button type="button" class="btn btn-success btn-sm mt-1 me-1" id="btnConfirmar">
							<i class="bx bx-badge-check"></i> Confirmar
						</button>
						<button type="button" class="btn btn-danger btn-sm mt-1 me-1" id="btnCancelar">
							<i class="bx bx-x-circle"></i> Cancelar
						</button>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<fieldset style="margin: 2px;padding: 2px;">
				<legend>
					<h5>Detalle de Productos a Ajustar</h5>
				</legend>
				<div class="row">
					<div class="row col-12">
						<div class="col-2" style="padding-right: 0px;">
							<partial name="~/areas/ControlComun/views/producto/_ctrBuscarProducto.cshtml" model="@busquedaProducto" />
						</div>
						<div class="col-8" style="padding-right: 0px;padding-left: 0px;width: 66%;">
							<div class="input-group input-group-sm">
								<span class="input-group-text">ID: </span>
								<input type="text" id="txtIdProd" class="form-control" style="width:10%;display: none;" readonly />
								<input type="text" id="txtProDescripcion" class="form-control" style="width: 30%;" readonly />
								<span class="input-group-text">UP: </span>
								<input type="text" id="txtUP" class="form-control activable inputEditable" />
								<span class="input-group-text">Bto: </span>
								<input type="number" id="txtBto" class="form-control activable inputEditable" min="0" />
								<span class="input-group-text">Unid: </span>
								<input type="text" id="txtUnid" class="form-control activable inputEditable" />
								<input type="text" id="txtUP_ID" style="display:none;" />
								<input type="text" id="txtBARRADO_ID" style="display:none;" />
								<input type="text" id="txtID_PROV" style="display:none;" />
							</div>
							@* <div class="input-group input-group-sm">
								<span style="display: none;" class="input-group-text">ID: </span>
								<input type="text" id="txtIdProd" class="form-control" style="width:10%;display: none;" readonly />
								<input type="text" id="txtProDescripcion" class="form-control" style="width: 33%;" readonly />
								<span class="input-group-text" style="width:5%;">UP: </span>
								<input type="text" id="txtUP" class="form-control align-right" style="width:10%;" />
								<span class="input-group-text" style="width:5%;">Bto: </span>
								<input type="number" id="txtBto" class="form-control align-right" min="0" style="width:10%;" />
								<span class="input-group-text" style="width:5%;">Unid: </span>
								<input type="text" id="txtUnid" class="form-control align-right" style="width:25%;" value="0" />
								<input type="text" id="txtUP_ID" style="display:none;" />
								<input type="text" id="txtBARRADO_ID" style="display:none;" />
								<input type="text" id="txtID_PROV" style="display:none;" />
							</div> *@
							@* <div class="mt-2 d-flex gap-2">
								<button type="button" class="btn btn-primary btn-sm" id="btnAddProd">
									<i class="bx bx-plus-circle"></i> Agregar Producto
								</button>
								<button type="button" class="btn btn-danger btn-sm" id="btnDelProd">
									<i class="bx bx-trash"></i> Quitar Producto
								</button>
							</div> *@
						</div>
						<div class="col-2" style="padding-left: 55px;">
							<button type="button" class="btn btn-primary btn-sm" id="btnAddProd" title="Agregar Producto">
								<i class="bx bx-plus-circle"></i> Agregar
							</button>
							<button type="button" class="btn btn-danger btn-sm" id="btnDelProd" title="Quitar Producto">
								<i class="bx bx-trash"></i> Quitar
							</button>
						</div>
					</div>
					<div id="divDetalleDeProductosAAjustar" style="padding-top:5px;">
						<div class="table-responsive table-wrapper-full-width">
							<table class="table table-bordered table-hover table-golden" id="tbDetalleDeProductosAAjustar">
								<thead>
									<tr class="header">
										<th style="width:5%;" class="col-header-small align-center">ID</th>
										<th style="width:20%;" class="col-header-small align-center">Descripción</th>
										<th style="width:5%;" class="col-header-small align-center">Cod. Prov</th>
										<th style="width:5%;" class="col-header-small align-center">Box</th>
										<th style="width:5%;" class="col-header-small align-center">Stk Actual</th>
										<th style="width:5%;" class="col-header-small align-center">Ajuste</th>
										<th style="width:5%;" class="col-header-small align-center">Stock Ajustado</th>
									</tr>
								</thead>
								<tbody>
									@if (Model != null && Model.ProductosAAjustar != null && Model.ProductosAAjustar.ListaDatos != null && Model.ProductosAAjustar.ListaDatos.Count > 0)
									{
										@foreach (var item in Model.ProductosAAjustar.ListaDatos)
										{
											if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
											<tr class="@clase" onclick="selectListaProductoRow(this)">
												<td class="align-center">@item.p_id</td>
												<td class="align-left">@item.p_desc</td>
												<td class="align-center">@item.p_id_prov</td>
												<td class="align-center">@item.box_desc</td>
												<td class="align-center">@item.as_stock</td>
												<td class="align-right">@item.as_ajuste</td>
												<td class="align-right">@item.as_resultado</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</fieldset>
		</div>
	</div>
</div>
<div class="modal fade modal-golden" id="modalCargaPrevia" tabindex="-1" style="display: none;" aria-hidden="true">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<div id="divModalCargaPrevia">
			</div>
		</div>
	</div>
</div>
@section scripts {
	<script type="text/javascript">
		var tipoMotivoSeleccionado = "";
		var pIdSeleccionado = "";
		var funcionBusquedaAvanzada = true;
		//parapaginacion
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var funcCallBack = null;
		var dataBak = {};
		var buscarProveedorUrl = "@Url.Action("Buscar", "proveedor", new { area = "ControlComun" })";
		var busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun", validarPertenenciaDeProveedor = false })";
		var BuscarBoxesDesdeDepositoURL = "@Url.Action("ObtenerBoxesDesdeDeposito", "ajustedestock", new { area = "Compras" })";
		var ObtenerDatosModalCargaPreviaUrl = "@Url.Action("ObtenerDatosModalCargaPrevia", "ajustedestock", new { area = "Compras" })";
		var ObtenerBoxesDesdeDepositoDesdeCargaPreviaURL = "@Url.Action("ObtenerBoxesDesdeDepositoDesdeCargaPrevia", "ajustedestock", new { area = "Compras" })";
		var ObtenerProductosDesdeAJRevertidoURL = "@Url.Action("ObtenerProductosDesdeAJRevertido", "ajustedestock", new { area = "Compras" })";
		var ValidarNroDeAjusteARevertirURL = "@Url.Action("ValidarNroDeAjusteARevertir", "ajustedestock", new { area = "Compras" })";
		var FiltrarProductosModalCargaPreviaURL = "@Url.Action("FiltrarProductosModalCargaPrevia", "ajustedestock", new { area = "Compras" })";
		var ActaulizarListaProductosDesdeModalCargaPreviaURL = "@Url.Action("ActaulizarListaProductosDesdeModalCargaPrevia", "ajustedestock", new { area = "Compras" })";
		var QuitarProductoDeListaURL = "@Url.Action("QuitarProductoDeLista", "ajustedestock", new { area = "Compras" })";
		var AgregarProductoAListaURL = "@Url.Action("AgregarProductoALista", "ajustedestock", new { area = "Compras" })";
		var ConfirmarAjusteDeStockURL = "@Url.Action("ConfirmarAjusteDeStock", "ajustedestock", new { area = "Compras" })";
		var VerificaExistenciaDeAjusteDeStockURL = "@Url.Action("VerificaExistenciaDeAjusteDeStock", "ajustedestock", new { area = "Compras" })";
		var CancelarAjusteDeStockURL = "@Url.Action("CancelarAjusteDeStock", "ajustedestock", new { area = "Compras" })";
		var autoComRel01Url = "@Url.Action("BuscarProvs", "abmproducto", new { area = "abms" })";
		var autoComRel02Url = "@Url.Action("BuscarRubros", "abmproducto", new { area = "abms" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "abmproducto", new { area = "abms" })";
		var busquedaAvanzadaUrl = "@Url.Action("BusquedaAvanzada", "producto", new { area = "ControlComun" })";

		window.addEventListener("DOMContentLoaded", function() {
		  document.getElementById("Busqueda").style.width = "100px";
		});
	</script>
	<script src="~/js/app/areas/ajustedestock/ajdestk.js"></script>
	<script src="~/js/app/busquedas.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/infoRpr.js" type="text/javascript"></script>
	<script src="~/js/plugins/jquery.simplePagination.js"></script>
}