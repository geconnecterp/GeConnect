@model GridCoreSmart<ProductoAAjustarDto>;
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#containerDetalleDeProductosAAjustar {
		position: relative;
		height: 600px;
		max-height: 600px;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbDetalleDeProductosAAjustar th,
	#tbDetalleDeProductosAAjustar td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbDetalleDeProductosAAjustar tr {
		height: 1.6rem !important;
	}

</style>
<div class="table-responsive table-wrapper-full-width" id="containerDetalleDeProductosAAjustar">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbDetalleDeProductosAAjustar">
		<thead>
			<tr class="header">
				<th style="width:5%;" class="col-header-small align-center">ID</th>
				<th style="width:20%;" class="col-header-small align-center">Descripción</th>
				<th style="width:5%;" class="col-header-small align-center">Cod. Prov</th>
				<th style="width:10%;" class="col-header-small align-center">Box</th>
				<th style="width:5%;" class="col-header-small align-center">Stk Actual</th>
				<th style="width:5%;" class="col-header-small align-center">Ajuste</th>
				<th style="width:5%;" class="col-header-small align-center">Stock Ajustado</th>
				<th style="width:2%;"></th>
				<th style="width:0%; display:none;">as_motivo</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectListaProductoRow(this)">
						<td class="align-center">@item.p_id</td>
						<td class="align-left">@item.p_desc</td>
						<td class="align-center">@item.p_id_prov</td>
						<td class="align-center">@item.box_desc</td>
						<td class="align-right">@GridHelper.FormatearDato(item.as_stock, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="align-right">@GridHelper.FormatearDato(item.as_ajuste, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="align-right">@GridHelper.FormatearDato(item.as_resultado, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="text-center align-middle">
							<button type="button" class="btn btn-danger btn-icon-compact" title="Rechazar" onclick="quitarProducto('@item.p_id')">
								<i class="bx bx-trash"></i>
							</button>
						</td>
						<td style="display:none;">@item.as_motivo</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>