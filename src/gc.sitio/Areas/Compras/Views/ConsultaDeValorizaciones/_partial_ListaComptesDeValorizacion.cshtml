@model ListaComprobantesDeValorizacionModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#containerListaComptesDeValorizacion {
		max-height: 700px;
		overflow-y: auto;
	}

	#tbListaComptesDeValorizacion thead th {
		position: sticky;
		top: 0;
		z-index: 10;
		/* Estilo Golden */
		background: linear-gradient(to bottom, #b8860b, #daa520);
		color: #fff;
		/* Opcional: mantener bordes */
		border-color: #a67c00;
	}
</style>
<div class="grid-golden" style="padding-left: 0px; padding-right: 0px;">
	<div class="grid-golden-header">
		<div class="row align-items-md-center">
			<div class="col-md-10 col-sm-6 d-flex align-items-center">
				<h5 class="mb-0 flex-grow-1">
					<i class="bx bx-package me-2"></i>
					<strong>Comprobantes</strong>
				</h5>
			</div>
		</div>
	</div>
	<div class="grid-golden-body">
		<div class="table-responsive table-wrapper-700-full-width" id="containerListaComptesDeValorizacion">
			<table class="table table-bordered table-hover table-golden" id="tbListaComptesDeValorizacion">
				<thead>
					<tr class="header">
						<th style="width:20%;" class="align-center">Comprobante</th>
						<th style="width:10%;" class="align-center">No Grabado</th>
						<th style="width:10%;" class="align-center">Exento</th>
						<th style="width:10%;" class="align-center">Grabado</th>
						<th style="width:10%;" class="align-center">IVA</th>
						<th style="width:10%;" class="align-center">II</th>
						<th style="width:10%;" class="align-center" title="Percepciones">Percep.</th>
						<th style="width:10%;" class="align-center" title="Otros No Grabados">Otros NG</th>
						<th style="width:10%;" class="align-center">Total</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Grilla != null && Model.Grilla.ListaDatos != null && Model.Grilla.ListaDatos.Count > 0)
					{
						@foreach (var item in Model.Grilla.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							<tr class="@clase"
								data-cta-id="@item.cta_id"
								data-tco-id="@item.tco_id"
								data-cm-compte="@item.cm_compte"
								data-dia-movi="@item.dia_movi"
								onclick="selectCompteDeValorizacion(this)"
								ondblclick="dblClickCompteDeValorizacion(this)">
								<td class="@Model.Grilla.ObtenerClase(item.comprobante)">@Model.Grilla.FormatearDato(item.comprobante, FormatDato.Ninguno)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_no_gravado)">@GridHelper.FormatearDato(item.cm_no_gravado, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_exento)">@GridHelper.FormatearDato(item.cm_exento, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_gravado)">@GridHelper.FormatearDato(item.cm_gravado, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_iva)">@GridHelper.FormatearDato(item.cm_iva, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_ii)">@GridHelper.FormatearDato(item.cm_ii, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_percepciones)">@GridHelper.FormatearDato(item.cm_percepciones, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_otro_ng)">@GridHelper.FormatearDato(item.cm_otro_ng, FormatDato.Monto, true)</td>
								<td class="@Model.Grilla.ObtenerClase(item.cm_total)">@GridHelper.FormatearDato(item.cm_total, FormatDato.Monto, true)</td>
							</tr>
						}
					}
					else
					{
						<tr class="fila-vacia">
							<td colspan="9" class="text-center text-muted py-2">
								<i class="bx bx-info-circle me-1"></i>
								No hay items para mostrar.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

