@model InitConsultaDeValorizacionesModel
@{
}
<style>
    .ancho-cont {
		padding-left: 10px;
		padding-right: 10px;
	}
</style>
<div class="row">
    <div class="col-6">
        <div>
            Proveedor: <strong>@Model.Proveedor</strong>
			Rango: <strong>@Model.RangoDeFechas</strong>
        </div>
    </div>
</div>

<div class="row">
	<div class="container-fluid min-vh-100 d-flex flex-column ancho-cont">
		<div class="d-flex align-items-center w-100 mt-2">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsConsultaValorizaciones">
				<li class="nav-item" role="presentation" id="tabComprobantes">
					<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-compte" aria-controls="navs-top-compte" aria-selected="true" id="btnTabComprobantes">
						Comprobantes
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabDetalle">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-det" aria-controls="navs-top-det" aria-selected="false" tabindex="-1" id="btnTabDetalle">
						Detalle
					</button>
				</li>
			</ul>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-compte" role="tabpanel">
				<div class="row">
					<div class="col-3" id="divValorizaciones">
					</div>
					<div class="col-9" id="divComprobantes">
					</div>
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-det" role="tabpanel">
				<div id="divDetalleRpr">
				</div>
			</div>
		</div>
	</div>
</div>
