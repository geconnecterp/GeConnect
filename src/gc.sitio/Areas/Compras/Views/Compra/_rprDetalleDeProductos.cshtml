@model GridCoreSmart<ProductoBusquedaDto>
@{
	var alt = true;
	string clase = string.Empty;
}

<div class="table-responsive text-nowrap table-wrapper-400-full-width">
	<table class="drageable-table table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbDetalleDeProd">
		<thead>
			<tr class="header">
				<th scope="col" class="table-fontsize align-center" style="width:5%;">ID</th>
				<th scope="col" class="table-fontsize align-center" style="width:45%">Descripción</th>
				<th scope="col" class="table-fontsize align-center" style="width:10%">ID Prov</th>
				<th scope="col" class="table-fontsize align-center" style="width:10%">OC</th>
				<th scope="col" class="table-fontsize align-center" style="width:5%">UP</th>
				<th scope="col" class="table-fontsize align-center" style="width:5%">Btos</th>
				<th scope="col" class="table-fontsize align-center" style="width:10%">Unidades</th>
				<th scope="col" class="table-fontsize align-center" style="width:10%">Cantidad</th>
				<th style="width:0%; display:none;">Item</th>
				<th style="width:0.1%;" class="col-header-small align-center tiny-row"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var resCantidad = string.Format(CultureInfo.InvariantCulture, "{0:#,0.000}", @item.Cantidad);
					var resUnidad = string.Format(CultureInfo.InvariantCulture, "{0:#,0.000}", @item.Unidad);
					<tr class="@clase sortme" onclick="selectDetalleDeProdRow(this)" id="productRow">
						<td class="table-fontsize align-center tiny-row">@item.P_id</td>
						<td class="table-fontsize align-left tiny-row">@item.P_desc</td>
						<td class="table-fontsize align-center tiny-row">@item.P_id_prov</td>
						<td class="table-fontsize align-center tiny-row">@item.oc_compte</td>
						<td class="table-fontsize align-right tiny-row">@item.P_unidad_pres</td>
						<td class="table-fontsize align-right tiny-row">@item.Bulto</td>
						<td class="table-fontsize align-right tiny-row">@GridHelper.FormatearDato(item.Unidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="table-fontsize align-right tiny-row">@GridHelper.FormatearDato(item.Cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td style="display:none;">@item.Item</td>
						<td style="padding-left:2px;padding-right:2px;"><a class="btn btn-xs btn-outline-danger" data-interaction="@item.P_id" onclick="quitarProductoDelDetalle(this);" title="Eliminar producto (@item.P_id)"> <i class="bx bxs-trash"></i></a></td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
