@model GridCoreSmart<RPRItemVerCompteDto>
@{
	var alt = true;
	string clase = string.Empty;
}

<div class="table-responsive text-nowrap table-wrapper">
	<table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbDetalleVerConteoSeleccionado">
		<thead>
			<tr class="header">
				<th scope="col" class="table-fontsize align-center" style="width:25%;">Comprobante</th>
				<th scope="col" class="table-fontsize align-center" style="width:25%;">Facturado</th>
				<th scope="col" class="table-fontsize align-center" style="width:25%;">Conteo</th>
				<th scope="col" class="table-fontsize align-center" style="width:25%;">No Recibido</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectDetalleVerConteoSeleccionado(this)">
						<td class="table-fontsize align-center">@item.Cm_compte</td>
						<td class="table-fontsize align-right">@item.Cantidad_c</td>
						<td class="table-fontsize align-right">@item.Cantidad</td>
						<td class="table-fontsize align-right">@item.No_recibido</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>