@model GridCoreSmart<RPROrdenDeCompraDetalleDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}
</style>
<div class="table-responsive text-nowrap table-wrapper-300">
	<table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbDetalleDeOC">
		<thead>
			<tr class="header">
				<th><input name="select_all" value="1" type="checkbox"></th>
				<th scope="col" class="table-fontsize align-center" style="width:10%;">ID</th>
				<th scope="col" class="table-fontsize align-center" style="width:30%;" title="Descripción">Desc.</th>
				<th scope="col" class="table-fontsize align-center" style="width:10%;">ID Prov</th>
				<th scope="col" class="table-fontsize align-center" style="width:8%;" title="Unidades por Bulto">UxB</th>
				<th scope="col" class="table-fontsize align-center" style="width:8%;" title="Bultos">Btos</th>
				<th scope="col" class="table-fontsize align-center" style="width:12%;" title="Unidades">Uds.</th>
				<th scope="col" class="table-fontsize align-center" style="width:12%;" title="Cantidad">Cant.</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var nombre = "chk" + item.p_id;
					<tr class="@clase" onclick="selectOCDetalleRow(this)">
						<td><input type="checkbox" name=@nombre /></td>
						<td class="table-fontsize align-center tiny-row">@item.p_id</td>
						<td class="table-fontsize align-left tiny-row">@item.p_desc</td>
						<td class="table-fontsize align-center tiny-row">@item.p_id_prov</td>
						<td class="table-fontsize align-right tiny-row">@item.ocd_unidad_x_bulto</td>
						<td class="table-fontsize align-right tiny-row">@item.ocd_bultos</td>
						<td class="table-fontsize align-right tiny-row">@item.ocd_unidad_pres</td>
						<td class="table-fontsize align-right tiny-row">@GridHelper.FormatearDato(item.ocd_cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>