@model BuscarCuentaDto
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var depositos = Model.ComboDeposito;
}

<style>
	.btn-abm-rpr {
		min-width: 180px;
		width: 180px;
	}

	.btn-comp-rpr {
		min-width: 180px;
		width: 180px;
	}
</style>

<div class="container-fluid min-vh-100 d-flex flex-column">

	@Html.Hidden("CtaId", Model.Cuenta)
	@Html.Hidden("Cuenta", Model.Cuenta)
	@Html.Hidden("IdTipoCompte", Model.IdTipoCompte)
	@Html.Hidden("NroCompte", Model.NroCompte)
	@Html.Hidden("DepoId", Model.Depo_id)
	@Html.Hidden("Rp", Model.rp)
	@Html.Hidden("FechaTurno", Model.FechaTurno)

	<div class="row">
		<div class="col-2"></div>
		<div class="col-8">
			<div class="card mt-3 mb-3">
				<div class="card-header fw-bold">
					@Model.TituloVista
				</div>
				<div class="card-body p-3">
					<div class="card mb-3">
						<div class="card-header d-flex justify-content-between align-items-center">
							<span class="fw-bold">Autorización</span>

							<div>
								<button type="button" class="btn btn-success btn-sm me-1 btn-abm-rpr" id="btnAceptarAutoRP">
									<i class="bx bx-check-circle"></i> Guardar Autorización RP
								</button>
								<button type="button" class="btn btn-danger btn-sm me-1 btn-abm-rpr" id="btnEliminarAutoRP">
									<i class="bx bx-trash"></i> Eliminar Autorización RP
								</button>
								<button type="button" class="btn btn-secondary btn-sm me-1 btn-abm-rpr" id="btnRegresarASelAuto">
									<i class="bx bx-chevron-left"></i> Volver
								</button>
							</div>
						</div>
						<div class="card-body p-2">
							@if (Model.Cuenta != "")
							{
								<div class="d-flex flex-wrap gap-4 mb-2">
									<div><strong>Cuenta:</strong> @Model.Cuenta</div>
									<div><strong>Denominación:</strong> @Model.Cuenta_Denominacion</div>
								</div>
							}
							else
							{
								<div class="row mb-2">
									<div class="col-md-12" id="divLs01">
										<div class="input-group  input-group-sm">
											<span class="input-group-text">Cuenta</span>
											<input type="text" class="form-control inputEditable" name="Rel01" id="Rel01" />
											@Html.Hidden("Rel01Item")
										</div>
									</div>
									<div class="col-md-6 col-sm-6" hidden>
										@Html.ListBox("Rel01List", null, new { @class = "form-control", @disabled = "disabled" })
									</div>
								</div>
							}
							<div class="row mb-2">
								<div class="col-sm-8">
									<div class="input-group input-group-sm mb-3">
										<span class="input-group-text">Nota Autorización:</span>
										<input type="text" id="txtNota" class="form-control activable inputEditable" asp-for="@Model.Nota" />
									</div>
								</div>
								<div class="col-sm-4">
									<div class="input-group input-group-sm">
										<span class="input-group-text">Cantidad de UL (pallet):</span>
										<input type="number" id="txtCantidadUL" class="form-control activable inputEditable" asp-for="@Model.CantidadUL" min="1" max="999" />
									</div>
								</div>
							</div>
							<div class="row mb-2">
								<div class="col-sm">
									<div class="input-group input-group-sm">
										<span class="input-group-text">Depósito:</span>
										@Html.DropDownList("id", depositos, "Seleccionar...", new { @id = "listaDeposito", @class = "form-control activable inputEditable" })
									</div>
								</div>
								<div class="col-sm">
									<div class="input-group input-group-sm">
										<span class="input-group-text">Turno:</span>
										<input type="date" id="dtpFechaTurno" class="form-control activable inputEditable" />
									</div>
								</div>
								<div class="col-sm d-flex align-items-center">
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="chkPonerEnCurso" checked>
										<label class="form-check-label">Poner en Curso</label>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card">
						<div class="card-header d-flex justify-content-between align-items-center">
							<span class="fw-bold">Comprobantes de RP</span>
							<div>
								<button type="button" class="btn btn-primary btn-sm me-1 btn-comp-rpr" id="btnNuevoCompteDeRP">
									<i class="bx bx-plus-circle"></i> Agregar comprobante
								</button>
								<button type="button" class="btn btn-danger btn-sm me-1 btn-comp-rpr" id="btnEliminarCompteDeRP">
									<i class="bx bx-trash"></i> Eliminar comprobante
								</button>
								<button type="button" class="btn btn-info btn-sm me-1 btn-comp-rpr" id="VerDetalle">
									<i class="bx bx-show"></i> Ver Detalle
								</button>
							</div>
						</div>
						<div class="card-body p-2">
							<div class="row mb-3">
								<div class="col-md-12">
									<div class="input-group input-group-sm">
										<span class="input-group-text">Tipo:</span>
										<div id="divTiposComptes" class="input-group input-group-sm" style="width: 35%;"></div>

										<span class="input-group-text">N°:</span>
										<input type="text" id="NroComprobantePtoVta" class="form-control activable" style="max-width:50px; font-weight:700;" />
										<span class="input-group-text">-</span>
										<input type="text" id="NroComprobanteNumero" class="form-control activable" style="max-width:78px; font-weight:700;" />

										<span class="input-group-text">Fecha:</span>
										<input type="date" id="dtpFechCompte" class="form-control activable inputEditable" />

										<span class="input-group-text">Monto:</span>
										<input type="text" id="txtMonto" class="form-control activable inputEditable" />
									</div>
								</div>
							</div>
							<div id="divComptesDeRPGrid" class="mt-2">
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-2"></div>
	</div>
</div>

<div class="modal fade modal-golden" id="modalCC" tabindex="-1" style="display: none;" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalCenterTitle">Búsqueda de Cuentas Comerciales</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="row">
					<div class="col-12">
						<div class="input-group">
							<button type="button" class="btn btn-icon btn-outline-primary" id="btnBuscarCC" title="Buscar cuenta comercial">
								<span class="tf-icons bx bx-search"></span>
							</button>
							<div class="autocomplete" style="width:300px;">
								<input type="text" class="form-control" style="max-width: 500px;" id="razonSocialEnModalDeBusqueda" />
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive table-wrapper fixed-padding-top">
					<table class="table table-bordered table-hover" id="tbCuentasComerciales">
						<thead class="table-dark">
							<tr class="header">
								<th scope="col" class="table-fontsize align-center" style="width:20%;">ID</th>
								<th scope="col" class="table-fontsize align-center" style="width:50%">Razón Social</th>
								<th scope="col" class="table-fontsize align-center" style="width:20%">N° Doc</th>
								<th scope="col" class="table-fontsize align-center" style="width:10%">TC</th>
								<th style="width:0%; display:none;">prov_id</th>
							</tr>
						</thead>
						<tbody>
						</tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
					Cerrar
				</button>
				<button type="button" class="btn btn-primary" onclick="seleccionarCuentaComercial();">Seleccionar</button>
			</div>
		</div>
	</div>
</div>


@section scripts {
	<script type="text/javascript">
		var linkVerDetalle = "";
		var modelObj = @Html.Raw(Json.Serialize(Model));
		var tipoCuenta = "B";
		var seccionEnVista = "#sectionNuevaAutorizacionRP";
		var vistaParcial = "_rprAutoCargaComptes";
		var idCuentaSeleccionada = "";
		var razonSocialSeleccionada = "";
		var provIdSeleccionado = "";
		var CargarComptesDeRPUrl = "@Url.Action("CargarComprobantesDeRP", "compra", new { area = "Compras" })";
		var ActualizarComptesDeRPUrl = "@Url.Action("ActualizarComprobantesDeRP", "compra", new { area = "Compras" })";
		var verificarDetalleCargadoURL = "@Url.Action("VerificarDetalleCargado", "compra", new { area = "Compras" })";
		var VerDetalleDeCompteDeRPUrl = "@Url.Action("VerDetalleDeComprobanteDeRP", "compra", new { area = "Compras" })";
		var GuardarDetalleDeComprobanteRPUrl = "@Url.Action("GuardarDetalleDeComprobanteRP", "compra", new { area = "Compras" })";
		var buscarCuentaUrl = "@Url.Action("BuscarCuentaComercial", "compra", new { area = "Compras" })";
		var buscarTiposComptesUrl = "@Url.Action("ComboTiposComptes", "compra", new { area = "Compras" })";
		var volverAListaDeAutorizacionesUrl = "@Url.Action("RPRAutorizacionesLista", "compra", new { area = "Compras" })";
		var eliminarComprobanteRPRUrl = "@Url.Action("RPREliminarComprobante", "compra", new { area = "Compras" })";
		var ActualizarCuentaComercialSeleccionadaUrl = "@Url.Action("ActualizarCuentaComercialSeleccionada", "compra", new { area = "Compras" })";
		var autoComRel01Url = "@Url.Action("BuscarProvs", "cargaprecios", new { area = "productos" })";/**/
	</script>
	<script src="~/js/app/controlcomun/busquedacuentacomercial.js"></script>
	@* <script src="~/js/app/areas/compras/_rprComprobantesDeRP.js"></script> *@
}