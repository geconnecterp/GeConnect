@using static gc.infraestructura.Constantes.Constantes
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var filtro = new QueryFilters()
	{
		Rel01 = new List<string>(),
		//Rel02 = new List<string>(),
		Rel03 = new List<ComboGenDto>(),
		Modelo = ModeloFilter.ORDEN_DE_PAGO_CONSULTA,
	};
}

@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<div class="container">
	<div class="row">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>

				<button class="btn btn-primary btn-sm mt-1 me-1" type="button" id="btnDetalle" data-bs-toggle="collapse" data-bs-target="#divDetalle" aria-expanded="true" aria-controls="divDetalle">
					<i class="bx bx-caret-down"></i>
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtroBase" model="filtro" />
		@Html.Hidden("pagEstado", false);
	</div>
	<div class="collapse" id="divDetalle" style="">
		<ul class="nav nav-tabs nav-tabs-golden mt-2" role="tablist" id="tabsConsultaDeOP">
			<li class="nav-item" role="presentation" id="tabOrdenesDePago">
				<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabOrdenesDePago">
					Ordenes de Pago
				</button>
			</li>
			<li class="nav-item" role="presentation" id="tabDetalleDeOP">
				<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabDetalleDeOP">
					Detalle
				</button>
			</li>
		</ul>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div id="divOrdenesDePago">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div id="divDetalleDeOP">
				</div>
			</div>
		</div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var opIdSeleccionado = "";
		var impIdSeleccionado = "";
		var funcCallBack = "BuscarOrdenesDePago";
		var autoComRel01Url = "@Url.Action("BuscarProvs", "ordendepagoconsulta", new { area = "Compras" })";
		var autoComRel03Url = "@Url.Action("BuscarTipos", "ordendepagoconsulta", new { area = "Compras" })";
		var autoComRel02Url = "@Url.Action("BuscarUsuarios", "ordendepagoconsulta", new { area = "Compras" })";
		var buscarOrdenesDePagoURL = "@Url.Action("BuscarOrdenesDePago", "ordendepagoconsulta", new { area = "Compras" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "ordendepagoconsulta", new { area = "Compras" })";
		var actualizarListaDeUsuariosOPURL = "@Url.Action("ActualizarListaDeUsuariosOP", "ordendepagoconsulta", new { area = "Compras" })";
		var actualizarListaDeUsuariosURL = "@Url.Action("ActualizarListaDeUsuarios", "ordendepagoconsulta", new { area = "Compras" })";
		var actualizarListaDeTiposURL = "@Url.Action("ActualizarListaDeTipos", "ordendepagoconsulta", new { area = "Compras" })";
		var consultarExistenciaDeCertificadosURL = "@Url.Action("ConsultarExistenciaDeCertificados", "ordendepagoconsulta", new { area = "Compras" })";
		var cargarListaTiposCertificadosURL = "@Url.Action("CargarListaTiposCertificados", "ordendepagoconsulta", new { area = "Compras" })";
		var anularOrdenDePagoURL = "@Url.Action("AnularOrdenDePago", "ordendepagoconsulta", new { area = "Compras" })";
		var inicializarDatosEnSesionURL = "@Url.Action("InicializarDatosEnSesion", "ordendepagoconsulta", new { area = "Compras" })";
		var anularCertificadoDeOrdenDePagoURL = "@Url.Action("AnularCertificadoDeOrdenDePago", "ordendepagoconsulta", new { area = "Compras" })";
		var setearTipoDeReporteUrl = "@Url.Action("SetearTipoDeReporte", "ordendepagoconsulta", new { area = "Compras" })";
		var validarExistenciaDeCertificadosParaImprimirURL = "@Url.Action("ValidarExistenciaDeCertificadosParaImprimir", "ordendepagoconsulta", new { area = "Compras" })";

		// Detalle de OP (Extracto de ConsCuenta)
		var consultarOPProvDetUrl = "@Url.Action("ConsultaOPagoProveedorDetalle", "ConsCuenta", new { area = "Consultas" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>
	<script src="~/js/app/areas/ordendepago/odepagoconsulta.js"></script>
}