@model ListaTiposModel
@{
    var tipos = Model.ListaTipos;
}
<div class="input-group input-group-sm">
    <span class="input-group-text">Nombre</span>
    @Html.DropDownListFor(m => m.id, tipos, "Seleccionar", new { @id = "listaTipo", disabled = "disabled", @class = "form-control inputEditable activable" })
</div>
