@using static gc.infraestructura.Helpers.GridHelper
@model ConsultaOPModel
@{
	var lista = Model.ListaTipoCertificado;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}
</style>
<div class="row">
	<div class="col-md-10">
		<div id="divListaOP">
			<div class="table-responsive table-wrapper-full-width" id="containerListaOP">
				<table class="table table-bordered table-hover" id="tbListaOP">
					<thead class="table-dark">
						<tr>
							<th style="width:10%;" class="col-header-small align-center tiny-row">N° OP</th>
							<th style="width:20%;" class="col-header-small align-center tiny-row">Tipo</th>
							<th style="width:5%;" class="col-header-small align-center tiny-row">Fecha</th>
							<th style="width:30%;" class="col-header-small align-center tiny-row">Proveedor</th>
							<th style="width:5%;" class="col-header-small align-center tiny-row">Anulada</th>
							<th style="width:15%;" class="col-header-small align-center tiny-row">Usuario</th>
							<th style="width:10%;" class="col-header-small align-center tiny-row">Importe</th>
							<th style="width:5%;" class="col-header-small align-center tiny-row">Imprimir Det</th>
							<th style="width:0%; display:none;">usu_id</th>
							<th style="width:0%; display:none;">cta_id</th>
							<th style="width:0%; display:none;">opt_id</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null && Model.GrillaOP != null && Model.GrillaOP.ListaDatos != null)
						{
							@foreach (var item in Model.GrillaOP.ListaDatos)
							{
								var nombre = "chkImpreso" + item.op_compte;
								<tr onclick="selectListaOPRow(this)">
									<td class="tiny-row align-center">@item.op_compte</td>
									<td class="tiny-row @Model.GrillaOP.ObtenerClase(item.opt_desc)">@Model.GrillaOP.FormatearDato(item.opt_desc, FormatDato.Ninguno)</td>
									<td class="tiny-row @Model.GrillaOP.ObtenerClase(item.op_fecha)">@Model.GrillaOP.FormatearDato(item.op_fecha, FormatDato.Fecha)</td>
									<td class="tiny-row @Model.GrillaOP.ObtenerClase(item.cta_denominacion)">@Model.GrillaOP.FormatearDato(item.cta_denominacion, FormatDato.Ninguno)</td>
									<td class="tiny-row align-center">@Model.GrillaOP.FormatearDato(item.op_anulada_desc, FormatDato.Fecha)</td>
									<td class="tiny-row @Model.GrillaOP.ObtenerClase(item.usu_apellidoynombre)">@Model.GrillaOP.FormatearDato(item.usu_apellidoynombre, FormatDato.Ninguno)</td>
									<td class="tiny-row @Model.GrillaOP.ObtenerClase(item.op_importe)">@Model.GrillaOP.FormatearDato(item.op_importe, FormatDato.Monto)</td>
									@if (item.op_impreso_bool)
									{
										<td class="@Model.GrillaOP.ObtenerClase(item.op_impreso_bool)"><input type="checkbox" class="chkImpreso" name=@nombre id="@nombre" checked /></td>
									}
									else
									{
										<td class="@Model.GrillaOP.ObtenerClase(item.op_impreso_bool)"><input type="checkbox" class="chkImpreso" name=@nombre id="@nombre" /></td>
									}
									<td style="display:none;">@item.usu_id</td>
									<td style="display:none;">@item.cta_id</td>
									<td style="display:none;">@item.opt_id</td>
								</tr>
							}
						}
					</tbody>
				</table>
				<div class="row">
					<div class="offset-md-3 col-md-6">
						<div id="divPaginacion" class="">
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-8">
			</div>
			<div class="col-4">
				<div class="input-group input-group-sm mt-1">
					<span class="input-group-text fixed-lbl-for-abm-100">Totales: </span>
					<input type="text" asp-for="Importe" class="form-control" style="text-align: right;" disabled />
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-2">
		<div class="row">
			<button type="button" class="btn btn-sm btn-primary" style="margin-left:5px; width:88%;" id="btnImprimirLista">
				<div class="row" style="display: contents">
					<div class="col-2">
						<span class="tf-icons bx bx-check-circle"></span>
					</div>
					<div class="col-10" style="font-size: medium;">
						Imprimir Lista
					</div>
				</div>
			</button>
		</div>
		<div class="row mt-1">
			<button type="button" class="btn btn-sm btn-primary" style="margin-left:5px; width:88%;" id="btnImprimirOP">
				<div class="row" style="display: contents">
					<div class="col-2">
						<span class="tf-icons bx bx-x-circle"></span>
					</div>
					<div class="col-10" style="font-size: medium;">
						Imprimir OP Sele
					</div>
				</div>
			</button>
		</div>
		<div class="row mt-1">
			<button type="button" class="btn btn-sm btn-primary" style="margin-left:5px; width:88%;" id="btnAnularOP">
				<div class="row" style="display: contents">
					<div class="col-2">
						<span class="tf-icons bx bx-eraser"></span>
					</div>
					<div class="col-10" style="font-size: medium;">
						Anular OP
					</div>
				</div>
			</button>
		</div>
		<div class="row mt-1">
			<button type="button" class="btn btn-sm btn-primary" style="margin-left:5px; width:88%;" id="btnAnularCertRet">
				<div class="row" style="display: contents">
					<div class="col-2">
						<span class="tf-icons bx bx-eraser"></span>
					</div>
					<div class="col-10" style="font-size: medium;">
						Anular Cert. Ret.
					</div>
				</div>
			</button>
		</div>
		<input type="hidden" asp-for="MostrarListaTipoCertificado" class="form-control activable inputEditable" />
		<div class="row mt-1" id="divListaCert">
		</div>
		@if (Model != null && Model.MostrarListaTipoCertificado)
		{
			<div class="input-group input-group-sm" style="margin-left: -8px;">
				@Html.DropDownListFor(m => m.ListaTipoCertificado.First().Value, lista, "Seleccionar...", new { @id = "listaTipoCert", @class = "form-control activable" })
			</div>
		}
	</div>
</div>