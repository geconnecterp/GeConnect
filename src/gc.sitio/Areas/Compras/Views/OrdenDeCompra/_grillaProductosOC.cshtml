@using static gc.infraestructura.Helpers.GridHelper
@model ProductoParaOcModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>

	thead th {
		position: sticky;
		top: 0px;
		z-index: 1;
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		overflow-y: auto;
		position: relative; 
	}

	.th-descripcion {
		position: relative;
		text-align: center;
		vertical-align: middle;
		width: 25%;
	}

		.th-descripcion .th-title {
			display: inline-block;
		}

	.btn-info-producto {
		position: absolute;
		right: 4px; 
		top: 50%;
		transform: translateY(-50%);
		background: transparent !important;
		border: none !important;
		padding: 0;
		color: #fff;
		cursor: pointer;
	}

		.btn-info-producto i {
			font-size: 1rem;
			line-height: 1;
		}

</style>
<div class="table-responsive text-nowrap table-wrapper" id="containerListaProductoOC">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProductoOC">
		<thead>
			<tr class="header">
				<th scope="col" class="check-column">
					<div class="check-producto-container">
						<input class="form-check-input" type="checkbox" id="checkAllProd" title="Seleccionar todos">
					</div>
				</th>
				<th scope="col" title="Código de Producto">Código</th>
				<th class="th-descripcion">
					<span class="th-title">Descripción</span>
					<button type="button"
							class="btn btn-info-producto"
							data-action="info-producto"
							title="Abrir info de producto">
						<i class="bx bx-info-circle"></i>
					</button>
				</th>
				<th scope="col">Barrado</th>
				<th scope="col" title="Código de Proveedor">Cod. Prov</th>
				<th scope="col" title="Unidad de Presentación">U.P.</th>
				<th scope="col" title="Pedido Bultos">Pedido Bultos</th>
				<th scope="col" title="Pedido Cantidad">Pedido Cantidad</th>
				<th scope="col" class="text-end">Precio Lista</th>
				<th scope="col">D1</th>
				<th scope="col">D2</th>
				<th scope="col">D3</th>
				<th scope="col">D4</th>
				<th scope="col">DPA</th>
				<th scope="col">Boni</th>
				<th scope="col" title="Pedido +Bonificaciones">Pedido +Boni</th>
				<th scope="col" title="Precio de Costo" class="text-end">Precio Costo</th>
				<th scope="col" title="Total Costo" class="text-end">Total Costo</th>
				<th scope="col" title="Total en Pallet">Total Pallet</th>
				<th scope="col"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaOC != null && Model.ListaOC.ListaDatos != null)
			{
				@foreach (var item in Model.ListaOC.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var nombre = "chk" + item.p_id;
					var nombre_Bultos = "bultos_" + item.p_id;
					var nombre_P_Plista = "p_plista_" + item.p_id;
					var nombre_P_Dto1 = "p_dto1_" + item.p_id;
					var nombre_P_Dto2 = "p_dto2_" + item.p_id;
					var nombre_P_Dto3 = "p_dto3_" + item.p_id;
					var nombre_P_Dto4 = "p_dto4_" + item.p_id;
					var nombre_P_Dto_Pa = "p_dto_pa_" + item.p_id;
					var nombre_P_Boni = "p_boni_" + item.p_id;
					<tr class="@clase" data-p-id="@item.p_id" onclick="selectListaProductoRowOC(this, 'tbListaProductoOC')">
						<td class="check-column">
							<div class="check-producto-container">
								<input type="checkbox" class="form-check-input check-producto" data-p-id="@item.p_id">
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_id) align-center">@Model.ListaOC.FormatearDato(item.p_id, FormatDato.Ninguno)</td> 
						<td class="@Model.ListaOC.ObtenerClase(item.p_desc)" title="@Model.ListaOC.FormatearDato(item.p_desc, FormatDato.Ninguno)">
							@Model.ListaOC.FormatearDato(item.p_desc, FormatDato.Ninguno)
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_id_barrado) align-center">@Model.ListaOC.FormatearDato(item.p_id_barrado, FormatDato.Ninguno)</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_id_prov) align-center">@Model.ListaOC.FormatearDato(item.p_id_prov, FormatDato.Ninguno)</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_unidad_pres) align-right">@Model.ListaOC.FormatearDato(item.p_unidad_pres, FormatDato.Ninguno)</td>
						<td class="@Model.ListaOC.ObtenerClase(item.bultos)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-bultos input-numeric"
									   value="@(item.bultos.ToString())"
									   data-p-id="@item.p_id"
									   data-field="bultos"
									   data-original-value="@(item.bultos)" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.cantidad) align-right">@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_plista)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_plista input-numeric"
									   value="@(item.p_plista.ToString("F3"))"
									   data-p-id="@item.p_id"
									   data-field="p_plista"
									   data-original-value="@(item.p_plista)" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_dto1)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto1 input-numeric"
									   value="@(item.p_dto1.ToString("F1"))"
									   data-p-id="@item.p_id"
									   data-field="p_dto1"
									   data-original-value="@item.p_dto1" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_dto2)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto2 input-numeric"
									   value="@(item.p_dto2.ToString("F1"))"
									   data-p-id="@item.p_id"
									   data-field="p_dto2"
									   data-original-value="@item.p_dto2" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_dto3)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto3 input-numeric"
									   value="@(item.p_dto3.ToString("F1"))"
									   data-p-id="@item.p_id"
									   data-field="p_dto3"
									   data-original-value="@item.p_dto3" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_dto4)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto4 input-numeric"
									   value="@(item.p_dto4.ToString("F1"))"
									   data-p-id="@item.p_id"
									   data-field="p_dto4"
									   data-original-value="@item.p_dto4" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_dto_pa)">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto_pa input-numeric"
									   value="@(item.p_dto_pa.ToString("F1"))"
									   data-p-id="@item.p_id"
									   data-field="p_dto_pa"
									   data-original-value="@item.p_dto_pa" />
							</div>
						</td>
						@{
							bool resBoni = item.p_boni?.Trim().Equals("0") ?? false;
							string bonificacionMostrada = resBoni ? "" : Model.ListaOC.FormatearDato(item.p_boni, FormatDato.Ninguno);
						}
						<td class="@Model.ListaOC.ObtenerClase('c')">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_boni"
									   value="@bonificacionMostrada"
									   data-p-id="@item.p_id"
									   data-field="p_boni"
									   data-original-value="@bonificacionMostrada"
									   placeholder="000/000" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.pedido_mas_boni)  align-right">@GridHelper.FormatearDato(item.pedido_mas_boni, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td> @*16*@
						@*<td class="@Model.ListaOC.ObtenerClase(item.p_pcosto)">@Model.ListaOC.FormatearDato(item.p_pcosto, FormatDato.Monto)</td> 17 revisar el formato*@ 
						<td class="@Model.ListaOC.ObtenerClase(item.p_pcosto)">@GridHelper.FormatearPrecio(item.p_pcosto, TipoPrecio.Costo)</td>
						<td class="@Model.ListaOC.ObtenerClase(item.p_pcosto_total)">@GridHelper.FormatearPrecio(item.p_pcosto_total, TipoPrecio.Costo)</td> @*18*@
						<td class="@Model.ListaOC.ObtenerClase(item.paletizado)">@item.paletizado.ToString("0.##")</td> @*19*@
						<td class="text-center">
							<a class="btn btn-xs btn-danger" data-interaction="@item.p_id" onclick="quitarProductoEnOC(this);">
								<i class="bx bxs-trash" style="line-height: 1.0;font-size: 1rem;"></i>
							</a>
						</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="20" class="text-center">No se han encontrado productos para los criterios especificados.</td>
				</tr>
			}
		</tbody>
	</table>
</div>
<div class="row">
	<div class="col-7">
	</div>
	<div class="col-5" style="padding-right: 60px;padding-left: 110px;">
		<div class="input-group input-group-sm mt-1">
			<span class="input-group-text fixed-lbl-for-abm-60">Totales: </span>
			<input type="text" asp-for="Cant_Items" class="form-control" style="text-align: right;" disabled title="Cantidad de Productos"/>
			<input type="text" asp-for="Precio_Costo" class="form-control" style="text-align: right;" disabled />
			<input type="text" asp-for="Total_Costo" class="form-control" style="text-align: right;max-width: 105px;width: 105px;" disabled />
			<input type="text" asp-for="Total_Pallet" class="form-control" style="text-align: right;width: 70px;max-width: 70px;" disabled title="Total Palletizado" />
		</div>
	</div>
</div>
<div class="row mb-1">
	<div class="col-4">
	</div>
	<div class="col-8">
		<div class="input-group input-group-sm mt-1">
			<span class="input-group-text fixed-lbl-for-abm-50">Dto1: </span>
			<input type="text" asp-for="Dto1" class="form-control" style="text-align: right;"/>
			<span class="input-group-text fixed-lbl-for-abm-50">Dto2: </span>
			<input type="text" asp-for="Dto2" class="form-control" style="text-align: right;"/>
			<span class="input-group-text fixed-lbl-for-abm-50">Dto3: </span>
			<input type="text" asp-for="Dto3" class="form-control" style="text-align: right;"/>
			<span class="input-group-text fixed-lbl-for-abm-50">Dto4: </span>
			<input type="text" asp-for="Dto4" class="form-control" style="text-align: right;"/>
			<span class="input-group-text fixed-lbl-for-abm-50">DPA: </span>
			<input type="text" asp-for="Dpa" class="form-control" style="text-align: right;"/>
			<button id="btnAplicar" class="btn btn-success btn-sm" style="margin-left:5px;margin-right: 5px;" type="button" title="Aplicar" onclick="AplicarSeteoMasivo();">
				<i class="bx bx-check-double"></i>
			</button>
			<div class="form-check form-check-inline form-switch" style="margin: 5px;">
				<input class="form-check-input" type="checkbox" name="FleteAPagar" id="chkFleteAPagar" />
				<label class="form-check-label" for="chkFleteAPagar">Flete a Pagar %</label>
			</div>
			<input type="text" asp-for="Flete" class="form-control" style="text-align: right;"/>
		</div>
	</div>
</div>

<script>
	$(function() {
			$('.campo-modificado').each(function() {
				if ($(this).parent('.input-container').find('.indicador-cambio').length === 0) {
					$(this).parent('.input-container').append('<div class="indicador-cambio"></div>');
				}
			});

			$("#checkAllProd").on("change", function() {
				const isChecked = $(this).prop("checked");
				$(".check-producto").prop("checked", isChecked);

				$("#tbListaProductoOC tbody tr:not(.table-secondary)").each(function() {
					$(this).toggleClass("selected", isChecked);
				});

				if (isChecked) {
					const primerProductoId = $("#tbListaProductoOC tbody tr:not(.table-secondary):first").data("p-id");
					if (primerProductoId && typeof destacarFilaSeleccionada === 'function') {
						destacarFilaSeleccionada(primerProductoId);
					}
				}
			});

			$(document).on("change", ".check-producto", function(e) {
				e.stopPropagation();

				const $checkbox = $(this);
				const isChecked = $checkbox.prop("checked");
				const $row = $checkbox.closest("tr");

				$row.toggleClass("selected", isChecked);

				if (!isChecked) {
					$("#checkAllProd").prop("checked", false);
				} else {
					const totalCheckboxes = $(".check-producto").length;
					const totalChecked = $(".check-producto:checked").length;
					$("#checkAllProd").prop("checked", totalCheckboxes === totalChecked);

					const productoId = $row.data("p-id");
					if (productoId && typeof destacarFilaSeleccionada === 'function') {
						destacarFilaSeleccionada(productoId);
					}
				}
			});

			window.obtenerProductosSeleccionados = function() {
				const productosSeleccionados = [];
				$(".check-producto:checked").each(function() {
					const productoId = $(this).data("p-id");
					if (productoId) {
						productosSeleccionados.push(productoId);
					}
				});
				return productosSeleccionados;
			};

			window.obtenerFilasGrillaOCModificadas = function () {
				const filas = new Set();

				$(".campo-modificado").each(function () {
					const fila = $(this).closest("tr");
					if (fila.length) {
						filas.add(fila[0]);
					}
				});

				return Array.from(filas);
			};

		});
</script>