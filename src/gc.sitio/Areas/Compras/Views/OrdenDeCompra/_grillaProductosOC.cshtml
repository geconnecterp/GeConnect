@using static gc.infraestructura.Helpers.GridHelper
@model ProductoParaOcModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
	position: sticky;
	top: 0px;
	}
</style>
<div class="table-responsive text-nowrap table-wrapper" id="containerListaProductoOC">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProductoOC">
		<thead>
			<tr class="header">
				@* <th><input name="select_all" value="1" type="checkbox"></th> *@
				<th scope="col" class="check-column">
					<div class="check-producto-container">
						<input class="form-check-input" type="checkbox" id="checkAllProd" title="Seleccionar todos">
					</div>
				</th>
				<th scope="col">Código</th>
				<th scope="col">Descripción</th>
				<th scope="col">Cod. Prov</th>
				<th scope="col">Stock Suc</th>
				<th scope="col">Stock Tot</th>
				<th scope="col" title="Unidad de Presentación">Unidad Pres.</th>
				<th scope="col" title="Pedido Bultos">Pedido Bultos</th>
				<th scope="col" title="Pedido Cantidad">Pedido Cantidad</th>
				<th scope="col" class="text-end">Precio Lista</th>
				<th scope="col">D1</th>
				<th scope="col">D2</th>
				<th scope="col">D3</th>
				<th scope="col">D4</th>
				<th scope="col">DPA</th>
				<th scope="col">Boni</th>
				<th scope="col" title="Pedido +Bonificaciones">Pedido +Boni</th>
				<th scope="col" title="Precio de Costo" class="text-end">Precio Costo</th>
				<th scope="col" title="Total Costo" class="text-end">Total Costo</th>
				<th scope="col" title="Total en Pallet">Total Pallet</th>
				<th scope="col">Carro</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaOC != null && Model.ListaOC.ListaDatos != null)
			{
				@foreach (var item in Model.ListaOC.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var nombre = "chk" + item.P_Id;
					var nombre_Bultos = "bultos_" + item.P_Id;
					var nombre_P_Plista = "p_plista_" + item.P_Id;
					var nombre_P_Dto1 = "p_dto1_" + item.P_Id;
					var nombre_P_Dto2 = "p_dto2_" + item.P_Id;
					var nombre_P_Dto3 = "p_dto3_" + item.P_Id;
					var nombre_P_Dto4 = "p_dto4_" + item.P_Id;
					var nombre_P_Dto_Pa = "p_dto_pa_" + item.P_Id;
					var nombre_P_Boni = "p_boni_" + item.P_Id;
					<tr class="@clase" data-p-id="@item.P_Id" onclick="selectListaProductoRowOC(this)">
						@* <td><input type="checkbox" name=@nombre id="@nombre" /></td> *@ @*00*@
						<td class="check-column">
							<div class="check-producto-container">
								<input type="checkbox" class="form-check-input check-producto" data-p-id="@item.P_Id">
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.P_Id)">@Model.ListaOC.FormatearDato(item.P_Id, FormatDato.Ninguno)</td> @*01*@
						<td class="@Model.ListaOC.ObtenerClase(item.P_Desc)" title="@Model.ListaOC.FormatearDato(item.P_Desc, FormatDato.Ninguno)">@*02*@
							@Model.ListaOC.FormatearDato(item.P_Desc, FormatDato.Ninguno)
						</td> 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Id_Prov)">@Model.ListaOC.FormatearDato(item.P_Id_Prov, FormatDato.Ninguno)</td> @*03*@
						<td class="@Model.ListaOC.ObtenerClase(item.Stk_Suc)">@Model.ListaOC.FormatearDato(item.Stk_Suc, FormatDato.Ninguno)</td> @*04*@
						<td class="@Model.ListaOC.ObtenerClase(item.Stk)">@Model.ListaOC.FormatearDato(item.Stk, FormatDato.Ninguno)</td> @*05*@
						<td class="@Model.ListaOC.ObtenerClase(item.P_Unidad_Pres)">@Model.ListaOC.FormatearDato(item.P_Unidad_Pres, FormatDato.Ninguno)</td> @*06*@
						@* <td class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_Bultos>@item.Bultos</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.Bultos)">@*07*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-bultos input-numeric"
									   value="@(item.Bultos.ToString())"
									   data-p-id="@item.P_Id"
									   data-field="bultos"
									   data-original-value="@(item.Bultos)" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.Cantidad)">@Model.ListaOC.FormatearDato(item.Cantidad.ToString("F3"), FormatDato.Ninguno)</td> @*08*@
						@* <td class="align-right tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Plista>@item.P_Plista.ToString("0.##")</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Plista)">@*09*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_plista input-numeric"
									   value="@(item.P_Plista.ToString("F3"))"
									   data-p-id="@item.P_Id"
									   data-field="p_plista"
									   data-original-value="@(item.P_Plista)" />
							</div>
						</td>
						@* <td class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Dto1>@item.P_Dto1.ToString("0.#")</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Dto1)">@*10*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto1 input-numeric"
									   value="@(item.P_Dto1.ToString("F1"))"
									   data-p-id="@item.P_Id"
									   data-field="p_dto1"
									   data-original-value="@item.P_Dto1" />
							</div>
						</td>
						@* <td class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Dto2>@item.P_Dto2.ToString("0.#")</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Dto2)">@*11*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto2 input-numeric"
									   value="@(item.P_Dto2.ToString("F1"))"
									   data-p-id="@item.P_Id"
									   data-field="p_dto2"
									   data-original-value="@item.P_Dto2" />
							</div>
						</td>
						@* <td class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Dto3>@item.P_Dto3.ToString("0.#")</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Dto3)">@*12*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto3 input-numeric"
									   value="@(item.P_Dto3.ToString("F1"))"
									   data-p-id="@item.P_Id"
									   data-field="p_dto3"
									   data-original-value="@item.P_Dto3" />
							</div>
						</td>
						@* <td class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Dto4>@item.P_Dto4.ToString("0.#")</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Dto4)">@*13*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto4 input-numeric"
									   value="@(item.P_Dto4.ToString("F1"))"
									   data-p-id="@item.P_Id"
									   data-field="p_dto4"
									   data-original-value="@item.P_Dto4" />
							</div>
						</td>
						@* <d class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Dto_Pa>@item.P_Dto_Pa.ToString("0.#")</td> *@ 
						<td class="@Model.ListaOC.ObtenerClase(item.P_Dto_Pa)">@*14*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_dto_pa input-numeric"
									   value="@(item.P_Dto_Pa.ToString("F1"))"
									   data-p-id="@item.P_Id"
									   data-field="p_dto_pa"
									   data-original-value="@item.P_Dto_Pa" />
							</div>
						</td>
						@* <td class="align-center tiny-row content-editable-td inputEditable" contenteditable='true' onfocusin="focusOnTd(this);" onkeyup="keyUpFromEditableCell(this);" id=@nombre_P_Boni>@item.P_Boni</td> *@ 
						@{
							bool resBoni = item.P_Boni?.Trim().Equals("0") ?? false;
							string bonificacionMostrada = resBoni ? "" : Model.ListaOC.FormatearDato(item.P_Boni, FormatDato.Ninguno);
						}
						<td class="@Model.ListaOC.ObtenerClase('c')">@*15*@
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-p_boni"
									   value="@bonificacionMostrada"
									   data-p-id="@item.P_Id"
									   data-field="p_boni"
									   data-original-value="@bonificacionMostrada"
									   placeholder="000/000" />
							</div>
						</td>
						<td class="@Model.ListaOC.ObtenerClase(item.Pedido_Mas_Boni)">@Model.ListaOC.FormatearDato(item.Pedido_Mas_Boni, FormatDato.Ninguno)</td> @*16*@
						<td class="@Model.ListaOC.ObtenerClase(item.P_Pcosto)">@Model.ListaOC.FormatearDato(item.P_Pcosto, FormatDato.Monto)</td> @*17*@
						<td class="@Model.ListaOC.ObtenerClase(item.P_Pcosto_Total)">@Model.ListaOC.FormatearDato(item.P_Pcosto_Total, FormatDato.Monto)</td> @*18*@
						<td class="@Model.ListaOC.ObtenerClase(item.Paletizado)">@item.Paletizado.ToString("0.##")</td> @*19*@
						<td class="text-center">
							<a class="btn btn-xs btn-danger" data-interaction="@item.P_Id" onclick="quitarProductoEnOC(this);">
								<i class="bx bxs-trash" style="line-height: 1.0;font-size: 1rem;"></i>
							</a>
						</td> @*20*@
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="20" class="text-center">No se han encontrado productos para los criterios especificados.</td>
				</tr>
			}
		</tbody>
	</table>
</div>
<div class="row">
	<div class="col-8">
	</div>
	<div class="col-4">
		<div class="input-group input-group-sm mt-1">
			<span class="input-group-text fixed-lbl-for-abm-100">Totales: </span>
			<input type="text" asp-for="Total_Costo" class="form-control" style="text-align: right;" disabled/>
			<input type="text" asp-for="Total_Pallet" class="form-control" style="text-align: right;" disabled />
		</div>
	</div>
</div>
<div class="row mb-1">
