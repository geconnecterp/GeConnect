@using static gc.infraestructura.Constantes.Constantes
@model CargarOcBuscarProductoModel
@{
	var lista = new List<ComboGenDto>();
	var sucursales = HelperMvc<ComboGenDto>.ListaGenerica(lista);
	string color = string.Empty;
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
	position: sticky;
	top: 0px;
	}
</style>
<div class="table-responsive table-wrapper-400-full-width" id="containerListaProducto">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProducto">
		<thead>
			<tr class="header">
				<th style="width:5%;" scope="col">Código</th>
				<th style="width:20%;" scope="col">Descripción</th>
				<th style="width:5%;" scope="col">Cod. Prov</th>
				<th style="width:5%;" scope="col">PI Pend</th>
				<th style="width:5%;" scope="col">OC Pend</th>
				<th style="width:5%;" scope="col">Stock Suc</th>
				<th style="width:5%;" scope="col">Stock Tot</th>
				<th style="width:5%;" scope="col">Unidad Pres.</th>
				<th style="width:5%;" scope="col">Unidad Pallet</th>
				<th style="width:5%;" scope="col">Precio Costo</th>
				<th style="width:2%;" scope="col"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.grillaDatos != null && Model.grillaDatos.ListaDatos != null)
			{
				@foreach (var item in Model.grillaDatos.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var nombre = "a" + item.p_id;
					<tr class="@clase" onclick="selectListaProductoRow(this, event)">
						<td class="@Model.grillaDatos.ObtenerClase(item.p_id) align-center">@item.p_id</td>
						@if (item.p_activo == "D")
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.p_desc)">@item.p_desc<span style="float:right;" title="Producto discontínuo"><i class="bx bx-dislike"></i></span></td>
						}
						else
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.p_desc)">@item.p_desc</td>
						}
						<td class="@Model.grillaDatos.ObtenerClase(item.p_id_prov) align-center">@item.p_id_prov</td>
						@if (item.pi_pendiente == 0)
						{
							<td class="align-right tiny-row"></td>
						}
						else
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.pi_pendiente)" style="font-weight:bold;">@item.pi_pendiente</td>
						}
						@if (item.oc_pendiente == 0)
						{
							<td class="align-right tiny-row"></td>
						}
						else
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.oc_pendiente)" style="font-weight:bold;">@item.oc_pendiente</td>
						}
						<td class="@Model.grillaDatos.ObtenerClase(item.stk_suc)">@item.stk_suc</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.stk)">@item.stk</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.p_unidad_pres)">@item.p_unidad_pres</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.p_unidad_palet)">@item.p_unidad_palet</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.costo)">@item.costo</td>
						@if (item.p_activo == "D")
						{
							<td>
								<a class="btn btn-xs btn-secondary no-propagar" id=@nombre data-interaction="@item.p_id" onclick="actualizarProducto(this);" title="Producto discontinuo">
									<i class="bx bx-cart-alt" style="line-height: 1.0;font-size: 1rem;"></i>
								</a>
							</td>
						}
						else
						{
							<td>
								<a class="btn btn-xs btn-success no-propagar" id=@nombre data-interaction="@item.p_id" onclick="actualizarProducto(this);">
									<i class="bx bx-cart-alt" style="line-height: 1.0;font-size: 1rem;"></i>
								</a>
							</td>
						}

					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="row d-flex p-2 flex-fill">
	<div class="col-2"></div>
	<div id="divPaginacion" class="ms-3">
	</div>
	<div class="col-2"></div>
</div>
<div class="row">
	<div class="row">
		<div class="col-2">
			<a class="btn btn-sm btn-primary me-1 collapsed" id="btnCollapseSectionInfoProd" role="button" aria-expanded="false" aria-controls="divInfoAdicionaDeProducto">
				Info. Adicional
			</a>
		</div>
		<div class="col-5"></div>
	</div>
	<div id="divInfoAdicionaDeProducto" class="collapse"></div>
</div>

@section scripts {
	<script type="text/javascript">
		var pedido = "";
		var pIdEditado = "";
		var rowIndex = 0;
	</script>
}