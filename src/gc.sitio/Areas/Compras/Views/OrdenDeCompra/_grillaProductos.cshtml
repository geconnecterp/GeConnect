@using static gc.infraestructura.Helpers.GridHelper
@using static gc.infraestructura.Constantes.Constantes
@model CargarOcBuscarProductoModel
@{
	var lista = new List<ComboGenDto>();
	var sucursales = HelperMvc<ComboGenDto>.ListaGenerica(lista);
	string color = string.Empty;
	var alt = true;
	string clase = string.Empty;

	string grupoActual = string.Empty;
	string grupoAnterior = string.Empty;
}
<style>
	#containerListaProducto {
		max-height: 500px;
		overflow-y: auto;
		overflow-x: hidden;
		position: relative;
	}

	.table-responsive thead {
		position: sticky;
		top: 0;
		z-index: 1;
	}

	thead th {
		position: static;
		top: 0;
		z-index: 1;
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
		vertical-align: middle;
		padding: 0.4rem 0.5rem;
		height: 2.2rem; /* altura fija para todos los th */
	}

	.th-descripcion {
		position: relative;
		width: 25%;
		text-align: center;
	}

	.th-title {
		display: inline-block;
		padding-right: 1.5rem; /* espacio para el ícono */
	}

	.btn-info-producto {
		position: absolute;
		top: 50%;
		right: 6px;
		transform: translateY(-50%);
		background: transparent !important;
		border: none !important;
		padding: 0;
		color: #fff;
		cursor: pointer;
	}

</style>
<div class="table-responsive table-wrapper-500-full-width" id="containerListaProducto">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProducto">
		<thead>
			<tr class="header">
				<th style="width:4%;" scope="col">Código</th>
				<th class="th-descripcion">
					<span class="th-title">Descripción</span>
					<button type="button"
							class="btn btn-info-producto"
							data-action="info-producto"
							title="Abrir info de producto">
						<i class="bx bx-info-circle"></i>
					</button>
				</th>
				<th style="width:5%;" scope="col">Barrado</th>
				<th style="width:5%;" scope="col">Cod. Prov</th>
				<th style="width:5%;" scope="col">Ult RP</th>
				<th style="width:5%;" scope="col">OC Pend</th>
				<th style="width:5%;" scope="col">Stk Suc</th>
				<th style="width:5%;" scope="col">Stk Total</th>
				<th style="width:5%;" scope="col">Unidad Pres.</th>
				<th style="width:5%;" scope="col">Unidad Pallet</th>
				<th style="width:5%;" scope="col">Precio Costo</th>
				<th style="width:3%; " scope="col"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.grillaDatos != null && Model.grillaDatos.ListaDatos != null)
			{
				var productos = Model.grillaDatos.ListaDatos.OrderBy(x => x.pg_desc).ToList();
				@foreach (var item in productos)
				{
					grupoActual = item.pg_id;
					if (grupoActual != grupoAnterior)
					{
						var leyenda = $"Familia: ({item.pg_id}) {item.pg_desc}";
						<tr class="table-secondary fw-bold">
							<td colspan="12" class="text-center">
								<i class="bx bx-folder me-1"></i>
								@leyenda
							</td>
						</tr>
						grupoAnterior = grupoActual;
						alt = true;
					}

					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var nombre = "a" + item.p_id;
					<tr class="@clase" onclick="selectListaProductoRow(this, event)">
						<td class="@Model.grillaDatos.ObtenerClase(item.p_id) align-center">@item.p_id</td>
						@if (item.p_activo == "D")
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.p_desc)">@item.p_desc<span style="float:right;" title="Producto discontínuo"><i class="bx bx-dislike"></i></span></td>
						}
						else
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.p_desc)">@item.p_desc</td>
						}
						<td class="@Model.grillaDatos.ObtenerClase(item.p_id_barrado) align-center">@item.p_id_barrado</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.p_id_prov) align-center">@item.p_id_prov</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.rp_dias) align-center">@item.rp_dias</td>
						@if (item.oc_pendiente == 0)
						{
							<td class="align-right tiny-row"></td>
						}
						else
						{
							<td class="@Model.grillaDatos.ObtenerClase(item.oc_pendiente)" style="font-weight:bold;">@item.oc_pendiente</td>
						}
						<td class="@Model.grillaDatos.ObtenerClase(item.stk_suc)">@GridHelper.FormatearDato(item.stk_suc, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.stk)">@GridHelper.FormatearDato(item.stk, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.p_unidad_pres)">@item.p_unidad_pres</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.p_unidad_palet)">@item.p_unidad_palet</td>
						<td class="@Model.grillaDatos.ObtenerClase(item.costo)">@GridHelper.FormatearPrecio(item.costo, TipoPrecio.Costo)</td>
						@if (item.p_activo == "D")
						{
							<td style="text-align: center;">
								<a class="btn btn-xs btn-secondary no-propagar" id=@nombre data-interaction="@item.p_id" onclick="actualizarProducto(this);" title="Producto discontinuo">
									<i class="bx bx-cart-alt" style="line-height: 1.0;font-size: 1rem;"></i>
								</a>
							</td>
						}
						else
						{
							<td style="text-align: center;">
								<a class="btn btn-xs btn-success no-propagar" id=@nombre data-interaction="@item.p_id" onclick="actualizarProducto(this);">
									<i class="bx bx-cart-alt" style="line-height: 1.0;font-size: 1rem;"></i>
								</a>
							</td>
						}

					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="row d-flex align-items-center p-2">
	<div class="col">
		<div id="divPaginacion"></div>
	</div>

	<div class="col text-end">
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var pedido = "";
		var pIdEditado = "";
		var rowIndex = 0;
	</script>
}