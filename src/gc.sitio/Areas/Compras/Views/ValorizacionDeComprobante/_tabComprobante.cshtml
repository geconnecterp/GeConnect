@model TabComprobanteModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var lst = Model.ConceptoDtoFinanc;
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}

	#containerListaValorizacion {
		position: relative;
		height: 300px;
		max-height: 300px;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
			}

	#tbListaValorizacion td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbListaValorizacion thead th {
		border-left: none !important;
		border-right: none !important;
	}

	#tbListaValorizacion tr {
		height: 1.6rem !important;
	}

	fieldset {
		margin: 8px;
		border: 1px solid silver;
		padding: 8px;
		border-radius: 4px;
		max-width: 100%;
		margin-top: 8px;
		margin-left: 0px;
		margin-right: 0px;
		margin-bottom: 0px;
		height: 420px;
	}

	legend {
		padding: 2px;
		margin-top: -22px;
		background: #f3f5f7 !important;
		width: 25%;
		text-align: center;
		font-size: small;
	}

	.columna-total {
		font-weight: bold !important;
	}

	#tbListaDescFinanc thead th {
		border-left: none !important;
		border-right: none !important;
	}

	#tbListaDescFinanc tbody td {
		border-left: none !important;
		border-right: none !important;
	}

	#tbListaValorizacion tbody td {
		border-left: none !important;
		border-right: none !important;
	}
</style>
<div class="row" style="padding-top: 10px;">
	@Html.Hidden("cm_compte", Model.DescFinanc.cm_compte)
	@Html.Hidden("dia_movi", Model.DescFinanc.dia_movi)
	@Html.Hidden("tco_id", Model.DescFinanc.tco_id)
	<div id="divListaValorizacion">
		<div class="table-responsive table-wrapper-400-full-width" id="containerListaValorizacion">
			<table class="table table-sm table-golden" id="tbListaValorizacion">
				<thead>
					<tr class="header">
						<th style="width:20%;" class="align-center">Comprobante</th>
						<th style="width:5%;" class="align-center">No Gravado</th>
						<th style="width:5%;" class="align-center">Exento</th>
						<th style="width:5%;" class="align-center">Gravado</th>
						<th style="width:5%;" class="align-center">IVA</th>
						<th style="width:5%;" class="align-center">II</th>
						<th style="width:5%;" class="align-center">Percep.</th>
						<th style="width:5%;" class="align-center">Otros NG</th>
						<th style="width:5%;" class="align-center">Total</th>
						<th style="width:0%;display:none;" class="align-center">resultado</th>
						<th style="width:0%;display:none;" class="align-center">resultado_msj</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.GrillaValoracion != null && Model.GrillaValoracion.ListaDatos != null)
					{
						@foreach (var item in Model.GrillaValoracion.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							var nombre = "chk" + item.cm_compte;
							<tr class="" 
								data-tco-id="@item.tco_id"
								onclick="selectListaValorizacion(this)">
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_compte_obs)">@Model.GrillaValoracion.FormatearDato(item.cm_compte_obs, FormatDato.Ninguno)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_no_gravado)">@GridHelper.FormatearDato(item.cm_no_gravado, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_exento)">@GridHelper.FormatearDato(item.cm_exento, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_gravado)">@GridHelper.FormatearDato(item.cm_gravado, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_iva)">@GridHelper.FormatearDato(item.cm_iva, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_ii)">@GridHelper.FormatearDato(item.cm_ii, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_percepciones)">@GridHelper.FormatearDato(item.cm_percepciones, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_otro_ng)">@GridHelper.FormatearDato(item.cm_otro_ng, FormatDato.Monto, true)</td>
								<td class="@Model.GrillaValoracion.ObtenerClase(item.cm_total) columna-total">@GridHelper.FormatearDato(item.cm_total, FormatDato.Monto, true)</td>
								<td style="display:none;">@item.resultado</td>
								<td style="display:none;">@item.resultado_msj</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
<div class="row mt-2">
	<div class="col-10" style="padding-left: 25px;">
		<div class="row">
			<fieldset style="height: 250px;">
				<div class="row">
					<div class="col-md-8">
						<div class="row">
							<div class="col-md-8" style="display: flex; align-items: center; text-align: justify; margin-top: 5px; margin-bottom: -15px;">
								<h6>Descuentos Financieros</h6>
							</div>
						</div>
						<div id="divDescFinanc">
							<div class="table-responsive table-wrapper-400-full-width" id="containerListaDescFinanc">
								<table class="drageable-table table table-bordered table-hover table-golden" id="tbListaDescFinanc">
									<thead>
										<tr class="header">
											<th style="width:0%;display:none;" class="align-center">Item</th>
											<th style="width:15%;" class="align-center">Neto Fijo</th>
											<th style="width:15%;" class="align-center">Dto/Tot</th>
											<th style="width:25%;" class="align-center">Concepto</th>
											<th style="width:15%;" class="align-center">Dto %</th>
											<th style="width:15%;" class="align-center">Neto</th>
											<th style="width:15%;" class="align-center"></th>
										</tr>
									</thead>
									<tbody>
										@if (Model != null && Model.GrillaDescuentosFin != null && Model.GrillaDescuentosFin.ListaDatos != null)
										{
											@foreach (var item in Model.GrillaDescuentosFin.ListaDatos)
											{
												if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
												var nombre1 = "chkNetoFijo" + item.cm_compte;
												var nombre2 = "chkDtoTot" + item.cm_compte;
												<tr class="@clase" 
													onclick="selectListaDescFinanc(this)"
													data-cm_compte="@item.cm_compte"
													data-dia_movi="@item.dia_movi"
													data-tco_id="@item.tco_id"
													data-dtoc_id="@item.dtoc_id"
													data-dto_obs="@item.dto_obs">
													<td style="display:none;">@item.item</td>
													@if (item.dto_fijo_bool)
													{
														<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dto_fijo_bool)"><input type="checkbox" name=@nombre1 id="@nombre1" checked disabled /></td>
													}
													else
													{
														<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dto_fijo_bool)"><input type="checkbox" name=@nombre1 id="@nombre1" disabled /></td>
													}
													@if (item.dto_sobre_total_bool)
													{
														<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dto_sobre_total_bool)"><input type="checkbox" name=@nombre2 id="@nombre2" checked disabled /></td>
													}
													else
													{
														<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dto_sobre_total_bool)"><input type="checkbox" name=@nombre2 id="@nombre2" disabled /></td>
													}
													<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dtoc_desc)">@Model.GrillaDescuentosFin.FormatearDato(item.dtoc_desc, FormatDato.Ninguno)</td>
													<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dto)">@GridHelper.FormatearDato(item.dto, FormatDato.Monto, true)</td>
													<td class="@Model.GrillaDescuentosFin.ObtenerClase(item.dto_importe)">@GridHelper.FormatearDato(item.dto_importe, FormatDato.Monto, true)</td>
													<td style="text-align:center;">
														<a class="btn btn-xs btn-danger" data-interaction="@item.item" onclick="quitarDescFinanc(this);">
															<i class="bx bxs-trash"></i>
														</a>
													</td> @*20*@
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<div class="col-md-4 mt-3">
						<div class="row mt-1">
							<div class="input-group input-group-sm">
								<div class="form-check form-check-inline form-switch mb-2">
									<input class="form-check-input activable" type="checkbox" asp-for="DescFinanc.dto_sobre_total_bool" value="true" id="chkSobreTotal">
									<label class="form-check-label" for="chkSobreTotal"> Aplica sobre Total</label>
								</div>
							</div>
						</div>
						<div class="row mt-1">
							<div class="input-group input-group-sm">
								<div class="form-check form-check-inline form-switch mb-2" style="margin-right:170px;">
									<input class="form-check-input activable" type="checkbox" asp-for="DescFinanc.dto_fijo_bool" value="" id="chkNetoFijo">
									<label class="form-check-label" for="chkNetoFijo"> Neto Fijo</label>
								</div>
								<div class="d-flex justify-content-sm-end">
									<button id="btnAceptarDescFinanc" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Agregar Descuento Financiero">
										<i class="bx bx-plus-circle"></i> Agregar
									</button>
								</div>
							</div>
						</div>
						<div class="row mt-1">
							<div class="input-group input-group-sm">
								<span class="input-group-text fixed-lbl-for-abm-100">Concepto: </span>
								@Html.DropDownListFor(m => m.Comprobante.tco_id, lst, "Seleccionar...", new { @id = "listaConcDescFinanc", @class = "form-control activable" })
							</div>
						</div>
						<div id="divDescFinancDto" class="show">
							<div class="row mt-1">
								<div class="input-group input-group-sm">
									<span class="input-group-text fixed-lbl-for-abm-100">Dto %:</span>
									<input type="text" asp-for="DescFinanc.dto" class="form-control activable inputEditable" />
								</div>
							</div>
						</div>
						<div id="divDescFinancDtoImporte" class="collapse">
							<div class="row mt-1">
								<div class="input-group input-group-sm">
									<span class="input-group-text fixed-lbl-for-abm-100">Neto Fijo:</span>
									<input type="text" asp-for="DescFinanc.dto_importe" class="form-control activable inputEditable" />
								</div>
							</div>
						</div>
						<div class="row mt-1">
							<div class="input-group input-group-sm">
								<span class="input-group-text fixed-lbl-for-abm-100">Obs.:</span>
								<input type="text" asp-for="DescFinanc.dto_obs" maxlength="40" class="form-control activable inputEditable" />
							</div>
						</div>
						<div class="row mt-1">
							<div class="d-flex justify-content-sm-center">
							</div>
						</div>
					</div>
				</div>
			</fieldset>
		</div>
	</div>
	<div class="col-2">
		<fieldset style="height: 250px;margin-top: 0px;">
			<div class="row mt-1">
				<div class="d-grid gap-2">
					<button id="btnGuardarValorizacion" class="btn btn-success btn-sm mt-1 me-1" type="button" title="Guardar Valorización">
						<i class="bx bx-badge-check"></i> Guardar Valorización
					</button>
					<button id="btnConfirmarValorizacion" class="btn btn-success btn-sm mt-1 me-1" type="button" title="Confirmar Valorización">
						<i class="bx bx-badge-check"></i> Confirmar Valorización
					</button>
					<button id="btnCancelarValorizacion" class="btn btn-danger btn-sm mt-1 me-1" type="button" title="Cancelar carga de Valorización">
						<i class="bx bx-x-circle"></i>Cancelar Carga
					</button>
					<button id="btnAgregarProducto" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Agregar Producto">
						<i class="bx bx-plus-circle"></i> AGREGAR PROD
					</button>
				</div>
			</div>
		</fieldset>
	</div>
</div>
@*Modal para cargar IVA discriminado o NO discriminado*@
<div class="modal fade modal-golden in" id="modalAgregarProducto" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog modal-x" role="document">
		<div class="modal-content">
			<div id="divAgregarProducto">
			</div>
		</div>
	</div>
</div>