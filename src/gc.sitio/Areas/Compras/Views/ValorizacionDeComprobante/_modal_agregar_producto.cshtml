@model AgregarProductoModel
@{
	BusquedaProducto busquedaProducto = new();
	var listaRP = Model.ComboRP;
}
<div class="modal-header">
	<h5 class="modal-title" id="modalCenterTitle">Agregar Producto</h5>
	<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
	<div class="row">
		<div class="col-md-12">
			<div class="input-group input-group-sm">
				<partial name="~/areas/ControlComun/views/producto/_ctrBuscarProducto.cshtml" model="@busquedaProducto" />
				<div class="input-group input-group-sm mt-2">
					<span class="input-group-text">ID: </span>
					<input type="text" asp-for="p_id" class="form-control activable inputEditable" readonly />
					<input type="text" asp-for="p_desc" class="form-control activable inputEditable" style="width: 60%;" readonly />
				</div>
				<div class="input-group input-group-sm mt-2">
					<span class="input-group-text">Cantidad: </span>
					<input type="text" asp-for="p_cantidad" class="form-control activable inputEditable" style="max-width:120px;" />
					<div class="form-check form-check-inline form-switch" style="margin-bottom: 0px;margin-left: 10px;">
						<input class="form-check-input activable" type="checkbox" asp-for="incluye_rp" value="" id="chkIncluyeRp">
						<label class="form-check-label" for="chkIncluyeRp"> Incluir Cantidad en RP</label>
					</div>
				</div>
				<div class="input-group input-group-sm mt-2">
					<span class="input-group-text">RP: </span>
					@Html.DropDownListFor(m => m.rp, listaRP, "Seleccionar...", new { @id = "listaRP", @class = "form-control activable inputEditable" })
				</div>
			</div>
		</div>
	</div>
</div>
<div class="modal-footer">
	<button type="button" class="btn btn-primary" onclick="AgregarProducto();" id="btnAgregar">Agregar</button>
	<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
		Cerrar
	</button>
</div>