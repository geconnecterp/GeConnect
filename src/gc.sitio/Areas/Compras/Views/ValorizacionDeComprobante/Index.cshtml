@using static gc.infraestructura.Constantes.Constantes
@model QueryFilters
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var filtro = new QueryFilters()
			{
				Rel01 = new List<string>(),
				Modelo = ModeloFilter.VALORIZACION_COMPROBANTE,
			};
}
@section styles {
	<link rel="stylesheet" href="~/css/compras/valor/grilladetrpr.css" />
}
<style>
	.fila-0DC {
		background-color: #fff7c2 !important; /* amarillo suave */
	}

	.fila-0DP {
		background-color: #ffe0b3 !important; /* naranja suave */
	}

	.fila-0DT {
		background-color: #d9ecff !important; /* celeste suave */
	}
</style>
<div class="container" style="margin-left: 20px;margin-right: 20px;">
	<div class="row">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>

				<button class="btn btn-primary btn-sm mt-1 me-1" type="button" id="btnDetalle" data-bs-toggle="collapse" data-bs-target="#divDetalle" aria-expanded="true" aria-controls="divDetalle">
					<i class="bx bx-caret-down"></i>
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtroBase" model="filtro" />
		@Html.Hidden("pagEstado", false);
	</div>
	<div class="collapse" id="divDetalle" style="">
		<ul class="nav nav-tabs nav-tabs-golden mt-2 d-flex justify-content-between align-items-center"
			role="tablist" id="tabsValorizacionDeComprobante">

			<div class="d-flex">
				<li class="nav-item" role="presentation" id="tabComprobantes">
					<button type="button" class="nav-link active" role="tab"
							data-bs-toggle="tab" data-bs-target="#navs-top-home">
						Comprobantes
					</button>
				</li>

				<li class="nav-item" role="presentation" id="tabDetalle">
					<button type="button" class="nav-link" role="tab"
							data-bs-toggle="tab" data-bs-target="#navs-top-profile">
						Detalle
					</button>
				</li>
			</div>

			<!-- Sección Cuenta alineada a la derecha -->
			<div class="input-group input-group-sm" id="divProveedorSeleccionado" style="max-width: 450px;">
				<span class="input-group-text fixed-lbl-for-abm-70">Cuenta:</span>
				<input type="text" id="CtaID" class="form-control" style="max-width: 100px; text-align:right;" disabled />
				<input type="text" id="CtaDesc" class="form-control" disabled />
			</div>

		</ul>

		<div class="tab-content tab-content-compact" style="padding:0;">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div id="divComprobantes">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div id="divDetalles">
				</div>
			</div>
		</div>
	</div>
</div>

<div id="divInfoDetalleDeComprobante" class="collapse"></div>

