@model TabDetalleRprModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
/* 	thead th {
		position: sticky;
		top: 0px;
	} */

	.opciones {
		display: flex;
		gap: 100px;
	}

</style>
<div class="row" style="padding-top: 10px;">
	<div id="divListaDetalleRpr">
		<div class="table-responsive table-wrapper-400-full-width" id="containerListaDetalleRpr">
			<table class="table table-bordered table-hover table-golden" id="tbListaDetalleRpr">
				<thead>
					<tr class="header">
						<th colspan="3" class="align-center"></th>
						<th colspan="9" class="align-center">Precio OC y Cantidad RP</th>
						<th colspan="10" class="align-center" style="background: cornflowerblue;">Factura</th>
						<th colspan="2" class="align-center" title="Valorización">Valoriz.</th>
					</tr>
					<tr class="header">
						<th scope="col" class="check-column">
							<div class="check-producto-container">
								<input class="form-check-input" type="checkbox" id="checkAllProd" title="Seleccionar todos">
							</div>
						</th>
						<th scope="col">ID</th>
						<th scope="col">Descripcion</th>
						<th scope="col" class="text-end">P. Lista</th>@*Precio OC y Cantidad RP*@
						<th scope="col">D1</th>
						<th scope="col">D2</th>
						<th scope="col">D3</th>
						<th scope="col">D4</th>
						<th scope="col">Dpa</th>
						<th scope="col">Boni.</th>
						<th scope="col" class="text-end">Costo</th>
						<th scope="col">Recibido</th>
						<th scope="col" class="text-end" style="background: cornflowerblue;">P. Lista</th>@*Factura*@
						<th scope="col" style="background: cornflowerblue;">D1</th>
						<th scope="col" style="background: cornflowerblue;">D2</th>
						<th scope="col" style="background: cornflowerblue;">D3</th>
						<th scope="col" style="background: cornflowerblue;">D4</th>
						<th scope="col" style="background: cornflowerblue;">Dpa</th>
						<th scope="col" style="background: cornflowerblue;">Boni.</th>
						<th scope="col" class="text-end" style="background: cornflowerblue;">Costo</th>
						<th scope="col" style="background: cornflowerblue;">AP</th>
						<th scope="col" style="background: cornflowerblue;">Cant. Fact.</th>
						<th scope="col">DC</th>@*Factura*@
						<th scope="col">DP</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.GrillaDetalleRpr != null && Model.GrillaDetalleRpr.ListaDatos != null)
					{
						@foreach (var item in Model.GrillaDetalleRpr.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							var nombre = item.p_id + "_";
							var nombre_check = nombre + "checkbox";
							var nombre_check_nc_genera = nombre + "nc_genera";
							<tr class="@clase" data-p-id="@item.p_id" onclick="selectListaDetalleRpr(this)" title="OC: @item.oc_compte // RP: @item.rp_compte" id="@item.p_id">
								@*0*@
								<td class="check-column">
									<div class="check-producto-container">
										<input type="checkbox" class="form-check-input check-producto" data-p-id="@item.p_id">
									</div>
								</td>
								@*1*@ <td class="@Model.GrillaDetalleRpr.ObtenerClase(item.p_id)" style="padding-left: 0.5px; padding-right: 0.5px; text-align-last: center;">@Model.GrillaDetalleRpr.FormatearDato(item.p_id, FormatDato.Ninguno)</td>
								@*2*@ <td class="@Model.GrillaDetalleRpr.ObtenerClase(item.p_desc)" title="@item.p_desc" style="padding-left: 0.5px;padding-right: 0.5px;text-align-last: left;">@Model.GrillaDetalleRpr.FormatearDato(item.p_desc, FormatDato.Ninguno)</td>
								@*3*@ 
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_plista)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_plista input-numeric"
											   value="@(item.ocd_plista.ToString("F3"))"
											   data-p-id="@item.p_id"
											   data-field="ocd_plista"
											   data-original-value="@(item.ocd_plista)" />
									</div>
								</td>
								@*4*@ 
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_dto1)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_dto1 input-numeric"
											   value="@(item.ocd_dto1.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="ocd_dto1"
											   data-original-value="@item.ocd_dto1" />
									</div>
								</td>
								@*5*@ 
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_dto2)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_dto2 input-numeric"
											   value="@(item.ocd_dto2.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="ocd_dto2"
											   data-original-value="@item.ocd_dto2" />
									</div>
								</td>
								@*6*@ 
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_dto3)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_dto3 input-numeric"
											   value="@(item.ocd_dto3.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="ocd_dto3"
											   data-original-value="@item.ocd_dto3" />
									</div>
								</td>
								@*7*@ 
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_dto4)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_dto4 input-numeric"
											   value="@(item.ocd_dto4.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="ocd_dto4"
											   data-original-value="@item.ocd_dto4" />
									</div>
								</td>
								@*8*@ 
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_dto_pa)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_dto_pa input-numeric"
											   value="@(item.ocd_dto_pa.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="ocd_dto_pa"
											   data-original-value="@item.ocd_dto_pa" />
									</div>
								</td>
								@*9*@ 
								@{
									bool ocdBoni = item.ocd_boni?.Trim().Equals("0") ?? false;
									string bonificacionMostrada = ocdBoni ? "" : Model.GrillaDetalleRpr.FormatearDato(item.ocd_boni, FormatDato.Ninguno);
								}
								<td class="@Model.GrillaDetalleRpr.ObtenerClase('c')">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-ocd_boni"
											   value="@bonificacionMostrada"
											   data-p-id="@item.p_id"
											   data-field="ocd_boni"
											   data-original-value="@bonificacionMostrada"
											   placeholder="000/000" />
									</div>
								</td>
								@*10*@<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.ocd_pcosto)">@Model.GrillaDetalleRpr.FormatearDato(item.ocd_pcosto, FormatDato.Monto)</td>
								@*11*@<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_cantidad)">@Model.GrillaDetalleRpr.FormatearDato(item.rpd_cantidad, FormatDato.Monto)</td>
								@*12*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_plista)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_plista input-numeric"
											   value="@(item.rpd_plista.ToString("F3"))"
											   data-p-id="@item.p_id"
											   data-field="rpd_plista"
											   data-original-value="@(item.rpd_plista)" />
									</div>
								</td>
								@*13*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_dto1)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_dto1 input-numeric"
											   value="@(item.rpd_dto1.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="rpd_dto1"
											   data-original-value="@item.rpd_dto1" />
									</div>
								</td>
								@*14*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_dto2)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_dto2 input-numeric"
											   value="@(item.rpd_dto2.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="rpd_dto2"
											   data-original-value="@item.rpd_dto2" />
									</div>
								</td>
								@*15*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_dto3)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_dto3 input-numeric"
											   value="@(item.rpd_dto3.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="rpd_dto3"
											   data-original-value="@item.rpd_dto3" />
									</div>
								</td>
								@*16*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_dto4)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_dto4 input-numeric"
											   value="@(item.rpd_dto4.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="rpd_dto4"
											   data-original-value="@item.rpd_dto4" />
									</div>
								</td>
								@*17*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_dto_pa)">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_dto_pa input-numeric"
											   value="@(item.rpd_dto_pa.ToString("F1"))"
											   data-p-id="@item.p_id"
											   data-field="rpd_dto_pa"
											   data-original-value="@item.rpd_dto_pa" />
									</div>
								</td>
								@*18*@
								@{
									bool rpdBoni = item.rpd_boni?.Trim().Equals("0") ?? false;
									string bonificacionMostradaRpd = rpdBoni ? "" : Model.GrillaDetalleRpr.FormatearDato(item.rpd_boni, FormatDato.Ninguno);
								}
								<td class="@Model.GrillaDetalleRpr.ObtenerClase('c')">
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_boni"
											   value="@bonificacionMostradaRpd"
											   data-p-id="@item.p_id"
											   data-field="rpd_boni"
											   data-original-value="@bonificacionMostradaRpd"
											   placeholder="000/000" />
									</div>
								</td>
								@*19*@<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_pcosto)">@Model.GrillaDetalleRpr.FormatearDato(item.rpd_pcosto, FormatDato.Monto)</td>
								@*20*@
								@if (item.nc_genera_bool)
								{
									<td style="padding: 0; text-align-last: center;"><input type="checkbox" class="chkNcGenera" name=@nombre_check_nc_genera id="chkNcGenera" onchange="onChangeChkNcGenera(this);" checked /></td>
								}
								else
								{
									<td style="padding: 0; text-align-last: center;"><input type="checkbox" class="chkNcGenera" name=@nombre_check_nc_genera id="chkNcGenera" onchange="onChangeChkNcGenera(this);" /></td>
								}
								@*21*@
								<td class="@Model.GrillaDetalleRpr.ObtenerClase(item.rpd_cantidad_compte)">
									@*07*@
									<div class="input-container">
										<input type="text" class="form-control form-control-sm input-rpd_cantidad_compte input-numeric"
											   value="@(item.rpd_cantidad_compte.ToString())"
											   data-p-id="@item.p_id"
											   data-field="rpd_cantidad_compte"
											   data-original-value="@(item.rpd_cantidad_compte)" />
									</div>
								</td>
								@*22*@
								@if (!item.valorizacion_mostrar_dc)
								{
									<td></td>
								}
								else
								{
									<td><span class="@item.valorizacion_class_dc" style="font-size:small;">@item.valorizacion_value_dc</span></td>
								}
								@*23*@
								@if (!item.valorizacion_mostrar_dp)
								{
									<td></td>
								}
								else
								{
									<td><span class="@item.valorizacion_class_dp" style="font-size:small;">@item.valorizacion_value_dp</span></td>
								}
							</tr>
						}
					}

				</tbody>
			</table>
		</div>
	</div>
	<div class="row" style="padding-bottom: 10px;">
		<div class="col-9" style="padding-left: 40px;">
			<div class="row mt-3">
				<fieldset style="height: 120px;">
					<legend></legend>
					<form class="opciones" id="radioSection">
						<label><input type="radio" name="opcion" value="opcion1"> Costos de Otra OC</label>
						<label><input type="radio" name="opcion" value="opcion2"> Costos de OC relacionada</label>
						<label><input type="radio" name="opcion" value="opcion3"> Costos Sistema</label>
						<label><input type="radio" name="opcion" value="opcion4"> Costos Especificos</label>
					</form>
					<div class="row collapse" id="sectionCostosEspecificos">
						<div class="input-group input-group-sm mt-1">
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkPLista">
								<label class="form-check-label" for="chkPLista" style="font-size: smaller;">PLista</label>
							</div>
							<input type="text" id="txtPLista" class="form-control" style="text-align: right;" />
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDto1">
								<label class="form-check-label" for="chkDto1" style="font-size: smaller;">Dto1</label>
							</div>
							<input type="text" id="txtDto1" class="form-control" style="text-align: right;" min="0.1" max="50" />
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDto2">
								<label class="form-check-label" for="chkDto2" style="font-size: smaller;">Dto2</label>
							</div>
							<input type="text" id="txtDto2" class="form-control" style="text-align: right;" min="0.1" max="50" />
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDto3">
								<label class="form-check-label" for="chkDto3" style="font-size: smaller;">Dto3</label>
							</div>
							<input type="text" id="txtDto3" class="form-control" style="text-align: right;" min="0.1" max="50" />
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDto4">
								<label class="form-check-label" for="chkDto4" style="font-size: smaller;">Dto4</label>
							</div>
							<input type="text" id="txtDto4" class="form-control" style="text-align: right;" min="0.1" max="50" />
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDpa">
								<label class="form-check-label" for="chkDpa" style="font-size: smaller;">DPA</label>
							</div>
							<input type="text" id="txtDpa" class="form-control" style="text-align: right;" min="0.1" max="50" />
							<div class="form-check form-check-inline form-switch" style="margin: 0px;">
								<input class="form-check-input activable" type="checkbox" value="" id="chkBoni">
								<label class="form-check-label" for="chkBoni" style="font-size: smaller;">Boni</label>
							</div>
							<input type="text" id="txtBoni" class="form-control" style="text-align: right;" min="0.1" max="50" />
						</div>
					</div>
					<div class="row col-3 collapse" id="sectionDeOtraOC">
						<div class="input-group input-group-sm mt-1">
							<span class="input-group-text fixed-lbl-for-abm-50">N°: </span>
							<input type="text" id="txtOC" class="form-control" style="text-align: right;width:20%;" />
						</div>
					</div>
					<div id="sectionDestinoDeAplicacion" class="mt-2">
						<div class="input-group input-group-sm mt-1 opciones">
							<div class="input-group input-group-sm" style="padding-right: 0px;">
								<div class="form-check form-check-inline form-switch mb-2">
									<input class="form-check-input activable" type="checkbox" value="" id="chkPrecio_oc" checked>
									<label class="form-check-label" for="chkPrecio_oc" style="font-size: smaller;"> Aplicar en Precio de OC</label>
								</div>
								<div class="form-check form-check-inline form-switch mb-2">
									<input class="form-check-input activable" type="checkbox" value="" id="chkPrecio_fac" checked>
									<label class="form-check-label" for="chkPrecio_fac" style="font-size: smaller;"> Aplicar en Factura</label>
								</div>
								<button id="btnAplicarSeteoMasivo" class="btn btn-success btn-sm" style="margin-left:5px;margin-right: 5px;" type="button" title="Aplicar">
									<i class="bx bx-check-double"></i> Aplicar
								</button>
							</div>
						</div>
					</div>
				</fieldset>
			</div>
		</div>
		<div class="col-3">
			<div class="row mt-3">
				<fieldset style="height: 120px;">
					<legend></legend>
					<div class="row mt-1">
						<div class="input-group input-group-sm" style="padding-right: 0px;">
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDifPrecio" checked>
								<label class="form-check-label" for="chkDifPrecio" style="font-size: smaller;"> Dif Precio</label>
							</div>
							<div class="form-check form-check-inline form-switch mb-2">
								<input class="form-check-input activable" type="checkbox" value="" id="chkDifCantidad" checked>
								<label class="form-check-label" for="chkDifCantidad" style="font-size: smaller;"> Dif Cantidad</label>
							</div>
						</div>
					</div>
					<div class="row mt-1">
						<div class="input-group input-group-sm" style="padding-right: 0px;">
							<div class="d-flex justify-content-sm-center">
								<button id="btnAceptarDesdeDetalleRpr" class="btn btn-success btn-sm mt-1 me-1" type="button" title="Aceptar">
									<i class="bx bx-badge-check"></i> Aceptar
								</button>

								<button id="btnCancelarDesdeDetalleRpr" class="btn btn-danger btn-sm mt-1 me-1" type="button" title="Cancelar">
									<i class="bx bx-x-circle"></i> Cancelar
								</button>
							</div>
						</div>
					</div>
				</fieldset>
			</div>
		</div>
	</div>
</div>
<script>
	$(function() {
			// Esta función aplica los indicadores visuales a los campos modificados en la carga inicial
			$('.campo-modificado').each(function() {
				// Solo si no tiene ya un indicador
				if ($(this).parent('.input-container').find('.indicador-cambio').length === 0) {
					$(this).parent('.input-container').append('<div class="indicador-cambio"></div>');
				}
			});

			// NUEVO: Forzar el ancho de la columna de descripción
			const setDescriptionColumnWidth = function() {
				// Seleccionar todas las celdas de descripción y sus encabezados
				$("#tbListaDetalleRpr th:nth-child(3), #tbListaProductoOC td:nth-child(3)").each(function() {
					$(this).css({
						'max-width': '150px',
						'width': '150px',
						'white-space': 'nowrap',
						'overflow': 'hidden',
						'text-overflow': 'ellipsis'
					});
				});
			};

			// Ejecutar inmediatamente
			setDescriptionColumnWidth();

			// Volver a aplicar después de cualquier redibujado de la tabla
			$(window).on('resize', setDescriptionColumnWidth);

			// CORREGIDO: Funcionalidad para checkbox de seleccionar todos
			$("#checkAllProd").on("change", function() {
				const isChecked = $(this).prop("checked");
				$(".check-producto").prop("checked", isChecked);

				// Aplicar la clase 'selected' a las filas
				$("#tbListaDetalleRpr tbody tr:not(.table-secondary)").each(function() {
					$(this).toggleClass("selected", isChecked);
				});

				// Si hay productos seleccionados, cargar el primero en la lista
				if (isChecked) {
					const primerProductoId = $("#tbListaDetalleRpr tbody tr:not(.table-secondary):first").data("p-id");
					if (primerProductoId && typeof destacarFilaSeleccionada === 'function') {
						destacarFilaSeleccionada(primerProductoId);
					}
				}
			});

			// CORREGIDO: Evento para checkboxes individuales sin usar 'event' global
			$(document).on("change", ".check-producto", function(e) {
				// Evitar propagación del evento
				e.stopPropagation();

				const $checkbox = $(this);
				const isChecked = $checkbox.prop("checked");
				const $row = $checkbox.closest("tr");

				// Marcar/desmarcar la fila
				$row.toggleClass("selected", isChecked);

				// Si se desmarca uno, desmarcar el "seleccionar todos"
				if (!isChecked) {
					$("#checkAllProd").prop("checked", false);
				} else {
					// Verificar si todos están marcados para actualizar el checkbox principal
					const totalCheckboxes = $(".check-producto").length;
					const totalChecked = $(".check-producto:checked").length;
					$("#checkAllProd").prop("checked", totalCheckboxes === totalChecked);

					// Si seleccionamos un producto, cargar sus listas
					const productoId = $row.data("p-id");
					if (productoId && typeof destacarFilaSeleccionada === 'function') {
						destacarFilaSeleccionada(productoId);
					}
				}
			});

			// CORREGIDO: Manejo de clic en la fila para selección
			$(document).on("click", "#tbListaDetalleRpr tbody tr:not(.table-secondary)", function(e) {
				// No activar si el clic fue en un checkbox o input
				if (!$(e.target).is('input, .check-producto, .check-producto-container')) {
					const $row = $(this);
					const $checkbox = $row.find(".check-producto");
					const productoId = $row.data("p-id");

					// Invertir el estado del checkbox
					const newState = !$checkbox.prop("checked");
					$checkbox.prop("checked", newState);

					// Actualizar selección visual
					$row.toggleClass("selected", newState);

					// Actualizar el checkbox principal
					if (!newState) {
						$("#checkAllProd").prop("checked", false);
					} else {
						const totalCheckboxes = $(".check-producto").length;
						const totalChecked = $(".check-producto:checked").length;
						$("#checkAllProd").prop("checked", totalCheckboxes === totalChecked);

						// Si seleccionamos un producto, cargar sus listas
						if (productoId && typeof destacarFilaSeleccionada === 'function') {
							destacarFilaSeleccionada(productoId);
						}
					}
				}
			});

			// AÑADIDO: Función de ayuda para obtener los IDs de productos seleccionados
			window.obtenerProductosSeleccionados = function() {
				const productosSeleccionados = [];
				$(".check-producto:checked").each(function() {
					const productoId = $(this).data("p-id");
					if (productoId) {
						productosSeleccionados.push(productoId);
					}
				});
				return productosSeleccionados;
			};
		});
</script>
