@using static gc.infraestructura.Constantes.Constantes
@model PedidosInternosDto
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var sucursales = Model.ComboSucursales;
	var filtro = new QueryFilters()
	{
		Rel01 = new List<string>(),
		Rel02 = new List<string>(),
		Rel03 = new List<ComboGenDto>(),
		Modelo = ModeloFilter.NECESIDADES_COMPRA,
		Opt1 = false,
		Opt2 = false,
		Opt3 = false,
		Opt4 = false,
		Opt5 = false,
	};
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	.container-fluid {
		padding-left: 10px !important;
		padding-right: 10px !important;
	}

	#divDetalle {
		min-height: calc(100vh - 140px);
		overflow-y: auto;
		overflow-x: hidden; /* evitar scroll horizontal */
	}

	html, body {
		overflow-x: hidden;
	}
</style>
<div class="container-fluid">
	<div class="row">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>
			</div>
		</div>
		<div class="col-md-6">
			<div class="collapse" style="text-align: right;align-content: center;padding-bottom:5px;" id="divBtnOpciones">
				<button type="button" class="btn btn-sm btn-primary btn-sm mt-1 me-1" id="btnPasarAPI" title="Pedido Interno" style="margin-left:5px;width: 100px;">
					<i class="bx bx-check-circle"></i> Pasar a PI
				</button>
				<button type="button" class="btn btn-sm btn-primary btn-sm mt-1 me-1" id="btnPIAuto" title="Pedido Interno Automático" style="margin-left:5px;width: 100px;">
					<i class="bx bx-check-circle"></i> PI Auto
				</button>
			</div>
			<div class="collapse" id="divBtnOpcionesPasarAPI" style="text-align: right; align-content: center; padding-bottom:5px;">
				<div class="d-flex align-items-center justify-content-end gap-2">
					<div class="input-group input-group-sm" style="width: auto;">
						<span class="input-group-text">Sucursal a la que se le realiza el pedido:</span>
						@Html.DropDownListFor(
								m => m.ListaSucursalesSeleccionada,
									Model.ListaSucursales,
									"Seleccionar",
									new { @id = "ListaSucursales", @class = "form-control inputEditable" }
									)
					</div>
					<button type="button" class="btn btn-sm btn-primary mt-1 me-1"
							id="btnConfirmarPI" title="Confirmar PI">
						<i class="bx bx-check-circle"></i> Confirmar PI
					</button>
					<button type="button" class="btn btn-sm btn-info mt-1 me-1"
							id="btnRegresar" title="Volver a pantalla principal">
						<i class="bx bx-arrow-back"></i> Regresar
					</button>
				</div>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtroBase" model="filtro" />
		@Html.Hidden("pagEstado", false)
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="row">
			<div class="col-12">
				<div id="divListaProducto">
					<div class="table-responsive text-nowrap table-wrapper" id="containerListaProducto">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProducto">
							<thead>
								<tr class="header">
									<th style="width:5%;" class="tiny-row align-center">Código</th>
									<th style="width:20%;" class="tiny-row align-center">Descripción</th>
									<th style="width:5%;" class="tiny-row align-center">Id. Barrado</th>
									<th style="width:5%;" class="tiny-row align-center">Cod. Prov</th>
									<th style="width:5%;" class="tiny-row align-center">Días Ult. RP</th>
									<th style="width:5%;" class="tiny-row align-center">OC Pend</th>
									<th style="width:5%;" class="tiny-row align-center">Stock</th>
									<th style="width:5%;" class="tiny-row align-center">Stock en Tránsito</th>
									<th style="width:5%;" class="tiny-row align-center">Stock a Facturar</th>
									<th style="width:5%;" class="tiny-row align-center">Unidad Pres.</th>
									<th style="width:5%;" class="tiny-row align-center">UM</th>
									<th style="width:5%;" class="tiny-row align-center">Pedido Bultos</th>
									<th style="width:5%;" class="tiny-row align-center">Cantidad</th>
									<th style="width:5%;" class="tiny-row align-center">Costo</th>
									<th style="width:5%;" class="tiny-row align-center">Costo Total</th>
									<th style="width:5%;" class="tiny-row align-center">Pallet</th>
									<th style="width:0%; display:none;">pg_id</th>
									<th style="width:0%; display:none;">rub_id</th>
								</tr>
							</thead>
						</table>
					</div>
				</div>
				<div>
				</div>
			</div>
		</div>
		<div class="row d-flex p-2 flex-fill">
			<div class="col-2"></div>
			<div id="divPaginacion" class="">
			</div>
			<div class="col-2"></div>
		</div>
	</div>
	<div id="divPasarPI" class="collapse"></div>
	<div id="divInfoAdicionaDeProducto" class="collapse"></div>
	<div id="modalGestorDocumental"></div>
</div>

<div class="modal fade modal-golden in" id="modalFiltroCompraAuto" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div id="divFiltroCompraAuto">
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var tipoDeOperacion = "PI";
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "BuscarProductos";
		var pedido = "";
		var pIdSeleccionado = "";

		var buscarFamiliaDesdeProveedorSeleccionadoUrl = "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "ndecypi", new { area = "Compras" })";
