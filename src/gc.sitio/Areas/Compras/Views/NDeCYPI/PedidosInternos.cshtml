@using static gc.infraestructura.Constantes.Constantes
@model PedidosInternosDto
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var sucursales = Model.ComboSucursales;
	var filtro = new QueryFilters()
	{
		Rel01 = new List<string>(),
		Rel02 = new List<string>(),
		Rel03 = new List<ComboGenDto>(),
		Modelo = ModeloFilter.NECESIDADES_COMPRA,
		Opt1 = false,
		Opt2 = false,
		Opt3 = false,
		Opt4 = false,
		Opt5 = false,
	};
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
}

<div class="container">
	<div class="row">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>
			</div>
		</div>
		<div class="col-md-6">
			<div class="collapse" style="text-align: right;align-content: center;padding-bottom:5px;" id="divBtnOpciones">
				<button type="button" class="btn btn-sm btn-primary btn-sm mt-1 me-1" id="btnPasarAPI" title="Pedido Interno">
					<i class="bx bx-check-circle"></i> Pasar a PI
				</button>
				<button type="button" class="btn btn-sm btn-primary btn-sm mt-1 me-1" id="btnPIAuto" title="Pedido Interno Automático">
					<i class="bx bx-check-circle"></i> PI Auto
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtroBase" model="filtro" />
		@Html.Hidden("pagEstado", false);
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="row">
			<div class="col-12">
				<div id="divListaProducto">
					<div class="table-responsive text-nowrap table-wrapper">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProducto">
							<thead>
								<tr class="header">
									<th style="width:5%;" class="tiny-row align-center">Código</th>
									<th style="width:20%;" class="tiny-row align-center">Descripción</th>
									<th style="width:5%;" class="tiny-row align-center">Id. Barrado</th>
									<th style="width:5%;" class="tiny-row align-center">Cod. Prov</th>
									<th style="width:5%;" class="tiny-row align-center">Días Ult. RP</th>
									<th style="width:5%;" class="tiny-row align-center">OC Pend</th>
									<th style="width:5%;" class="tiny-row align-center">Stock</th>
									<th style="width:5%;" class="tiny-row align-center">Stock en Tránsito</th>
									<th style="width:5%;" class="tiny-row align-center">Stock a Facturar</th>
									<th style="width:5%;" class="tiny-row align-center">Unidad Pres.</th>
									<th style="width:5%;" class="tiny-row align-center">UM</th>
									<th style="width:5%;" class="tiny-row align-center">Pedido Bultos</th>
									<th style="width:5%;" class="tiny-row align-center">Cantidad</th>
									<th style="width:5%;" class="tiny-row align-center">Costo</th>
									<th style="width:5%;" class="tiny-row align-center">Costo Total</th>
									<th style="width:5%;" class="tiny-row align-center">Pallet</th>
									<th style="width:0%; display:none;">pg_id</th>
									<th style="width:0%; display:none;">rub_id</th>
								</tr>
							</thead>
						</table>
					</div>
				</div>
				<div>
				</div>
			</div>
		</div>
		<div class="row d-flex p-2 flex-fill">
			<div class="col-2"></div>
			<div id="divPaginacion" class="">
			</div>
			<div class="col-2"></div>
		</div>
		<div class="collapse" id="divFiltro" style="">
			@Html.Hidden("pagEstado", false);
		</div>
	</div>
	<div id="divInfoAdicionaDeProducto" class="collapse"></div>
</div>

@section scripts {
	<script type="text/javascript">
		var tipoDeOperacion = "PI";
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "BuscarProductos";
		var pedido = "";
		var pIdSeleccionado = "";
		
		var buscarFamiliaDesdeProveedorSeleccionadoUrl = "@Url.Action("BuscarFamiliaDesdeProveedorSeleccionado", "ndecypi", new { area = "Compras" })";
		var autoComRel01Url = "@Url.Action("BuscarProvs", "ndecypi", new { area = "Compras" })";
		var autoComRel02Url = "@Url.Action("BuscarRubros", "ndecypi", new { area = "Compras" })";
		var autoComRel03Url = "@Url.Action("BuscarFlias", "ndecypi", new { area = "Compras" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "ndecypi", new { area = "Compras" })";
		var BuscarProductosOCPI2URL = "@Url.Action("BuscarProductosOCPI2", "ndecypi", new { area = "Compras" })";
		var CargaPedidoOCPIURL = "@Url.Action("CargaPedidoOCPI", "ndecypi", new { area = "Compras" })";
		var BuscarRubrosURL = "@Url.Action("ObtenerRubros", "ndecypi", new { area = "Compras" })";
		var BuscarProveedoresFamiliaURL = "@Url.Action("ObtenerProveedoresFamilia", "ndecypi", new { area = "Compras" })";
		var busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun" })";

		/*URL para componente de Información Adicional de Productos*/
		var abrirComponenteDeInfoAdicionalDeProdUrl = "@Url.Action("AbrirComponente", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdURL = "@Url.Action("BuscarInfoProd", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdStkAURL = "@Url.Action("BuscarInfoProdStkA", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdStkDURL = "@Url.Action("BuscarInfoProdStkD", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdStkBoxURL = "@Url.Action("BuscarInfoProdStkBox", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdMovMensURL = "@Url.Action("BuscarInfoProdMovMens", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdMovSemURL = "@Url.Action("BuscarInfoProdMovSem", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdMovDURL = "@Url.Action("BuscarInfoProdMovD", "infoadicionaldeprod", new { area = "ControlComun" })";
		var BuscarInfoProdSustitutoURL = "@Url.Action("BuscarInfoProdSustituto", "infoadicionaldeprod", new { area = "ControlComun" })";
		/**/
	</script>
	<script src="~/js/plugins/jquery.simplePagination.js"></script>
	<script src="~/js/app/siteGen.js"></script>@**@
	<script src="~/js/app/areas/ndecypi/comun.js"></script>
	<script src="~/js/app/areas/ndecypi/pi.js"></script>
	<script src="~/js/app/busquedas.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/rpr.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/infoRpr.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/infoAdicionalDeProd.js" type="text/javascript"></script>
}