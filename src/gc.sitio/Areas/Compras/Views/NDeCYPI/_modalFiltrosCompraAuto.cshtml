@model FiltroCompraAutoModel

<style>
    .hidden {
        display: none !important;
    }

    .section-title {
        font-weight: bold;
        margin-top: 5px;
        margin-bottom: 5px;
        font-size: 1rem;
    }

    .alinear-vertical {
        display: flex;
        align-items: center;
    }

    .alinear-arriba {
        display: flex;
        align-items: flex-start; /* Alinea arriba */
        gap: 8px; /* Espacio entre checkbox y select */
    }

    .promo-inline {
        display: flex;
        align-items: center;
        gap: 8px; /* espacio entre checkbox y input */
    }

    .promo-input {
        width: 60px; /* tamaño compacto */
        padding-left: 4px;
        padding-right: 4px;
    }

</style>

<div id="divInputsModal">

    <!-- HEADER -->
    <div class="modal-header">
        <h5 class="modal-title">@Model.Titulo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">

        <!-- ========================= -->
        <!-- 1) OPCIONES (RADIO + CHECKS) -->
        <!-- ========================= -->

        <div class="section-title">Opciones</div>

        <!-- FILA 1: Radios + inputs date -->
        <div class="row mt-2">

            <!-- Ventas Ult. 30 días -->
            <div class="col-sm-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="optFiltro" id="optVta30" value="VTA30">
                    <label class="form-check-label fw-bold" for="optVta30">
                        Ventas Últ. 30 días
                    </label>
                </div>
            </div>

            <!-- Ventas entre + fechas en la misma línea -->
            <div class="col-sm-6 d-flex align-items-center">

                <!-- Radio -->
                <div class="form-check me-2">
                    <input class="form-check-input" type="radio" name="optFiltro" id="optVtaEntre" value="VTAENTRE">
                    <label class="form-check-label fw-bold" for="optVtaEntre">
                        Ventas entre
                    </label>
                </div>

                <!-- Inputs Desde / Hasta -->
                <input type="date" class="form-control form-control-sm me-1" id="VentaDiariaDesde" style="max-width: 120px;">
                Y
                <input type="date" class="form-control form-control-sm" id="VentaDiariaHasta" style="max-width: 120px;">

            </div>
        </div>

        <!-- FILA 2: Checkboxes alineados -->
        <div class="row mt-2">

            <!-- Check debajo de Ventas Ult. 30 días -->
            <div class="col-sm-6">
                <div class="form-check" id="divChkCotizaciones">
                    <input class="form-check-input" type="checkbox" id="chkCotizaciones">
                    <label class="form-check-label" for="chkCotizaciones">
                        Excluir Vtas. Cotizaciones de Licitaciones
                    </label>
                </div>
            </div>

            <!-- Check + input debajo de Ventas entre -->
            <div class="col-sm-6">

                <div class="promo-inline" id="divChkPromos">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" id="chkExcluirPromos">
                        <label class="form-check-label" for="chkExcluirPromos">
                            Excluir % de Vtas. de Ofertas y Promos
                        </label>
                    </div>

                    <input type="text" class="form-control form-control-sm promo-input align-right" id="txtPorcPromos" disabled>
                </div>

            </div>

        </div>

        <!-- FILA 3: Radios Proyección / Última OC -->
        <div class="row mt-3">
            <div class="col-sm-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="optFiltro" id="optProy" value="PROY">
                    <label class="form-check-label fw-bold" for="optProy">
                        Proyección de Ventas
                    </label>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="optFiltro" id="optUltOC" value="ULTOC">
                    <label class="form-check-label fw-bold" for="optUltOC">
                        Tomar Última OC
                    </label>
                </div>
            </div>
        </div>



        <!-- ========================= -->
        <!-- COMPRAR PARA -->
        <!-- ========================= -->
        <div class="section-title">Comprar para</div>

        <div class="row mt-2">

            <!-- Checkbox + SelectList -->
            <div class="col-sm-6 alinear-arriba">
                <div class="form-check me-2">
                    <input class="form-check-input" type="checkbox" id="chkSucursales">
                    <label class="form-check-label fw-bold" for="chkSucursales">Sucursales</label>
                </div>

                @Html.DropDownListFor(m => m.SelectedValue, Model.ListaSucursales, "Seleccionar",
                    new { @id = "listaSucursalesModal", @class = "form-control form-control-sm ms-2", disabled = "disabled" })
            </div>

            <!-- ListBox -->
            <div class="col-sm-6 alinear-arriba">
                @Html.ListBox("SucursalesListModal", null,
                    new { @class = "form-control listbox-sm", disabled = "disabled" })
            </div>

        </div>

        <!-- ========================= -->
        <!-- EXISTENCIAS -->
        <!-- ========================= -->

        <div class="section-title">Existencias</div>

        <div class="row mt-2">

            <!-- Checkbox + label alineado al select -->
            <div class="col-sm-6 alinear-arriba">
                <div class="form-check me-2">
                    <input class="form-check-input" type="checkbox" id="chkDepositos">
                    <label class="form-check-label fw-bold" for="chkDepositos">Depósitos</label>
                </div>

                @Html.DropDownListFor(m => m.SelectedValue, Model.ListaDepositos, "Seleccionar",
                    new { @id = "listaDepositosModal", @class = "form-control form-control-sm", disabled = "disabled" })
            </div>

            <!-- ListBox -->
            <div class="col-sm-6 alinear-arriba">
                @Html.ListBox("DepositosListModal", null,
                    new { @class = "form-control listbox-sm", disabled = "disabled" })
            </div>

        </div>


        <!-- ========================= -->
        <!-- 4) DÍAS DE APROVISIONAMIENTO -->
        <!-- ========================= -->
        <div class="row mt-3">
            <div class="col-sm-3">
                <label class="input-group-text fw-bold">Días de Aprovisionamiento:</label>
            </div>
            <div class="col-sm-1">
                <input type="text" asp-for="DiasAprov" id="DiasAprov"
                       class="form-control form-control-sm align-right" value="30" />
            </div>
        </div>

        <!-- ========================= -->
        <!-- 5) CHECKS FINALES -->
        <!-- ========================= -->
        <div class="row mt-3">
            <div class="col-sm-12">

                <!-- NUEVO -->
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" asp-for="PedidoConPisoPalletCompleto">
                    <label class="form-check-label" for="PedidoConPisoPalletCompleto">
                        Pedido con Piso Pallet Completo
                    </label>
                </div>

                <!-- Renombrado -->
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" asp-for="ExcluirOCPendientes" />
                    <label class="form-check-label" for="ExcluirOCPendientes">
                        Excluir OC Pendientes con plazo de Entrega no vencido
                    </label>
                </div>

                <!-- Ya existentes -->
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" asp-for="LimitarPedidoACompletar" />
                    <label class="form-check-label" asp-for="LimitarPedidoACompletar">
                        Limitar Pedido a completar Stock Máximo definido por Sucursal
                    </label>
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" asp-for="LimitarPedidoParaCumplir" />
                    <label class="form-check-label" asp-for="LimitarPedidoParaCumplir">
                        Limitar Pedido para cumplir con Stock Mínimo definido por Sucursal
                    </label>
                </div>

            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <div class="modal-footer">
        <button type="button" class="btn btn-success btn-sm" id="btnCompraAutoBuscar" style="width:100px;">
            <i class="bx bx-badge-check"></i> Confirmar
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="width:100px;">
            <i class="bx bx-log-out-circle"></i> Salir
        </button>
    </div>

</div>
