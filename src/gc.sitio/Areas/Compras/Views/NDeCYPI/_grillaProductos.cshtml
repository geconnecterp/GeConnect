@model BuscarProductosOCPI2Model;
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;

	string grupoActual = string.Empty;
	string grupoAnterior = string.Empty;

	decimal totalCosto = 0;
	decimal totalPallet = 0;
}
@section styles {
	<link rel="stylesheet" href="~/css/compras/ndecypi/ndecypi.css" />
}
<style>
	.bg-pedido-m {
		background-color: lightgreen !important;
	}

	.bg-pedido-a {
		background-color: #6cc6f3 !important;
	}

	#containerListaProducto {
		position: relative;
		height: 600px;
		max-height: 600px;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
		background: #fff; /* evita que el footer se mezcle con el fondo */
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbListaProducto th,
	#tbListaProducto td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbListaProducto tr {
		height: 1.6rem !important;
	}

	.th-descripcion {
		position: relative;
		text-align: center;
		vertical-align: middle;
		width: 25%;
	}

		.th-descripcion .th-title {
			display: inline-block;
		}

	.btn-info-producto {
		position: absolute;
		right: 4px; /* margen a la derecha */
		top: 50%;
		transform: translateY(-50%);
		background: transparent !important;
		border: none !important;
		padding: 0;
		color: #fff; /* o el color del header */
		cursor: pointer;
	}

		.btn-info-producto i {
			font-size: 1rem;
			line-height: 1;
		}

	#tbListaProducto tfoot {
		position: sticky;
		bottom: 0;
		z-index: 2;
	}

		#tbListaProducto tfoot .total-row {
			border-top: 2px solid #999;
			background-color: #e9ecef; /* igual que table-secondary */
		}
</style>
<div class="table-responsive table-wrapper-full-width" id="containerListaProducto">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProducto">
		<thead>
			<tr class="header">
				<th style="width:4%;" class="align-center tiny-row">Código</th>
				<th class="th-descripcion">
					<span class="th-title">Descripción</span>
					<button type="button"
							class="btn btn-info-producto"
							data-action="info-producto"
							title="Abrir info de producto">
						<i class="bx bx-info-circle"></i>
					</button>
				</th>
				<th style="width:6%;" class="align-center">Id. Barrado</th>
				<th style="width:5%;" class="align-center tiny-row">Cod. Prov</th>
				@if (Model.Tipo == "PI")
				{
					<th style="width:5%;" class="align-center tiny-row" title="Días de Última Transferencia">Días Ult. Transf.</th>
					<th style="width:5%;" class="align-center tiny-row" title="Pedido Interno Pendiente">PI Pend</th>
				}
				else
				{
					<th style="width:5%;" class="align-center tiny-row">Días Ult. RP</th>
					<th style="width:5%;" class="align-center tiny-row">OC Pend</th>
				}
				<th style="width:5%;" class="align-center tiny-row">Stock Suc</th>
				<th style="width:5%;" class="align-center tiny-row">Stock Tot</th>
				<th style="width:0%; display:none;" class="align-center tiny-row">Stock a Facturar</th>
				<th style="width:5%;" class="align-center tiny-row">Unidad Pres.</th>
				<th style="width:4%;" class="align-center tiny-row">Unidad Pallet</th>
				<th style="width:5%;" class="align-center tiny-row">Pedido Bultos</th> @* 10 *@
				<th style="width:5%;" class="align-center tiny-row">Pedido Cantidad</th>
				<th style="width:7%;" class="align-center tiny-row">Precio Costo</th>
				<th style="width:7%;" class="align-center tiny-row">Total Costo</th>
				<th style="width:5%;" class="align-center tiny-row">Total Pallet</th>
				<th style="width:0%; display:none;">pg_id</th>
				<th style="width:0%; display:none;">rub_id</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatosProductos != null && Model.ListaDatosProductos.ListaDatos != null && Model.ListaDatosProductos.ListaDatos.Count > 0)
			{
				var productos = Model.ListaDatosProductos.ListaDatos.OrderBy(x => x.cta_id).ThenBy(y => y.pg_id).ThenBy(z => z.p_orden_pg).ToList();
				
				@foreach (var item in productos)
				{
					grupoActual = item.cta_id + item.pg_id;
					if (grupoActual != grupoAnterior)
					{
						var leyenda = $"Prov: {item.cta_id} {item.cta_denominacion} Familia: {item.pg_id} {item.pg_desc}";
						<tr class="table-secondary fw-bold">
							<td colspan="15" class="text-center">
								<i class="bx bx-folder me-1"></i>
								@leyenda
							</td>
						</tr>
						grupoAnterior = grupoActual;
						alt = true; 
					}

					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase"
						data-id="@item.p_id"
						data-cta-id="@item.cta_id"
						data-cta-denominacion="@item.cta_denominacion"
						data-pedido-tipo="@item.pedido_tipo"
						onclick="selectListaProductoRow(this)">
						<td class="align-center tiny-row">@item.p_id</td>
						@if (item.p_activo == "D")
						{
							<td class="align-left tiny-row">@item.p_desc<span style="float:right;" title="Producto discontínuo"><i class="bx bx-dislike"></i></span></td>
						}
						else
						{
							<td class="align-left tiny-row">@item.p_desc</td>
						}
						<td class="align-center tiny-row">@item.p_id_barrado</td>
						<td class="align-center tiny-row">@item.p_id_prov</td>
						@if(Model.Tipo == "PI")
						{
							<td class="align-right tiny-row">@item.re_dias</td>
							<td class="align-right tiny-row" style="font-weight:bold;">@item.pi_pendiente</td>
						}
						else
						{
							<td class="align-right tiny-row">@item.rp_dias</td>
							<td class="align-right tiny-row" style="font-weight:bold;">@item.oc_pendiente</td>
						}
						<td class="align-right tiny-row">@GridHelper.FormatearDato(item.stk_suc, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td class="align-right tiny-row">@GridHelper.FormatearDato(item.stk, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						<td style="display:none;">@item.stk_suc_comprometido</td>
						<td class="align-right tiny-row">@item.p_unidad_pres</td>
						<td class="align-right tiny-row">@item.p_unidad_palet</td>
						<td style="width:5%;"
							class="columna-bulto @Model.ListaDatosProductos.ObtenerClase(item.pedido)
								   @(item.pedido > 0 && item.pedido_tipo == "M" ? "bg-pedido-m" : "")
								   @(item.pedido > 0 && item.pedido_tipo == "A" ? "bg-pedido-a" : "")">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-bulto input-numeric"
									   value="@(item.pedido)"
									   data-field="pedido"
									   data-id="@item.p_id"
									   data-original-value="@(item.pedido)" />
							</div>
						</td>

						@if (item.pedido == 0)
						{
							<td class="align-right tiny-row">@item.cantidad</td>
							<td class="align-right tiny-row">
								@GridHelper.FormatearPrecio(item.costo, TipoPrecio.Costo)
							</td>
							<td class="align-right tiny-row" style="font-weight:bold;">
								@GridHelper.FormatearPrecio(item.costo_total, TipoPrecio.Venta)
							</td>
						}
						else
						{
							if (item.pedido_tipo == "M")
							{
								<td class="align-right tiny-row" style="background-color: lightgreen;">@item.cantidad</td>
								<td class="align-right tiny-row" style="background-color: lightgreen;">@GridHelper.FormatearPrecio(item.costo, TipoPrecio.Costo)</td>
								<td class="align-right tiny-row" style="background-color: lightgreen;font-weight:bold;">@GridHelper.FormatearPrecio(item.costo_total, TipoPrecio.Venta)</td>
							}
							else
							{
								<td class="align-right tiny-row" style="background-color: #6cc6f3;">@item.cantidad</td>
								<td class="align-right tiny-row" style="background-color: #6cc6f3;">@GridHelper.FormatearPrecio(item.costo, TipoPrecio.Costo)</td>
								<td class="align-right tiny-row" style="background-color: #6cc6f3;font-weight:bold;">@GridHelper.FormatearPrecio(item.costo_total, TipoPrecio.Venta)</td>
							}
						}
						<td class="align-right tiny-row">@item.paletizado</td>
						<td style="display:none;">@item.pg_id</td>
						<td style="display:none;">@item.rub_id</td>
					</tr>
				}
				
				totalCosto = productos.Sum(x => x.costo_total);
				totalPallet = productos.Sum(x => x.paletizado);
			}
		</tbody>
		<tfoot>
			<tr class="table-secondary fw-bold total-row">
				<td colspan="12" class="text-end">Total:</td>

				<td class="align-right tiny-row" style="font-weight:bold;">
					@GridHelper.FormatearPrecio(totalCosto, TipoPrecio.Costo)
				</td>
				<td class="align-right tiny-row" style="font-weight:bold;">
				</td>
				<td class="align-right tiny-row" style="font-weight:bold;">
					@totalPallet
				</td>

				<td style="display:none;"></td>
				<td style="display:none;"></td>
			</tr>
		</tfoot>
	</table>
</div>
<script>
	$(function() {
			// Esta función aplica los indicadores visuales a los campos modificados en la carga inicial
			$('.campo-modificado').each(function() {
				// Solo si no tiene ya un indicador
				if ($(this).parent('.input-container').find('.indicador-cambio').length === 0) {
					$(this).parent('.input-container').append('<div class="indicador-cambio"></div>');
				}
			});
		});
</script>

@section scripts {
	<script type="text/javascript">
		var pedido = "";
		var pIdEditado = "";
		var rowIndex = 0;
	</script>
}