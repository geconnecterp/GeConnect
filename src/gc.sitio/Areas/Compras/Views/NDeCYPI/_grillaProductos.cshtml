@model GridCoreSmart<ProductoNCPIDto>
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;

	string grupoActual = string.Empty;
	string grupoAnterior = string.Empty;
}
@section styles {
	<link rel="stylesheet" href="~/css/compras/ndecypi/ndecypi.css" />
}
<style>
	.bg-pedido-m {
		background-color: lightgreen !important;
	}

	.bg-pedido-a {
		background-color: #6cc6f3 !important;
	}

	/* El contenedor debe ser el scroll real y generar contexto */
	#containerListaProducto {
		position: relative;
		height: 600px;
		max-height: 600px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbListaProducto th,
	#tbListaProducto td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	/* Opcional: altura fija para todas las filas */
	#tbListaProducto tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}

</style>
<div class="table-responsive table-wrapper-full-width" id="containerListaProducto">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProducto">
		<thead>
			<tr class="header">
				<th style="width:5%;" class="align-center tiny-row">Código</th>
				<th style="width:20%;" class="align-center tiny-row">Descripción</th>
				<th style="width:5%;" class="align-center">Id. Barrado</th>
				<th style="width:5%;" class="align-center tiny-row">Cod. Prov</th>
				<th style="width:5%;" class="align-center tiny-row">Días Ult. RP</th>
				<th style="width:5%;" class="align-center tiny-row">OC Pend</th>
				<th style="width:5%;" class="align-center tiny-row">Stock Suc</th>
				<th style="width:5%;" class="align-center tiny-row">Stock Tot</th>
				<th style="width:0%; display:none;" class="align-center tiny-row">Stock a Facturar</th>
				<th style="width:5%;" class="align-center tiny-row">Unidad Pres.</th>
				<th style="width:5%;" class="align-center tiny-row">Unidad Pallet</th>
				<th style="width:5%;" class="align-center tiny-row">Pedido Bultos</th> @* 10 *@
				<th style="width:5%;" class="align-center tiny-row">Pedido Cantidad</th>
				<th style="width:5%;" class="align-center tiny-row">Precio Costo</th>
				<th style="width:5%;" class="align-center tiny-row">Total Costo</th>
				<th style="width:5%;" class="align-center tiny-row">Total Pallet</th>
				<th style="width:0%; display:none;">pg_id</th>
				<th style="width:0%; display:none;">rub_id</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				var productos = Model.ListaDatos.OrderBy(x => x.cta_id).ThenBy(y => y.pg_id).ThenBy(z => z.p_orden_pg).ToList();
				@foreach (var item in productos)
				{
					grupoActual = item.cta_id + item.pg_id;
					// Si cambia la cuenta+grupo, insertamos una fila de encabezado
					if (grupoActual != grupoAnterior)
					{
						var leyenda = $"Prov: {item.cta_id} {item.cta_denominacion} Familia: {item.pg_id} {item.pg_desc}";
						<tr class="table-secondary fw-bold">
							<td colspan="15" class="text-center">
								<i class="bx bx-folder me-1"></i>
								@leyenda
							</td>
						</tr>
						grupoAnterior = grupoActual;
						alt = true; // Reiniciar alternancia de colores después de cada familia
					}

					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase"
						data-id="@item.p_id"
						data-cta-id="@item.cta_id"
						data-cta-denominacion="@item.cta_denominacion"
						data-pedido-tipo="@item.pedido_tipo"
						onclick="selectListaProductoRow(this)">
						<td class="align-center tiny-row">@item.p_id</td>
						@if (item.p_activo == "D")
						{
							<td class="align-left tiny-row">@item.p_desc<span style="float:right;" title="Producto discontínuo"><i class="bx bx-dislike"></i></span></td>
						}
						else
						{
							<td class="align-left tiny-row">@item.p_desc</td>
						}
						<td class="align-center tiny-row">@item.p_id_barrado</td>
						<td class="align-center tiny-row">@item.p_id_prov</td>
						<td class="align-right tiny-row">@item.rp_dias</td>
						@if (item.oc_pendiente == 0)
						{
							<td class="align-right tiny-row"></td>
						}
						else
						{
							<td class="align-right tiny-row" style="font-weight:bold;">@item.oc_pendiente</td>
						}
						<td class="align-right tiny-row">@item.stk_suc</td>
						<td class="align-right tiny-row">@item.stk</td>
						<td style="display:none;">@item.stk_suc_comprometido</td>
						<td class="align-right tiny-row">@item.p_unidad_pres</td>
						<td class="align-right tiny-row">@item.p_unidad_palet</td>
						<td style="width:5%;" 
							class="columna-bulto @Model.ObtenerClase(item.pedido)
						   @(item.pedido > 0 && item.pedido_tipo == "M" ? "bg-pedido-m" : "")
						   @(item.pedido > 0 && item.pedido_tipo == "A" ? "bg-pedido-a" : "")">
							<div class="input-container">
								<input type="text" class="form-control form-control-sm input-bulto input-numeric"
									   value="@(item.pedido)"
									   data-field="pedido"
									   data-id="@item.p_id"
									   data-original-value="@(item.pedido)" />
							</div>
						</td>

						@if (item.pedido == 0)
						{
							<td class="align-right tiny-row">@item.cantidad</td>
							<td class="align-right tiny-row">@item.costo</td>
							<td class="align-right tiny-row">@item.costo_total</td>
						}
						else
						{
							if (item.pedido_tipo == "M")
							{
								<td class="align-right tiny-row" style="background-color: lightgreen;">@item.cantidad</td>
								<td class="align-right tiny-row" style="background-color: lightgreen;">@item.costo</td>
								<td class="align-right tiny-row" style="background-color: lightgreen;">@item.costo_total</td>
							}
							else
							{
								<td class="align-right tiny-row" style="background-color: #6cc6f3;">@item.cantidad</td>
								<td class="align-right tiny-row" style="background-color: #6cc6f3;">@item.costo</td>
								<td class="align-right tiny-row" style="background-color: #6cc6f3;">@item.costo_total</td>
							}
						}
						<td class="align-right tiny-row">@item.paletizado</td>
						<td style="display:none;">@item.pg_id</td>
						<td style="display:none;">@item.rub_id</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
