@model GridCoreSmart<ValoresDesdeObligYCredDto>
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#tbListaValores_Paso2 thead th {
		color: #1565c0 !important; /* azul profesional */
		font-weight: bold;
	}
</style>
<div class="col-11 mt-2 table-responsive table-wrapper-200" id="containerValores_Paso2" style="padding-right: 0px;width: 100%;">
	<table class="table table-bordered table-hover table-golden" id="tbListaValores_Paso2">
		<thead>
			<tr>
				<th style="width:35%;" class="col-header-small align-center tiny-row">Cuenta Financiera</th>
				<th style="width:55%;" class="col-header-small align-center tiny-row">Valor</th>
				<th style="width:10%;" class="col-header-small align-center tiny-row">Importe</th>
				<th style="width:0%; display:none;">orden</th>
				<th style="width:0%; display:none;">dia_movi</th>
				<th style="width:0%; display:none;">fc_compte</th>
				<th style="width:0%; display:none;">fc_item</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbListaValores_Paso2')" ondblclick="selectRegDblGrillaValores(this);">
						<td class="@Model.ObtenerClase(item.ctaf_denominacion) cell-fit-content">@Model.FormatearDato(item.ctaf_denominacion, FormatDato.Ninguno)</td>
						<td class="@Model.ObtenerClase(item.concepto_valor) cell-fit-content">@Model.FormatearDato(item.concepto_valor, FormatDato.Monto)</td>
						<td class="@Model.ObtenerClase(item.op_importe) text-end cell-fit-content">@GridHelper.FormatearDato(item.op_importe, FormatDato.Monto, true)</td>
						<td style="display:none;">@item.orden</td>
						<td style="display:none;">@item.fc_dia_movi</td>
						<td style="display:none;">@item.fc_compte</td>
						<td style="display:none;">@item.fc_item</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>