@model CargarNuevasObligacionesModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}
	#tbListaObligacionesParaAgregar tbody td {
		padding-top: 2px !important;
		padding-bottom: 2px !important;
		line-height: 1.6 !important;
	}

	#tbListaObligacionesParaAgregar thead th {
		color: #c62828 !important; /* rojo profesional */
		font-weight: bold;
	}
</style>
@Html.Hidden("MsgErrorEnCargarOSacarObligaciones", Model.MsgErrorEnCargarOSacarObligaciones)
<div class="table-responsive table-wrapper-200" id="containerListaObligacionesParaAgregar">
	<table class="table table-bordered table-hover table-golden" id="tbListaObligacionesParaAgregar">
		<thead>
			<tr>
				<th style="width:60%;" class="col-header-small align-center tiny-row">Comprobante</th>
				<th style="width:10%;" class="col-header-small align-center tiny-row">Cuota</th>
				<th style="width:10%;" class="col-header-small align-center tiny-row">Vencimiento</th>
				<th style="width:10%;" class="col-header-small align-center tiny-row">Importe</th>
				<th style="width:10%;" class="col-header-small align-center tiny-row">Imputado</th>
				<th style="width:0%;display:none;" class="col-header-small align-center tiny-row">dia_movi</th>
				<th style="width:0%;display:none;" class="col-header-small align-center tiny-row">cm_compte</th>
				<th style="width:0%;display:none;" class="col-header-small align-center tiny-row">tco_id</th>
				<th style="width:0%;display:none;" class="col-header-small align-center tiny-row">cta_id</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaObligacionesNuevas.ListaDatos != null && Model.GrillaObligacionesNuevas.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaObligacionesNuevas.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbListaObligacionesParaAgregar')" ondblclick="selectRegDbl(this, 'tbListaObligacionesParaAgregar')">
						<td class="@Model.GrillaObligacionesNuevas.ObtenerClase(item.concepto) cell-fit-content">@Model.GrillaObligacionesNuevas.FormatearDato(item.concepto, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaObligacionesNuevas.ObtenerClase(item.cm_compte_cuota) cell-fit-content">@Model.GrillaObligacionesNuevas.FormatearDato(item.cm_compte_cuota, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaObligacionesNuevas.ObtenerClase(item.cv_fecha_vto) cell-fit-content">@Model.GrillaObligacionesNuevas.FormatearDato(item.cv_fecha_vto, FormatDato.Fecha)</td>
						<td class="@Model.GrillaObligacionesNuevas.ObtenerClase(item.cv_importe) text-end cell-fit-content">@GridHelper.FormatearDato(item.cv_importe, FormatDato.Monto, true)</td>
						<td class="@Model.GrillaObligacionesNuevas.ObtenerClase(item.cv_imputado) text-end cell-fit-content">@GridHelper.FormatearDato(item.cv_imputado, FormatDato.Monto, true)</td>
						<td style="display:none;">@item.dia_movi</td>
						<td style="display:none;">@item.cm_compte</td>
						<td style="display:none;">@item.tco_id</td>
						<td style="display:none;">@item.cta_id</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>