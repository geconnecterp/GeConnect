@model GridCoreSmart<RetencionesDesdeObligYCredDto>
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#tbListaRetenciones_Paso2 thead th {
		color: #1565c0 !important; /* azul profesional */
		font-weight: bold;
		border-left: none !important;
		border-right: none !important;
	}
</style>
<div class="table-responsive table-wrapper-100" id="containerRetenciones_Paso2" style="padding-right:0px;">
	<table class="table table-bordered table-hover table-golden" id="tbListaRetenciones_Paso2">
		<thead>
			<tr>
				<th style="width:75%;" class="col-header-small align-center tiny-row">Retenciones</th>
				<th style="width:25%;" class="col-header-small align-center tiny-row">Importes</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbListaRetenciones_Paso2')" ondblclick="selectRegDbl(this, 'tbListaRetenciones_Paso2')">
						<td class="@Model.ObtenerClase(item.concepto_retencion) cell-fit-content">@Model.FormatearDato(item.concepto_retencion, FormatDato.Ninguno)</td>
						<td class="@Model.ObtenerClase(item.retencion) text-end cell-fit-content">@GridHelper.FormatearDato(item.retencion, FormatDato.Monto, true)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
