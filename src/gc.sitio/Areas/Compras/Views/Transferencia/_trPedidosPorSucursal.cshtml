@model GridCoreSmart<TRAutPIDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<div class="table-responsive text-nowrap table-wrapper">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaPedidosSucursal">
		<thead>
			<tr class="header">
				<th style="width:15%;" class="align-center">N° PI</th>
				<th style="width:10%;" class="align-center">Fecha</th>
				<th style="width:10%;" class="align-center">Estado</th>
				<th style="width:30%;" class="align-center">Nota</th>
				<th style="width:15%;" class="align-center">Tipo</th>
				<th style="width:10%;" class="align-center">Det</th>
				<th style="width:10%;" class="align-center">Carga</th>
				<th style="width:0%; display:none;">adm_id</th>
				<th style="width:0%; display:none;">adm_desc</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectTRPedidoSucursalRow(this)">
						<td class="align-center">@item.pi_compte</td>
						<td class="align-center">@item.pi_fecha.ToString("dd/MM/yyyy")</td>
						<td class="align-left">@item.pie_desc</td>
						<td>@item.pi_nota</td>
						<td>@item.pit_desc</td>
						<td class="text-center align-middle">
							<button type="button" class="btn btn-info btn-sm btn-icon-compact" data-interaction="@item.pi_compte" onclick="verDetalleDePedido(this);" tabindex="-1">
								<i class="bx bx-show"></i>
							</button>
						</td>
						<td class="text-center align-middle">
							<button type="button" class="btn btn-primary btn-sm btn-icon-compact" data-interaction="@item.pi_compte" onclick="agregarAPedidosIncl(this);" tabindex="-1">
								<i class="bx bx-plus-circle"></i>
							</button>
						</td>
						<td style="display:none;">@item.adm_id</td>
						<td style="display:none;">@item.adm_desc</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
