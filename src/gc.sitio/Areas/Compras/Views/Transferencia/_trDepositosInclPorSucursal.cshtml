@model GridCoreSmart<TRAutDepoDto>

<div class="table-responsive text-nowrap table-wrapper">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbDepositosDeEnvio">
		<thead>
			<tr class="header">
				<th style="width:80%;" class="align-center">Depósito</th>
				<th style="width:20%;" class="align-center">Sele</th>
				<th style="width:0%; display:none;">depo_id</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					<tr onclick="selectTRDepositosDeEnvioRow(this)">
						<td class="align-left">@item.depo_nombre</td>
						<td><input type="checkbox" name="tienePI" id="chkTienePI" value="@item.seleccionado" @((item.seleccionado == false ? "" : "checked")) /></td>
						<td style="width:0%; display:none;">@item.depo_id</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>