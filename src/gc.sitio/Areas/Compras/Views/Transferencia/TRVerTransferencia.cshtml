@model TRVerTransferenciaDto
@{
	var alt = true;
	string clase = string.Empty;
	Layout = "~/views/shared/_Layout.cshtml";
}
<style>

	.card,
	.card-body,
	#formulario {
		overflow: visible !important;
	}

	.table-wrapper {
		max-height: 650px;
		overflow-y: auto;
		overflow-x: hidden;
		position: relative;
	}

	.table-golden thead {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: inherit;
	}

	.diferencia-cero {
		background-color: #d4edda !important; /* verde suave */
		color: #155724 !important; /* texto verde oscuro */
		font-weight: bold !important;
	}

	.diferencia-no-cero {
		background-color: #f8d7da !important; /* rojo suave */
		color: #721c24 !important; /* texto rojo oscuro */
		font-weight: bold !important;
	}

	.icon-warning {
		color: #dc3545; /* rojo Bootstrap */
		margin-left: 6px;
		cursor: pointer;
	}

	.icon-arrow {
		font-size: 0.75rem !important;
		line-height: 0 !important;
		padding: 0 !important;
		margin: 0 !important;
		border: none !important;
		display: inline-flex !important;
		align-items: center !important;
	}

	.td-conteo {
		display: table;
		width: 100%;
	}

	.td-icon {
		display: table-cell;
		vertical-align: middle;
		width: 1%;
	}

	.td-value {
		display: table-cell;
		vertical-align: middle;
		text-align: right;
		padding-left: 4px;
	}

	.tr-detalle {
		background-color: #f8f9fa;
	}

	.subtabla-wrapper {
		padding: 4px 8px;
		background-color: #ffffff;
		border-left: 3px solid #0dc556; /* verde Golden */
		border-right: 3px solid #0dc556;
		border-bottom: 3px solid #0dc556;
	}
</style>
<div class="card w-75 mx-auto">
	<div class="card-body" style="padding: 5px;">
		<div class="row">
			@Html.Hidden("ti", Model.ti)
			@Html.Hidden("tipo", Model.Tipo)
			<div>
				<div class="d-flex align-items-center flex-wrap gap-2">
					<span class="badge bg-primary">@Model.Autorizacion</span>
					<span class="badge bg-info">@Model.TipoTR</span>
					<span class="badge bg-secondary">@Model.Destino</span>

					<div class="ms-auto">
						<button id="btnConfirmar" style="width: 100px;" class="btn btn-success btn-sm me-1" type="button" title="Confirmar Transferencia" onclick="iniciarValidarAutorizacion();">
							<i class="bx bx-badge-check"></i> Confirmar
						</button>
						<button id="btnRegresar" style="width: 100px;" class="btn btn-secondary btn-sm" type="button" title="Volver" onclick="regresarATRLista();">
							<i class="bx bx-chevron-left"></i> Volver
						</button>
					</div>
				</div>
			</div>
		</div>
		<div class="grid-golden mt-2">
			<div class="grid-golden-header">
				<div class="row align-items-md-center">
					<div class="col-md-10 col-sm-6 d-flex align-items-center">
						<h5 class="mb-0 flex-grow-1">
							<i class="bx bx-package me-2"></i>
							<strong>Conteos</strong>
						</h5>
					</div>
					<div class="col-md-2 col-sm-6">
						<div class="d-flex justify-content-sm-end"></div>
					</div>
				</div>
			</div>
			<div id="divListaConteos" class="grid-golden-body">
				<div class="text-nowrap table-wrapper">
					<table class="table table-sm mb-0 table-hover table-golden" id="tbListaConteos">
						<thead>
							<tr class="header">
								<th style="width:8%;" class="align-center">ID</th>
								<th style="width:40%;text-align: center;">Descripcion</th>
								<th style="width:7%;" class="align-center">ID Prov</th>
								<th style="width:6%;" class="align-center"></th>
								<th style="width:7%;" class="align-center">UxB</th>
								<th style="width:8%;" class="align-center">Pedido</th>
								<th style="width:8%;" class="align-center">CONTEOS</th>
								<th style="width:8%;" class="align-center">CTL Salida</th>
								<th style="width:8%;" class="align-center">Diferencia</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.ListaTransferencias != null && Model.ListaTransferencias.ListaDatos != null && Model.ListaTransferencias.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.ListaTransferencias.ListaDatos)
								{
									if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
									<tr class="@clase" 
										data-p-id="@item.p_id"
										data-cantidad-pi="@item.cantidad_pi"
										data-cantidad="@item.cantidad"
										data-cantidad-c="@item.cantidad_c"
										data-diferencia="@item.Diferencia"
										onclick="selectTRRow(this)"
										ondblclick="dblClickTRRow(this)">
										<td class="align-center">@item.p_id</td>
										<td>
											@item.p_desc
											@if (item.cantidad == 0 && item.cantidad_c == 0)
											{
												<i class="bx bx-error-circle icon-warning"
												   title="Producto sin Conteos y Sin Control de Salida!"></i>
											}
										</td>
										<td class="align-center">@item.p_id_prov</td>
										<td class="text-center">
											@if (item.remplazo == 'S')
											{
												<span class="badge bg-danger" title="Producto con reemplazo">Reemp</span>
											}
										</td>
										<td style="text-align: right;">@item.unidad_pres</td>
										<td style="text-align: right;font-weight: bold;">@GridHelper.FormatearDato(item.cantidad_pi, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
										<td class="table-fontsize" style="font-weight: bold;">
											<div class="td-conteo">
												<span class="td-icon">
													@if (item.cantidad > item.cantidad_pi)
													{
														<i class="bx bx-up-arrow-alt text-info icon-arrow"></i>
													}
													else if (item.cantidad < item.cantidad_pi)
													{
														<i class="bx bx-down-arrow-alt text-danger icon-arrow"></i>
													}
												</span>

												<span class="td-value">
													@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)
												</span>
											</div>
										</td>
										<td class="table-fontsize" style="font-weight: bold;">
											<div class="td-conteo">
												<span class="td-icon">
													@if (item.cantidad_c == item.cantidad && item.cantidad > 0)
													{
														<i class="bx bx-check-circle text-success"></i>
													}
												</span>

												<span class="td-value">
													@GridHelper.FormatearDato(item.cantidad_c, GridHelper.FormatDato.Monto, item.PermiteDecimales)
												</span>
											</div>
										</td>
										@if (item.Diferencia == 0)
										{
											<td class="table-fontsize diferencia-cero d-flex justify-content-between align-items-center">
												<span>
													<i class="bx bx-check-circle text-success" title="Sin diferencia"></i>
												</span>
												<span class="ms-auto">
													@GridHelper.FormatearDato(item.Diferencia, GridHelper.FormatDato.Monto, item.PermiteDecimales)
												</span>
											</td>
										}
										else
										{
											<td class="table-fontsize diferencia-no-cero text-end">
												@GridHelper.FormatearDato(item.Diferencia, GridHelper.FormatDato.Monto, item.PermiteDecimales)
											</td>
										}
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var TRRegresarAAutorizacionesListaUrl = "@Url.Action("TRAutorizacionesLista", "transferencia", new { area = "Compras" })";
		var TRValidarTransferenciaUrl = "@Url.Action("ValidarTransferencia", "transferencia", new { area = "Compras" })";
		var TRConfirmarAutorizacionUrl = "@Url.Action("ConfirmarAutorizacion", "transferencia", new { area = "Compras" })";
		var TIVerProductosUrl = "@Url.Action("TIVerProductos", "transferencia", new { area = "Compras" })";
	</script>
	@* <script src="~/js/app/areas/transferencias/trAutorizacionesLista.js"></script> *@
	<script src="~/js/app/areas/transferencias/trVerTransferencia.js"></script>
}