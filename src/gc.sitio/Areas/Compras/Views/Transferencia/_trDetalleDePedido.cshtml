@model TRDetallePedidoDto
@{
	var alt = true;
	string clase = string.Empty;
	var pi_compte = string.Empty;
	if (Model != null && Model.Detalle != null && Model.Detalle.ListaDatos != null && Model.Detalle.ListaDatos.Count > 0)
	{
		pi_compte = Model.Detalle.ListaDatos.First().pi_compte;
	}
}
<div class="modal-header">
	<h5 class="modal-title" id="modalCenterTitle">@Model.Titulo</h5>
	<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
	<div class="table-responsive text-nowrap table-wrapper-xs">
		<table class="table table-sm mb-0 table-hover table-golden" id="tbDetalleDePedido">
			<thead>
				<tr class="header">
					<th style="width:10%;" class="align-center">PI</th>
					<th style="width:10%;" class="align-center">Orden</th>
					<th style="width:10%;" class="align-center">Prod ID</th>
					<th style="width:40%;" class="align-center">Descripción</th>
					<th style="width:10%;" class="align-center">Cantidad</th>
					<th style="width:10%;" class="align-center">Enviado</th>
					<th style="width:10%;" class="align-center">Stk</th>
				</tr>
			</thead>
			<tbody>
				@if (Model != null && Model.Detalle != null && Model.Detalle.ListaDatos != null && Model.Detalle.ListaDatos.Count > 0)
				{
					@foreach (var item in Model.Detalle.ListaDatos)
					{
						if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
						<tr class ="@clase" onclick="selectTRDetalleDePedido(this)">
							<td class="align-center">@item.pi_compte</td>
							<td class="align-center">@item.pid_item</td>
							<td class="align-center">@item.p_id</td>
							<td class="align-left">@item.p_desc</td>
							<td class="align-right">@item.pid_cantidad</td>
							<td class="align-right">@item.pid_enviado</td>
							<td class="align-right">@item.pid_stk</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</div>
<div class="modal-footer">
	<button class="btn btn-secondary btn-sm mt-1 me-1" type="button" title="Imprimir" id="btnImprimirDetallePI" @* onclick="imprimirPIDetalle(@pi_compte);" *@>
		<i class="bx bx-printer"></i> Imprimir
	</button>
	<button class="btn btn-outline-secondary btn-sm mt-1 me-1" data-bs-dismiss="modal">
		<i class="bx bx-log-out-circle"></i> Cerrar
	</button>
</div>
