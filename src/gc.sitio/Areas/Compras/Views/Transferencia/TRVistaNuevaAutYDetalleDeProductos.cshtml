@model TRNuevaAutDto
@{
	Layout = "~/views/shared/_Layout.cshtml";
	BusquedaProducto busquedaProducto = new();
	var alt = true;
	string clase = string.Empty;
	string ultimoProducto = null;
}
<style>
	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	fieldset > .d-flex {
		padding: 4px 2px;
	}

	fieldset h5 {
		font-weight: 600;
	}

	.table-area {
		max-height: 350px; 
		overflow-y: auto; 
		overflow-x: hidden;
		padding-right: 4px; 
	}

	.modal-body {
		overflow: hidden; 
		padding-bottom: 0; 
	}

		.modal-body .d-flex {
			flex-wrap: wrap;
		}

	#modalCargarNuevoProducto .input-group-text {
		padding: 2px 6px;
		font-size: 0.75rem;
	}

	#modalCargarNuevoProducto .form-control {
		padding: 2px 6px;
		font-size: 0.75rem;
		height: 28px;
	}

	.a-transferir{
		width: 40%;
		max-width: 40%;
	}

	.btn-modal{
		width: 100px;
		height: 30px;
	}
</style>
<div class="card">
	<div class="row">
		<div class="col-4" style="padding-right:0px;">
			<fieldset>
				<div class="d-flex justify-content-between align-items-center mb-2">
					<h5 class="mb-0">Nuevas Aut. TR</h5>

					<div class="d-flex gap-2">
						<button type="button" class="btn btn-secondary btn-sm" id="btnRegresarANuevaAut" title="Volver a pantalla anterior">
							<i class="bx bx-chevron-left"></i> Regresar
						</button>
						<button type="button" class="btn btn-success btn-sm" id="btnConfirmarAuto" title="Confirmar autorizaciones">
							<i class="bx bx-badge-check"></i> Confirmar
						</button>
					</div>
				</div>
				<div id="divNuevaAutListaSucursales">
					<div class="table-responsive text-nowrap table-wrapper">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbNuevaAutListaSucursales">
							<thead>
								<tr class="header">
									<th style="width:20%;" class="align-center">Aut. a Gen.</th>
									<th style="width:45%;" class="align-center">Sucursal</th>
									<th style="width:20%;" class="align-center">Pal. Aprox</th>
									<th style="width:15%;" class="align-center">Nota</th>
									<th style="width:0%; display:none;">adm_id</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.Sucursales != null && Model.Sucursales.ListaDatos != null && Model.Sucursales.ListaDatos.Count > 0)
								{
									@foreach (var item in Model.Sucursales.ListaDatos)
									{
										if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
										<tr class="@clase" onclick="selectNuevaAutListaSucursalesRow(this)">
											<td style="text-align: right;">@item.aut_a_generar</td>
											<td>@item.adm_nombre</td>
											<td style="text-align: right;">@GridHelper.FormatearDato(item.pallet_aprox, GridHelper.FormatDato.Monto, true)</td>
											<td class="text-center align-middle">
												<button type="button" class="btn btn-info btn-sm btn-icon-compact" data-interaction="@item.adm_id" data-interaction2="@item.aut_a_generar" onclick="verNotaEnSucursal(this);">
													<i class="bx bx-detail"></i>
												</button>
											</td>
											<td style="display:none;">@item.adm_id</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				</div>
			</fieldset>
		</div>
		<div class="col-8" style="padding-left: 0px;">
			<fieldset>
				<div class="d-flex justify-content-between align-items-center mb-2">
					<h5 class="mb-0">Detalle de Productos de TR</h5>

					<div class="d-flex gap-2">
						<button id="btnAgregar" class="btn btn-primary btn-sm" onclick="abrirlModalAgregaProductoATR();" title="Agregar un nuevo producto">
							<i class="bx bx-plus-circle"></i> Agregar
						</button>

						@*<button id="btnSustituto" class="btn btn-primary btn-sm" onclick="abrirlModalSustitutoDeProductoATR();" disabled title="Buscar sustituto" >
							<i class="bx bx-plus-circle"></i> Sustituto
						</button>*@

						<button id="btnEliminar" class="btn btn-danger btn-sm" onclick="eliminarProductoATR();" disabled title="Eliminar">
							<i class="bx bx-trash"></i> Eliminar
						</button>

						<button id="btnModCantidad" class="btn btn-info btn-sm" onclick="abrirlModalModCantDeProductoATR();" disabled title="Modificar">
							<i class="bx bx-edit"></i> Modificar
						</button>
					</div>
				</div>
				<div id="divNuevaAutListaProductos">
					<div class="table-responsive text-nowrap table-wrapper">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbNuevaAutListaProductos">
							<thead>
								<tr class="header">
									<th style="width:5%;" class="align-center">ID</th>
									<th style="width:25%;" class="align-center">Descripción</th>
									<th style="width:8%;" class="align-center">Id Prov</th>
									<th style="width:8%;" class="align-center">PI</th>
									<th style="width:8%;" class="align-center">Stk Suc</th>
									<th style="width:8%;" class="align-center">Pedido</th>
									<th style="width:8%;" class="align-center">A transf.</th>
									<th style="width:10%;" class="align-center">Dif</th>
									<th style="width:10%;" class="align-center">Box</th>
									<th style="width:10%;" class="align-center">A transf. Box</th>
									<th style="width:5%;" class="align-center">Nota</th>
									<th style="width:0%; display:none;">sustituto</th>
									<th style="width:0%; display:none;">adm_id</th>
									<th style="width:0%; display:none;">depo_id</th>
									<th style="width:0%; display:none;">depo_nombre</th>
									<th style="width:0%; display:none;">rub_id</th>
									<th style="width:0%; display:none;">rub_nombre</th>
									<th style="width:0%; display:none;">box_id</th>
								</tr>
							</thead>
							
							<tbody>
								@if (Model != null && Model.Detalle != null && Model.Detalle.ListaDatos != null && Model.Detalle.ListaDatos.Count > 0)
								{
									foreach (var item in Model.Detalle.ListaDatos)
									{
										var dif = item.pedido - item.a_transferir;

										bool esRepetido = (ultimoProducto == item.p_id + "|" + item.p_desc);
										ultimoProducto = item.p_id + "|" + item.p_desc;

										if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

										<tr class="@clase" onclick="selectNuevaAutListaProductosRow(this)">
											<td class="align-center">
												@(esRepetido ? "" : item.p_id)
											</td>
											<td class="align-left">
												@(esRepetido ? "" : item.p_desc)
											</td>
											<td class="align-center">
												@(esRepetido ? "" : item.p_id_prov)
											</td>
											<td class="align-center">
												@(esRepetido ? "" : item.pi_compte)
											</td>
											<td class="align-right">
												@(esRepetido ? "" : GridHelper.FormatearDato(item.stk, GridHelper.FormatDato.Monto, item.PermiteDecimales))
											</td>
											<td class="align-right">
												@(esRepetido ? "" : GridHelper.FormatearDato(item.pedido, GridHelper.FormatDato.Monto, item.PermiteDecimales))
											</td>
											<td class="align-right">
												@(esRepetido ? "" : GridHelper.FormatearDato(item.a_transferir, GridHelper.FormatDato.Monto, item.PermiteDecimales))
											</td>
											<td class="align-right">
												@(esRepetido ? "" : GridHelper.FormatearDato(dif, GridHelper.FormatDato.Monto, item.PermiteDecimales))
											</td>
											<td class="align-center">@item.box_id</td>
											<td class="align-right">@GridHelper.FormatearDato(item.a_transferir_box, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
											<td class="text-center align-middle">
												@if (!string.IsNullOrEmpty(item.nota))
												{
													<button type="button" class="btn btn-info btn-sm btn-icon-compact"
															data-interaction="@item.p_id"
															data-adm_id="@item.adm_id"
															data-autorizacion="@item.autorizacion"
															onclick="verNotaEnProducto(this);">
														<i class="bx bx-detail"></i>
													</button>
												}
											</td>
											@if (item.p_sustituto)
											{
												<td style="display:none;"><input type="checkbox" name="p_sustituto" value="@item.p_sustituto" checked disabled="disabled" /></td>
											}
											else
											{
												<td style="display:none;"><input type="checkbox" name="p_sustituto" value="@item.p_sustituto" disabled="disabled" /></td>
											}
											<td style="display:none;">@item.adm_id</td>
											<td style="display:none;">@item.depo_id</td>
											<td style="display:none;">@item.depo_nombre</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				</div>
			</fieldset>
		</div>
	</div>
</div>

<div class="modal fade modal-golden" id="modalNotaEnSucursal" tabindex="-1" style="display: none;" aria-hidden="true">
	<div class="modal-dialog modal-md" role="document">
		<div class="modal-content">
			<div id="divNotaEnSucursal">
			</div>
		</div>
	</div>
</div>

<div class="modal fade modal-golden" id="modalNotaEnProducto" tabindex="-1" style="display: none;" aria-hidden="true">
	<div class="modal-dialog modal-md" role="document">
		<div class="modal-content">
			<div id="divNotaEnProducto">
			</div>
		</div>
	</div>
</div>

<div class="modal fade modal-golden" id="modalCargarNuevoProducto" tabindex="-1" style="display: none;" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalCenterTitle"></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<fieldset>
					<legend>
						<h5 id="leyendaNuevoProducto" style="margin-bottom: 0px;">Cargar Nuevo Producto Aut TR</h5>
					</legend>
					<div id="divBusquedaProducto">
						<partial name="~/areas/ControlComun/views/producto/_ctrBuscarProducto.cshtml" model="@busquedaProducto" />
					</div>
					<!-- TABLA -->
					<div id="divListaProductosParaAgregar" class="mt-3 table-area">
					</div>

					<!-- CONTROLES ABAJO -->
					<div class="d-flex justify-content-start align-items-center gap-2 mt-3">

						<div class="input-group" style="width: 200px;">
							<span class="input-group-text">A Transferir</span>
							<input type="number" id="txtAtransferir" class="form-control a-transferir" />
						</div>

						<button type="button" class="btn btn-sm btn-success btn-modal" id="btnAceptarNuevoProducto">
							<i class="bx bx-check"></i> Aceptar
						</button>

						<button type="button" class="btn btn-sm btn-secondary btn-modal" data-bs-dismiss="modal">
							Cerrar
						</button>

					</div>
				</fieldset>
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var admSeleccionado = "";
		var admSeleccionadoNombre = "";
		var autAGenerarSeleccionado = "";
		var prodSeleccionado = "";
		var prodSeleccionadoNombre = "";
		var stkDeProdSeleccionado = 0;
		var boxDeProdSeleccionado = "";
		var pedidoDeProdSeleccionado = 0;
		var idProvDeProdSeleccionado = "";
		var idProdDeProdSeleccionado = "";
		var sustituto = false;
		var esProductoSustituto = false;
		var TREditarNotaEnSucursalUrl = "@Url.Action("EditarNotaEnSucursal", "transferencia", new { area = "Compras" })";
		var TRAgregarNotaASucursalNuevaAutUrl = "@Url.Action("AgregarNotaASucursalNuevaAutTR", "transferencia", new { area = "Compras" })";
		var TREditarNotaEnProductoUrl = "@Url.Action("EditarNotaEnProducto", "transferencia", new { area = "Compras" })";
		var TRAgregarNotaAProductoNuevaAutTRUrl = "@Url.Action("AgregarNotaAProductoNuevaAutTR", "transferencia", new { area = "Compras" })";
		var TRInicializarModalAgregarProductoATRUrl = "@Url.Action("InicializarModalAgregarProductoATR", "transferencia", new { area = "Compras" })";
		var busquedaProdBaseUrl = "@Url.Action("BusquedaBase", "producto", new { area = "ControlComun" })";
		var TRExisteProductoEnTRUrl = "@Url.Action("ExisteProductoEnTR", "transferencia", new { area = "Compras" })";
		var TRCargarListaProductoSustitutoUrl = "@Url.Action("CargarListaProductoSustituto", "transferencia", new { area = "Compras" })";
		var TRFiltrarListaDeProductosPorSucursalUrl = "@Url.Action("FiltrarListaDeProductosPorSucursal", "transferencia", new { area = "Compras" })";
		var TRAgregarNuevoProductoUrl = "@Url.Action("AgregarNuevoProducto", "transferencia", new { area = "Compras" })";
		var TRAgregarProductoSustitutoUrl = "@Url.Action("AgregarProductoSustituto", "transferencia", new { area = "Compras" })";
		var TRInicializarModalAgregarProductoSustitutoATRUrl = "@Url.Action("InicializarModalAgregarProductoSustitutoATR", "transferencia", new { area = "Compras" })";
		var TREliminarProductoUrl = "@Url.Action("EliminarProducto", "transferencia", new { area = "Compras" })";
		var TRInicializarModalModificarCantidadATRUrl = "@Url.Action("InicializarModalModificarCantidad", "transferencia", new { area = "Compras" })";
		var TREditarCantidadEnProductoUrl = "@Url.Action("EditarCantidadEnProducto", "transferencia", new { area = "Compras" })";
		var TRValidarSiExisteAnalisisUrl = "@Url.Action("ValidarSiExisteAnalisis", "transferencia", new { area = "Compras" })";
		var TRAbrirVistaTRCrudAutorizacionUrl = "@Url.Action("NuevaTR", "transferencia", new { area = "Compras" })";
		var TRLimpiarAnalisisUrl = "@Url.Action("LimpiarAnalisis", "transferencia", new { area = "Compras" })";
		var TRConfirmaAutorizacionesDeTRUrl = "@Url.Action("ConfirmaAutorizacionesDeTR", "transferencia", new { area = "Compras" })";
		var TRAbrirVistaTRAutorizacionesListaUrl = "@Url.Action("TRAutorizacionesLista", "transferencia", new { area = "Compras" })";
	</script>
	<script src="~/js/app/areas/transferencias/trVistaNuevaAutYDetalleDeProductos.js"></script>
	<script src="~/js/app/busquedas.js" type="text/javascript"></script>
	<script src="~/js/app/controlcomun/infoRpr.js" type="text/javascript"></script>
}