@model TRCRUDDto
@{
	Layout = "~/views/shared/_Layout.cshtml";
	var alt = true;
	string clase = string.Empty;
}
<style>
	/* ============================================
	   ESTILOS ORIGINALES
	   ============================================ */

	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	/* ============================================
	   FIELDSET SUPERIORES (50% de la pantalla)
	   ============================================ */

	.fieldset-fixed {
		height: 50vh; 
		display: flex;
		flex-direction: column;
	}

		.fieldset-fixed .fieldset-body {
			flex: 1;
			overflow-y: auto;
			overflow-x: hidden;
			min-height: 0;
		}

	/* ============================================
	   FIELDSET INFERIORES (ocupan el resto)
	   ============================================ */

	.fieldset-flex-fill {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

		.fieldset-flex-fill .fieldset-body {
			flex: 1;
			overflow-y: auto;
			overflow-x: hidden;
		}

	/* ============================================
	   CORRECCIONES PARA ALINEAR Y EXPANDIR COL-8
	   ============================================ */

	.col-8 {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

		.col-8 > .row:last-child {
			flex: 1;
			min-height: 0;
		}

			.col-8 > .row:last-child fieldset {
				height: 100%;
				width: 100%;
				display: flex;
				flex-direction: column;
			}

				.col-8 > .row:last-child fieldset .fieldset-body {
					flex: 1;
					overflow-y: auto;
				}

		.col-8 > .row {
			padding-left: 0 !important;
			padding-right: 0 !important;
		}

	.col-4 > .row > [class^="col-"] {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

		.col-4 > .row > [class^="col-"] fieldset {
			flex: 1;
			display: flex;
			flex-direction: column;
			height: 100%;
		}

			.col-4 > .row > [class^="col-"] fieldset .fieldset-body {
				flex: 1;
				overflow-y: auto;
			}


	/* ============================================
	   TABLAS: asegurar ancho completo
	   ============================================ */

	.table-responsive,
	.table-wrapper,
	.table-wrapper-xs {
		width: 100%;
		height: 100%;
	}

		.table-wrapper table,
		.table-wrapper-xs table {
			width: 100%;
		}

	#divOpciones .form-check-label {
		font-size: 0.80rem !important;
		line-height: 1.1 !important;
		white-space: nowrap;
	}

	#divOpciones .form-check-input {
		width: 14px !important;
		height: 14px !important;
		margin-top: 0.2rem !important;
	}

	#divOpciones .form-check {
		margin-bottom: 0.35rem !important;
	}

	#divOpciones {
		padding: 0.25rem 0.5rem !important;
	}

		#divOpciones a.btn {
			text-align: left;
			padding: 0.35rem 0.75rem;
			font-size: 0.80rem;
		}

			#divOpciones a.btn i {
				margin-right: 4px;
			}
	.table-golden i {
		font-size: 1.2rem;
	}
</style>
<div class="grid-golden">
	<div class="row row mt-2 ms-2 me-4 mb-2">
		<div class="col-4">
			<div class="row me-2">
				<fieldset class="fieldset-fixed">
					<legend>
						<h5 style="margin-bottom: 0px;">
							Sucursales
						</h5>
					</legend>
					<div class="fieldset-body" id="divListaSucursales">
						<div class="table-responsive text-nowrap table-wrapper">
							<table class="table table-sm mb-0 table-hover table-golden" id="tbListaSucursales">
								<thead>
									<tr class="header">
										<th style="width:80%;" class="align-center">Sucursal Destino</th>
										<th style="width:20%;" class="align-center" title="Tiene Pedidos">PS</th>
										<th style="width:20%;" class="align-center" title="Tiene Pedidos Incluidos para Autorizar">PI</th>
										<th style="width:0%; display:none;">adm_id</th>
									</tr>
								</thead>
								<tbody>
									@if (Model != null && Model.ListaAutSucursales != null && Model.ListaAutSucursales.ListaDatos != null && Model.ListaAutSucursales.ListaDatos.Count > 0)
									{
										@foreach (var item in Model.ListaAutSucursales.ListaDatos)
										{
											if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
											<tr class="@clase" onclick="selectTRSucursalesRow(this)">
												<td>@item.adm_nombre</td>
												<td class="align-center">
													@if (item.tiene_ordenes)
													{
														<i class="bx bx-check text-success"></i>
													}
												</td>

												<td class="align-center">
													@if (item.tiene_pi)
													{
														<i class="bx bx-check text-primary"></i>
													}
												</td>
												<td style="display:none;">@item.adm_id</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</fieldset>
			</div>
			<div class="row">
				<div class="col-5" style="padding-left: 0px;padding-right: 0px;">
					<fieldset class="fieldset-flex-fill">
						<legend>
							<h5 style="margin-bottom: 0px;">Depósitos de Envío</h5>
						</legend>
						<div class="fieldset-body" id="divDepositosDeEnvio">
							<div class="table-responsive text-nowrap table-wrapper">
								<table class="table table-sm mb-0 table-hover table-golden" id="tbDepositosDeEnvio">
									<thead>
										<tr class="header">
											<th style="width:80%;" class="align-center">Depósito</th>
											<th style="width:20%;" class="align-center">
												<input type="checkbox" id="chkSelectAllDepositos" />
											</th>
											<th style="width:0%; display:none;">depo_id</th>
										</tr>
									</thead>
									<tbody>
										@if (Model != null && Model.ListaDepositosDeEnvio != null && Model.ListaDepositosDeEnvio.ListaDatos != null && Model.ListaDepositosDeEnvio.ListaDatos.Count > 0)
										{
											@foreach (var item in Model.ListaDepositosDeEnvio.ListaDatos)
											{
												if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
												<tr class="@clase" onclick="selectTRDepositosDeEnvioRow(this)">
													<td>@item.depo_nombre</td>
													<td class="text-center">
														<input type="checkbox" class="chkDeposito" value="@item.seleccionado" @((item.seleccionado ? "checked" : "")) />
													</td>
													<td style="width:0%; display:none;">@item.depo_id</td>
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>
					</fieldset>
				</div>
				<div class="col-7" style="padding-left: 0px;padding-right: 5px;">
					<fieldset class="fieldset-flex-fill">
						<legend>
							<h5 style="margin-bottom: 0px;">Opciones</h5>
						</legend>
						<div class="fieldset-body" id="divOpciones">
							<div class="row">
								<div class="col-sm">
									<div class="form-check">
										@if (Model != null && Model.ConsiderarStockExistente == false)
										{
											<input class="form-check-input" type="checkbox" id="chkConsiderarStock" asp-for="@Model.ConsiderarStockExistente">
										}
										else
										{
											<input class="form-check-input" type="checkbox" id="chkConsiderarStock" checked asp-for="@Model.ConsiderarStockExistente">
										}
										<label class="form-check-label" for="chkConsiderarStock"> Considerar STK Existente de Sucursales</label>
									</div>
								</div>
								<div class="col-sm">
									<div class="form-check">
										@if (Model != null && Model.ModificarYSustituto == false)
										{
											<input class="form-check-input" type="checkbox" id="chkModificarYSustituto" asp-for="@Model.ModificarYSustituto">
										}
										else
										{
											<input class="form-check-input" type="checkbox" id="chkModificarYSustituto" checked asp-for="@Model.ModificarYSustituto">
										}
										<label class="form-check-label" for="chkModificarYSustituto"> Modificar y Sustituto</label>
									</div>
								</div>
								<div class="col-sm">
									<div class="row">
										<div class="col-9" style="padding-right: 0;">
											@if (Model != null && Model.MaximoPalletXAuto == false)
											{
												<input class="form-check-input" onchange="changeMaxPalletChk(this);" type="checkbox" id="chkMaxPallet" asp-for="@Model.MaximoPalletXAuto">
											}
											else
											{
												<input class="form-check-input" onchange="changeMaxPalletChk(this);" type="checkbox" id="chkMaxPallet" checked asp-for="@Model.MaximoPalletXAuto">
											}
											<label class="form-check-label" for="chkMaxPallet" title="Máximo Pallet x Autorización de TR"> Máx. Pallet x Aut. de TR</label>
										</div>
										<div class="col-3" style="padding-left: 0px;">
											<input type="number" id="txtMaxPallet" class="form-control" min="10" max="100" value="@Model.MaximoPalletXAutoValor">
										</div>
									</div>
								</div>
								<div class="row mt-4">
									<div class="col-sm-6">
										<a asp-action="TRAutorizacionesLista"
										   asp-controller="Transferencia"
										   asp-area="Compras"
										   class="btn btn-sm btn-secondary w-100"
										   id="btnNuevaAut">
											<i class="bx bx-chevron-left"></i> Regresar
										</a>
									</div>

									<div class="col-sm-6">
										<a href="#"
										   id="btnAnalizar"
										   class="btn btn-sm btn-success w-100">
											<i class="bx bx-badge-check"></i> Analizar
										</a>
									</div>
								</div>
							</div>
						</div>
					</fieldset>
				</div>
			</div>
		</div>
		<div class="col-8">
			<div class="row">
				<fieldset class="fieldset-fixed">
					<legend>
						<h5 style="margin-bottom: 0px;">Pedido de Sucursal</h5>
					</legend>
					<div class="fieldset-body" id="divListaPedidosSucursal">
						<div class="table-responsive text-nowrap table-wrapper">
							<table class="table table-sm mb-0 table-hover table-golden" id="tbListaPedidosSucursal">
								<thead>
									<tr class="header">
										<th style="width:15%;" class="align-center">N° PI</th>
										<th style="width:10%;" class="align-center">Fecha</th>
										<th style="width:10%;" class="align-center">Estado</th>
										<th style="width:30%;" class="align-center">Nota</th>
										<th style="width:15%;" class="align-center">Tipo</th>
										<th style="width:10%;" class="align-center">Det</th>
										<th style="width:10%;" class="align-center">Carga</th>
										<th style="width:0%; display:none;">adm_id</th>
										<th style="width:0%; display:none;">adm_desc</th>
									</tr>
								</thead>
								<tbody>
									@if (Model != null && Model.ListaPedidosSucursal != null && Model.ListaPedidosSucursal.ListaDatos != null && Model.ListaPedidosSucursal.ListaDatos.Count > 0)
									{
										@foreach (var item in Model.ListaPedidosSucursal.ListaDatos)
										{
											if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
											<tr data-pi-compte="@item.pi_compte"
												class="@clase" onclick="selectTRPedidoSucursalRow(this)">
												<td class="align-center">@item.pi_compte</td>
												<td class="align-center">@item.pi_fecha.ToString("dd/MM/yyyy")</td>
												<td class="align-center">@item.pie_desc</td>
												<td class="align-left">@item.pi_nota</td>
												<td class="align-center">@item.pit_desc</td>
												<td class="text-center align-middle">
													<button type="button" class="btn btn-info btn-sm btn-icon-compact" data-interaction="@item.pi_compte" onclick="verDetalleDePedido(this);" tabindex="-1">
														<i class="bx bx-show"></i>
													</button>
												</td>
												<td class="text-center align-middle">
													<button type="button" class="btn btn-primary btn-sm btn-icon-compact" data-interaction="@item.pi_compte" onclick="agregarAPedidosIncl(this);" tabindex="-1">
														<i class="bx bx-plus-circle"></i>
													</button>
												</td>
												<td style="display:none;">@item.adm_id</td>
												<td style="display:none;">@item.adm_desc</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</fieldset>
			</div>
			<div class="row mt-2 mb-2" style="width:104%;">
				<fieldset class="fieldset-flex-fill">
					<legend>
						<h5 style="margin-bottom: 0px;">Pedidos Incluidos para Autorizar TR</h5>
					</legend>
					<div class="fieldset-body" id="divListaPedidosIncluidos">
						<div class="table-responsive text-nowrap table-wrapper">
							<table class="table table-sm mb-0 table-hover table-golden" id="tbListaPedidosIncluidos">
								<thead>
									<tr class="header">
										<th style="width:15%;" class="align-center">Sucursal</th>
										<th style="width:10%;" class="align-center">N° PI</th>
										<th style="width:10%;" class="align-center">Fecha</th>
										<th style="width:10%;" class="align-center">Estado</th>
										<th style="width:20%;" class="align-center">Nota</th>
										<th style="width:15%;" class="align-center">Tipo</th>
										<th style="width:10%;" class="align-center">Det</th>
										<th style="width:10%;" class="align-center">Carga</th>
									</tr>
								</thead>
								<tbody>
									@if (Model != null && Model.ListaPedidosIncluidos != null && Model.ListaPedidosIncluidos.ListaDatos != null && Model.ListaPedidosIncluidos.ListaDatos.Count > 0)
									{
										@foreach (var item in Model.ListaPedidosIncluidos.ListaDatos)
										{
											if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
											<tr data-pi-compte="@item.pi_compte" 
												class="@clase" onclick="selectTRPedidoIncluidoRow(this)">
												<td class="align-left">@item.adm_desc</td>
												<td class="align-center">@item.pi_compte</td>
												<td class="align-center">@item.pi_fecha.ToString("dd/MM/yyyy")</td>
												<td class="align-left">@item.pie_desc</td>
												<td class="align-center">@item.pi_nota</td>
												<td class="align-center">@item.pit_desc</td>
												<td>
													<button type="button" class="btn btn-info btn-sm btn-icon-compact" data-interaction="@item.pi_compte" onclick="verDetalleDePedido(this);" tabindex="-1">
														<i class="bx bx-show"></i>
													</button>
												</td>
												<td>
													<button type="button" class="btn btn-danger btn-sm btn-icon-compact" data-interaction="@item.pi_compte" onclick="quitarDePedidosIncl(this);" tabindex="-1">
														<i class="bx bx-trash"></i>
													</button>
												</td>
											</tr>
										}
									}
								</tbody>
							</table>
						</div>
					</div>
				</fieldset>
			</div>
		</div>
	</div>
</div>

<div class="modal fade modal-golden" id="modalCenter" tabindex="-1" style="display: none;" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div id="divDetalleDePedido">
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var TRCargarPedidosPorSucursalUrl = "@Url.Action("CargarPedidosPorSucursal", "transferencia", new { area = "Compras" })";
		var TRCargarDepositosInclPorSucursalUrl = "@Url.Action("CargarDepositosInclPorSucursal", "transferencia", new { area = "Compras" })";
		var TRAgregarAPedidosIncluidosParaAutUrl = "@Url.Action("AgregarAPedidosIncluidosParaAutTR", "transferencia", new { area = "Compras" })";
		var TRQuitarDePedidosIncluidosParaAutUrl = "@Url.Action("QuitarDePedidosIncluidosParaAutTR", "transferencia", new { area = "Compras" })";
		var TRActualizarInfoEnListaDeSucursalesUrl = "@Url.Action("ActualizarInfoEnListaDeSucursalesTR", "transferencia", new { area = "Compras" })";
		var TRAnalizarParametrosUrl = "@Url.Action("AnalizarParametros", "transferencia", new { area = "Compras" })";
		var TRAbrirVistaAutorizacionesUrl = "@Url.Action("AbrirVistaEdicionNuevasAutYDetalleTR", "transferencia", new { area = "Compras" })";
		var TRVerDetallePedidoDeSucursalUrl = "@Url.Action("VerDetallePedidoDeSucursal", "transferencia", new { area = "Compras" })";
	</script>
	<script src="~/js/app/areas/transferencias/trCrudAutorizacion.js"></script>
}