@model GridCoreSmart<TRAutSucursalesDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<div class="table-responsive text-nowrap table-wrapper">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaSucursales">
		<thead>
			<tr class="header">
				<th style="width:80%;" class="align-center">Sucursal Destino</th>
				<th style="width:20%;" class="align-center" title="Tiene Pedidos">PS</th>
				<th style="width:20%;" class="align-center" title="Tiene Pedidos Incluidos para Autorizar">PI</th>
				<th style="width:0%; display:none;">adm_id</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectTRSucursalesRow(this)">
						<td class="align-left">@item.adm_nombre</td>
						<td class="align-center">
							@if (item.tiene_ordenes)
							{
								<i class="bx bx-check text-success"></i>
							}
						</td>

						<td class="align-center">
							@if (item.tiene_pi)
							{
								<i class="bx bx-check text-primary"></i>
							}
						</td>
						<td style="display:none;">@item.adm_id</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>