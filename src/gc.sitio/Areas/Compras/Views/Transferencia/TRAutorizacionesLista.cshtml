@model GridCoreSmart<TRPendienteDto>
@{
	var alt = true;
	string clase = string.Empty;
	Layout = "~/views/shared/_Layout.cshtml";
}
<div class="card">
	<div class="card-body">
		<div class="row">
			<h5>Autorizaciones TR</h5>
			<div class="d-flex align-items-center justify-content-between flex-wrap mt-2">
				<div class="btn-group me-2" role="group" aria-label="Basic radio toggle button group">
					<input type="radio" class="btn-check" name="btnradio" id="btnradioSucursales" checked="">
					<label class="btn btn-outline-primary" for="btnradioSucursales">TR Sucursales</label>
					<input type="radio" class="btn-check" name="btnradio" id="btnradioDepositos">
					<label class="btn btn-outline-primary" for="btnradioDepositos">TR Depósitos</label>
				</div>
				<div>
					<button id="btnNuevaAut" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Agregar Nueva Transferencia" asp-action="NuevaTR" asp-controller="Transferencia" asp-area="Compras">
						<i class="bx bx-plus-circle"></i> Nueva Transferencia
					</button>
@* 					<a asp-action="NuevaTR" asp-controller="Transferencia" asp-area="Compras" class="btn btn-primary btn-sm mt-1 me-1" id="btnNuevaAut" title="Agregar Autorización de Transferencia">
						<span class="bx bx-plus-circle"> Nueva</span>
					</a> *@
					<button id="btnModificarAut" class="btn btn-info btn-sm mt-1 me-1" type="button" title="Modificar Transferencia seleccionada">
						<i class="bx bx-edit-alt"></i> Modificar Transferencia
					</button>
					@* <a href="#" id="btnModificarAut" class="btn btn-info btn-sm mt-1 me-1" title="Modificar Autorización de Transferencia"><span class="bx bx-edit"> Modificar</span></a> *@
					@* <a href="#" id="btnVer" class="btn btn-info btn-sm mt-1 me-1" title="Visualizar datos de Autorización" onclick="verTransferencia();return false;"><span class="bx bx-show"> Ver</span></a> *@
					<button id="btnVer" class="btn btn-info btn-sm mt-1 me-1" type="button" title="Ver Autorización seleccionada" onclick="verTransferencia();return false;">
						<i class="bx bx-show"></i> Ver Transferencia
					</button>
				</div>
			</div>
		</div>
		<div class="grid-golden-body">
			<div id="divListaAutorizaciones">
				<div class="table-responsive text-nowrap table-wrapper">
					<table class="table table-sm mb-0 table-hover table-golden" id="tbListaAutorizaciones">
						<thead>
							<tr class="header">
								<th style="width:10%;" class="align-center">N° Auto</th>
								<th style="width:10%;" class="align-center">Sucursal</th>
								<th style="width:10%;" class="align-center">Fecha</th>
								<th style="width:50%;" class="align-center">Nota</th>
								<th style="width:10%;" class="align-center">PI</th>
								<th style="width:10%;" class="align-center">Estado</th>
								<th style="width:0%; display:none;">adm_id_des</th>
								<th style="width:0%; display:none;">usu_id</th>
								<th style="width:0%; display:none;">tie_id</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.ListaDatos)
								{
									if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
									<tr class="@clase" onclick="selectTRRow(this)">
										<td class="align-center">@item.ti</td>
										<td>@item.adm_nombre</td>
										<td class="align-center">@item.fecha.ToString("dd/MM/yyyy")</td>
										<td>@item.nota</td>
										<td class="align-center">@item.pi_compte</td>
										<td class="align-center">@item.tie_desc</td>
										<td style="display:none;">@item.adm_id_des</td>
										<td style="display:none;">@item.usu_id</td>
										<td style="display:none;">@item.tie_id</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var admSeleccionado = "";
		var trSeleccionada = "";
		var sucSeleccionada = "";
		var titId = "";
		var TRAutorizacionesListaPorSucursalUrl = "@Url.Action("TRAutorizacionesListaPorSucursal", "transferencia", new { area = "Compras" })";
		var TRVerTransferenciaUrl = "@Url.Action("TRVerTransferencia", "transferencia", new { area = "Compras" })";
	</script>
	<script src="~/js/app/areas/transferencias/trAutorizacionesLista.js"></script>
}