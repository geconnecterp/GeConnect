@model GridCoreSmart<DevolucionPrevioCargadoDto>;
@{
	var alt = true;
	string clase = string.Empty;
}

<div class="table-responsive table-wrapper-full-width">
	<table class="table table-sm mb-0 table-hover table-golden" id="tbListaProductosParaAgregar">
		<thead>
			<tr class="header">
				<th style="width:1%;"><input name="select_all" value="1" type="checkbox"></th>
				<th style="width:5%;" class="col-header-small align-center">ID</th>
				<th style="width:20%;" class="col-header-small align-center">Descripción</th>
				<th style="width:5%;" class="col-header-small align-center">Cta</th>
				<th style="width:5%;" class="col-header-small align-center">Ajuste</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.ListaDatos != null && Model.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					var nombre = "chk" + item.p_id;
					<tr class="@clase" onclick="selectListaProductoRow(this)">
						<td><input type="checkbox" name=@nombre /></td>
						<td class="align-center">@item.p_id</td>
						<td class="align-left">@item.p_desc</td>
						<td class="align-center">@item.cta_id</td>
						<td class="align-right">@GridHelper.FormatearDato(item.cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>