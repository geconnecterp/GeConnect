@using static gc.infraestructura.Helpers.GridHelper
@model GridCoreSmart<OrdenDeCompraRprAsociadasDto>
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.table-wrapper-full-width {
		max-width: 99%;
	}

	#tbListaRprAsociadaDeOC thead th {
		border-left: none !important;
		border-right: none !important;
	}

	#tbListaRprAsociadaDeOC tbody td {
		border-left: none !important;
		border-right: none !important;
	}
</style>
<div class="row">
	<div class="table-responsive table-wrapper-full-width" id="containerListaOC">
		<table class="table table-bordered table-hover table-golden" id="tbListaRprAsociadaDeOC">
			<thead>
				<tr>
					<th style="width:3%;" class="align-center">Código</th>
					<th style="width:25%;" class="align-center">Descripción</th>
					<th style="width:3%;" class="align-center">Cod. Prov.</th>
					<th style="width:5%;" class="align-center">Pedido Bultos</th>
					<th style="width:4%;" class="align-center">Unid. Pres.</th>
					<th style="width:3%;" class="align-center">Boni</th>
					<th style="width:5%;" class="align-center">Cant. total</th>
					<th style="width:5%;" class="align-center">Precio Costo</th>
					<th style="width:5%;" class="align-center">N° RPR</th>
					<th style="width:5%;" class="align-center">Cant. RPR</th>
					<th style="width:5%;" class="align-center">Dif. OC/RPR</th>
				</tr>
			</thead>
			<tbody>
				@if (Model != null && Model.ListaDatos != null)
				{
					@foreach (var item in Model.ListaDatos)
					{
						if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
						<tr class="@clase" onclick="selectListaOCDetalleRow(this)">
							<td class="align-center tiny-row">@item.p_id</td>
							<td class="align-left tiny-row">@item.p_desc</td>
							<td class="align-center tiny-row">@item.p_id_prov</td>
							<td class="align-right tiny-row">@item.ocd_bultos</td>
							<td class="align-right tiny-row">@item.ocd_unidad_pres</td>
							<td class="align-right tiny-row">@item.ocd_bonificacion</td>
							<td class="align-right tiny-row">@GridHelper.FormatearDato(item.ocd_cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
							<td class="align-right tiny-row">@GridHelper.FormatearDato(item.ocd_pcosto, GridHelper.FormatDato.Monto, true)</td>
							<td class="align-center tiny-row">@item.rp_compte</td>
							<td class="align-right tiny-row">@GridHelper.FormatearDato(item.rpd_cantidad, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
							<td class="align-right tiny-row" style="font-weight:bold;">@GridHelper.FormatearDato(item.dif_oc_rpr, GridHelper.FormatDato.Monto, item.PermiteDecimales)</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</div>
