@using static gc.infraestructura.Helpers.GridHelper
@model ConsultaOCModel
@{
	var adm = Model.ListaAdministraciones;
	var alt = true;
	string clase = string.Empty;
}
<style>
	#containerListaOC {
		position: relative;
		max-height: 60vh;
		height: auto;
		overflow-y: auto;
		overflow-x: hidden;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
				white-space: nowrap; /* evita saltos de línea */
			}

			.table-golden thead,
			.table-golden thead th {
			}

	#tbListaOC {
		width: 100%;
		max-width: 100%;
	}

	#tbListaOC th,
	#tbListaOC td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbListaOC tr {
		height: 1.6rem !important;
	}

	.grid-golden {
		width: 100%;
		margin: 0 auto;
	}

	.grid-golden-body .table-wrapper table {
		width: 100%;
	}
</style>
<div class="row mb-1 pe-1">
	<div class="col-md-10">
		<div class="table-wrapper" id="containerListaOC">
			<table class="table table-sm table-golden" id="tbListaOC">
				<thead>
					<tr>
						<th style="width:5%;" class="col-header-small align-center tiny-row">N° OC</th>
						<th style="width:20%;" class="col-header-small align-center tiny-row">Proveedor</th>
						<th style="width:5%;" class="col-header-small align-center tiny-row">Fecha</th>
						<th style="width:5%;" class="col-header-small align-center tiny-row">Sucursal</th>
						<th style="width:10%;" class="col-header-small align-center tiny-row">Estado</th>
						<th style="width:20%;" class="col-header-small align-center tiny-row">Usuario</th>
						<th style="width:5%;" class="col-header-small align-center tiny-row">Importe</th>
						<th style="width:0%; display:none;">oce_id</th>
						<th style="width:0%; display:none;">adm_id</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.GrillaOC != null && Model.GrillaOC.ListaDatos != null)
					{
						@foreach (var item in Model.GrillaOC.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							<tr data-oc-compte="@item.oc_compte"
								data-cta-id="@item.cta_id"
								class="@clase" onclick="selectListaOCRow(this)">
								<td class="align-center tiny-row">@item.oc_compte</td>
								<td class="align-left tiny-row">@item.cta_denominacion</td>
								<td class="align-center tiny-row">@Model.GrillaOC.FormatearDato(item.oc_fecha, FormatDato.Fecha)</td>
								<td class="align-center tiny-row">@item.adm_nombre</td>
								<td class="align-left tiny-row">@item.oce_desc</td>
								<td class="align-left tiny-row">@item.usu_apellidoynombre</td>
								<td class="align-right tiny-row">@GridHelper.FormatearDato(item.oc_total, GridHelper.FormatDato.Monto, true)</td>
								<td style="display:none;">@item.oce_id</td>
								<td style="display:none;">@item.adm_id</td>
							</tr>
						}
					}
				</tbody>
			</table>
			<div class="row mt-1">
				<div class="offset-md-3 col-md-6">
					<div id="divPaginacion" class="">
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-8">
			</div>
			<div class="col-4">
				<div class="input-group input-group-sm mt-1">
					<span class="input-group-text fixed-lbl-for-abm-100">Totales: </span>
					<input type="text" asp-for="Importe" class="form-control" style="text-align: right;" disabled />
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-2">
		<div>
			<button type="button" class="btn btn-sm btn-primary w-100 btn-sm mt-1 me-1" id="btnActivarOC" title="Activar OC">
				<i class="bx bx-check-circle"></i> Activar OC
			</button>
		</div>
		<div>
			<button type="button" class="btn btn-sm btn-primary w-100 btn-sm mt-1 me-1" id="btnCerrarOC" title="Cerrar OC">
				<i class="bx bx-check-circle"></i> Cerrar OC
			</button>
		</div>
		<div>
			<button type="button" class="btn btn-sm btn-danger w-100 btn-sm mt-1 me-1" id="btnAnularOC" title="Anular OC">
				<i class="bx bx-trash"></i> Anular OC
			</button>
		</div>
		<div>
			<button type="button" class="btn btn-sm btn-primary w-100 btn-sm mt-1 me-1" id="btnLevantarOC" title="Levantar OC">
				<i class="bx bx-check-circle"></i> Levantar OC
			</button>
		</div>
		<div>
			<button type="button" class="btn btn-sm btn-secondary w-100 btn-sm mt-1 me-1" id="btnImprimir" title="Imprimir">
				<i class="bx bx-printer"></i> Imprimir
			</button>
		</div>
		<div>
			<button type="button" class="btn btn-sm btn-primary w-100 btn-sm mt-1 me-1" id="btnServicioExt" title="Servicio Ext">
				<i class="bx bx-check-circle"></i> Servicio Ext
			</button>
		</div>
		<div>
			<button type="button" class="btn btn-sm btn-info w-100 btn-sm mt-1 me-1" id="btnModiAdm" title="Modificar Administración">
				<i class="bx bx-edit"></i> Modi. Adm.
			</button>
		</div>
		<div class="row mt-1">
			<div class="col-12">
				<label class="form-label mb-1">Modificar Sucursal:</label>
				@Html.DropDownListFor(
					m => m.ListaAdministraciones.First().Value,
					adm,
					"Seleccionar...",
					new { @id = "listaAdm", disabled = "disabled", @class = "form-control activable" }
				)
			</div>
		</div>

	</div>
</div>
