@using static gc.infraestructura.Helpers.GridHelper
@model ConsultaOCDetalleModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.fecha-compact {
		width: 30%;
		max-width: 30%;
	}

	.table-wrapper-full-width {
		max-width: 99%;
	}
</style>
<div class="row">
	<div class="table-responsive table-wrapper-full-width" id="containerListaOC">
		<table class="table table-bordered table-hover table-golden" id="tbListaDetalleOC">
			<thead>
				<tr class="header">
					<th style="width:4%;" class="col-header-small align-center tiny-row">Código</th>
					<th style="width:20%;" class="col-header-small align-center tiny-row">Descripción</th>
					<th style="width:5%;" class="col-header-small align-center tiny-row">Cod. Prov.</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">Unidad Pres.</th>
					<th style="width:5%;" class="col-header-small align-center tiny-row">Precio Lista</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">D1</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">D2</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">D3</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">D4</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">DPA</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">Pedido Bultos</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">Unid. Pres.</th>
					<th style="width:5%;" class="col-header-small align-center tiny-row">Boni</th>
					<th style="width:4%;" class="col-header-small align-center tiny-row">Cant. total</th>
					<th style="width:5%;" class="col-header-small align-center tiny-row">Precio Costo</th>
					<th style="width:5%;" class="col-header-small align-center tiny-row">Total Costo</th>
					<th style="width:0%; display:none;">oce_id</th>
				</tr>
			</thead>
			<tbody>
				@if (Model != null && Model.GrillaDetalle != null && Model.GrillaDetalle.ListaDatos != null)
				{
					@foreach (var item in Model.GrillaDetalle.ListaDatos)
					{
						if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
						var total_costo = item.ocd_cantidad * item.ocd_pcosto;
						<tr class="@clase" onclick="selectListaOCDetalleRow(this)">
							<td class="align-center tiny-row">@item.p_id</td>
							<td class="align-left tiny-row">@item.p_desc</td>
							<td class="align-center tiny-row">@item.p_id_prov</td>
							<td class="align-center tiny-row">@item.ocd_unidad_pres</td>
							<td class="align-right tiny-row">@GridHelper.FormatearPrecio(item.ocd_plista, TipoPrecio.Lista)</td>
							<td class="align-center tiny-row">@item.ocd_dto1</td>
							<td class="align-center tiny-row">@item.ocd_dto2</td>
							<td class="align-center tiny-row">@item.ocd_dto3</td>
							<td class="align-center tiny-row">@item.ocd_dto4</td>
							<td class="align-center tiny-row">@item.ocd_dto_pa</td>
							<td class="align-center tiny-row">@item.ocd_bultos</td>
							<td class="align-center tiny-row">@item.ocd_unidad_x_bulto</td>
							<td class="align-center tiny-row">@item.ocd_boni</td>
							<td class="align-right tiny-row">@item.ocd_cantidad</td>
							<td class="align-right tiny-row">@GridHelper.FormatearPrecio(item.ocd_pcosto, TipoPrecio.Costo)</td>
							<td class="align-right tiny-row" style="font-weight:bold;">@GridHelper.FormatearPrecio(total_costo, TipoPrecio.Venta)</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</div>
<div class="row">
	<div class="col-md-4" style="margin-left: 10px;margin-top: 10px;">
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-100">Entrega</span>
				@Html.TextBoxFor(t => t.FechaEntrega, "{0:yyyy-MM-dd}", new { disabled = "disabled", type = "date", @class = "form-control activable" })
				<span class="input-group-text fixed-lbl-for-abm-70">Sucursal:</span>
				<input type="text" asp-for="SucursalEntrega" class="form-control activable inputEditable" disabled />
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<div class="form-check form-check-inline form-switch mb-2">
					<input class="form-check-input activable" type="checkbox" asp-for="PagoAnticipado" value="" id="chkPagoAnticipado" disabled>
					<label class="form-check-label" for="chkPagoAnticipado"> Pago Anticipado</label>
				</div>
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-100">Pago a plazo:</span>
				@Html.TextBoxFor(t => t.PagoPlazo, "{0:yyyy-MM-dd}", new { disabled = "disabled", type = "date", @class = "form-control activable inputEditable fecha-compact" })
			</div>
		</div>
		<div class="row mt-1">
			<div class="input-group input-group-sm">
				<span class="input-group-text fixed-lbl-for-abm-10">Observaciones:</span>
				<input type="text" asp-for="Observaciones" class="form-control activable inputEditable" disabled />
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="row mt-1">
			<div class="card">
				<div class="card-body mt-1-ctm">
					<div class="table-responsive text-nowrap table-wrapper-300-full-width">
						<table class="table table-sm mb-0 table-hover table-golden" id="tbGridConcepto">
							<thead>
								<tr class="header">
									<th class="col-header-small align-left">Concepto</th>
									<th class="col-header-small align-right">Importe</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.ResumenGrilla != null && Model.ResumenGrilla.ListaDatos != null)
								{
									@foreach (var item in Model.ResumenGrilla.ListaDatos)
									{
										if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
										<tr class="@clase">
											<td class="align-left">@item.Concepto</td>
											<td class="align-right font-bold">@item.Importe</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
	@* <div class="col-md-3" style="margin-top: 10px;">
		<div>
			<button type="button" class="btn btn-sm btn-secondary btn-sm mt-1 me-1" id="btnImprimirDesdeDetalle" title="Imprimir desde detalle">
				<i class="bx bx-printer"></i> Imprimir
			</button>
		</div>
	</div> *@
</div>

