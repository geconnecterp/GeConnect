@model ChequeRechazadoPasoUnoModel
@{
	Layout = "~/views/shared/_Layout.cshtml";

	var list = Model.ListaCuentasBancarias;
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}

	fieldset {
		margin: 8px;
		border: 1px solid silver;
		padding: 8px;
		border-radius: 4px;
		max-width: 100%;
		margin-top: 8px;
		margin-left: 0px;
		margin-right: 0px;
		margin-bottom: 0px;
		height: 420px;
	}

	legend {
		padding: 2px;
		margin-top: -22px;
		background: #f3f5f7 !important;
		width: 25%;
		text-align: center;
		font-size: small;
	}

</style>
<div class="container">
	<div class="row col-12 justify-content-sm-center mb-1 mt-3">
		<div class="col-1" id="divUno"></div>
		<div class="col-10" id="divPrincipal">
			@* <fieldset style="height: 140px;">
				<legend></legend>
				<div class="input-group input-group-sm mt-1">
					<span class="input-group-text">Cuenta de Banco: </span>
					@Html.DropDownListFor(m => m.ctaSelected, list, "Seleccionar...", new { @id = "ListaCuentaBancaria", @class = "form-control activable" })
				</div>
				<div class="input-group input-group-sm mt-1">
					<span class="input-group-text">Desde: </span>
					@Html.TextBoxFor(m => m.FechaDesde, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control activable inputEditable", @onchange = "onChangeFechaDesde(this);", @id = "fechaDesde" })
					<span class="input-group-text">Hasta: </span>
					@Html.TextBoxFor(m => m.FechaHasta, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control activable inputEditable", @onchange = "onChangeFechaHasta(this);", @id = "fechaHasta" })
				</div>
				<div class="row mt-3">
					<div class="col-2"></div>
					<div class="col-8 text-center">
						<button type="button" id="btnBuscar" class="btn btn-sm btn-primary">
							<i class="bx bx-search"></i>Buscar
						</button>
						<button type="button" id="btnCancel" class="btn btn-sm btn-danger">
							<i class="bx bx-x-circle"></i>Cancelar
						</button>
					</div>
					<div class="col-2"></div>
				</div>
			</fieldset> *@
			<div class="card card-golden" style="padding-left: 0px;padding-right: 0px;">
				<div class="card-header mb-2">
					<h5 class="mb-0" id="tituloLegend">Filtros </h5>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="row">
							<div class="col-6">
								<div class="row">
									<div class="input-group input-group-sm">
										<div class="form-check form-check-inline form-switch mb-2">
											<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
											<label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta">Fechas</label>
										</div>
									</div>
									<div class=" col-sm-6">
										<div class="input-group input-group-sm">
											<span class="input-group-text" id="lbIdDesde">Desde:</span>
											<input type="date" class="form-control inputEditable" asp-for="FechaDesde" style="background-color:rgb(251,255,195);font-weight:900;" autofocus />
										</div>
									</div>
									<div class=" col-sm-6">
										<div class="input-group input-group-sm">
											<span class="input-group-text" id="lbIdHasta">Hasta:</span>
											<input type="date" class="form-control inputEditable" asp-for="FechaHasta" style="background-color:rgb(251,255,195);font-weight:900;" autofocus />
										</div>
									</div>
								</div>
							</div>
							<div class="col-6">
								<div class="row">
									<div class="col-sm-12">
										<div class="input-group input-group-sm">
											<div class="form-check form-check-inline form-switch mb-2">
												<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkCuentaBanco" />
												<label class="form-check-label" for="chkCuentaBanco" id="lbCuentaBanco">Cuenta de Banco</label>
											</div>
										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-12">
										<div class="input-group input-group-sm">
											@Html.DropDownListFor(m => m.ctaSelected, list, "Seleccionar...", new { @id = "ListaCuentaBancaria", @class = "form-control activable" })
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="row m-3">
				<div class="d-flex justify-content-around">
					<button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger"><i class="bx bx-sm bx-x-circle"></i> Inicializa</button>
					<button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success"><i class="bx bx-sm bx-search"></i> Ver</button>
				</div>
			</div>
		</div>
		<div class="col-1" id="divDos"></div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var CuentaBancariaSelected = "";
		var tra_compte_selected = "";
		var fc_dia_movi_selected = "";
		var fc_compte_selected = "";
		var fc_item_selected = "";
		var conciliado = "";
		var rechazado = "";

		var buscarChequesDepositadosUrl = '@Url.Action("BuscarChequesDepositados", "ChequeDeTerceroRechazado", new { area = "Financieros" })';
		var volverPasoUnoUrl = '@Url.Action("VolverPasoUno", "ChequeDeTerceroRechazado", new { area = "Financieros" })';
		var confirmarRechazoDeValorUrl = '@Url.Action("ConfirmarRechazoDeValor", "ChequeDeTerceroRechazado", new { area = "Financieros" })';
		var inicializarDatosEnSesionURL = "@Url.Action("InicializarDatosEnSesion", "ChequeDeTerceroRechazado", new { area = "Financieros" })";
		var paso1Url = "@Url.Action("Paso1", "ChequeDeTerceroRechazado", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>

	<script src="~/js/app/areas/financieros/chequedetercerorechazado/chequeterrech.js"></script>
}