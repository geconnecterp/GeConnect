@using static gc.infraestructura.Helpers.GridHelper
@model CargarDatosExtractoYSistemaModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.check-column {
		text-align: center;
		vertical-align: middle;
	}

	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	.btn.invisible {
		visibility: hidden;
		pointer-events: none;
	}

	#tbGrillaExtracto th {
		padding: 0.4rem 0.5rem;
		font-size: 0.8rem;
	}

	#tbGrillaExtracto td {
		padding: 0.2rem 0.3rem;
		font-size: 0.75rem;
		line-height: 1.1;
		vertical-align: middle;
	}

	.check-sele-container {
		display: flex;
		justify-content: center;
		align-items: center;
		height: 100%;
	}

	#tbGrillaExtracto td:empty {
		min-height: 32px; /* ajustable según tu diseño */
	}

	.td-placeholder::before {
		content: "•";
		visibility: hidden;
		display: inline-block;
	}

	#tbGrillaExtracto thead th {
		position: sticky;
		top: 0;
		background-color: #d4af37; /* o el color de fondo que uses */
		z-index: 2;
	}

	.col-conci {
		width: 40px; /* ajustable según el tamaño del botón */
		text-align: center;
		vertical-align: middle;
		white-space: nowrap;
	}

	.col-a-conc {
		width: 40px; /* igual que col-conci, ajustable si el botón cambia */
		text-align: center;
		vertical-align: middle;
		white-space: nowrap;
	}

</style>
<div class="table-responsive table-wrapper-500-full-width" id="containerGrillaExtracto">
	<table class="table table-bordered table-hover table-golden" id="tbGrillaExtracto">
		<thead>
			<tr class="header">
				<th scope="col" class="check-column">
					SEL
					<div class="check-sele-container">
						<input class="form-check-input" type="checkbox" id="checkAllItemExtracto" title="Seleccionar todos">
					</div>
				</th>
				<th class="col-conci" scope="col">Conci.</th>
				<th class="text-center" scope="col">Fecha</th>
				<th class="text-center" scope="col">Concepto</th>
				<th class="text-center" scope="col">Importe</th>
				<th class="col-a-conc" scope="col">A Conc.</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaExtracto != null && Model.GrillaExtracto.ListaDatos != null && Model.GrillaExtracto.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaExtracto.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" data-ctaf-id="@item.ctaf_id" data-extr-id="@item.extr_id" data-ext-fecha="@item.ext_fecha" onclick="selectGrillaExtracto(this);">
						@if (item.puedo_seleccionar)
						{
							<td class="check-column">
								<div class="check-sele-container">
									<input type="checkbox" class="form-check-input check-extracto" data-ctaf-id="@item.ctaf_id" data-extr-id="@item.extr_id" data-ext-fecha="@item.ext_fecha">
								</div>
							</td>
						}
						else
						{
							<td class="text-center align-middle">
								<button type="button" class="btn btn-icon-compact invisible" tabindex="-1">
									<i class="bx bx-dots-horizontal-rounded"></i>
								</button>
							</td>
						}
						@if (item.bool_conciliado)
						{
							<td class="col-conci">
								<button type="button" class="btn btn-warning btn-icon-compact" title="Registro Conciliado" onclick="verDetalleConciliado('@item.conciliado_nro')">
									<i class="bx bx-search"></i>
								</button>
							</td>
						}
						else
						{
							<td class="col-conci">
								<button type="button" class="btn btn-icon-compact invisible" tabindex="-1">
									<i class="bx bx-dots-horizontal-rounded"></i>
								</button>
							</td>
						}
						<td class="@Model.GrillaExtracto.ObtenerClase(item.ext_fecha)">@Model.GrillaExtracto.FormatearDato(item.ext_fecha, FormatDato.Fecha)</td>
						<td class="@Model.GrillaExtracto.ObtenerClase(item.concepto)">@Model.GrillaExtracto.FormatearDato(item.concepto, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaExtracto.ObtenerClase(item.importe)">@Model.GrillaExtracto.FormatearDato(item.importe, FormatDato.Monto)</td>
						@if (item.bool_a_conciliar)
						{
							<td class="col-a-conc">
								<button type="button" class="btn btn-success btn-icon-compact" title="Registro A Conciliar" onclick="VerDetalleAConciliar('@item.ctaf_id')">
									<i class="bx bx-search"></i>
								</button>
							</td>
						}
						else
						{
							<td class="col-a-conc">
								<button type="button" class="btn btn-icon-compact invisible" tabindex="-1">
									<i class="bx bx-dots-horizontal-rounded"></i>
								</button>
							</td>
						}
					</tr>
				}
			}
		</tbody>
	</table>
</div>
<script>
	$(function() {
			// Funcionalidad para checkbox de seleccionar todos
			$("#checkAllItemExtracto").on("change", function() {
				const isChecked = $(this).prop("checked");
				$(".check-extracto").prop("checked", isChecked);

				// Aplicar la clase 'selected' a las filas
				$("#tbGrillaExtracto tbody tr:not(.table-secondary)").each(function() {
					$(this).toggleClass("selected", isChecked);
				});
			});

			// Evento para checkboxes individuales sin usar 'event' global
			$(document).on("change", ".check-extracto", function(e) {
				// Evitar propagación del evento
				e.stopPropagation();

				const $checkbox = $(this);
				const isChecked = $checkbox.prop("checked");
				const $row = $checkbox.closest("tr");

				// Marcar/desmarcar la fila
				$row.toggleClass("selected", isChecked);

				// Si se desmarca uno, desmarcar el "seleccionar todos"
				if (!isChecked) {
					$("#checkAllItemExtracto").prop("checked", false);
				} else {
					// Verificar si todos están marcados para actualizar el checkbox principal
					const totalCheckboxes = $(".check-extracto").length;
					const totalChecked = $(".check-extracto:checked").length;
					$("#checkAllItemExtracto").prop("checked", totalCheckboxes === totalChecked);
				}
			});

			// Función de ayuda para obtener los IDs de productos seleccionados
			window.obtenerItemExtractoSeleccionados = function() {
				const itemMarcados = [];
				$(".check-extracto:checked").each(function () {
					const ctafId = $(this).data("ctaf-id");
					const extrId = $(this).data("extr-id");
					const extFecha = $(this).data("ext-fecha");
					if (ctafId && extrId && extFecha) {
						if (typeof ctafId === "string" && typeof extrId === "string" && typeof extFecha === "string") {
							itemMarcados.push(`${ctafId}|${extrId}|${extFecha}`);
						}
					}
				});
				return itemMarcados;
			};
		});
</script>