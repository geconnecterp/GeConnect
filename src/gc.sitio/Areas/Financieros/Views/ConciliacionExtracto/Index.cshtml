@model FiltroConciliacionExtractoModel
@{
    Layout = "~/views/shared/_Layout.cshtml";
}
<style>
	.filtro-btn {
		margin-right: 555px;
	}
</style>
<div class="container mt-2">
	<div class="row mb-2">
		<div class="d-flex justify-content-center">
			<button id="btnFiltro" class="btn btn-primary btn-sm filtro-btn" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltros" aria-expanded="true" aria-controls="divFiltros">
				<i class="bx bx-filter bx-xs"></i>
			</button>
		</div>
	</div>

	<div class="d-flex justify-content-center">
		<div id="divFiltros" class="w-100" style="max-width: 600px;">
			<partial name="_filtros" model="Model" />
		</div>
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="row" id="divConciliacionExtracto">
		</div>
	</div>
</div>
<div class="modal fade modal-golden in" id="modalRegistrosConciliados" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<div id="divModalRegistrosConciliados">
			</div>
		</div>
	</div>
</div>
<div class="modal fade modal-golden in" id="modalRegistrosAConciliar" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<div id="divModalRegistrosAConciliar">
			</div>
		</div>
	</div>
</div>
@section scripts {
	<script type="text/javascript">
		var ctafIdSelected = "";
		var ctafDenominacionSelected = "";
		var inicializarDatosEnSesionUrl =  "@Url.Action("InicializarDatosEnSesion", "ConciliacionExtracto", new { area = "Financieros" })";
		var cargarDatosExtractoYSistemaUrl = "@Url.Action("CargarDatosExtractoYSistema", "ConciliacionExtracto", new { area = "Financieros" })";
		var cargarDatosExtractoYSistema2Url = "@Url.Action("CargarDatosExtractoYSistema", "ConciliacionExtracto", new { area = "Financieros" })";
		var obtenerModalRegistrosConciliadosUrl = "@Url.Action("ObtenerModalRegistrosConciliados", "ConciliacionExtracto", new { area = "Financieros" })";
		var obtenerModalRegistrosAConciliarUrl = "@Url.Action("ObtenerModalRegistrosAConciliar", "ConciliacionExtracto", new { area = "Financieros" })";
		var desconciliarRegistrosConciliadosUrl = "@Url.Action("DesconciliarRegistrosConciliados", "ConciliacionExtracto", new { area = "Financieros" })";
		var actualizarRegistrosLuegoDeDesconciliarUrl = "@Url.Action("ActualizarRegistrosLuegoDeDesconciliar", "ConciliacionExtracto", new { area = "Financieros" })";
		var actuRegsPorConciliacionPreviaManualUrl = "@Url.Action("ActuRegsPorConciliacionPreviaManual", "ConciliacionExtracto", new { area = "Financieros" })";
		var desunirConciliacionPreviaManualUrl = "@Url.Action("DesunirConciliacionPreviaManual", "ConciliacionExtracto", new { area = "Financieros" })";
		var validarAntesDeConfirmarUrl = "@Url.Action("ValidarAntesDeConfirmar", "ConciliacionExtracto", new { area = "Financieros" })";
		var financieroConciliacionExtractoConfirmarUrl = "@Url.Action("FinancieroConciliacionExtractoConfirmar", "ConciliacionExtracto", new { area = "Financieros" })";
		//
	</script>
	<script src="~/js/app/areas/financieros/conciliacionextracto/conciextracto.js" type="text/javascript"></script>
}
