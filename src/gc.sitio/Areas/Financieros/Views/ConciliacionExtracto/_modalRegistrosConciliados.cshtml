@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@model ModalRegistrosConciliadosModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	
	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	.btn.invisible {
		visibility: hidden;
		pointer-events: none;
	}

	#tbGrillaExtractoRegConci th {
		padding: 0.4rem 0.5rem;
		font-size: 0.8rem;
	}

	#tbGrillaExtractoRegConci td {
		padding-top: 0.325rem !important;
		padding-bottom: 0.325rem !important;
		padding-left: 0.3rem !important;
		padding-right: 0.3rem !important;
		line-height: 1 !important;
	}

	#tbGrillaSistemaRegConci th {
		padding: 0.4rem 0.5rem;
		font-size: 0.8rem;
	}

	#tbGrillaSistemaRegConci td {
		padding-top: 0.325rem !important;
		padding-bottom: 0.325rem !important;
		padding-left: 0.3rem !important;
		padding-right: 0.3rem !important;
		line-height: 1 !important;
	}

	#tbGrillaExtractoRegConci td:empty {
		min-height: 32px; 
	}

	#tbGrillaSistemaRegConci td:empty {
		min-height: 32px;
	}

	.td-placeholder::before {
		content: "•";
		visibility: hidden;
		display: inline-block;
	}

	#tbGrillaExtractoRegConci thead th {
		position: sticky;
		top: 0;
		background-color: #d4af37;
		z-index: 2;
	}

	#tbGrillaSistemaRegConci thead th {
		position: sticky;
		top: 0;
		background-color: #d4af37; 
		z-index: 2;
	}

	/* Evitar salto de línea + mostrar ellipsis */
	.col-concepto {
		white-space: nowrap !important;
		overflow: hidden !important;
		text-overflow: ellipsis !important;
		max-width: 100%; /* respeta el ancho de la columna */
		cursor: default;
	}

		/* Tooltip Bootstrap */
		.col-concepto[data-bs-toggle="tooltip"] {
			cursor: pointer;
		}
</style>
@Html.Hidden("ConciliadoNro", Model.ConciliadoNro)
<div class="modal-header">
	<h5 class="modal-title" id="modalCenterTitle">@Model.RegistroConciliado</h5>
	<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
	<div class="row">
		<div id="divGrillaExtracto" class="col-md-6">
			<div class="table-responsive table-wrapper-500-full-width" id="containerGrillaExtractoRegConci">
				<table class="table table-bordered table-hover table-golden" id="tbGrillaExtractoRegConci">
					<thead>
						<tr class="header">
							<th class="text-center" style="width:5%;">Fecha</th>
							<th class="text-center" style="width:70%;">Concepto</th>
							<th class="text-center">Importe</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null && Model.GrillaExtracto != null && Model.GrillaExtracto.ListaDatos != null && Model.GrillaExtracto.ListaDatos.Count > 0)
						{
							@foreach (var item in Model.GrillaExtracto.ListaDatos)
							{
								if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
								<tr class="@clase" data-ctaf-id="@item.ctaf_id" data-extr-id="@item.extr_id" data-ext-fecha="@item.ext_fecha" onclick="selectGrillaExtractoModalRegConci(this);">
									<td class="@Model.GrillaExtracto.ObtenerClase(item.ext_fecha)"
										data-bs-toggle="tooltip"
										data-bs-placement="top"
										title="@Model.GrillaExtracto.FormatearDato(item.concepto, FormatDato.Ninguno)">
										@Model.GrillaExtracto.FormatearDato(item.ext_fecha, FormatDato.Fecha)
									</td>
									<td class="col-concepto @Model.GrillaExtracto.ObtenerClase(item.concepto)">@Model.GrillaExtracto.FormatearDato(item.concepto, FormatDato.Ninguno)</td>
									<td class="@Model.GrillaExtracto.ObtenerClase(item.importe)">@GridHelper.FormatearDato(item.importe, FormatDato.Monto, true)</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
		<div id="divGrillaSistema" class="col-md-6">
			<div class="table-responsive table-wrapper-500-full-width" id="containerGrillaSistemaRegConci">
				<table class="table table-bordered table-hover table-golden" id="tbGrillaSistemaRegConci">
					<thead>
						<tr class="header">
							<th class="text-center" style="width:5%;">Fecha</th>
							<th class="text-center" style="width:70%;">Concepto</th>
							<th class="text-center">Importe</th>
						</tr>
					</thead>
					<tbody>
						@if (Model != null && Model.GrillaSistema != null && Model.GrillaSistema.ListaDatos != null && Model.GrillaSistema.ListaDatos.Count > 0)
						{
							@foreach (var item in Model.GrillaSistema.ListaDatos)
							{
								if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
								<tr class="@clase" data-ctaf-id="@item.ctaf_id" data-dia-movi="@item.dia_movi" data-cf-compte="@item.cf_compte" data-cf-item="@item.cf_item" onclick="selectGrillaSistema(this);">
									<td class="@Model.GrillaSistema.ObtenerClase(item.cf_fecha_concilia)">@Model.GrillaSistema.FormatearDato(item.cf_fecha_concilia, FormatDato.Fecha)</td>
									<td class="col-concepto @Model.GrillaSistema.ObtenerClase(item.concepto)"
										data-bs-toggle="tooltip"
										data-bs-placement="top"
										title="@Model.GrillaSistema.FormatearDato(item.concepto, FormatDato.Ninguno)">
										@Model.GrillaSistema.FormatearDato(item.concepto, FormatDato.Ninguno)
									</td>
									<td class="@Model.GrillaSistema.ObtenerClase(item.importe)">@GridHelper.FormatearDato(item.importe, FormatDato.Monto, true)</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
<div class="modal-footer">
	<div class="input-group input-group-sm">
		<button type="button" class="btn btn-success btn-sm ms-1" id="btnDesconciliar" style="width:120px;">
			<i class="bx bx-unlink"></i> Des Conciliar
		</button>
		<button type="button" class="btn btn-outline-secondary btn-sm ms-1" id="btnSalir" style="width:120px;" data-bs-dismiss="modal">
			<i class="bx bx-log-out-circle"></i> Salir
		</button>
	</div>
</div>