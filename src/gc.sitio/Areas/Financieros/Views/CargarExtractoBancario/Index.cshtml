@model FiltroExtractoModel
@{
	Layout = "~/views/shared/_Layout.cshtml";
	string uploadId = ViewBag.UploadId ?? "default";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	.filtro-btn{
		margin-right:555px;
	}

	#tbListaCrudExtracto td .btn-icon-compact {
		height: 16px !important;
		width: 20px !important;
		line-height: 16px !important;
		padding: 0 !important;
		margin: 0 auto !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
	}

		#tbListaCrudExtracto td .btn-icon-compact i {
			font-size: 0.70rem !important;
			line-height: 1 !important;
			padding: 0 !important;
			margin: 0 !important;
		}

	#tbListaCrudExtracto td {
		padding-top: 0.325rem !important;
		padding-bottom: 0.325rem !important;
		padding-left: 0.3rem !important;
		padding-right: 0.3rem !important;
		line-height: 1 !important;
	}

	#containerCrudExtracto {
		position: relative;
		max-height: 60vh;
		height: auto;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}
</style>
<div class="container mt-2">
	<div class="row mb-2">
		<div class="d-flex justify-content-center">
			<button id="btnFiltro" class="btn btn-primary btn-sm filtro-btn" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltros" aria-expanded="true" aria-controls="divFiltros">
				<i class="bx bx-filter bx-xs"></i>
			</button>
		</div>
	</div>

	<div class="d-flex justify-content-center">
		<div id="divFiltros" class="w-100" style="max-width: 600px;">
			<partial name="_filtros" model="Model" />
		</div>
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="row" id="divExtractoBco">
		</div>
	</div>
</div>
<div class="modal fade modal-golden in" id="modalAgregarItemExtracto" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog modal-x" role="document">
		<div class="modal-content">
			<div id="divAgregarItemExtracto">
			</div>
		</div>
	</div>
</div>
<div class="modal fade modal-golden" id="modalImportarArchivo" tabindex="-1" aria-labelledby="tituloImportarArchivo" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div id="divModalImportarExtracto">
			</div>
			
		</div>
	</div>
</div>

@section scripts {
	<script type="text/javascript">
		var ctafIdSelected = "";
		var ctafDenominacionSelected = "";
		var obtenerCuentaBancoUrl = "@Url.Action("ObtenerCuentaBanco", "CargarExtractoBancario", new { area = "Financieros" })";
		var cargarExtractoBancarioURL = "@Url.Action("CargarExtractoBancarioCrud", "CargarExtractoBancario", new { area = "Financieros" })";
		var abrirModalAgregarItemExtractoUrl = "@Url.Action("AbrirModalAgregarItemExtracto", "CargarExtractoBancario", new { area = "Financieros" })";
		var agregarItemExtractoUrl = "@Url.Action("AgregarItemExtracto", "CargarExtractoBancario", new { area = "Financieros" })";
		var obtenerListaExtractoBancarioUrl = "@Url.Action("ObtenerListaExtractoBancario", "CargarExtractoBancario", new { area = "Financieros" })";
		var inicializarDatosEnSesionUrl =  "@Url.Action("InicializarDatosEnSesion", "CargarExtractoBancario", new { area = "Financieros" })";
		var modificarItemExtractoUrl = "@Url.Action("ModificarItemExtracto", "CargarExtractoBancario", new { area = "Financieros" })";
		var quitarItemExtractoUrl = "@Url.Action("QuitarItemExtracto", "CargarExtractoBancario", new { area = "Financieros" })";
		var procesarArchivoUrl = "@Url.Action("ProcesarArchivo", "CargarExtractoBancario", new { area = "Financieros" })";
		var importarArchivoUrl = "@Url.Action("ImportarArchivo", "CargarExtractoBancario", new { area = "Financieros" })";
		var abrirModalImportarExtractoUrl = "@Url.Action("AbrirModalImportarExtracto", "CargarExtractoBancario", new { area = "Financieros" })";
		var validarSiExistenRegistrosDeArchivoParaImportarUrl = "@Url.Action("ValidarSiExistenRegistrosDeArchivoParaImportar", "CargarExtractoBancario", new { area = "Financieros" })";
		var procesarArchivoImportadoUrl = "@Url.Action("ProcesarArchivoImportado", "CargarExtractoBancario", new { area = "Financieros" })";
		var validarAntesDeConfirmarUrl = "@Url.Action("ValidarAntesDeConfirmar", "CargarExtractoBancario", new { area = "Financieros" })";
		var confirmarExtractoUrl = "@Url.Action("ConfirmarExtracto", "CargarExtractoBancario", new { area = "Financieros" })";
	</script>
	<script src="~/js/plugins/jquery.simplePagination.js"></script>
	<script src="~/js/app/areas/financieros/extractobancario/extrbancario.js" type="text/javascript"></script>
}