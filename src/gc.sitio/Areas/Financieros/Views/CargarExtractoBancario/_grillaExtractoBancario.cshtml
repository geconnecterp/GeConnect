@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@model CrudExtractoBancarioModel
@{
    var alt = true;
    string clase = string.Empty;
}
<style>
</style>
<div class="table-responsive table-wrapper-500-full-width" id="containerCrudExtracto">
    <table class="table table-bordered table-hover table-golden" id="tbListaCrudExtracto">
        <thead>
            <tr class="header">
                <th class="text-center" style="width:6%;">Fecha Mov.</th>
                <th class="text-center" style="width:6%;">Fecha</th>
                <th class="text-center" style="width:6%;">Código Mov.</th>
                <th class="text-center" style="width:20%;">Origen Mov.</th>
                <th class="text-center" style="width:15%;">N° Comprobante</th>
                <th class="text-center" style="width:10%;">Debe</th>
                <th class="text-center" style="width:10%;">Haber</th>
                <th class="text-center" style="width:10%;">Saldo</th>
                <th class="text-center" style="width:5%;">Conc.</th>
                <th class="text-center" style="width:5%;">Ctrl. Cierre</th>
                <th style="width:3%;"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.GrillaExtracto != null && Model.GrillaExtracto.ListaDatos != null && Model.GrillaExtracto.ListaDatos.Count > 0)
            {
                @foreach (var item in Model.GrillaExtracto.ListaDatos)
                {
                    if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
                    <tr class="@clase" data-orden="@item.orden" data-extr-id="@item.extr_id" data-ctaf-id="@item.ctaf_id" onclick="selectItemExtracto(this);">
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_fecha_movi)">@Model.GrillaExtracto.FormatearDato(item.ext_fecha_movi, FormatDato.Fecha)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_fecha)">@Model.GrillaExtracto.FormatearDato(item.ext_fecha, FormatDato.Fecha)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.extr_id)">@Model.GrillaExtracto.FormatearDato(item.extr_id, FormatDato.Ninguno)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.extr_desc)">@Model.GrillaExtracto.FormatearDato(item.extr_desc, FormatDato.Ninguno)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_concepto)">@Model.GrillaExtracto.FormatearDato(item.ext_concepto, FormatDato.Ninguno)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_debe)">@GridHelper.FormatearDato(item.ext_debe, FormatDato.Monto, true)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_haber)">@GridHelper.FormatearDato(item.ext_haber, FormatDato.Monto, true)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_saldo)">@GridHelper.FormatearDato(item.ext_saldo, FormatDato.Monto, true)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_conciliado) text-center">@Model.GrillaExtracto.FormatearDato(item.ext_conciliado, FormatDato.Ninguno)</td>
                        <td class="@Model.GrillaExtracto.ObtenerClase(item.ctl_cierre) text-center">@Model.GrillaExtracto.FormatearDato(item.ctl_cierre, FormatDato.Ninguno)</td>
                        @if (!item.ext_conciliado_bool && !item.ctl_cierre_bool)
                        {
                            <td class="text-center align-middle">
                                <button type="button" class="btn btn-danger btn-icon-compact" title="Eliminar" onclick="eliminarItem('@item.ctaf_id', '@item.extr_id','@item.orden')">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </td>
                        }
                        else
                        {
                            <td class="text-center align-middle">
                                <button type="button" class="btn btn-icon-compact invisible" tabindex="-1">
                                    <i class="bx bx-dots-horizontal-rounded"></i>
                                </button>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>