@using gc.infraestructura.Dtos.Gen
@model FiltroExtractoModel
@{
	var list = new List<ComboGenDto>();
	var ls02 = new SelectList(list, "Id", "Descripcion");

}
<style>
	.listbox-sm {
		height: 80px;
		font-size: 0.85rem;
	}

	.lbl-sm {
		width: 100px;
	}
</style>
<div class="card card-golden">
	<div class="card-header mb-2">
		<h5 class="mb-0" id="tituloLegend">Filtros </h5>
	</div>
	<div class="card-body">
		<div class="row">
			<div class="col-sm-6">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkCuentaBanco" />
						<label class="form-check-label" for="chkCuentaBanco" id="lbCuentaBanco"></label>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="input-group input-group-sm">
					<span class="input-group-text d-flex align-items-center justify-content-end lbl-sm">Cuenta Banco: </span>
					@Html.DropDownListFor(m => m.selectedValue, Model.CuentaBanco, "Seleccionar", new { @id = "listaCuentaBanco", @class = "form-control inputEditable activable" })
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-sm-6">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkFecha" />
						<label class="form-check-label" for="chkFecha" id="lbFecha"></label>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-md-4">
				<div class="input-group input-group-sm">
					<span class="input-group-text" id="lbIdDesde">Desde:</span>
					<input type="date" class="form-control inputEditable" asp-for="FechaDesde" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
				</div>
			</div>
			<div class=" col-sm-4">
				<div class="input-group input-group-sm">
					<span class="input-group-text" id="lbIdHasta">Hasta:</span>
					<input type="date" class="form-control inputEditable" asp-for="FechaHasta" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
				</div>
			</div>
			<div class=" col-sm-4">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkCargar" />
						<label class="form-check-label" for="chkCargar" id="lbCargar"></label>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="row m-3">
	<div class="d-flex justify-content-around">
		<button type="button" id="btnCancel" class="btn btn-sm btn-danger"><i class="bx bx-sm bx-x-circle"></i></button>
		<button type="button" id="btnBuscar" class="btn btn-sm btn-success"><i class="bx bx-sm bx-search"></i></button>
	</div>
</div>