@model MovimientoFinancieroModel
@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@{
    var alt = true;
	string clase = string.Empty;
	string sortDirInv = Model.GrillaMovimientoFinanciero.SortDir.Equals("ASC") ? "DESC" : "ASC";
	var total = 0;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}

	.table-wrapper-fixed-head th,
	.table-wrapper-fixed-head td {
		box-sizing: border-box;
	}

	.table-wrapper {
		overflow-x: hidden;
	}

</style>
<div class="card">
	<div class="card-body">
		<div class="row">
			<div class="col-10">
				<div class="table-responsive table-wrapper">
					<table class="table table-sm table-golden" id="tbGridMovFin">
						<thead>
							<tr class="header">
								<th style="width:8%;" class="col-header-small align-center ">N° Tra.</th>
								<th style="width:8%;" class="col-header-small align-center ">Fecha</th>
								<th style="width:25%;" class="col-header-small align-center ">Tipo</th>
								<th style="width:30%;" class="col-header-small align-center ">Concepto</th>
								<th style="width:5%;" class="col-header-small align-center ">Anulada</th>
								<th style="width:10%;" class="col-header-small align-center ">Usuario</th>
								<th style="width:10%;" class="col-header-small align-center ">Importe</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.GrillaMovimientoFinanciero != null && Model.GrillaMovimientoFinanciero.ListaDatos != null && Model.GrillaMovimientoFinanciero.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.GrillaMovimientoFinanciero.ListaDatos)
								{
									if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

									@* <tr class="@clase" onclick="selectReg(this, 'tbGridMovFin')" ondblclick="selectRegDbl(this, 'tbGridMovFin')"> *@
									<tr class="@clase" data-grid="tbGridMovFin">
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.tra_compte) align-center cell-fit-content">@Model.GrillaMovimientoFinanciero.FormatearDato(item.tra_compte, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.tra_fecha) align-center cell-fit-content">@Model.GrillaMovimientoFinanciero.FormatearDato(item.tra_fecha, FormatDato.Fecha)</td>
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.ttra_desc) align-left cell-fit-content">@Model.GrillaMovimientoFinanciero.FormatearDato(item.ttra_desc, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.tra_concepto) align-left cell-fit-content">@Model.GrillaMovimientoFinanciero.FormatearDato(item.tra_concepto, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.strAnulada) align-center cell-fit-content">@Model.GrillaMovimientoFinanciero.FormatearDato(item.strAnulada, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.usu_apellidoynombre) align-left cell-fit-content">@Model.GrillaMovimientoFinanciero.FormatearDato(item.usu_apellidoynombre, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaMovimientoFinanciero.ObtenerClase(item.tra_importe) align-right cell-fit-content">@GridHelper.FormatearDato(item.tra_importe, FormatDato.Monto, true)</td>
									</tr>
								}
							}
						</tbody>
					</table>
					<div class="row mt-3">
						<div class="offset-md-3 col-md-6">
							<div id="divPaginacion" class="">
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-8">
					</div>
					<div class="col-4">
						<div class="input-group input-group-sm mt-1">
							<span class="input-group-text fixed-lbl-for-abm-100">Totales: </span>
							<input type="text" asp-for="Totales" class="form-control" style="text-align: right;" disabled />
						</div>
					</div>
				</div>
			</div>
			<div class="col-2">
				<div class="row">
					<button type="button" class="btn btn-secondary btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnImprimirLista">
						<div class="row" style="display: contents">
							<div class="col-2">
								<span class="bx bx-printer"></span>
							</div>
							<div class="col-10" style="font-size: small;">
								Imprimir Lista
							</div>
						</div>
					</button>
				</div>
				<div class="row mt-1">
					<button type="button" class="btn btn-secondary btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnImprimirMovSele">
						<div class="row" style="display: contents">
							<div class="col-2">
								<span class="bx bx-printer"></span>
							</div>
							<div class="col-10" style="font-size: small;">
								Imprimir Acuse
							</div>
						</div>
					</button>
				</div>
				<div class="row mt-1">
					<button type="button" class="btn btn-danger btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnAnularMovi">
						<div class="row" style="display: contents">
							<div class="col-2">
								<span class="bx bx-trash"></span>
							</div>
							<div class="col-10" style="font-size: small;">
								Anular Movimiento
							</div>
						</div>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>