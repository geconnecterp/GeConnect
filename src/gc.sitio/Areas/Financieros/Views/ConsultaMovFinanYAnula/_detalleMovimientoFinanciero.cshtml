@model DetalleMovFinanModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	string clase = string.Empty;
}
@Html.Hidden("MostrarSeccionGrillaOrigen", Model.MostrarSeccionGrillaOrigen)
@Html.Hidden("MostrarSeccionGrillaDestino", Model.MostrarSeccionGrillaDestino)
@Html.Hidden("MostrarSeccionGrillaCtag", Model.MostrarSeccionGrillaCtag)
<div class="card">
	<div class="card-body">
		@if (Model != null && Model.MostrarSeccionGrillaOrigen)
		{
			<div class="row">
				<div class="table-responsive text-nowrap  table-wrapper">
					<table class="table table-sm mb-0 table-hover table-wrapper-fixed-head" id="tbGridOrigen">
						<thead class="table-dark">
							<tr class="header">
								<th style="width:10%;" class="col-header-small align-center tiny-row">Código</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Denominación</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Concepto</th>
								<th style="width:20%;" class="col-header-small align-center tiny-row">Monto</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.GrillaOrigen != null && Model.GrillaOrigen.ListaDatos != null && Model.GrillaOrigen.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.GrillaOrigen.ListaDatos)
								{
									<tr class="@clase" onclick="selectReg(this, 'tbGridOrigen')">
										<td class="@Model.GrillaOrigen.ObtenerClase(item.ctaf_id) align-center cell-fit-content">@Model.GrillaOrigen.FormatearDato(item.ctaf_id, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaOrigen.ObtenerClase(item.ctaf_denominacion) align-left cell-fit-content">@Model.GrillaOrigen.FormatearDato(item.ctaf_denominacion, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaOrigen.ObtenerClase(item.concepto) align-left cell-fit-content">@Model.GrillaOrigen.FormatearDato(item.concepto, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaOrigen.ObtenerClase(item.fc_importe) align-center cell-fit-content">@Model.GrillaOrigen.FormatearDato(item.fc_importe, FormatDato.Monto)</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="row col-12 mb-1">
				<div class="col-7"></div>
				<div class="col-2"></div>
				<div class="col-3 justify-content-sm-end">
					<div class="input-group input-group-sm">
						<span class="input-group-text">Total Egreso Cuentas Origen: </span>
						<input type="text" asp-for="TotalOrigen" class="form-control inputEditable" disabled style="text-align:end;" />
					</div>
				</div>
			</div>
		}
		@if (Model != null && Model.MostrarSeccionGrillaDestino)
		{
			<div class="row">
				<div class="table-responsive text-nowrap  table-wrapper">
					<table class="table table-sm mb-0 table-hover table-wrapper-fixed-head" id="tbGridDestino">
						<thead class="table-dark">
							<tr class="header">
								<th style="width:10%;" class="col-header-small align-center tiny-row">Código</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Denominación</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Concepto</th>
								<th style="width:20%;" class="col-header-small align-center tiny-row">Monto</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.GrillaDestino != null && Model.GrillaDestino.ListaDatos != null && Model.GrillaDestino.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.GrillaDestino.ListaDatos)
								{
									<tr class="@clase" onclick="selectReg(this, 'tbGridDestino')">
										<td class="@Model.GrillaDestino.ObtenerClase(item.ctaf_id) align-center cell-fit-content">@Model.GrillaDestino.FormatearDato(item.ctaf_id, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaDestino.ObtenerClase(item.ctaf_denominacion) align-left cell-fit-content">@Model.GrillaDestino.FormatearDato(item.ctaf_denominacion, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaDestino.ObtenerClase(item.concepto) align-left cell-fit-content">@Model.GrillaDestino.FormatearDato(item.concepto, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaDestino.ObtenerClase(item.fc_importe) align-center cell-fit-content">@Model.GrillaDestino.FormatearDato(item.fc_importe, FormatDato.Monto)</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="row col-12 mb-1">
				<div class="col-7"></div>
				<div class="col-2"></div>
				<div class="col-3 justify-content-sm-end">
					<div class="input-group input-group-sm">
						<span class="input-group-text">Total Ingreso Cuentas Destino: </span>
						<input type="text" asp-for="TotalDestino" class="form-control inputEditable" disabled style="text-align:end;" />
					</div>
				</div>
			</div>
		}
		@if (Model != null && Model.MostrarSeccionGrillaCtag)
		{
			<div class="row">
				<div class="table-responsive text-nowrap  table-wrapper">
					<table class="table table-sm mb-0 table-hover table-wrapper-fixed-head" id="tbGridCtag">
						<thead class="table-dark">
							<tr class="header">
								<th style="width:10%;" class="col-header-small align-center tiny-row">Código</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Denominación</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Tipo Comprobante</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Comprobante</th>
								<th style="width:35%;" class="col-header-small align-center tiny-row">Número</th>
								<th style="width:20%;" class="col-header-small align-center tiny-row">Importe</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.GrillaCtag != null && Model.GrillaCtag.ListaDatos != null && Model.GrillaCtag.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.GrillaCtag.ListaDatos)
								{
									<tr class="@clase" onclick="selectReg(this, 'tbGridCtag')">
										<td class="@Model.GrillaCtag.ObtenerClase(item.ctag_id) align-center cell-fit-content">@Model.GrillaCtag.FormatearDato(item.ctag_id, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaCtag.ObtenerClase(item.ctag_denominacion) align-left cell-fit-content">@Model.GrillaCtag.FormatearDato(item.ctag_denominacion, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaCtag.ObtenerClase(item.tco_id) align-left cell-fit-content">@Model.GrillaCtag.FormatearDato(item.tco_id, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaCtag.ObtenerClase(item.tco_desc) align-center cell-fit-content">@Model.GrillaCtag.FormatearDato(item.tco_desc, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaCtag.ObtenerClase(item.cm_compte) align-center cell-fit-content">@Model.GrillaCtag.FormatearDato(item.cm_compte, FormatDato.Ninguno)</td>
										<td class="@Model.GrillaCtag.ObtenerClase(item.cm_importe) align-center cell-fit-content">@Model.GrillaCtag.FormatearDato(item.cm_importe, FormatDato.Monto)</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="row col-12 mb-1">
				<div class="col-7"></div>
				<div class="col-2"></div>
				<div class="col-3 justify-content-sm-end">
					<div class="input-group input-group-sm">
						<span class="input-group-text">Total: </span>
						<input type="text" asp-for="TotalCtag" class="form-control inputEditable" disabled style="text-align:end;" />
					</div>
				</div>
			</div>
		}
	</div>
</div>