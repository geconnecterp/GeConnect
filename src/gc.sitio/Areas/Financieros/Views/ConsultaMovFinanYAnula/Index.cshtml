@model ConsultaMovFinanYAnulaModel
@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	#btnCancelar {
		border: 2px solid transparent; /* evita que el borde se agregue en hover */
		padding: 4px 8px; /* tamaño fijo */
		transition: background-color 0.2s ease, color 0.2s ease;
		margin-top: 4px; /* equivalente a mt-1 */
		margin-right: 4px; /* equivalente a me-1 */
	}

		#btnCancelar:hover {
			background-color: #c82333; /* tono más oscuro */
			color: white;
			border-color: transparent; /* no cambia el borde */
		}

	/* Estilos para el recuadro flotante de filtros aplicados */
	#filtrosAplicadosFloating {
		overflow: visible;
		z-index: 1050;
		white-space: nowrap;
		display: inline-flex;
		gap: 6px;
		align-items: center;
	}

		#filtrosAplicadosFloating .dropdown-menu {
			z-index: 3000 !important;
		}
	/* Si el header global tiene un z-index muy alto, forzamos el menu del filtro encima */
	.navbar, .main-header {
		z-index: 1100;
	}
</style>
<div class="container mt-2">
	<div class="row mb-2">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>

				<button class="btn btn-primary btn-sm mt-1 me-1" type="button" id="btnDetalle" data-bs-toggle="collapse" data-bs-target="#divDetalle" aria-expanded="true" aria-controls="divDetalle" hidden>
					<i class="bx bx-caret-down"></i>
				</button>

				<button class="collapse btn btn-light btn-sm mt-1 me-1" type="button" id="btnImprimir" title="Imprimir">
					<i class="bx bx-printer"></i> Imprimir
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltro" style="">
		<partial name="_filtros" model="Model" />
		@Html.Hidden("pagEstado", false);
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="d-flex align-items-center w-100" style="position:relative;">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsConsultaMovimientoFinanciero">
				<li class="nav-item" role="presentation" id="tabMovimientoFinanciero">
					<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabMovimientoFinanciero">
						Movimiento Financiero
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabDetalle">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabDetalle">
						Detalle
					</button>
				</li>
			</ul>
			<!-- Contenedor flotante para filtros aplicados -->
			<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center" style="position:absolute; right:16px; left:auto; top:2px; height:auto; width:auto; border-color:#d9534f; background-color:#fff; z-index:1050; padding:6px 10px; overflow:visible; gap:6px; display:inline-flex; white-space:nowrap;">
				<!-- Badges rellenadas por JS -->
			</div>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div id="divDatosMovimientoFinanciero">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div id="divDetalleMovimiento">
				</div>
			</div>
		</div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "BuscarMovimientosFinancieros";
		var dataBak = {};
		var ttraSelected = "";

		var actualizarListaDeUsuariosURL = "@Url.Action("ActualizarListaDeUsuarios", "consultamovfinanyanula", new { area = "Financieros" })";
		var buscarMovimientosFinancierosURL = "@Url.Action("BuscarMovimientosFinancieros", "consultamovfinanyanula", new { area = "Financieros" })";
		var buscarMovimientosFinancieros2URL = "@Url.Action("BuscarMovimientosFinancieros", "consultamovfinanyanula", new { area = "Financieros" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "consultamovfinanyanula", new { area = "Financieros" })";
		var inicializarDatosEnSesionURL = "@Url.Action("InicializarDatosEnSesion", "consultamovfinanyanula", new { area = "Financieros" })";
		var actualizarTotalUrl ="@Url.Action("ActualizarTotales", "consultamovfinanyanula", new { area = "Financieros" })";
		var setearTipoDeReporteUrl = "@Url.Action("SetearTipoDeReporte", "consultamovfinanyanula", new { area = "Financieros" })";
		var anularMovimientoFinancieroUrl = "@Url.Action("AnularMovimientoFinanciero", "consultamovfinanyanula", new { area = "Financieros" })";
		var cargarDetalleDeMovimientoFinancieroURL = "@Url.Action("CargarDetalleDeMovimientoFinanciero", "consultamovfinanyanula", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>

	<script src="~/js/app/areas/financieros/consultamovimientofinanyanulacion/consmovfinanyanula.js" type="text/javascript"></script>
}