@model FiltroLiqDeEmpConsultaYAnulacionModel
@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />

	<style>
		/* Estilos para el recuadro flotante de filtros aplicados */
		#filtrosAplicadosFloating { overflow: visible; z-index: 1050; white-space: nowrap; display:inline-flex; gap:6px; align-items:center; }
		#filtrosAplicadosFloating .dropdown-menu { z-index: 3000 !important; }
		/* Si el header global tiene un z-index muy alto, forzamos el menu del filtro encima */
		.navbar, .main-header {
			z-index: 1100;
		}
	</style>
}
<div class="container mt-2">
	<div class="row mb-2">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>

				<button class="btn btn-primary btn-sm mt-1 me-1" type="button" id="btnDetalle" data-bs-toggle="collapse" data-bs-target="#divDetalle" aria-expanded="true" aria-controls="divDetalle" hidden>
					<i class="bx bx-caret-down"></i>
				</button>
			</div>
		</div>
		<div class="collapse col-md-2">
			<div class="d-flex justify-content-sm-end">
				<!-- Botón Imprimir -->
				<button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" title="Imprimir">
					<i class="bx bx-printer"></i>
				</button>
				<button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" id="btnImprimirTemp" title="Imprimir Temporal">
					<i class="bx bx-printer"></i>
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltros">
		<div class="row justify-content-center">
			<div class="col-auto">
				<partial name="_filtros" model="Model" />
				@Html.Hidden("pagEstado", false);
			</div>
		</div>
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="d-flex align-items-center w-100 mt-2" style="position:relative;">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsLiqDeEmp">
				<li class="nav-item" role="presentation" id="tabLiqDeEmp">
					<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabLiqDeEmp">
						Liq. de Empleados
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabLiqDeEmpDetalle">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabLiqDeEmpDetalle">
						Detalle
					</button>
				</li>
			</ul>
			<!-- Contenedor flotante para filtros aplicados -->
			<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center" style="position:absolute; right:16px; left:auto; top:4px; height:auto; width:auto; border-color:#d9534f; background-color:#fff; z-index:1050; padding:6px 10px; overflow:visible; gap:6px; display:inline-flex; white-space:nowrap;">
				<!-- Badges rellenadas por JS -->
			</div>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div class="row col-12">
					<div class="col-10" id="divLiqDeEmp">
					</div>
					<div class="col-2">
						<div class="row ms-1">
							<button type="button" class="btn btn-secondary btn-sm me-1" style="margin-left:5px; width:88%;" id="btnImprimirDetalle">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-printer"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Imprimir Detalle
									</div>
								</div>
							</button>
						</div>
						<div class="row mt-1 ms-1">
							<button type="button" class="btn btn-danger btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnAnularLiqDeEmp">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-trash"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Anular Liquidación
									</div>
								</div>
							</button>
						</div>
						<div class="row mt-1 ms-1">
							<button type="button" class="btn btn-info btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnFileBco">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-file"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										File Bco
									</div>
								</div>
							</button>
						</div>
						<div class="row mt-1 ms-1">
							<button type="button" class="btn btn-danger btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnCancelar">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-x-circle"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Cancelar
									</div>
								</div>
							</button>
						</div>
					</div>
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div id="divLiqDeEmpDetalle">
				</div>
			</div>

		</div>
	</div>
</div>

<div class="modal fade modal-golden in" id="modalArchivoParaBanco" tabindex="-1" style="display: none;" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog modal-x" role="document">
		<div class="modal-content">
			<div id="divArchivoParaBanco">
			</div>
		</div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "BuscarLiquidacionDeEmpleados";
		var dataBak = {};
		var le_compte_selected = "";
		var le_compte_anulada = "";

		var buscarLiquidacionesDeEmpleadosURL = "@Url.Action("BuscarLiquidacionesDeEmpleados", "liqdeempconsultayanulacion", new { area = "Financieros" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "liqdeempconsultayanulacion", new { area = "Financieros" })";
		var cargarDetalleDeLiquidacionUrl = "@Url.Action("CargarDetalleDeLiquidacion", "liqdeempconsultayanulacion", new { area = "Financieros" })";
		var anularLiquidacionDeEmpleadoURL = "@Url.Action("AnularLiquidacionDeEmpleado", "liqdeempconsultayanulacion", new { area = "Financieros" })";
		var inicializarDatosEnSesionUrl =  "@Url.Action("InicializarDatosEnSesion", "liqdeempconsultayanulacion", new { area = "Financieros" })";
		var abrirModalArchivoBancoUrl = "@Url.Action("AbrirModalArchivoBanco", "liqdeempconsultayanulacion", new { area = "Financieros" })";
		var generarArchivoParaBancoUrl = "@Url.Action("GenerarArchivoParaBanco", "liqdeempconsultayanulacion", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>

	<script src="~/lib/xlsx/xlsx.full.min.js"></script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>

	<script src="~/js/app/areas/financieros/liquidaciondeempleadosconsyanu/liqdeempconsyanu.js" type="text/javascript"></script>
}