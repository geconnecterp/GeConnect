@model CargaDeAnticiposModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
		z-index: 1; /* suficiente para estar sobre las filas */
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		/*max-height: 400px;  o lo que necesites */
		overflow-y: auto;
		position: relative;
	}

	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	#tbListaAnticipos td,
	#tbListaAnticipos th {
		padding-top: 0.25rem;
		padding-bottom: 0.25rem;
		font-size: 0.75rem;
	}

	.alerta-importe {
		color: #b30000 !important; /* rojo fuerte */
		font-weight: bold !important;
	}

	#containerGrillaAnticipos {
		position: relative;
		height: 480px;
		max-height: 480px;
		overflow-y: auto;
		overflow-x: hidden !important;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbListaAnticipos th,
	#tbListaAnticipos td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbListaAnticipos tr {
		height: 1.6rem !important;
	}
</style>
<div class="table-responsive table-wrapper-500-full-width" id="containerGrillaAnticipos">
	<table class="table table-bordered table-hover table-golden" id="tbListaAnticipos">
		<thead>
			<tr class="header">
				<th class="text-center" scope="col" style="width: 40%;">Cliente</th>
				<th class="text-center" scope="col">Cuotas</th>
				<th class="text-center" scope="col">Importe</th>
				<th class="text-center" scope="col">Intereses</th>
				<th class="text-center" scope="col">Valor Cuota</th>
				<th class="text-center" scope="col">Valor Total</th>
				<th class="text-center" scope="col">Tope</th>
				<th style="width:4%;"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaAnticipos != null && Model.GrillaAnticipos.ListaDatos != null && Model.GrillaAnticipos.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaAnticipos.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase @(item.mostrar_alerta ? "alerta-fila" : "")"
						title="El valor total supera el tope permitido"
						onclick="selectItemGrillaAnticipo(this);">
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.cta_denominacion)">@Model.GrillaAnticipos.FormatearDato(item.cta_denominacion, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.cuotas)">@Model.GrillaAnticipos.FormatearDato(item.cuotas, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.importe)">@Model.GrillaAnticipos.FormatearDato(item.importe, FormatDato.Monto)</td>
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.intereses)">@Model.GrillaAnticipos.FormatearDato(item.intereses, FormatDato.Monto)</td>
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.valor_cuota)">@Model.GrillaAnticipos.FormatearDato(item.valor_cuota, FormatDato.Monto)</td>
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.valor_total) @(item.mostrar_alerta ? "alerta-importe" : "")">
							@Model.GrillaAnticipos.FormatearDato(item.valor_total, FormatDato.Monto)
						</td>
						<td class="@Model.GrillaAnticipos.ObtenerClase(item.tope)">@Model.GrillaAnticipos.FormatearDato(item.tope, FormatDato.Monto)</td>
						<td class="text-center align-middle">
							<div class="d-flex justify-content-center gap-1">
								<button type="button" class="btn btn-danger btn-icon-compact" title="Eliminar" onclick="eliminarItem('@item.id')">
									<i class="bx bx-trash"></i>
								</button>
							</div>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
