@model CargarChequesDeTercerosEnCarteraModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var col1 = Model.titulo_col_1;
	var col2 = Model.titulo_col_2;
	var col3 = Model.titulo_col_3;
}
<fieldset style="height: 460px;">
	<legend></legend>
	<div class="row">
		<div class="col-4">
			@if (Model.mostrar_fecha)
			{
				<div class="input-group input-group-sm">
					<span class="input-group-text">Fecha Valor: </span>
					@Html.TextBoxFor(m => m.fecha_valor, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control activable inputEditable", @onchange = "onChangeFechaValor(this);", @id = "fechaValor" })
				</div>
			}
		</div>
		<div class="col-4">
			<button type="button" id="btnAceptar" class="btn btn-sm btn-success"><i class="bx bx-check-double"></i></button>
			<button type="button" id="btnCancel" class="btn btn-sm btn-danger"><i class="bx bx-x-circle"></i></button>
		</div>
		<div class="col-4"></div>
	</div>
	<div class="table-responsive table-wrapper-400-full-width mt-2" id="containerChequesDeTercerosEnCartera">
		<table class="table table-bordered table-hover table-golden" id="tbListaChequesDeTercerosEnCartera">
			<thead>
				<tr class="header">
					<th style="width:15%;" class="col-header-small align-center tiny-row">Fecha Valor</th>
					<th style="width:15%;" class="col-header-small align-center tiny-row">Fecha Carga</th>
					<th style="width:40%;" class="col-header-small align-center tiny-row">@col1</th>
					<th style="width:10%;" class="col-header-small align-center tiny-row">@col2</th>
					<th style="width:10%;" class="col-header-small align-center tiny-row">@col3</th>
					<th style="width:10%;" class="col-header-small align-center tiny-row">Importe</th>
					<th style="width:0%; display:none;">dia_movi</th>
					<th style="width:0%; display:none;">fc_compte</th>
					<th style="width:0%; display:none;">fc_item</th>
				</tr>
			</thead>
			<tbody>
				@if (Model != null && Model.GrillaChequesEnCartera != null && Model.GrillaChequesEnCartera.ListaDatos != null && Model.GrillaChequesEnCartera.ListaDatos.Count > 0)
				{
					@foreach (var item in Model.GrillaChequesEnCartera.ListaDatos)
					{
						<tr onclick="selectReg(this, 'tbListaChequesDeTercerosEnCartera')" title="@item.concepto_valor">
							<td class="@Model.GrillaChequesEnCartera.ObtenerClase(item.fc_fecha_valor) cell-fit-content">@Model.GrillaChequesEnCartera.FormatearDato(item.fc_fecha_valor, FormatDato.Fecha)</td>
							<td class="@Model.GrillaChequesEnCartera.ObtenerClase(item.fc_fecha) cell-fit-content">@Model.GrillaChequesEnCartera.FormatearDato(item.fc_fecha, FormatDato.Fecha)</td>
							<td class="@Model.GrillaChequesEnCartera.ObtenerClase(item.fc_dato1_valor) cell-fit-content">@Model.GrillaChequesEnCartera.FormatearDato(item.fc_dato1_valor, FormatDato.Ninguno)</td>
							<td class="@Model.GrillaChequesEnCartera.ObtenerClase(item.fc_dato2_valor) cell-fit-content">@Model.GrillaChequesEnCartera.FormatearDato(item.fc_dato2_valor, FormatDato.Monto)</td>
							<td class="@Model.GrillaChequesEnCartera.ObtenerClase(item.fc_dato3_valor) cell-fit-content">@Model.GrillaChequesEnCartera.FormatearDato(item.fc_dato3_valor, FormatDato.Monto)</td>
							<td class="@Model.GrillaChequesEnCartera.ObtenerClase(item.fc_importe) cell-fit-content">@Model.GrillaChequesEnCartera.FormatearDato(item.fc_importe, FormatDato.Monto)</td>
							<td style="display:none;">@item.dia_movi</td>
							<td style="display:none;">@item.fc_compte</td>
							<td style="display:none;">@item.fc_item</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</fieldset>
