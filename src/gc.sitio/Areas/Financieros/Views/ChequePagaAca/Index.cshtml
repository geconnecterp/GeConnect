@model PasoUnoModel
@{
	Layout = "~/views/shared/_Layout.cshtml";

	var list = Model.ListaCuentaValoresEnCartera;
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}

	/* FRAME GENERAL */
	fieldset {
		margin: 8px 0;
		border: 1px solid silver;
		padding: 18px 16px 14px 16px;
		border-radius: 4px;
		position: relative;
	}

	/* LEGEND CENTRADO Y SIN TAPAR BORDE */
	legend {
		padding: 2px 8px;
		background: #f3f5f7 !important;
		font-size: small;
		border-radius: 4px;
		position: absolute;
		top: -10px;
		left: 12px;
	}

	/* FILAS FLEXIBLES */
	.frame-row {
		display: flex;
		flex-wrap: nowrap; /* 🔥 NO PERMITE SALTOS DE LÍNEA */
		align-items: center;
		gap: 10px;
	}

		/* LABEL TIPO INPUT-GROUP */
		.frame-row .input-group-text {
			flex-shrink: 0;
			height: 32px;
			display: flex;
			align-items: center;
			padding-left: 6px;
			padding-right: 6px;
			font-size: 0.75rem;
		}

		/* CAMPOS DE TEXTO */
		.frame-row .form-control {
			min-width: 120px; /* 🔥 REDUCIDO PARA QUE ENTRE EN UNA LÍNEA */
			max-width: 360px;
			padding-left: 6px;
			padding-right: 6px;
			max-height: 30px;
			font-weight: 500 !important;
		}

		/* DROPDOWN */
		.frame-row select.form-control {
			min-width: 160px; /* 🔥 REDUCIDO */
			max-width: 220px;
		}

		/* CHECKBOXES */
		.frame-row .form-check {
			margin-bottom: 0;
			display: flex;
			align-items: center;
			flex-shrink: 0;
		}

		.frame-row .form-check-label {
			font-size: 0.75rem;
		}

		.frame-row .form-control.full-width {
			flex: 1; /* ocupa todo el espacio disponible */
			min-width: 0 !important; /* permite que se expanda */
		}

	.select-compact {
		padding: 2px 6px !important;
		height: 30px !important;
		font-size: 0.75rem !important;
		line-height: 1 !important;
	}
</style>
<div class="container">
	<div class="row col-12 justify-content-sm-center mb-1 mt-3">
		<div class="col-2"></div>

		<div class="col-8" id="divPrincipal">

			<!-- FRAME 1: DATOS DE CUENTAS -->
			<fieldset>
				<legend style="max-width:130px;">Datos de Cuentas</legend>

				<div class="frame-row mt-2">

					<span class="input-group-text">Cuenta de Valores en Cartera:</span>

					@Html.DropDownListFor(m => m.ctafIdSelected, list, "Seleccionar...",
						new { @id = "ListaCuentaValoresEnCartera", @class = "form-control activable select-compact" })

					<div class="form-check form-check-inline form-switch">
						<input class="form-check-input" type="checkbox" id="chkCliente" />
						<label class="form-check-label" for="chkCliente">Cliente</label>
					</div>

					<input type="text" class="form-control inputEditable full-width"
						   name="txtCliente" id="txtCliente" disabled />

					@Html.Hidden("txtClienteItem")
				</div>
			</fieldset>

			<!-- FRAME 2: OPCIONES -->
			<fieldset class="mt-3">
				<legend style="max-width:90px;">Opciones</legend>

				<div class="frame-row mt-2">

					<div class="form-check form-check-inline form-switch">
						<input class="form-check-input" type="checkbox"
							   id="chkDocumentoEnCuenta" checked />
						<label class="form-check-label" for="chkDocumentoEnCuenta">
							Documento en Cuenta (Cheque paga Acá)
						</label>
					</div>

					<div class="form-check form-check-inline form-switch">
						<input class="form-check-input" type="checkbox"
							   id="chkCambioDeFechaDePresentacion" />
						<label class="form-check-label" for="chkCambioDeFechaDePresentacion">
							Cambio de Fecha de Presentación
						</label>
					</div>

				</div>
			</fieldset>

			<!-- BOTONES -->
			<div class="row mt-3">
				<div class="col-2"></div>
				<div class="col-8">
					<div class="d-flex justify-content-around">
						<button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger">
							<i class="bx bx-sm bx-x-circle"></i> Inicializa
						</button>
						<button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success">
							<i class="bx bx-sm bx-search"></i> Ver
						</button>
					</div>
				</div>
				<div class="col-2"></div>
			</div>

		</div>

		<div class="col-2"></div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">

		var dia_movi = "";
		var fc_compte = "";
		var fc_item = "";
		var docEnCuenta = false;
		var cambioDeFecha = false;

		var autoComClienteUrl = "@Url.Action("BuscarCuentas", "chequepagaaca", new { area = "Financieros" })";
		var cargarChequesDeTercerosEnCarteraUrl = "@Url.Action("CargarChequesDeTercerosEnCartera", "chequepagaaca", new { area = "Financieros" })";
		var cargarPasoUnoUrl = "@Url.Action("PasoUno", "chequepagaaca", new { area = "Financieros" })";
		var inicializarDatosEnSesionURL = "@Url.Action("InicializarDatosEnSesion", "chequepagaaca", new { area = "Financieros" })";
		var confirmarCargaDeChequeDeTerceroEnCarteraUrl = "@Url.Action("ConfirmarCargaDeChequeDeTerceroEnCartera", "chequepagaaca", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/app/areas/financieros/chequepagaaca/cpagaaca.js"></script>
}
