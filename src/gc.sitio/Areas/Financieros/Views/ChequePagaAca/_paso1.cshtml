@model PasoUnoModel
@{
	var list = Model.ListaCuentaValoresEnCartera;
}
<!-- FRAME 1: DATOS DE CUENTAS -->
<fieldset>
	<legend style="max-width:130px;">Datos de Cuentas</legend>

	<div class="frame-row mt-2">

		<span class="input-group-text">Cuenta de Valores en Cartera:</span>

		@Html.DropDownListFor(m => m.ctafIdSelected, list, "Seleccionar...",
			new { @id = "ListaCuentaValoresEnCartera", @class = "form-control activable select-compact" })

		<div class="form-check form-check-inline form-switch">
			<input class="form-check-input" type="checkbox" id="chkCliente" />
			<label class="form-check-label" for="chkCliente">Cliente</label>
		</div>

		<input type="text" class="form-control inputEditable full-width"
			   name="txtCliente" id="txtCliente" disabled />

		@Html.Hidden("txtClienteItem")
	</div>
</fieldset>

<!-- FRAME 2: OPCIONES -->
<fieldset class="mt-3">
	<legend style="max-width:90px;">Opciones</legend>

	<div class="frame-row mt-2">

		<div class="form-check form-check-inline form-switch">
			<input class="form-check-input" type="checkbox"
				   id="chkDocumentoEnCuenta" checked />
			<label class="form-check-label" for="chkDocumentoEnCuenta">
				Documento en Cuenta (Cheque paga Acá)
			</label>
		</div>

		<div class="form-check form-check-inline form-switch">
			<input class="form-check-input" type="checkbox"
				   id="chkCambioDeFechaDePresentacion" />
			<label class="form-check-label" for="chkCambioDeFechaDePresentacion">
				Cambio de Fecha de Presentación
			</label>
		</div>

	</div>
</fieldset>

<!-- BOTONES -->
<div class="row mt-3">
	<div class="col-2"></div>
	<div class="col-8">
		<div class="d-flex justify-content-around">
			<button type="button" id="btnCancel" style="width:150px;" class="btn btn-lg btn-danger">
				<i class="bx bx-sm bx-x-circle"></i> Inicializa
			</button>
			<button type="button" id="btnBuscar" style="width:150px;" class="btn btn-lg btn-success">
				<i class="bx bx-sm bx-search"></i> Ver
			</button>
		</div>
	</div>
	<div class="col-2"></div>
</div>