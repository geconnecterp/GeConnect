@model ExtractoBancarioModel
@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@{
    var alt = true;
    string clase = string.Empty;
    string sortDirInv = Model.GrillaExtracto.SortDir.Equals("ASC") ? "DESC" : "ASC";
}
<style>
    thead th {
        position: sticky;
        top: 0px;
        z-index: 1; /* suficiente para estar sobre las filas */
        background: linear-gradient(to bottom, #b8860b, #daa520) !important;
        color: #fff !important;
    }

    .table-wrapper {
        /*max-height: 400px;  o lo que necesites */
        overflow-y: auto;
        position: relative;
    }

    #containerGridExtractoBancario {
        position: relative;
        height: 480px;
        max-height: 480px;
        overflow-y: auto;
        overflow-x: auto;
        z-index: auto;
    }

    .container-auto {
        height: auto !important;
        max-height: none !important;
    }

    .table-golden {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .table-golden thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(to bottom, #b8860b, #daa520) !important;
            color: #fff !important;
        }

            .table-golden thead th {
                position: sticky;
                top: 0;
                z-index: 4;
                background: linear-gradient(to bottom, #b8860b, #daa520);
                color: #fff;
                box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
                background-clip: padding-box;
            }

            .table-golden thead,
            .table-golden thead th {
                /*background-color: #b8860b;  tu dorado */
                /* color: #333; */
            }

    #tbGridExtractoBancario th,
    #tbGridExtractoBancario td {
        padding: 0.01rem 0.15rem !important;
        line-height: 1.2 !important;
        height: auto !important;
    }

    #tbGridExtractoBancario tr {
        height: 1.6rem !important;
    }
</style>
<div class="card" style="padding-left: 0px;padding-right: 0px;">
	<div class="card-body p-1">
        <div class="table-responsive text-nowrap  table-wrapper-500" id="containerGridExtractoBancario">
            <table class="table table-sm mb-0 table-hover table-wrapper-fixed-head table-golden" id="tbGridExtractoBancario">
                <thead>
                    <tr class="header">
                        <th style="width: 5%;" class="text-sm-center" scope="col">FECHA MOV.</th>
                        <th style="width: 5%;" class="text-sm-center" scope="col">COD. MOV.</th>
                        <th style="width: 25%;" class="text-sm-center" scope="col">ORIGEN DEL MOVIMIENTO PARA EL SISTEMA</th>
                        <th style="width: 25%;" class="text-sm-center" scope="col">CONCEPTO</th>
                        <th style="width: 10%;" class="text-sm-center" scope="col">DEBE</th>
                        <th style="width: 10%;" class="text-sm-center" scope="col">HABER</th>
                        <th style="width: 10%;" class="text-sm-center" scope="col">SALDO</th>
                        <th style="width: 5%;" class="text-sm-center" scope="col">Conciliado</th>
                        <th style="width: 5%;" class="text-sm-center" scope="col">Cierre</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.GrillaExtracto != null && Model.GrillaExtracto.ListaDatos != null && Model.GrillaExtracto.ListaDatos.Count > 0)
                    {
                        @foreach (var item in Model.GrillaExtracto.ListaDatos)
                        {
                            if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

                            <tr class="@clase" onclick="selectReg(this,'tbGridExtractoBancario')">
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_fecha) align-center">@Model.GrillaExtracto.FormatearDato(item.ext_fecha, FormatDato.Fecha)</td>
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.extr_id) align-center">@Model.GrillaExtracto.FormatearDato(item.extr_id, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.extr_desc) align-left">@Model.GrillaExtracto.FormatearDato(item.extr_desc, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_concepto) align-left">@Model.GrillaExtracto.FormatearDato(item.ext_concepto, FormatDato.Ninguno)</td>
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_debe) align-right">@GridHelper.FormatearDato(item.ext_debe, FormatDato.Monto, true)</td>
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_haber) align-right">@GridHelper.FormatearDato(item.ext_haber, FormatDato.Monto, true)</td>
                                <td class="@Model.GrillaExtracto.ObtenerClase(item.ext_saldo) align-right">@GridHelper.FormatearDato(item.ext_saldo, FormatDato.Monto, true)</td>
                                <td class="align-center">
                                    @if (item.strConciliado)
                                    {
                                        <i class='bx bx-check text-success'></i>
                                    }
                                </td>
                                <td class="align-center">
                                    @if (item.strCierre)
                                    {
                                        <i class='bx bx-check text-success'></i>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
	</div>
</div>