@model FiltroModel
@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	.tab-content-compact {
		padding: 0.25rem 0 !important;
		border-radius: 0.375rem !important;
		background-color: transparent !important;
	}
</style>

<div class="container mt-2">
	<div class="row">
		<div class="col-md-6">
			<div class="d-flex justify-content-start">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>
			</div>
		</div>
	</div>
	<div id="divFiltros" style="">
		<partial name="_filtros" model="Model" />
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="row mt-1">
			<div class="col-md-5">
				<div class="input-group input-group-sm" id="divCuentaBanco">
					<span class="input-group-text fixed-lbl-for-abm-70">Cuenta: </span>
					<input type="text" id="CtafId" class="form-control" style="max-width: 100px;text-align: right;" disabled />
					<input type="text" id="CtafDesc" class="form-control" disabled />
				</div>
			</div>
		</div>
		<div class="d-flex align-items-center w-100 mt-2">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsFinancieroBancos">
				<li class="nav-item" role="presentation" id="tabVencimientoChequeEmitido">
					<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabVencimientoChequeEmitido">
						Vencimiento de Cheques Emitidos
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabLibroBancoDetalle">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabLibroBancoDetalle">
						Libro Banco Detalle
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabLibroBancoResumen">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-cat" aria-controls="navs-top-cat" aria-selected="false" tabindex="-2" id="btnTabLibroBancoResumen">
						Libro Banco Resumen
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabHistoricoLibro">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-dog" aria-controls="navs-top-dog" aria-selected="false" tabindex="-3" id="btnTabHistoricoLibro">
						Histórico Libro
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabExtractoBancario">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-tiger" aria-controls="navs-top-tiger" aria-selected="false" tabindex="-4" id="btnTabExtractoBancario">
						Extracto Bancario
					</button>
				</li>
			</ul>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Desde:</span>
							<input type="date" class="form-control" id="fechaDesdeVencChequeEmitido" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaVencChequeEmitido" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarVencChequeEmitido"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirVencChequeEmitido"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div id="divVencimientoChequeEmitido">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaLibroBancoDetalle" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarLibroBancoDetalle"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirLibroBancoDetalle"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div id="divLibroBancoDetalle">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-cat" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaLibroBancoResumen" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarLibroBancoResumen"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirLibroBancoResumen"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div class="row" id="divLibroBancoResumen" style="padding-left: 14px;padding-right: 13px;">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-dog" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Desde:</span>
							<input type="date" class="form-control" id="fechaDesdeHistoricoLibro" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaHistoricoLibro" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarHistoricoLibro"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirHistoricoLibro"><i class="bx bx-printer"></i></button>
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm mt-2">
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="radio" name="tipoFiltro" id="radioFecha" value="R" checked>
								<label class="form-check-label" for="radioFecha">Fecha</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="radio" name="tipoFiltro" id="radioVencimiento" value="V">
								<label class="form-check-label" for="radioVencimiento">Vencimiento</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="radio" name="tipoFiltro" id="radioPercibido" value="P">
								<label class="form-check-label" for="radioPercibido">Percibido</label>
							</div>
						</div>
					</div>
				</div>
				<div class="row" id="divHistoricoLibro" style="padding-left: 14px;padding-right: 13px;">
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-tiger" role="tabpanel">
				<div class="row">
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Desde:</span>
							<input type="date" class="form-control" id="fechaDesdeExtractoBancario" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text">Hasta:</span>
							<input type="date" class="form-control" id="fechaHastaExtractoBancario" />
						</div>
					</div>
					<div class="col-md-3 col-sm-6">
						<div class="input-group input-group-sm">
							<button type="button" class="btn btn-success" id="btnBuscarExtractoBancario"><i class="bx bx-play"></i></button>
							<button type="button" class="btn btn-warning" id="btnImprimirExtractoBancario"><i class="bx bx-printer"></i></button>
						</div>
					</div>
				</div>
				<div class="row" id="divExtractoBancario" style="padding-left: 14px;padding-right: 13px;">
				</div>
			</div>
		</div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var ctafIdSelected = "";
		var ctafDenominacionSelected = "";

		var posicionarseEnTabVencimientoChequeEmitidoURL = "@Url.Action("PosicionarseEnTabVencimientoChequeEmitido", "Bancos", new { area = "Financieros" })";
		var buscarVencimientoChequeEmitidoURL = "@Url.Action("BuscarVencimientoChequeEmitido", "Bancos", new { area = "Financieros" })";
		var buscarVencimientoChequeEmitidoListaURL = "@Url.Action("BuscarVencimientoChequeEmitidoLista", "Bancos", new { area = "Financieros" })";
		var buscarExtractoBancarioURL = "@Url.Action("ObtenerExtractoBancario", "Bancos", new { area = "Financieros" })";
		var posicionarseEnTabHistoricoLibroURL = "@Url.Action("PosicionarseEnTabHistoricoLibro", "Bancos", new { area = "Financieros" })";
		var buscarHistoricoLibroURL = "@Url.Action("ObtenerHistoricoLibro", "Bancos", new { area = "Financieros" })";
		var posicionarseEnTabLibroResumenURL = "@Url.Action("PosicionarseEnTabLibroResumen", "Bancos", new { area = "Financieros" })";
		var obtenerLibroResumenURL = "@Url.Action("ObtenerLibroResumen", "Bancos", new { area = "Financieros" })";
		var posicionarseEnTabLibroDetalleURL = "@Url.Action("PosicionarseEnTabLibroDetalle", "Bancos", new { area = "Financieros" })";
		var obtenerLibroDetalleURL = "@Url.Action("ObtenerLibroDetalle", "Bancos", new { area = "Financieros" })";
		var setearTipoDeReporteUrl = "@Url.Action("SetearTipoDeReporte", "Bancos", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";

	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>

	<script src="~/js/app/areas/financieros/bancos/banco.js" type="text/javascript"></script>
}