@model LibroBancoDetalleModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	.linea {
		margin-bottom: 2px;
		line-height: 1.2;
	}

	.azul {
		color: #007BFF;
	}

	.rojo {
		color: #B22222;
	}

	.linea-con-puntos {
		display: flex;
		align-items: center;
	}

	.descripcion {
		white-space: nowrap;
	}

	.puntos {
		flex-grow: 1;
		border-bottom: 1px dotted #999;
		margin: 0 6px;
		height: 0;
	}

	.monto {
		white-space: nowrap;
	}

	.texto-uniforme {
		font-size: 0.95rem;
		font-weight: bold;
	}

	thead th {
		position: sticky;
		top: 0px;
		z-index: 1; /* suficiente para estar sobre las filas */
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		/*max-height: 400px;  o lo que necesites */
		overflow-y: auto;
		position: relative;
	}

	#containerGrillaUno {
		position: relative;
		height: 480px;
		max-height: 480px;
		overflow-y: auto;
		overflow-x: hidden !important;
		z-index: auto;
	}

	#containerGrillaDos {
		position: relative;
		height: 480px;
		max-height: 480px;
		overflow-y: auto;
		overflow-x: hidden !important;
		z-index: auto;
	}

	.container-auto {
		height: auto !important;
		max-height: none !important;
		overflow-x: hidden !important;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tabGrillaUno th,
	#tabGrillaUno td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tabGrillaUno tr {
		height: 1.6rem !important;
	}

	#tabGrillaDos th,
	#tabGrillaDos td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tabGrillaDos tr {
		height: 1.6rem !important;
	}
</style>
<div class="card">
	<div class="card-body">
		<div class="row">
			<!-- Líneas en azul -->
			<div class="col-12 linea azul linea-con-puntos texto-uniforme">
				<span class="descripcion">@Model.saldo_bco_descripcion</span>
				<span class="puntos"></span>
				<span class="monto">@Model.saldo_bco</span>
			</div>
			<div class="col-12 linea azul linea-con-puntos texto-uniforme">
				<span class="descripcion">@Model.saldo_bco_che_descripcion</span>
				<span class="puntos"></span>
				<span class="monto">@Model.saldo_bco_che</span>
			</div>
			<div class="col-12 linea azul linea-con-puntos texto-uniforme">
				<span class="descripcion">@Model.saldo_pendiente_descripcion</span>
				<span class="puntos"></span>
				<span class="monto">@Model.saldo_pendiente</span>
			</div>

			<!-- Líneas en rojo -->
			<div class="col-12 linea rojo linea-con-puntos texto-uniforme">
				<span class="descripcion">@Model.conciliado_m_ant_descripcion</span>
				<span class="puntos"></span>
				<span class="monto">@Model.conciliado_m_ant</span>
			</div>
			<div class="col-12 linea rojo linea-con-puntos texto-uniforme">
				<span class="descripcion">@Model.conciliado_m_sig_descripcion</span>
				<span class="puntos"></span>
				<span class="monto">@Model.conciliado_m_sig</span>
			</div>
			<div class="col-12 linea rojo linea-con-puntos texto-uniforme">
				<span class="descripcion">@Model.conciliado_m_pos_descripcion</span>
				<span class="puntos"></span>
				<span class="monto">@Model.conciliado_m_pos</span>
			</div>
		</div>
		<div class="row">
			@if (Model != null && Model.GrillaBcoLibro_Cero != null && Model.GrillaBcoLibro_Cero.ListaDatos != null && Model.GrillaBcoLibro_Cero.ListaDatos.Count > 0)
			{
				<div class="table-responsive mt-3" style="max-width: 89%;">
					<table class="table table-bordered mb-0 table-golden" id="tabGrillaCero">
						<tbody>
							@foreach (var item in Model.GrillaBcoLibro_Cero.ListaDatos)
							{
								var concepto = item.concepto ?? "";
								var idx = concepto.LastIndexOf(" ");

								string textoFijo = "Saldo Extracto al";
								string fecha = "";

								if (idx > -1)
								{
									fecha = concepto.Substring(idx + 1);   // obtiene la fecha
								}

								var importeFormateado = item.importe < 0
									? $"({Math.Abs(item.importe):N2})"
									: $"{item.importe:N2}";

								<tr>
									<td class="texto-uniforme" style="width:80%;text-align: end;">@textoFijo</td>
									<td class="texto-uniforme">@fecha</td>
									<td class="text-end texto-uniforme">@importeFormateado</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

			}
		</div>
		<div class="row">
			@if (Model != null && Model.GrillaBcoLibro_Uno != null && Model.GrillaBcoLibro_Uno.ListaDatos != null && Model.GrillaBcoLibro_Uno.ListaDatos.Count > 0)
			{
				<h5 class="mt-4 mb-2 azul texto-uniforme">@Model.Descripcion_Grid_Uno</h5>
				<div class="table-responsive table-wrapper-300" style="max-width: 90%;" id="containerGrillaUno">
					<table class="table table-bordered table-sm mb-0 table-golden" id="tabGrillaUno">
						<thead>
							<tr class="texto-uniforme">
								<th class="align-center" style="width:80%;">Concepto</th>
								@* <th class="align-center">Fecha Reg.</th> *@
								<th class="align-center">Fecha Vto.</th>
								<th class="align-center">Importe</th>
								@* <th style="width: 5%;" class="text-sm-center" scope="col">Estado</th> *@
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.GrillaBcoLibro_Uno.ListaDatos)
							{
								if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
								var importeFormateado = item.importe < 0 ? $"({Math.Abs(item.importe):N2})" : $"{item.importe:N2}";
								var fecha = item.fecha != null ? item.fecha.Value.ToString("dd/MM/yyyy") : "";
								var fecha_vto = item.fecha_vto != null ? item.fecha_vto.Value.ToString("dd/MM/yyyy") : "";
								<tr class="texto-uniforme @clase">
									<td>@item.concepto</td>
									@* <td class="text-center">@fecha</td> *@
									<td class="text-center">@fecha_vto</td>
									<td class="text-end">@importeFormateado</td>
									@* <td class="align-center">
										@if (item.strEstado)
										{
											<i class='bx bx-check text-danger'></i>
										}
									</td> *@
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		<div class="row">
			@if (Model != null && Model.GrillaBcoLibro_Dos != null && Model.GrillaBcoLibro_Dos.ListaDatos != null && Model.GrillaBcoLibro_Dos.ListaDatos.Count > 0)
			{
				<h5 class="mt-4 mb-2 azul texto-uniforme">@Model.Descripcion_Grid_Dos</h5>
				<div class="table-responsive table-wrapper-300" id="containerGrillaDos">
					<table class="table table-bordered table-sm mb-0 table-golden" id="tabGrillaDos">
						<thead>
							<tr class="texto-uniforme">
								<th class="align-center" style="width: 65%;">Concepto</th>
								<th class="align-center">Fecha Reg.</th>
								<th class="align-center">Fecha Vto.</th>
								<th class="align-center">Importe</th>
								<th style="width: 8%;" class="text-sm-center" scope="col">CH en curso</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.GrillaBcoLibro_Dos.ListaDatos)
							{
								if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
								var importeFormateado = item.importe < 0 ? $"({Math.Abs(item.importe):N2})" : $"{item.importe:N2}";
								var fecha = item.fecha != null ? item.fecha.Value.ToString("dd/MM/yyyy") : "";
								var fecha_vto = item.fecha_vto != null ? item.fecha_vto.Value.ToString("dd/MM/yyyy") : "";
								<tr class="texto-uniforme @clase">
									<td>@item.concepto</td>
									<td class="text-center">@fecha</td>
									<td class="text-center">@fecha_vto</td>
									<td class="text-end">@importeFormateado</td>
									<td class="align-center">
										@if (item.strEstado)
										{
											<i class='bx bx-check text-success'></i>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
</div>
