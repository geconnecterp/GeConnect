@model VencimientoChequeEmitidoModel
@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@{
    var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
		z-index: 1; /* suficiente para estar sobre las filas */
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		/*max-height: 400px;  o lo que necesites */
		overflow-y: auto;
		position: relative;
	}

	#containerGridCheques {
		position: relative;
		height: 480px;
		max-height: 480px;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.container-auto {
		height: auto !important;
		max-height: none !important;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbGridCheques th,
	#tbGridCheques td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
	}

	#tbGridCheques tr {
		height: 1.6rem !important;
	}
</style>
<div class="card">
	<div class="card-body p-1">
		<div class="row">
			<div class="col-4">
				<div class="table-responsive table-wrapper-400" id="containerGridCheques">
					<table class="table table-bordered table-sm mb-0 table-golden" id="tbGridCheques">
						<thead>
							<tr class="header">
								<th class="align-center" style="width: 15%;">Fec. Vto.</th>
								<th class="align-center" style="width: 15%;">Emitidos</th>
								<th class="align-center" style="width: 25%;">No Entregados</th>
								<th class="align-center" style="width: 20%;">Depositados</th>
								<th class="align-center">Saldo Proy.</th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null && Model.GrillaCheques != null && Model.GrillaCheques.ListaDatos != null && Model.GrillaCheques.ListaDatos.Count > 0)
							{
								@foreach (var item in Model.GrillaCheques.ListaDatos)
								{
									if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
									<tr class="@clase" onclick="selectReg(this, 'tbGridCheques')">
										<td class="@Model.GrillaCheques.ObtenerClase(item.hasta) align-center cell-fit-content">@Model.GrillaCheques.FormatearDato(item.hasta, FormatDato.Fecha)</td>
										<td class="@Model.GrillaCheques.ObtenerClase(item.che_emi_ent) align-right cell-fit-content">@Model.GrillaCheques.FormatearDato(item.che_emi_ent, FormatDato.Monto)</td>
										<td class="@Model.GrillaCheques.ObtenerClase(item.che_emi_nent) align-right cell-fit-content">@Model.GrillaCheques.FormatearDato(item.che_emi_nent, FormatDato.Monto)</td>
										<td class="@Model.GrillaCheques.ObtenerClase(item.che_depo) align-right cell-fit-content">@Model.GrillaCheques.FormatearDato(item.che_depo, FormatDato.Monto)</td>
										<td class="@Model.GrillaCheques.ObtenerClase(item.saldo_bco) align-right cell-fit-content">@GridHelper.FormatearDato(item.saldo_bco, FormatDato.Monto, true)</td>
									</tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="col-8" id="divListaCheques">
			</div>
		</div>
	</div>
</div>