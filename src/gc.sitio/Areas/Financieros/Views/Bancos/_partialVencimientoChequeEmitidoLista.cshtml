@model VencimientoChequeEmitidoModel
@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@{
    var alt = true;
	string clase = string.Empty;
	//string sortDirInv = Model.GrillaHistorico.SortDir.Equals("ASC") ? "DESC" : "ASC";
}
<style>
	thead th {
		position: sticky;
		top: 0px;
		z-index: 1; /* suficiente para estar sobre las filas */
		background: linear-gradient(to bottom, #b8860b, #daa520) !important;
		color: #fff !important;
	}

	.table-wrapper {
		/*max-height: 400px;  o lo que necesites */
		overflow-y: auto;
		position: relative;
	}

	#containerGridChequesDetalle {
		position: relative;
		height: 480px;
		max-height: 480px;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.container-auto {
		height: auto !important;
		max-height: none !important;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbGridChequesDetalle th,
	#tbGridChequesDetalle td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
		height: auto !important;
		border-left: none !important;
		border-right: none !important;
	}

	#tbGridChequesDetalle tr {
		height: 1.6rem !important;
	}
</style>
<div class="table-responsive table-wrapper-400" id="containerGridChequesDetalle">
	<table class="table table-bordered table-sm mb-0 table-golden" id="tbGridChequesDetalle">
		<thead>
			<tr class="header">
				<th class="align-center" style="width: 8%;">Fec. Vto.</th>
				<th class="align-center" style="width: 8%;">Fec. Emi.</th>
				<th class="align-center" style="width: 8%;">N° Cheque</th>
				<th class="align-center">A Nombre de</th>
				<th class="align-center" style="width: 10%;">Estado</th>
				<th class="align-center" style="width: 12%;">Importe</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaChequesDetalle != null && Model.GrillaChequesDetalle.ListaDatos != null && Model.GrillaChequesDetalle.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaChequesDetalle.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbGridChequesDetalle')">
						<td class="@Model.GrillaChequesDetalle.ObtenerClase(item.che_fecha) align-center cell-fit-content">@Model.GrillaChequesDetalle.FormatearDato(item.che_fecha, FormatDato.Fecha)</td>
						<td class="@Model.GrillaChequesDetalle.ObtenerClase(item.che_fecha_emi) align-center cell-fit-content">@Model.GrillaChequesDetalle.FormatearDato(item.che_fecha_emi, FormatDato.Fecha)</td>
						<td class="@Model.GrillaChequesDetalle.ObtenerClase(item.che_nro) align-center cell-fit-content">@Model.GrillaChequesDetalle.FormatearDato(item.che_nro, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaChequesDetalle.ObtenerClase(item.che_anombre) align-left cell-fit-content">@Model.GrillaChequesDetalle.FormatearDato(item.che_anombre, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaChequesDetalle.ObtenerClase(item.che_estado_desc) align-left cell-fit-content">@Model.GrillaChequesDetalle.FormatearDato(item.che_estado_desc, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaChequesDetalle.ObtenerClase(item.che_importe) align-right cell-fit-content">@GridHelper.FormatearDato(item.che_importe, FormatDato.Monto, true)</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
<div class="row col-12 mb-1">
	<div class="col-6"></div>
	<div class="col-2"></div>
	<div class="col-4 justify-content-sm-end" style="padding-right: 0px;">
		<div class="input-group input-group-sm">
			<span class="input-group-text">Totales: </span>
			<input type="text" asp-for="TotalStr" class="form-control inputEditable" disabled style="text-align:end;"/>
		</div>
	</div>
</div>