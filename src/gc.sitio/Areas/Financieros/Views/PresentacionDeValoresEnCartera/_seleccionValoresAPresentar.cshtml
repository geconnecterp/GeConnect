@model SeleccionValoresAPresentarModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var col1 = Model.titulo_col_1;
	var col2 = Model.titulo_col_2;
	var col3 = Model.titulo_col_3;
	var alt = true;
	string clase = string.Empty;
}
<style>
	/* El contenedor debe ser el scroll real y generar contexto */
	#containerValores {
		position: relative;
		height: 530px;
		max-height: 530px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbValores th,
	#tbValores td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	/* Opcional: altura fija para todas las filas */
	#tbValores tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}
</style>
<div class="row justify-content-sm-center mb-1 mt-1">
	<div class="col-md-2">
		<div class="d-flex justify-content-sm-center">
			<button id="btnAnterior3" class="btn btn-secondary btn-sm mt-1 me-1" type="button" title="Anterior">
				<i class="bx bx-chevron-left"></i>Anterior
			</button>
			<button id="btnSiguiente3" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Siguiente">
				<i class="bx bx-chevron-right"></i>Siguiente
			</button>
			<button id="btnConfirmar1" class="btn btn-success btn-sm mt-1 me-1" type="button" title="Confirmar" disabled>
				<i class="bx bx-badge-check"></i>Confirmar
			</button>
			<button id="btnAbmCancelar1" class="btn btn-danger btn-sm mt-1 me-1" type="button" title="Cancelar" >
				<i class="bx bx-x-circle"></i>Cancelar
			</button>
		</div>
	</div>
</div>
<div class="row col-12 justify-content-sm-center mb-1">
	<div class="col-2"></div>
	<div class="col-8">
		<div class="input-group input-group-sm">
			<input type="text" asp-for="ctaf_id" class="form-control inputEditable" disabled style="text-align:center;"/>
			<input type="text" asp-for="ctaf_desc" class="form-control inputEditable" disabled style="width:75%;"/>
		</div>
	</div>
	<div class="col-2"></div>
</div>
<div class="row col-12 justify-content-sm-center mb-1">
	<div class="col-2"></div>
	<div class="col-8">
		<div class="table-responsive table-wrapper-400-full-width" id="containerValores">
			<table class="table table-sm table-golden" id="tbValores">
				<thead>
					<tr class="header">
						<th style="width:15%;" class="align-center">Fecha Valor</th>
						<th style="width:15%;" class="align-center">Fecha Carga</th>
						<th style="width:40%;" class="align-center">@col1</th>
						<th style="width:10%;" class="align-center">@col2</th>
						<th style="width:10%;" class="align-center">@col3</th>
						<th style="width:10%;" class="align-center">Importe</th>
						<th style="width:2%;padding: 0;text-align-last: center;vertical-align: middle;"><input name="select_all" value="1" type="checkbox"></th>
						<th style="width:0%;display:none;" class="align-center">dia_movi</th>
						<th style="width:0%;display:none;" class="align-center">fc_compte</th>
						<th style="width:0%;display:none;" class="align-center">fc_item</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.GrillaValoresAPresentar != null && Model.GrillaValoresAPresentar.ListaDatos != null && Model.GrillaValoresAPresentar.ListaDatos.Count > 0)
					{
						@foreach (var item in Model.GrillaValoresAPresentar.ListaDatos)
						{
							if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
							var nombre = item.fc_compte + "_" + item.fc_item;
							var nombre_check = nombre + "_checkbox";
							<tr class="@clase" onclick="selectReg(this, 'tbValores')" title="@item.concepto_valor">
								<td class="@Model.GrillaValoresAPresentar.ObtenerClase(item.fc_fecha_valor) align-center cell-fit-content">@Model.GrillaValoresAPresentar.FormatearDato(item.fc_fecha_valor, FormatDato.Fecha)</td>
								<td class="@Model.GrillaValoresAPresentar.ObtenerClase(item.fc_fecha) align-center cell-fit-content">@Model.GrillaValoresAPresentar.FormatearDato(item.fc_fecha, FormatDato.Fecha)</td>
								<td class="@Model.GrillaValoresAPresentar.ObtenerClase(item.fc_dato1_valor) cell-fit-content">@Model.GrillaValoresAPresentar.FormatearDato(item.fc_dato1_valor, FormatDato.Ninguno)</td>
								<td class="@Model.GrillaValoresAPresentar.ObtenerClase(item.fc_dato2_valor) cell-fit-content">@Model.GrillaValoresAPresentar.FormatearDato(item.fc_dato2_valor, FormatDato.Monto)</td>
								<td class="@Model.GrillaValoresAPresentar.ObtenerClase(item.fc_dato3_valor) cell-fit-content">@Model.GrillaValoresAPresentar.FormatearDato(item.fc_dato3_valor, FormatDato.Monto)</td>
								<td class="@Model.GrillaValoresAPresentar.ObtenerClase(item.fc_importe) cell-fit-content">@Model.GrillaValoresAPresentar.FormatearDato(item.fc_importe, FormatDato.Monto)</td>
								<td style="padding: 0; text-align-last: center;"><input type="checkbox" name=@nombre_check id="@nombre_check" /></td>
								<td style="display:none;">@item.dia_movi</td>
								<td style="display:none;">@item.fc_compte</td>
								<td style="display:none;">@item.fc_item</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
	<div class="col-2"></div>
</div>
<div class="row col-12 mb-1">
	<div class="col-7"></div>
	<div class="col-3 justify-content-sm-end">
		<div class="input-group input-group-sm">
			<span class="input-group-text">Total Seleccionado: </span>
			<input type="text" asp-for="total" class="form-control inputEditable" disabled style="text-align:end;"/>
		</div>
	</div>
	<div class="col-2"></div>
</div>