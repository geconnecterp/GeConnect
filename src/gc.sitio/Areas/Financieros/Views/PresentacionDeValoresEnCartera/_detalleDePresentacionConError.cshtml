@using gc.api.core.Entidades
@using gc.infraestructura.Dtos.Gen
@model RespuestaGenerica<EntidadBase>
@{
	var filtro = Model;
}
<div class="row justify-content-sm-center mb-1 mt-1">
	<div class="col-md-2">
		<div class="d-flex justify-content-sm-center">
			<button id="btnAnterior4" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Anterior">
				<i class="bx bx-arrow-to-left bx-xs"></i>
			</button>
			<button id="btnSiguiente4" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Siguiente" disabled>
				<i class="bx bx-arrow-to-right bx-xs"></i>
			</button>
			<button id="btnConfirmar1" class="btn btn-success btn-sm mt-1 me-1" type="button" title="Confirmar" disabled>
				<i class="bx bx-check-circle"></i>
			</button>
			<button id="btnAbmCancelar1" class="btn btn-danger btn-sm mt-1 me-1" type="button" title="Cancelar" onclick="btnAbmCancelar_click();">
				<i class="bx bx-x-circle bx-xs"></i>
			</button>
		</div>
	</div>
</div>
<partial name="_gridMensaje" model="filtro" />