@model PresDeValEnCartera_Paso1Model
@{
	Layout = "~/views/shared/_Layout.cshtml";

	var list = Model.ListaTipoMedioDePago;
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}
</style>
<div class="container" id="divPrincipal">
	<div class="row justify-content-sm-center mb-1 mt-1">
		<div class="col-md-2">
			<div class="d-flex justify-content-sm-center">
				<button id="btnAnterior1" class="btn btn-secondary btn-sm mt-1 me-1" type="button" title="Anterior" disabled>
					<i class="bx bx-chevron-left"></i>Anterior
				</button>
				<button id="btnSiguiente1" class="btn btn-primary btn-sm mt-1 me-1" type="button" title="Siguiente">
					<i class="bx bx-chevron-right"></i>Siguiente
				</button>
				<button id="btnConfirmar1" class="btn btn-success btn-sm mt-1 me-1" type="button" title="Confirmar" disabled>
					<i class="bx bx-badge-check"></i>Confirmar
				</button>
				<button id="btnAbmCancelar1" class="btn btn-danger btn-sm mt-1 me-1" type="button" title="Cancelar" >
					<i class="bx bx-x-circle"></i>Cancelar
				</button>
			</div>
		</div>
	</div>
	<div class="row col-12 justify-content-sm-center mb-1">
		<div class="col-2"></div>
		<div class="col-8">
			<div class="input-group input-group-sm mt-1">
				<span class="input-group-text fixed-lbl-for-abm-150">Tipo de Medio de Pago: </span>
				@Html.DropDownListFor(m => m.tpo_medio, list, "Seleccionar...", new { @id = "listaTipoMedioPago", @class = "form-control activable" })
			</div>
		</div>
		<div class="col-2"></div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var tipoMedioPagoSelected = "";
		var ctafIdSelected = "";
		var ctafDescSelected = "";
		var total_seleccionado_en_cartera = 0;
		var saldo_de_ctaf = 0;

		var paso1Url = "@Url.Action("Paso1", "presentaciondevaloresencartera", new { area = "Financieros" })";
		var seleccionCuentaFinUrl = "@Url.Action("SeleccionCuentaFin", "presentaciondevaloresencartera", new { area = "Financieros" })";
		var seleccionValoresAPresentarUrl = "@Url.Action("SeleccionValoresAPresentar", "presentaciondevaloresencartera", new { area = "Financieros" })";
		var detalleDePresentacionUrl = "@Url.Action("DetalleDePresentacion", "presentaciondevaloresencartera", new { area = "Financieros" })";
		var confirmarPresentacionDeValoresUrl = "@Url.Action("ConfirmarPresentacionDeValores", "presentaciondevaloresencartera", new { area = "Financieros" })";
		var inicializarDatosEnSesionUrl = "@Url.Action("InicializarDatosEnSesion", "presentaciondevaloresencartera", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js" asp-append-version="true"></script>

	<script src="~/js/app/areas/financieros/presentaciondevaloresencartera/presdevalencartera.js"></script>
}