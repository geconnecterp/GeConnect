@model FiltroAnticipoConsYAnuModel
@{
	Layout = "~/views/shared/_Layout.cshtml";
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />

	<style>
		/* Estilos para filtros flotantes */
		#filtrosAplicadosFloating { overflow: visible; z-index: 1050; flex-wrap: nowrap; white-space: nowrap; overflow-x: visible; }
		#filtrosAplicadosFloating .dropdown-menu { z-index: 3000 !important; }
		/* Si el header global tiene un z-index muy alto, forzamos el menu del filtro encima */
		.navbar, .main-header {
			z-index: 1100;
		}
	</style>
}
<div class="container mt-2">
	<div class="row mb-2">
		<div class="col-md-6">
			<div class="d-flex justify-content-sm-around">
				<button id="btnFiltro" class="btn btn-primary btn-sm mt-1 me-1" type="button" data-bs-toggle="collapse" data-bs-target="#divFiltro" aria-expanded="true" aria-controls="divFiltro">
					<i class="bx bx-filter bx-xs"></i>
				</button>

				<button class="btn btn-primary btn-sm mt-1 me-1" type="button" id="btnDetalle" data-bs-toggle="collapse" data-bs-target="#divDetalle" aria-expanded="true" aria-controls="divDetalle" hidden>
					<i class="bx bx-caret-down"></i>
				</button>
			</div>
		</div>
		<div class="collapse col-md-2">
			<div class="d-flex justify-content-sm-end">
				<!-- Botón Imprimir -->
				<button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" title="Imprimir">
					<i class="bx bx-printer"></i>
				</button>
				<button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" id="btnImprimirTemp" title="Imprimir Temporal">
					<i class="bx bx-printer"></i>
				</button>
			</div>
		</div>
	</div>
	<div class="collapse" id="divFiltros" style="">
		<partial name="_filtros" model="Model" />
		@Html.Hidden("pagEstado", false);
	</div>
	<div class="collapse" id="divDetalle" style="">
		<div class="d-flex align-items-center w-100 mt-2" style="position:relative;">
			<ul class="nav nav-tabs nav-tabs-golden" role="tablist" id="tabsAntFinanEmp">
				<li class="nav-item" role="presentation" id="tabAntFinanEmp">
					<button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-home" aria-controls="navs-top-home" aria-selected="true" id="btnTabAntFinanEmp">
						Anticipos
					</button>
				</li>
				<li class="nav-item" role="presentation" id="tabAntFinanEmpDetalle">
					<button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-top-profile" aria-controls="navs-top-profile" aria-selected="false" tabindex="-1" id="btnTabAntFinanEmpDetalle">
						Detalle
					</button>
				</li>
			</ul>
			<!-- Contenedor flotante para filtros aplicados -->
			<div id="filtrosAplicadosFloating" class="border rounded d-flex align-items-center" style="position:absolute; right:16px; left:auto; top:-2px; height:auto; width:auto; border-color:#d9534f; background-color:#fff; z-index:1050; padding:6px 10px; overflow:visible; gap:6px; display:inline-flex; white-space:nowrap;">
				<!-- Badges rellenadas por JS -->
			</div>
		</div>
		<div class="tab-content tab-content-compact">
			<div class="tab-pane fade tab-content-golden show active" id="navs-top-home" role="tabpanel">
				<div class="row col-12">
					<div class="col-10" id="divAntFinanEmp">
					</div>
					<div class="col-2">
						<div class="row ms-1">
							<button type="button" class="btn btn-secondary btn-sm me-1" style="margin-left:5px; width:88%;" id="btnImprimirDetalle">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-printer"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Imprimir Detalle
									</div>
								</div>
							</button>
						</div>
						<div class="row mt-1 ms-1">
							<button type="button" class="btn btn-secondary btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnImprimirVales">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-printer"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Imprimir Vales
									</div>
								</div>
							</button>
						</div>
						<div class="row mt-1 ms-1">
							<button type="button" class="btn btn-danger btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnAnularAntic">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-trash"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Anular Anticipos
									</div>
								</div>
							</button>
						</div>
						<div class="row mt-1 ms-1">
							<button type="button" class="btn btn-danger btn-sm mt-1 me-1" style="margin-left:5px; width:88%;" id="btnCancelar">
								<div class="row" style="display: contents">
									<div class="col-2">
										<span class="bx bx-x-circle"></span>
									</div>
									<div class="col-10" style="font-size: small;">
										Cancelar
									</div>
								</div>
							</button>
						</div>
					</div>
				</div>
			</div>
			<div class="tab-pane fade tab-content-golden" id="navs-top-profile" role="tabpanel">
				<div id="divAntFinanEmpDetalle">
				</div>
			</div>
			
		</div>
	</div>
</div>

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

@section scripts {
	<script type="text/javascript">
		var totalRegs = 0;
		var pagRegs = 0;
		var pags = 0;
		var pagina = 1;
		var search = "";
		var funcCallBack = "BuscarAnticiposDeEmpleados";
		var dataBak = {};
		var an_compte_selected = "";

		var autoComRel01Url = "@Url.Action("BuscarClientes", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var buscarAnticiposDeEmpleadosURL = "@Url.Action("BuscarAnticipoFinancierosDeEmpleados", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var buscarMetadataURL = "@Url.Action("ObtenerDatosPaginacion", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var cargarDetalleDeAnticipoUrl = "@Url.Action("CargarDetalleDeAnticipo", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var inicializarDatosEnSesionUrl =  "@Url.Action("InicializarDatosEnSesion", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var setearTipoDeReporteUrl = "@Url.Action("SetearTipoDeReporte", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var financieroAnticipoAnularUrl = "@Url.Action("FinancieroAnticipoAnular", "anticiposconsultayanulacion", new { area = "Financieros" })";
		var cargarUsuariosUrl = "@Url.Action("ObtenerUsuarios", "anticiposconsultayanulacion", new { area = "Financieros" })";

		// Gestor de impresión
		var repoApiUrl = '@Url.Action("ObtenerPdfDesdeAPI", "GestorImpresion", new { area = "ControlComun" })';
		var OrquestadorDeModulosUrl = "@Url.Action("OrquestadorDeModulos", "GestorImpresion", new { area = "ControlComun" })";
		var presentarArchivosUrl = "@Url.Action("presentarArchivos", "GestorImpresion", new { area = "ControlComun" })";
		var enviarEmailUrl = "@Url.Action("EnviarEmail", "GestorImpresion", new { area = "ControlComun" })";
		var enviarWhatsAppUrl = "@Url.Action("EnviarWhatsApp", "GestorImpresion", new { area = "ControlComun" })";
		var generadorArchivoUrl = "@Url.Action("GeneradorArchivo", "GestorImpresion", new { area = "ControlComun" })";
	</script>
	<script src="~/lib/xlsx/xlsx.full.min.js"></script>
	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/plugins/jquery.simplePagination.js"></script>

	<script src="~/js/app/areas/financieros/anticiposconsultayanulacion/consyanulacion.js" type="text/javascript"></script>
}