@model FiltroAnticipoConsYAnuModel
@{
}
<style>

</style>
<div class="card card-golden">
	<div class="card-header mb-2">
		<h5 class="mb-0" id="tituloLegend">Filtros </h5>
	</div>
	<div class="card-body">
		<div class="row">
			<div class="col-sm-5">
				<div class="row">
					<div class="input-group input-group-sm">
						<div class="form-check form-check-inline form-switch mb-2">
							<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkDesdeHasta" />
							<label class="form-check-label" for="chkDesdeHasta" id="lbChkDesdeHasta"></label>
						</div>
					</div>
					<div class=" col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text fixed-lbl-for-abm-70" id="lbIdDesde">Desde:</span>
							<input type="date" class="form-control inputEditable" asp-for="Date1" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
						</div>
					</div>
					<div class=" col-sm-6">
						<div class="input-group input-group-sm">
							<span class="input-group-text fixed-lbl-for-abm-70" id="lbIdHasta">Hasta:</span>
							<input type="date" class="form-control inputEditable" asp-for="Date2" style="background-color:rgb(251,255,195);font-weight:900;" disabled autofocus />
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-sm-6">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkRel01" />
						<label class="form-check-label" for="chkRel01" id="lbRel01"></label>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-sm-6">
				<div class="input-group  input-group-sm">
					<span class="input-group-text fixed-lbl-for-abm-70">Nombre</span>
					<input type="text" class="form-control inputEditable" name="Rel01" id="Rel01" disabled />
					@Html.Hidden("Rel01Item")
				</div>
			</div>
			<div class="col-sm-6">
				@Html.ListBox("Rel01List", null, new { @class = "form-control", @disabled = "disabled", size = "3" })
			</div>
		</div>
		<div class="row">
			<div class="col-sm-6">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkTipo" />
						<label class="form-check-label" for="chkTipo" id="lbTipo"></label>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-md-6" id="divCB">
				<div class="input-group input-group-sm">
					<span class="input-group-text d-flex align-items-center justify-content-end lbl-sm fixed-lbl-for-abm-70">Tipo</span>
					@Html.DropDownListFor(m => m.selectedValue, Model.ListaTipo, "Seleccionar", new { @id = "listaTipo", disabled = "disabled", @class = "form-control inputEditable activable" })
				</div>
			</div>
			@* <div class="col-sm-6">
				@Html.ListBox("CBList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
			</div> *@
		</div>
		<div class="row mt-2">
			<div class="col-sm-6">
				<div class="input-group input-group-sm">
					<div class="form-check form-check-inline form-switch mb-2">
						<input class="form-check-input" type="checkbox" name="EstadoActivo" id="chkUsuario" />
						<label class="form-check-label" for="chkUsuario" id="lbUsuario"></label>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-md-6" id="divCB">
				<div class="input-group input-group-sm">
					<span class="input-group-text d-flex align-items-center justify-content-end lbl-sm fixed-lbl-for-abm-70">Usuario</span>
					@Html.DropDownListFor(m => m.selectedValue, Model.ListaUsuario, "Seleccionar", new { @id = "listaUsuario", disabled = "disabled", @class = "form-control inputEditable activable" })
				</div>
			</div>
			<div class="col-sm-6">
				@Html.ListBox("UsuarioList", null, new { @class = "form-control listbox-sm", @disabled = "disabled" })
			</div>
		</div>
	</div>
</div>
<div class="row m-3">
	<div class="d-flex justify-content-around">
		<button type="button" id="btnCancel" class="btn btn-sm btn-danger">
			<i class="bx bx-x-circle"></i>Cancelar
		</button>
		<button type="button" id="btnBuscar" class="btn btn-sm btn-primary">
			<i class="bx bx-search"></i>Buscar
		</button>
	</div>
</div>