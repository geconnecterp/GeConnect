@model AnticipoFinanEmpModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}

	.table-wrapper-fixed-head th,
	.table-wrapper-fixed-head td {
		box-sizing: border-box;
	}

	.table-wrapper {
		overflow-x: hidden;
	}

</style>
<div class="table-responsive table-wrapper">
	<table class="table table-sm table-golden" id="tbGridAnticipoFinEmp">
		<thead>
			<tr class="header">
				<th class="text-center" scope="col">N° Anticipo</th>
				<th class="text-center" scope="col">Concepto</th>
				<th class="text-center" scope="col">Fecha</th>
				<th class="text-center" scope="col">Contrapartida</th>
				<th class="text-center" scope="col">Anulado</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaAnticipoFinanEmp != null && Model.GrillaAnticipoFinanEmp.ListaDatos != null && Model.GrillaAnticipoFinanEmp.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaAnticipoFinanEmp.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }

					<tr class="@clase" onclick="selectReg(this, 'tbGridAnticipoFinEmp')" data-an-compte="@item.an_compte">
						<td class="@Model.GrillaAnticipoFinanEmp.ObtenerClase(item.an_compte) align-center cell-fit-content">@Model.GrillaAnticipoFinanEmp.FormatearDato(item.an_compte, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaAnticipoFinanEmp.ObtenerClase(item.an_concepto) align-center cell-fit-content">@Model.GrillaAnticipoFinanEmp.FormatearDato(item.an_concepto, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaAnticipoFinanEmp.ObtenerClase(item.an_fecha) align-left cell-fit-content">@Model.GrillaAnticipoFinanEmp.FormatearDato(item.an_fecha, FormatDato.Fecha)</td>
						<td class="@Model.GrillaAnticipoFinanEmp.ObtenerClase(item.ant_desc) align-left cell-fit-content">@Model.GrillaAnticipoFinanEmp.FormatearDato(item.ant_desc, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaAnticipoFinanEmp.ObtenerClase(item.str_an_anulada) align-center cell-fit-content">@Model.GrillaAnticipoFinanEmp.FormatearDato(item.str_an_anulada, FormatDato.Ninguno)</td>
					</tr>
				}
			}
		</tbody>
	</table>
	<div class="row mt-3">
		<div class="offset-md-3 col-md-6">
			<div id="divPaginacion" class="">
			</div>
		</div>
	</div>
</div>