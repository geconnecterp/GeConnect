@model TransferenciaBancariaModel
@using gc.infraestructura.Helpers
@using static gc.infraestructura.Helpers.GridHelper
@{
    Layout = "~/views/shared/_Layout.cshtml";
	var alt = true;
	string clase = string.Empty;
}
@section styles {
	<link rel="stylesheet" href="~/css/simplePagination.css" />
	<link rel="stylesheet" href="~/lib/jstree/themes/default/style.min.css" />
}
<style>
	thead th {
		position: sticky;
		top: 0px;
	}

	.opciones {
		display: flex;
		gap: 100px;
	}

	fieldset {
		margin-left: 0px;
		margin-right: 0px;
		margin-top: 10px;
		border: 1px solid silver;
		padding: 8px;
		border-radius: 4px;
	}

	legend {
		padding: 2px;
		margin-top: -22px;
		background: #fff !important;
		width: 25%;
		text-align: center;
		font-size: small;
	}

	/* El contenedor debe ser el scroll real y generar contexto */
	#containerOrigen {
		position: relative;
		height: 540px;
		max-height: 540px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	#containerDestino {
		position: relative;
		height: 540px;
		max-height: 540px;
		overflow-y: auto; /* vertical */
		overflow-x: auto; /* horizontal si hace falta */
		z-index: auto; /* no fuerza stacking context */
	}

	/* Evitar collapse para que sticky funcione mejor en thead/th */
	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed; /* estabiliza anchos con tus width% */
	}

		/* Fijar el thead y darle fondo del tema */
		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1; /* suficiente para estar sobre las filas */
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			/* Redundancia intencional: asegurar cada th sticky y el mismo fondo */
			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box; /* evita “sangrados” con border-spacing */
			}

			/* Alinear colores: si tu app usa dorado para cabecera */
			.table-golden thead,
			.table-golden thead th {
				/*background-color: #b8860b;  tu dorado */
				/* color: #333; */
			}

	#tbListaOrigen th,
	#tbListaOrigen td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	/* Opcional: altura fija para todas las filas */
	#tbListaOrigen tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}

	#tbListaDestino th,
	#tbListaDestino td {
		padding: 0.01rem 0.15rem !important; /* o incluso 0 si querés máxima compresión */
		line-height: 1.2 !important; /* más compacto */
		height: auto !important; /* evita altura fija */
	}

	/* Opcional: altura fija para todas las filas */
	#tbListaDestino tr {
		height: 1.6rem !important; /* ajustá según lo que quieras */
	}
</style>
@Html.Hidden("parametro_valores_origen", Model.parametro_valores_origen)
@Html.Hidden("parametro_valores_destino", Model.parametro_valores_destino)
@Html.Hidden("parametro_confirmacion", Model.parametro_confirmacion)
<div class="card">
	<div class="container" style="margin-top:10px;">
		<div class="collapse col-md-2">
			<div class="d-flex justify-content-sm-end">
				<button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" title="Imprimir">
					<i class="bx bx-printer"></i>
				</button>
				<button type="button" class="btn btn-golden btn-sm mt-1 me-1 btnImprimir" id="btnImprimirTemp" title="Imprimir Temporal">
					<i class="bx bx-printer"></i>
				</button>
			</div>
		</div>
		<div class="row mb-2">

			<!-- Columna alineada con ORIGEN -->
			<div class="col-6 d-flex align-items-center">
				<div class="input-group input-group-sm">
					<span class="input-group-text">Concepto: </span>
					<input type="text" asp-for="concepto" class="form-control inputEditable" />

					<span class="input-group-text">Fecha: </span>
					@Html.TextBoxFor(m => m.fecha, "{0:yyyy-MM-dd}",
						new
						{
							type = "date",
							@class = "form-control activable inputEditable",
							@onchange = "onChangeFecha(this);",
							@id = "fecha",
							style = "width:120px; max-width:120px;"
						})
				</div>
			</div>

			<!-- Columna alineada con DESTINO -->
			<div class="col-6 d-flex justify-content-end align-items-center">
				<button id="btnAbmAceptar" class="btn btn-success btn-sm me-2 btn-compact" type="button" title="Aceptar">
					<i class="bx bx-badge-check"></i> Confirmar
				</button>
				<button id="btnAbmCancelar" class="btn btn-danger btn-sm btn-compact" type="button" title="Cancelar">
					<i class="bx bx-x-circle"></i> Cancelar
				</button>
			</div>

		</div>
		<div class="row">
			<dvi class="col-6">
				<fieldset>
					<legend>Origen</legend>
					<div class="row">
						<div class="col-1">
							<button id="btnAgregarValorOrigen" class="btn btn-success btn-sm me-1" type="button" title="Agregar">
								<i class="bx bx-plus bx-xs"></i>
							</button>
						</div>
						<div class="col-11" id="divOrigen" style="height: 550px;">
							<div class="table-responsive table-wrapper-440-full" id="containerOrigen">
								<table class="table table-sm table-golden" id="tbListaOrigen">
									<thead>
										<tr class="header">
											<th style="width:30%;" class="align-center">Cuenta Financiera</th>
											<th style="width:55%;" class="align-center">Valor</th>
											<th style="width:15%;" class="align-center">Importe</th>
											<th style="width:0%; display:none;">orden</th>
											<th style="width:0%; display:none;">dia_movi</th>
											<th style="width:0%; display:none;">fc_compte</th>
											<th style="width:0%; display:none;">fc_item</th>
										</tr>
									</thead>
									<tbody>
										@if (Model != null && Model.GrillaOrigen != null && Model.GrillaOrigen.ListaDatos != null && Model.GrillaOrigen.ListaDatos.Count > 0)
										{
											@foreach (var item in Model.GrillaOrigen.ListaDatos)
											{
												if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
												<tr class="@clase" onclick="selectReg(this, 'tbListaValores_Paso2')" ondblclick="selectRegDblGrillaValores(this);">
													<td class="@Model.GrillaOrigen.ObtenerClase(item.ctaf_denominacion) cell-fit-content">@Model.GrillaOrigen.FormatearDato(item.ctaf_denominacion, FormatDato.Ninguno)</td>
													<td class="@Model.GrillaOrigen.ObtenerClase(item.concepto_valor) cell-fit-content">@Model.GrillaOrigen.FormatearDato(item.concepto_valor, FormatDato.Monto)</td>
													<td class="@Model.GrillaOrigen.ObtenerClase(item.op_importe) cell-fit-content">@GridHelper.FormatearDato(item.op_importe, FormatDato.Monto, true)</td>
													<td style="display:none;">@item.orden</td>
													<td style="display:none;">@item.fc_dia_movi</td>
													<td style="display:none;">@item.fc_compte</td>
													<td style="display:none;">@item.fc_item</td>
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-8"></div>
						<div class="col-4">
							<div class="input-group input-group-sm">
								<span class="input-group-text">Total Origen: </span>
								<input type="text" asp-for="total_origen" class="form-control inputEditable align-right" readonly />
							</div>
						</div>
					</div>
				</fieldset>
			</dvi>
			<dvi class="col-6">
				<fieldset>
					<legend>Destino</legend>
					<div class="row">
						<div class="col-1">
							<button id="btnAgregarValorDestino" class="btn btn-success btn-sm me-1" type="button" title="Agregar">
								<i class="bx bx-plus bx-xs"></i>
							</button>
						</div>
						<div class="col-11" id="divDestino" style="height: 550px;">
							<div class="table-responsive table-wrapper-440-full" id="containerDestino">
								<table class="table table-sm table-golden" id="tbListaDestino">
									<thead>
										<tr class="header">
											<th style="width:35%;" class="align-center">Cuenta Financiera</th>
											<th style="width:55%;" class="align-center">Valor</th>
											<th style="width:10%;" class="align-center">Importe</th>
											<th style="width:0%; display:none;">orden</th>
											<th style="width:0%; display:none;">dia_movi</th>
											<th style="width:0%; display:none;">fc_compte</th>
											<th style="width:0%; display:none;">fc_item</th>
										</tr>
									</thead>
									<tbody>
										@if (Model != null && Model.GrillaDestino != null && Model.GrillaDestino.ListaDatos != null && Model.GrillaDestino.ListaDatos.Count > 0)
										{
											@foreach (var item in Model.GrillaDestino.ListaDatos)
											{
												if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
												<tr class="@clase" onclick="selectReg(this, 'tbListaValores_Paso2')" ondblclick="selectRegDblGrillaValores(this);">
													<td class="@Model.GrillaDestino.ObtenerClase(item.ctaf_denominacion) cell-fit-content">@Model.GrillaDestino.FormatearDato(item.ctaf_denominacion, FormatDato.Ninguno)</td>
													<td class="@Model.GrillaDestino.ObtenerClase(item.concepto_valor) cell-fit-content">@Model.GrillaDestino.FormatearDato(item.concepto_valor, FormatDato.Monto)</td>
													<td class="@Model.GrillaDestino.ObtenerClase(item.op_importe) cell-fit-content">@GridHelper.FormatearDato(item.op_importe, FormatDato.Monto, true)</td>
													<td style="display:none;">@item.orden</td>
													<td style="display:none;">@item.fc_dia_movi</td>
													<td style="display:none;">@item.fc_compte</td>
													<td style="display:none;">@item.fc_item</td>
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-8"></div>
						<div class="col-4">
							<div class="input-group input-group-sm">
								<span class="input-group-text">Total Destino: </span>
								<input type="text" asp-for="total_destino" class="form-control inputEditable align-right" readonly />
							</div>
						</div>
					</div>
				</fieldset>
			</dvi>
		</div>
	</div>
</div>

<div id="modalSeleccionValores"></div>
@Html.Hidden("UpdateValores", false)

<!-- para el modal del geston de impresion -->
<div id="modalGestorDocumental"></div>

