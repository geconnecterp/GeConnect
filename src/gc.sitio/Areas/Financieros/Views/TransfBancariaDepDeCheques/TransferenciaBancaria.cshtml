	<script src="~/lib/jstree/jstree.min.js"></script>
	<script src="~/js/app/areas/docmngr/docmanager.js"></script>

	<script src="~/js/app/controlcomun/selecciondevalores.js"></script>
	<script src="~/js/app/areas/financieros/transfbancariadepdecheques/transbancariadepdecheques.js"></script>
}