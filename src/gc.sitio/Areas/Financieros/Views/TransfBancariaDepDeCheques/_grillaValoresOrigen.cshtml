@model ValoresModel
@using static gc.infraestructura.Helpers.GridHelper
@{
	var alt = true;
	string clase = string.Empty;
}
@Html.Hidden("YaExiste", Model.YaExiste)
@Html.Hidden("MensajeExiste", Model.MensajeExiste)
<div class="table-responsive table-wrapper-440-full" id="containerOrigen">
	<table class="table table-sm table-golden" id="tbListaOrigen">
		<thead>
			<tr class="header">
				<th style="width:30%;" class="align-center">Cuenta Financiera</th>
				<th style="width:55%;" class="align-center">Valor</th>
				<th style="width:15%;" class="align-center">Importe</th>
				<th style="width:0%; display:none;">orden</th>
				<th style="width:0%; display:none;">dia_movi</th>
				<th style="width:0%; display:none;">fc_compte</th>
				<th style="width:0%; display:none;">fc_item</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.Grilla != null && Model.Grilla.ListaDatos != null && Model.Grilla.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.Grilla.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" onclick="selectReg(this, 'tbListaOrigen')" ondblclick="selectRegDblGrillaValores(this, 'tbListaOrigen');">
						<td class="@Model.Grilla.ObtenerClase(item.ctaf_denominacion) cell-fit-content">@Model.Grilla.FormatearDato(item.ctaf_denominacion, FormatDato.Ninguno)</td>
						<td class="@Model.Grilla.ObtenerClase(item.concepto_valor) cell-fit-content">@Model.Grilla.FormatearDato(item.concepto_valor, FormatDato.Monto)</td>
						<td class="@Model.Grilla.ObtenerClase(item.op_importe) cell-fit-content">@Model.Grilla.FormatearDato(item.op_importe, FormatDato.Monto)</td>
						<td style="display:none;">@item.orden</td>
						<td style="display:none;">@item.fc_dia_movi</td>
						<td style="display:none;">@item.fc_compte</td>
						<td style="display:none;">@item.fc_item</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>