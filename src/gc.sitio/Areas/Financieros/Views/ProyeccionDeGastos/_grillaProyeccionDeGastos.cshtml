@using static gc.infraestructura.Helpers.GridHelper
@model ProyeccionDeGastosModel
@{
	var alt = true;
	string clase = string.Empty;
}
<style>
	#containerGrillaProyeccionDeGastos {
		position: relative;
		height: 560px;
		max-height: 560px;
		overflow-y: auto;
		overflow-x: auto;
		z-index: auto;
	}

	.table-golden {
		border-collapse: separate;
		border-spacing: 0;
		table-layout: fixed;
	}

		.table-golden thead {
			position: sticky;
			top: 0;
			z-index: 1;
			background: linear-gradient(to bottom, #b8860b, #daa520) !important;
			color: #fff !important;
		}

			.table-golden thead th {
				position: sticky;
				top: 0;
				z-index: 4;
				background: linear-gradient(to bottom, #b8860b, #daa520);
				color: #fff;
				box-shadow: 0 1px 0 rgba(0,0,0,0.05), 0 2px 2px rgba(0,0,0,0.04);
				background-clip: padding-box;
			}

			.table-golden thead,
			.table-golden thead th {
				text-align: center;
			}

	#tbListaProyeccionDeGastos th,
	#tbListaProyeccionDeGastos td {
		padding: 0.01rem 0.15rem !important;
		line-height: 1.2 !important;
	}

	#tbListaProyeccionDeGastos tr {
		height: 1.6rem !important;
	}

	.btn-icon-compact {
		padding: 0.15rem 0.3rem;
		font-size: 0.7rem;
		line-height: 1;
	}

		.btn-icon-compact i {
			font-size: 0.9rem;
		}

	#tbListaProyeccionDeGastos tbody tr {
		height: 1.75rem !important; /* antes era 1.6rem */
	}

	#tbListaProyeccionDeGastos tbody td {
		padding-top: 0.1rem !important;
		padding-bottom: 0.1rem !important;
	}

	.fila-futura {
		color: #b30000 !important; /* rojo suave */
		font-weight: 600 !important; /* semi-bold */
	}

</style>
<div class="table-responsive table-wrapper-500-full-width" id="containerGrillaProyeccionDeGastos">
	<table class="table table-bordered table-hover table-golden" id="tbListaProyeccionDeGastos">
		<thead>
			<tr class="header">
				<th class="text-center" scope="col" style="width:10%">Fecha</th>
				<th class="text-center" scope="col" style="width:40%">Concepto</th>
				<th class="text-center" scope="col" style="width:15%">Importe</th>
				<th class="text-center" scope="col" style="width:15%">Acumulado</th>
				<th style="width:7%;"></th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.GrillaProyeccion != null && Model.GrillaProyeccion.ListaDatos != null && Model.GrillaProyeccion.ListaDatos.Count > 0)
			{
				@foreach (var item in Model.GrillaProyeccion.ListaDatos)
				{
					if (alt) { clase = "alt"; alt = false; } else { clase = string.Empty; alt = true; }
					<tr class="@clase" data-orden="@item.orden" onclick="selectItemGrillaProyeccion(this);">
						<td class="@Model.GrillaProyeccion.ObtenerClase(item.fecha)">@Model.GrillaProyeccion.FormatearDato(item.fecha, FormatDato.Fecha)</td>
						<td class="@Model.GrillaProyeccion.ObtenerClase(item.concepto)">@Model.GrillaProyeccion.FormatearDato(item.concepto, FormatDato.Ninguno)</td>
						<td class="@Model.GrillaProyeccion.ObtenerClase(item.importe)">@Model.GrillaProyeccion.FormatearDato(item.importe, FormatDato.Monto)</td>
						<td class="@Model.GrillaProyeccion.ObtenerClase(item.acumulado)">@Model.GrillaProyeccion.FormatearDato(item.acumulado, FormatDato.Monto)</td>
						<td class="text-center align-middle">
							<div class="d-flex justify-content-center gap-1">
								<button type="button" class="btn btn-info btn-icon-compact" title="Modificar" onclick="modificarItem('@item.orden', '@item.items')">
									<i class="bx bx-edit"></i>
								</button>
								<button type="button" class="btn btn-danger btn-icon-compact" title="Eliminar" onclick="eliminarItem('@item.orden', '@item.items', '@item.concepto')">
									<i class="bx bx-trash"></i>
								</button>
							</div>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>
